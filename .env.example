# ═══════════════════════════════════════════════════════
# Walton Family — Environment Variables
# Copy this to .env and fill in your values
# For Vercel: set these in Project Settings → Environment Variables
# ═══════════════════════════════════════════════════════

# Server
NODE_ENV=development
PORT=3000

# ── Database (MySQL) ──
# Local: use localhost / root
# Production: use your MySQL host (InfinityFree, PlanetScale, Railway, etc.)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=walton_family
DB_USER=root
DB_PASS=

# ── Session ──
SESSION_SECRET=change_this_to_a_long_random_string
SESSION_MAX_AGE=2592000000

# ── Discord OAuth2 ──
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=https://your-domain.vercel.app/auth/discord/callback

# ── Discord Bot API ──
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_discord_guild_id
DISCORD_PROXY_BASE=https://dawn-sun-102d.abdllafa1.workers.dev

# ── Secrets ──
SECRET_BOT_API=change_me
SECRET_WEBHOOK=change_me
SECRET_CRON=change_me

# ── Site Settings ──
SITE_NAME=Walton Family
SITE_URL=https://your-domain.vercel.app
SITE_ACCENT_COLOR=#780ecf

# ── Rate Limiting ──
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60000

# ── Discord Webhooks ──
WH_PROXY=
WH_ADMIN_LOG=
WH_APPLICATIONS=
WH_SUPPORT_LOG=
WH_NEW_ACCOUNT=
WH_COMMUNITY=
