<%- include('layout') %>
<script>document.getElementById('pageTitle').textContent = 'إشعارات الديسكورد';</script>

<style>
.bot-notify-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}
@media(max-width:768px){.bot-notify-grid{grid-template-columns:1fr}}
.bot-notify-card{padding:20px;background:var(--bg-card);border:1px solid var(--border);border-radius:12px}
.bot-notify-card h3{margin-bottom:16px;font-size:14px;display:flex;align-items:center;gap:8px}
.bot-notify-card h3 i{color:var(--ac)}
.bot-send-btn{padding:10px 20px;border-radius:8px;border:none;background:var(--ac);color:#fff;font-family:inherit;font-weight:700;cursor:pointer;font-size:13px;transition:all .3s;width:100%}
.bot-send-btn:hover{opacity:.9}
.bot-send-btn:disabled{opacity:.5;cursor:not-allowed}
.bot-result{margin-top:12px;padding:10px;border-radius:8px;font-size:12px;display:none}
.bot-result.success{display:block;background:rgba(34,197,94,.1);color:#22c55e;border:1px solid rgba(34,197,94,.2)}
.bot-result.error{display:block;background:rgba(239,68,68,.1);color:#ef4444;border:1px solid rgba(239,68,68,.2)}
.bot-quick-msgs{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.bot-quick-msg{padding:4px 10px;border-radius:6px;border:1px solid var(--border);background:transparent;color:var(--text-dim);cursor:pointer;font-size:11px;font-family:inherit;transition:all .2s}
.bot-quick-msg:hover{background:rgba(var(--ac-rgb),.1);color:var(--ac);border-color:var(--ac)}
</style>

<div class="bot-notify-grid">
  <!-- Send to Channel -->
  <div class="bot-notify-card">
    <h3><i class="fas fa-bullhorn"></i> إرسال رسالة لقناة</h3>
    <div style="margin-bottom:12px">
      <label style="display:block;font-size:12px;font-weight:600;color:var(--text-dim);margin-bottom:4px">القناة</label>
      <select id="channelSelect" style="width:100%;padding:10px 12px;background:rgba(255,255,255,.05);border:1px solid var(--border);border-radius:8px;color:var(--text);font-family:inherit">
        <option value="">جاري التحميل...</option>
      </select>
    </div>
    <div style="margin-bottom:12px">
      <label style="display:block;font-size:12px;font-weight:600;color:var(--text-dim);margin-bottom:4px">الرسالة</label>
      <textarea id="channelMessage" rows="4" placeholder="اكتب الرسالة..." style="width:100%;padding:10px 12px;background:rgba(255,255,255,.05);border:1px solid var(--border);border-radius:8px;color:var(--text);font-family:inherit;resize:vertical"></textarea>
    </div>
    <div class="bot-quick-msgs">
      <button class="bot-quick-msg" onclick="quickMsg('channel','مرحباً بالجميع! 👋')">تحية</button>
      <button class="bot-quick-msg" onclick="quickMsg('channel','📢 إعلان هام')">إعلان</button>
      <button class="bot-quick-msg" onclick="quickMsg('channel','🎉 مبروك للفائز!')">تهنئة</button>
      <button class="bot-quick-msg" onclick="quickMsg('channel','⚠️ تنبيه: اقرأوا القوانين')">تنبيه</button>
    </div>
    <button class="bot-send-btn" onclick="sendToChannel()" id="btnChannelSend"><i class="fas fa-paper-plane"></i> إرسال</button>
    <div class="bot-result" id="channelResult"></div>
  </div>

  <!-- Send DM -->
  <div class="bot-notify-card">
    <h3><i class="fas fa-envelope"></i> إرسال رسالة خاصة (DM)</h3>
    <div style="margin-bottom:12px">
      <label style="display:block;font-size:12px;font-weight:600;color:var(--text-dim);margin-bottom:4px">معرف المستخدم (Discord ID)</label>
      <input type="text" id="dmUserId" placeholder="123456789012345678" style="width:100%;padding:10px 12px;background:rgba(255,255,255,.05);border:1px solid var(--border);border-radius:8px;color:var(--text);font-family:monospace;font-size:13px">
    </div>
    <div style="margin-bottom:12px">
      <label style="display:block;font-size:12px;font-weight:600;color:var(--text-dim);margin-bottom:4px">الرسالة</label>
      <textarea id="dmMessage" rows="4" placeholder="اكتب الرسالة..." style="width:100%;padding:10px 12px;background:rgba(255,255,255,.05);border:1px solid var(--border);border-radius:8px;color:var(--text);font-family:inherit;resize:vertical"></textarea>
    </div>
    <div class="bot-quick-msgs">
      <button class="bot-quick-msg" onclick="quickMsg('dm','مرحباً! 👋')">تحية</button>
      <button class="bot-quick-msg" onclick="quickMsg('dm','تم قبول طلبك! 🎉')">قبول</button>
      <button class="bot-quick-msg" onclick="quickMsg('dm','تم رفض طلبك. يمكنك المحاولة مرة أخرى بعد 24 ساعة')">رفض</button>
      <button class="bot-quick-msg" onclick="quickMsg('dm','⚠️ تنبيه: قم بقراءة القوانين')">تنبيه</button>
    </div>
    <button class="bot-send-btn" onclick="sendDM()" id="btnDmSend"><i class="fas fa-paper-plane"></i> إرسال</button>
    <div class="bot-result" id="dmResult"></div>
  </div>
</div>

<script>
async function loadChannels() {
  try {
    const res = await fetch('/api/bot/channels');
    const data = await res.json();
    const sel = document.getElementById('channelSelect');
    if (!data.success || !data.channels.length) { sel.innerHTML = '<option value="">لا توجد قنوات</option>'; return; }
    sel.innerHTML = '<option value="">اختر قناة...</option>' + data.channels.map(c =>
      '<option value="' + c.id + '">' + (c.category ? c.category + ' / ' : '') + '#' + c.name + '</option>'
    ).join('');
  } catch(e) {
    document.getElementById('channelSelect').innerHTML = '<option value="">خطأ في التحميل</option>';
  }
}

function quickMsg(type, msg) {
  document.getElementById(type === 'channel' ? 'channelMessage' : 'dmMessage').value = msg;
}

async function sendToChannel() {
  const channelId = document.getElementById('channelSelect').value;
  const message = document.getElementById('channelMessage').value;
  if (!channelId || !message) return;
  const btn = document.getElementById('btnChannelSend');
  const result = document.getElementById('channelResult');
  btn.disabled = true;
  try {
    const res = await fetch('/api/bot/channel', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ channelId, message }) });
    const data = await res.json();
    result.className = 'bot-result ' + (data.success ? 'success' : 'error');
    result.textContent = data.success ? 'تم الإرسال بنجاح' : (data.error || 'خطأ');
  } catch(e) {
    result.className = 'bot-result error';
    result.textContent = 'خطأ في الاتصال';
  }
  btn.disabled = false;
}

async function sendDM() {
  const userId = document.getElementById('dmUserId').value;
  const message = document.getElementById('dmMessage').value;
  if (!userId || !message) return;
  const btn = document.getElementById('btnDmSend');
  const result = document.getElementById('dmResult');
  btn.disabled = true;
  try {
    const res = await fetch('/api/bot/dm', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ userId, message }) });
    const data = await res.json();
    result.className = 'bot-result ' + (data.success ? 'success' : 'error');
    result.textContent = data.success ? 'تم الإرسال' : (data.error || 'تأكد من أن المستخدم يسمح بالرسائل الخاصة');
  } catch(e) {
    result.className = 'bot-result error';
    result.textContent = 'خطأ في الاتصال';
  }
  btn.disabled = false;
}

loadChannels();
</script>
<%- include('admin_footer') %>
