<%- include('layout') %>
<script>document.getElementById('pageTitle').textContent = 'إشعارات الديسكورد';</script>

<style>
.bot-notify-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}
@media(max-width:768px){.bot-notify-grid{grid-template-columns:1fr}}
.bot-notify-card{padding:20px;background:var(--bg-card);border:1px solid var(--border);border-radius:12px}
.bot-notify-card h3{margin-bottom:16px;font-size:14px;display:flex;align-items:center;gap:8px}
.bot-notify-card h3 i{color:var(--ac)}
.bot-send-btn{padding:10px 20px;border-radius:8px;border:none;background:var(--ac);color:#fff;font-family:inherit;font-weight:700;cursor:pointer;font-size:13px;transition:all .3s;width:100%}
.bot-send-btn:hover{opacity:.9}
.bot-send-btn:disabled{opacity:.5;cursor:not-allowed}
.bot-result{margin-top:12px;padding:10px;border-radius:8px;font-size:12px;display:none}
.bot-result.success{display:block;background:rgba(34,197,94,.1);color:#22c55e;border:1px solid rgba(34,197,94,.2)}
.bot-result.error{display:block;background:rgba(239,68,68,.1);color:#ef4444;border:1px solid rgba(239,68,68,.2)}
.bot-quick-msgs{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.bot-quick-msg{padding:4px 10px;border-radius:6px;border:1px solid var(--border);background:transparent;color:var(--text-dim);cursor:pointer;font-size:11px;font-family:inherit;transition:all .2s}
.bot-quick-msg:hover{background:rgba(var(--ac-rgb),.1);color:var(--ac);border-color:var(--ac)}
/* روابط ويبهوك الإشعارات */
.wh-help{margin-bottom:14px;padding:12px 14px;border-radius:10px;background:rgba(var(--ac-rgb),.06);border:1px solid rgba(var(--ac-rgb),.18);font-size:12.5px;line-height:2;color:var(--text-dim)}
.wh-help b{color:var(--text)}
.wh-help ol{margin:6px 18px 0 0;padding:0}
.wh-row{padding:12px;border:1px solid var(--border);border-radius:10px;margin-bottom:10px;background:rgba(255,255,255,.02)}
.wh-row-head{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:8px}
.wh-label{font-size:13px;font-weight:700;color:var(--text)}
.wh-key{font-family:monospace;font-size:10.5px;padding:2px 7px;border-radius:5px;background:rgba(var(--ac-rgb),.12);color:var(--ac);border:1px solid rgba(var(--ac-rgb),.25)}
.wh-src{font-size:10.5px;padding:2px 8px;border-radius:5px;border:1px solid transparent}
.wh-src.db{background:rgba(34,197,94,.12);color:#22c55e;border-color:rgba(34,197,94,.3)}
.wh-src.env{background:rgba(59,130,246,.12);color:#60a5fa;border-color:rgba(59,130,246,.3)}
.wh-src.none{background:rgba(239,68,68,.12);color:#f87171;border-color:rgba(239,68,68,.3)}
.wh-row-body{display:flex;gap:8px}
.wh-row-body input{flex:1;min-width:0;padding:9px 12px;background:rgba(255,255,255,.05);border:1px solid var(--border);border-radius:8px;color:var(--text);font-family:monospace;font-size:12px}
.wh-row-body input:focus{outline:none;border-color:var(--ac)}
.wh-test-btn{padding:9px 14px;border-radius:8px;border:1px solid var(--border);background:transparent;color:var(--text-dim);font-family:inherit;font-size:12px;font-weight:700;cursor:pointer;white-space:nowrap;transition:all .2s}
.wh-test-btn:hover{border-color:var(--ac);color:var(--ac)}
.wh-test-btn:disabled{opacity:.5;cursor:not-allowed}
.wh-test-result{margin-top:7px;font-size:11.5px;display:none;padding:6px 10px;border-radius:7px}
.wh-test-result.ok{display:block;background:rgba(34,197,94,.1);color:#22c55e;border:1px solid rgba(34,197,94,.25)}
.wh-test-result.err{display:block;background:rgba(239,68,68,.1);color:#f87171;border:1px solid rgba(239,68,68,.25)}
.wh-more{margin-top:4px}
.wh-more summary{cursor:pointer;font-size:12.5px;font-weight:700;color:var(--text-dim);padding:8px 0;user-select:none}
.wh-more summary:hover{color:var(--ac)}
.wh-more[open] summary{color:var(--ac)}
.wh-save-result{margin-top:12px;padding:10px;border-radius:8px;font-size:12px;display:none}
.wh-save-result.success{display:block;background:rgba(34,197,94,.1);color:#22c55e;border:1px solid rgba(34,197,94,.2)}
.wh-save-result.error{display:block;background:rgba(239,68,68,.1);color:#ef4444;border:1px solid rgba(239,68,68,.2)}
@media(max-width:600px){.wh-row-body{flex-direction:column}.wh-test-btn{width:100%}}
</style>

<!-- روابط ويبهوك الإشعارات -->
<div class="bot-notify-card" style="margin-bottom:20px">
  <h3><i class="fas fa-link"></i> روابط ويبهوك الإشعارات — الصق الرابط واحفظ بدون Railway</h3>
  <details class="wh-help" open>
    <summary style="cursor:pointer;font-weight:700;color:var(--text);user-select:none">📌 كيف أسوي رابط ويبهوك من ديسكورد؟ (اضغط للفتح/الطي)</summary>
    <ol>
      <li>افتح <b>ديسكورد</b> وادخل سيرفرك</li>
      <li>اضغط <b>اسم السيرفر</b> (فوق) ← <b>إعدادات السيرفر</b></li>
      <li>من القائمة الجانبية: <b>التكاملات</b> ← <b>ويبهوكات الويب</b></li>
      <li>اضغط <b>«ويبهوك جديد»</b> وسمّه (مثال: اشعارات والتون) واختر <b>القناة</b> اللي تبي الإشعارات تجي فيها</li>
      <li>اضغط <b>«نسخ رابط الويبهوك»</b></li>
      <li>ارجع هنا — الصق الرابط في خانته تحت واضغط <b>حفظ الروابط</b> — وجرب زر <b>تجربة</b> بتوصلك رسالة بالقناة فوراً</li>
    </ol>
  </details>
  <div id="whList" style="margin-top:14px"><span style="font-size:12px;color:var(--text-dim)">جاري التحميل...</span></div>
  <button class="bot-send-btn" onclick="whSave()" id="whSaveBtn"><i class="fas fa-floppy-disk"></i> حفظ الروابط</button>
  <div class="wh-save-result" id="whSaveResult"></div>
</div>

<div class="bot-notify-grid">
  <!-- Send to Channel -->
  <div class="bot-notify-card">
    <h3><i class="fas fa-bullhorn"></i> إرسال رسالة لقناة</h3>
    <div style="margin-bottom:12px">
      <label style="display:block;font-size:12px;font-weight:600;color:var(--text-dim);margin-bottom:4px">القناة</label>
      <select id="channelSelect" style="width:100%;padding:10px 12px;background:rgba(255,255,255,.05);border:1px solid var(--border);border-radius:8px;color:var(--text);font-family:inherit">
        <option value="">جاري التحميل...</option>
      </select>
    </div>
    <div style="margin-bottom:12px">
      <label style="display:block;font-size:12px;font-weight:600;color:var(--text-dim);margin-bottom:4px">الرسالة</label>
      <textarea id="channelMessage" rows="4" placeholder="اكتب الرسالة..." style="width:100%;padding:10px 12px;background:rgba(255,255,255,.05);border:1px solid var(--border);border-radius:8px;color:var(--text);font-family:inherit;resize:vertical"></textarea>
    </div>
    <div class="bot-quick-msgs">
      <button class="bot-quick-msg" onclick="quickMsg('channel','مرحباً بالجميع! 👋')">تحية</button>
      <button class="bot-quick-msg" onclick="quickMsg('channel','📢 إعلان هام')">إعلان</button>
      <button class="bot-quick-msg" onclick="quickMsg('channel','🎉 مبروك للفائز!')">تهنئة</button>
      <button class="bot-quick-msg" onclick="quickMsg('channel','⚠️ تنبيه: اقرأوا القوانين')">تنبيه</button>
    </div>
    <button class="bot-send-btn" onclick="sendToChannel()" id="btnChannelSend"><i class="fas fa-paper-plane"></i> إرسال</button>
    <div class="bot-result" id="channelResult"></div>
  </div>

  <!-- Send DM -->
  <div class="bot-notify-card">
    <h3><i class="fas fa-envelope"></i> إرسال رسالة خاصة (DM)</h3>
    <div style="margin-bottom:12px">
      <label style="display:block;font-size:12px;font-weight:600;color:var(--text-dim);margin-bottom:4px">معرف المستخدم (Discord ID)</label>
      <input type="text" id="dmUserId" placeholder="123456789012345678" style="width:100%;padding:10px 12px;background:rgba(255,255,255,.05);border:1px solid var(--border);border-radius:8px;color:var(--text);font-family:monospace;font-size:13px">
    </div>
    <div style="margin-bottom:12px">
      <label style="display:block;font-size:12px;font-weight:600;color:var(--text-dim);margin-bottom:4px">الرسالة</label>
      <textarea id="dmMessage" rows="4" placeholder="اكتب الرسالة..." style="width:100%;padding:10px 12px;background:rgba(255,255,255,.05);border:1px solid var(--border);border-radius:8px;color:var(--text);font-family:inherit;resize:vertical"></textarea>
    </div>
    <div class="bot-quick-msgs">
      <button class="bot-quick-msg" onclick="quickMsg('dm','مرحباً! 👋')">تحية</button>
      <button class="bot-quick-msg" onclick="quickMsg('dm','تم قبول طلبك! 🎉')">قبول</button>
      <button class="bot-quick-msg" onclick="quickMsg('dm','تم رفض طلبك. يمكنك المحاولة مرة أخرى بعد 24 ساعة')">رفض</button>
      <button class="bot-quick-msg" onclick="quickMsg('dm','⚠️ تنبيه: قم بقراءة القوانين')">تنبيه</button>
    </div>
    <button class="bot-send-btn" onclick="sendDM()" id="btnDmSend"><i class="fas fa-paper-plane"></i> إرسال</button>
    <div class="bot-result" id="dmResult"></div>
  </div>
</div>

<script>
async function loadChannels() {
  try {
    const res = await fetch('/api/bot/channels');
    const data = await res.json();
    const sel = document.getElementById('channelSelect');
    if (!data.success || !data.channels.length) { sel.innerHTML = '<option value="">لا توجد قنوات</option>'; return; }
    sel.innerHTML = '<option value="">اختر قناة...</option>' + data.channels.map(c =>
      '<option value="' + c.id + '">' + (c.category ? c.category + ' / ' : '') + '#' + c.name + '</option>'
    ).join('');
  } catch(e) {
    document.getElementById('channelSelect').innerHTML = '<option value="">خطأ في التحميل</option>';
  }
}

function quickMsg(type, msg) {
  document.getElementById(type === 'channel' ? 'channelMessage' : 'dmMessage').value = msg;
}

async function sendToChannel() {
  const channelId = document.getElementById('channelSelect').value;
  const message = document.getElementById('channelMessage').value;
  if (!channelId || !message) return;
  const btn = document.getElementById('btnChannelSend');
  const result = document.getElementById('channelResult');
  btn.disabled = true;
  try {
    const res = await fetch('/api/bot/channel', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ channelId, message }) });
    const data = await res.json();
    result.className = 'bot-result ' + (data.success ? 'success' : 'error');
    result.textContent = data.success ? 'تم الإرسال بنجاح' : (data.error || 'خطأ');
  } catch(e) {
    result.className = 'bot-result error';
    result.textContent = 'خطأ في الاتصال';
  }
  btn.disabled = false;
}

async function sendDM() {
  const userId = document.getElementById('dmUserId').value;
  const message = document.getElementById('dmMessage').value;
  if (!userId || !message) return;
  const btn = document.getElementById('btnDmSend');
  const result = document.getElementById('dmResult');
  btn.disabled = true;
  try {
    const res = await fetch('/api/bot/dm', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ userId, message }) });
    const data = await res.json();
    result.className = 'bot-result ' + (data.success ? 'success' : 'error');
    result.textContent = data.success ? 'تم الإرسال' : (data.error || 'تأكد من أن المستخدم يسمح بالرسائل الخاصة');
  } catch(e) {
    result.className = 'bot-result error';
    result.textContent = 'خطأ في الاتصال';
  }
  btn.disabled = false;
}

/* ===== روابط ويبهوك الإشعارات ===== */
const WH_LABELS = {
  WH_FARM: 'إشعارات المزارع (الحجوزات والعربون والنص الثاني)',
  WH_COMPANY: 'إشعارات خدمات الشركة (الطلبات والتأكيدات)',
  WH_ADMIN_LOG: 'سجل عمليات الإدارة',
  WH_APPLICATIONS: 'طلبات الانضمام — جديدة',
  WH_APP_NOTIFY: 'تنبيهات مراجعة الطلبات',
  WH_FAMILY_STORE: 'متجر العائلة',
  WH_PRODUCTS: 'المنتجات والطلبات',
  WH_SUPPORT_LOG: 'سجل التذاكر',
  WH_SUPPORT_NOTIFY: 'تنبيهات التذاكر الجديدة',
  WH_CONTENT: 'تعديلات المحتوى والإخبار',
  WH_NEW_ACCOUNT: 'تسجيلات الحسابات الجديدة',
  WH_STAFF_CHAT: 'محادثة الطاقم',
  WH_ROLE_CHANGE: 'تغييرات الرتب',
  WH_STAFF_PERMS: 'صلاحيات الطاقم',
  WH_COMMUNITY: 'نشاطات المجتمع',
  WH_ABOUT: 'تعديلات صفحة من نحن',
  WH_APP_SETTINGS: 'تغييرات إعدادات الطلبات',
  WH_BROADCAST: 'الإذاعات',
  WH_STAFF: 'إشعارات الطاقم',
  WH_SHOP: 'المتجر'
};
const WH_PRIMARY = ['WH_FARM', 'WH_COMPANY', 'WH_ADMIN_LOG'];
let whItems = [];

function whEsc(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
function whSrcBadge(s) {
  if (s === 'db') return '<span class="wh-src db">محفوظ بالموقع</span>';
  if (s === 'env') return '<span class="wh-src env">من متغيرات Railway</span>';
  return '<span class="wh-src none">غير مضبوط — ما راح توصل إشعارات</span>';
}
function whRow(w) {
  return '<div class="wh-row" data-key="' + w.key + '">' +
    '<div class="wh-row-head"><span class="wh-label">' + whEsc(WH_LABELS[w.key] || w.key) + '</span>' +
    '<span class="wh-key">' + w.key + '</span>' + whSrcBadge(w.source) + '</div>' +
    '<div class="wh-row-body"><input type="text" dir="ltr" data-key="' + w.key + '" placeholder="https://discord.com/api/webhooks/..." value="' + whEsc(w.url) + '" spellcheck="false">' +
    '<button class="wh-test-btn" onclick="whTest(\'' + w.key + '\', this)"><i class="fas fa-vial"></i> تجربة</button></div>' +
    '<div class="wh-test-result" id="whRes_' + w.key + '"></div></div>';
}
function whRender() {
  const prim = whItems.filter(w => WH_PRIMARY.includes(w.key));
  const rest = whItems.filter(w => !WH_PRIMARY.includes(w.key));
  let html = prim.map(whRow).join('');
  if (rest.length) {
    html += '<details class="wh-more"><summary><i class="fas fa-sliders"></i> قنوات أخرى (' + rest.length + ') — للإشعارات الثانوية</summary>' + rest.map(whRow).join('') + '</details>';
  }
  document.getElementById('whList').innerHTML = html;
}
async function whLoad() {
  try {
    const res = await fetch('/api/admin/webhook-settings');
    const data = await res.json();
    if (!data.success) { document.getElementById('whList').innerHTML = '<span style="font-size:12px;color:#f87171">خطأ في التحميل: ' + whEsc(data.error || '') + '</span>'; return; }
    whItems = data.webhooks || [];
    whRender();
  } catch(e) {
    document.getElementById('whList').innerHTML = '<span style="font-size:12px;color:#f87171">خطأ في الاتصال</span>';
  }
}
async function whSave() {
  const btn = document.getElementById('whSaveBtn');
  const box = document.getElementById('whSaveResult');
  const urls = {};
  document.querySelectorAll('#whList input[data-key]').forEach(i => { urls[i.dataset.key] = i.value.trim(); });
  btn.disabled = true;
  try {
    const res = await fetch('/api/admin/webhook-settings', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ urls }) });
    const data = await res.json();
    if (data.success) {
      const bad = (data.invalid || []);
      if (bad.length) {
        box.className = 'wh-save-result error';
        box.textContent = '⚠️ حُفظ ' + (data.saved || []).length + ' رابط — لكن هذي المفاتيح فيها روابط غير صالحة (تأكد إن الرابط منسوخ كامل): ' + bad.join(', ');
      } else {
        box.className = 'wh-save-result success';
        box.textContent = '✅ تم الحفظ — الإشعارات راح تروح على الروابط الجديدة خلال دقيقة كأقصى تقدير' + ((data.cleared || []).length ? ' (وتم مسح: ' + data.cleared.join(', ') + ')' : '');
      }
    } else {
      box.className = 'wh-save-result error';
      box.textContent = data.error || 'خطأ في الحفظ';
    }
  } catch(e) {
    box.className = 'wh-save-result error';
    box.textContent = 'خطأ في الاتصال';
  }
  btn.disabled = false;
}
async function whTest(key, btn) {
  const input = document.querySelector('#whList input[data-key="' + key + '"]');
  const box = document.getElementById('whRes_' + key);
  btn.disabled = true;
  box.className = 'wh-test-result';
  try {
    const res = await fetch('/api/admin/webhook-test', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ key, url: input ? input.value.trim() : '' }) });
    const data = await res.json();
    if (data.success) {
      box.className = 'wh-test-result ok';
      box.textContent = '✅ وصلت رسالة تجربة للقناة — الرابط شغال';
    } else {
      box.className = 'wh-test-result err';
      box.textContent = '❌ ' + (data.error || 'فشل الإرسال');
    }
  } catch(e) {
    box.className = 'wh-test-result err';
    box.textContent = '❌ خطأ في الاتصال';
  }
  btn.disabled = false;
}
whLoad();

loadChannels();
</script>
<%- include('admin_footer') %>
