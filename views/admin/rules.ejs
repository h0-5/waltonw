<%- include('layout') %>
<div class="admin-card">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px">
    <h3 style="margin:0;border:none;padding:0"><i class="fas fa-gavel"></i> إدارة القوانين</h3>
    <button onclick="showAddRule()" class="admin-btn primary"><i class="fas fa-plus"></i> إضافة</button>
  </div>
  <table class="admin-table">
    <thead><tr><th>#</th><th>التصنيف</th><th>القانون</th><th>الترتيب</th><th>إجراءات</th></tr></thead>
    <tbody>
      <% if (rules.length > 0) { %>
        <% rules.forEach(function(r, i) { %>
        <tr>
          <td><%= i + 1 %></td>
          <td><span class="badge"><%= r.category || 'عام' %></span></td>
          <td><%= r.rule_text %></td>
          <td><%= r.sort_order || 0 %></td>
          <td style="display:flex;gap:6px">
            <button onclick="showEditRule(<%= r.id %>)" class="admin-btn small"><i class="fas fa-edit"></i></button>
            <button onclick="deleteRule(<%= r.id %>)" class="admin-btn danger small"><i class="fas fa-trash"></i></button>
          </td>
        </tr>
        <% }); %>
      <% } else { %>
        <tr><td colspan="5" style="text-align:center;padding:2rem;color:rgba(255,255,255,0.3)">لا توجد قوانين</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<div id="addRuleModal" class="admin-modal" style="display:none">
  <div class="modal-content">
    <h3>إضافة قانون جديد</h3>
    <form id="addRuleForm">
      <div class="form-group"><label>التصنيف</label><input type="text" name="category" placeholder="مثال: قوانين عامة" required></div>
      <div class="form-group"><label>نص القانون</label><textarea name="rule_text" rows="3" required></textarea></div>
      <div class="form-group"><label>الترتيب</label><input type="number" name="sort_order" value="0"></div>
      <div class="modal-actions">
        <button type="button" onclick="closeModal('addRuleModal')" class="admin-btn">إلغاء</button>
        <button type="submit" class="admin-btn primary">حفظ</button>
      </div>
    </form>
  </div>
</div>

<div id="editRuleModal" class="admin-modal" style="display:none">
  <div class="modal-content">
    <h3>تعديل القانون</h3>
    <form id="editRuleForm">
      <input type="hidden" name="id" id="edit_rule_id">
      <div class="form-group"><label>التصنيف</label><input type="text" name="category" id="edit_rule_category" required></div>
      <div class="form-group"><label>نص القانون</label><textarea name="rule_text" id="edit_rule_text" rows="3" required></textarea></div>
      <div class="form-group"><label>الترتيب</label><input type="number" name="sort_order" id="edit_rule_sort" value="0"></div>
      <div class="modal-actions">
        <button type="button" onclick="closeModal('editRuleModal')" class="admin-btn">إلغاء</button>
        <button type="submit" class="admin-btn primary">تحديث</button>
      </div>
    </form>
  </div>
</div>

<script>
var allRules = <%- JSON.stringify(rules) %>;
function showAddRule() { document.getElementById('addRuleModal').style.display = 'flex'; }
function showEditRule(id) {
  var rule = allRules.find(r => r.id === id);
  if (!rule) return;
  document.getElementById('edit_rule_id').value = rule.id;
  document.getElementById('edit_rule_category').value = rule.category || '';
  document.getElementById('edit_rule_text').value = rule.rule_text || '';
  document.getElementById('edit_rule_sort').value = rule.sort_order || 0;
  document.getElementById('editRuleModal').style.display = 'flex';
}
function closeModal(id) { document.getElementById(id).style.display = 'none'; }
document.getElementById('addRuleForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const fd = new FormData(e.target);
  const res = await fetch('/api/admin/rules', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(Object.fromEntries(fd)) });
  const data = await res.json();
  if (data.success) location.reload(); else alert(data.error || 'خطأ');
});
document.getElementById('editRuleForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const id = document.getElementById('edit_rule_id').value;
  const fd = new FormData(e.target);
  fd.delete('id');
  const res = await fetch('/api/admin/rules/' + id, { method: 'PUT', headers: {'Content-Type':'application/json'}, body: JSON.stringify(Object.fromEntries(fd)) });
  const data = await res.json();
  if (data.success) location.reload(); else alert(data.error || 'خطأ');
});
async function deleteRule(id) {
  if (!confirm('هل أنت متأكد؟')) return;
  const res = await fetch('/api/admin/rules/' + id, { method: 'DELETE' });
  const data = await res.json();
  if (data.success) location.reload();
}
</script>
<%- include('admin_footer') %>
