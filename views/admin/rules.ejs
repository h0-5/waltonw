<%- include('layout') %>
<script>document.getElementById('pageTitle').textContent = 'إدارة القوانين';</script>

<style>
.rules-topbar{display:flex;align-items:center;gap:12px;margin-bottom:20px;flex-wrap:wrap}
.rules-topbar h2{font-size:18px;font-weight:700;flex:1}
.rules-stats{display:flex;gap:16px;font-size:12px;color:var(--text-dim)}
.rules-stats span{display:flex;align-items:center;gap:4px}
.cat-section{margin-bottom:24px;background:rgba(var(--ac-rgb),.03);border:1px solid rgba(var(--ac-rgb),.1);border-radius:14px;padding:1.2rem}
.cat-header{display:flex;align-items:center;gap:10px;margin-bottom:1rem;padding-bottom:.8rem;border-bottom:1px solid rgba(var(--ac-rgb),.1)}
.cat-header h3{flex:1;font-size:1rem;font-weight:700;margin:0}
.cat-header .cat-count{font-size:.75rem;color:var(--text-dim);background:rgba(var(--ac-rgb),.1);padding:2px 10px;border-radius:12px}
.cat-actions{display:flex;gap:6px}
.cat-icon{width:32px;height:32px;border-radius:8px;background:rgba(var(--ac-rgb),.1);display:flex;align-items:center;justify-content:center;color:var(--ac);font-size:.85rem}
.rule-card{background:rgba(0,0,0,.2);border:1px solid rgba(var(--ac-rgb),.08);border-radius:10px;padding:10px 14px;margin-bottom:8px;display:flex;align-items:center;gap:10px;transition:all .2s}
.rule-card:hover{border-color:rgba(var(--ac-rgb),.2);background:rgba(var(--ac-rgb),.03)}
.rule-num{width:28px;height:28px;border-radius:50%;background:rgba(var(--ac-rgb),.1);display:flex;align-items:center;justify-content:center;font-size:.7rem;font-weight:700;color:var(--ac);flex-shrink:0}
.rule-text{flex:1;font-size:.85rem;color:rgba(255,255,255,.8)}
.rule-order{font-size:.7rem;color:var(--text-dim);min-width:30px;text-align:center}
.rule-actions{display:flex;gap:4px}
.sm-btn{padding:4px 8px;border-radius:6px;border:none;font-size:.7rem;cursor:pointer;transition:all .2s;display:flex;align-items:center;gap:4px}
.sm-btn.edit{background:rgba(var(--ac-rgb),.1);color:var(--ac)}
.sm-btn.del{background:rgba(239,68,68,.1);color:#f87171}
.sm-btn:hover{transform:scale(1.05)}
.add-rule-btn{width:100%;padding:8px;border:1px dashed rgba(var(--ac-rgb),.2);border-radius:8px;background:transparent;color:var(--ac);font-size:.8rem;font-weight:600;cursor:pointer;font-family:inherit;transition:all .2s;display:flex;align-items:center;justify-content:center;gap:6px}
.add-rule-btn:hover{background:rgba(var(--ac-rgb),.05);border-color:rgba(var(--ac-rgb),.4)}
.big-btn{padding:.6rem 1.5rem;border-radius:8px;border:none;font-weight:700;font-family:inherit;cursor:pointer;font-size:.85rem;transition:all .2s;display:flex;align-items:center;gap:6px}
.big-btn.primary{background:var(--ac);color:#fff}
.big-btn.primary:hover{opacity:.9}
.big-btn.secondary{background:rgba(255,255,255,.06);color:var(--text-dim);border:1px solid rgba(var(--ac-rgb),.15)}
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);backdrop-filter:blur(4px);z-index:9999;align-items:center;justify-content:center}
.modal-overlay.show{display:flex}
.modal-box{background:#12101a;border:1px solid rgba(var(--ac-rgb),.2);border-radius:16px;padding:1.5rem;max-width:480px;width:90%;max-height:80vh;overflow-y:auto}
.modal-box h3{margin:0 0 1rem;font-size:1rem;color:var(--ac)}
.form-group{margin-bottom:1rem}
.form-group label{display:block;font-size:.8rem;color:var(--text-dim);margin-bottom:.3rem;font-weight:600}
.form-input,.form-textarea,.form-select{width:100%;padding:.55rem .8rem;background:rgba(255,255,255,.05);border:1px solid rgba(var(--ac-rgb),.15);border-radius:8px;color:#fff;font-family:inherit;font-size:.85rem}
.form-textarea{min-height:70px;resize:vertical}
.form-input:focus,.form-textarea:focus{outline:none;border-color:var(--ac)}
.form-select option{background:#1a1525;color:#fff}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
.modal-actions{display:flex;gap:8px;justify-content:flex-end;margin-top:1rem}
.empty-msg{text-align:center;padding:2rem;color:var(--text-dim);font-size:.85rem}
</style>

<div class="admin-content">
  <div class="rules-topbar">
    <h2><i class="fas fa-gavel" style="color:var(--ac)"></i> إدارة القوانين</h2>
    <div class="rules-stats">
      <span><i class="fas fa-layer-group" style="color:var(--ac)"></i> <%= categories.length %> أقسام</span>
      <span><i class="fas fa-file-lines" style="color:var(--ac)"></i> <%= rules.length %> قوانين</span>
    </div>
    <button class="big-btn primary" onclick="openCatModal()"><i class="fas fa-folder-plus"></i> قسم جديد</button>
  </div>

  <div id="categoriesContainer">
    <% if (categories.length > 0) { %>
      <% categories.forEach(function(cat) { %>
        <% var catRules = rules.filter(function(r) { return r.category === cat.name; }); %>
        <div class="cat-section" id="cat-<%= cat.id %>">
          <div class="cat-header">
            <div class="cat-icon"><i class="fas <%= cat.icon || 'fa-gavel' %>"></i></div>
            <h3><%= cat.name %></h3>
            <span class="cat-count"><%= catRules.length %> قوانين</span>
            <div class="cat-actions">
              <button class="sm-btn edit" onclick="openCatModal(<%= cat.id %>, '<%= cat.name.replace(/'/g, "\\'") %>', '<%= cat.icon || 'fa-gavel' %>', <%= cat.sort_order || 0 %>)"><i class="fas fa-edit"></i></button>
              <button class="sm-btn del" onclick="deleteCategory(<%= cat.id %>)"><i class="fas fa-trash"></i></button>
            </div>
          </div>
          <div id="rules-<%= cat.id %>">
            <% catRules.forEach(function(rule, ri) { %>
              <div class="rule-card">
                <span class="rule-num"><%= ri + 1 %></span>
                <span class="rule-text"><%= rule.rule_text %></span>
                <span class="rule-order">#<%= rule.sort_order || 0 %></span>
                <div class="rule-actions">
                  <button class="sm-btn edit" onclick="openRuleModal(<%= rule.id %>, '<%= cat.name.replace(/'/g, "\\'") %>', `<%= rule.rule_text.replace(/`/g, '\\`') %>`, <%= rule.sort_order || 0 %>)"><i class="fas fa-edit"></i></button>
                  <button class="sm-btn del" onclick="deleteRule(<%= rule.id %>)"><i class="fas fa-trash"></i></button>
                </div>
              </div>
            <% }); %>
          </div>
          <button class="add-rule-btn" onclick="openRuleModal(null, '<%= cat.name.replace(/'/g, "\\'") %>')"><i class="fas fa-plus"></i> إضافة قانون</button>
        </div>
      <% }); %>
    <% } else { %>
      <div class="empty-msg"><i class="fas fa-folder-open" style="font-size:2rem;display:block;margin-bottom:8px;opacity:.4"></i> لا توجد أقسام. أضف قسم أولاً.</div>
    <% } %>
  </div>
</div>

<!-- Category Modal -->
<div class="modal-overlay" id="catModal">
  <div class="modal-box">
    <h3><i class="fas fa-folder"></i> <span id="catModalTitle">قسم جديد</span></h3>
    <input type="hidden" id="catId">
    <div class="form-group">
      <label>اسم القسم</label>
      <input type="text" class="form-input" id="catName" placeholder="مثال: قوانين عامة">
    </div>
    <div class="form-row">
      <div class="form-group">
        <label>الأيقونة (Font Awesome)</label>
        <input type="text" class="form-input" id="catIcon" placeholder="fa-gavel">
      </div>
      <div class="form-group">
        <label>الترتيب</label>
        <input type="number" class="form-input" id="catSort" value="0">
      </div>
    </div>
    <div class="modal-actions">
      <button class="big-btn secondary" onclick="closeModal('catModal')">إلغاء</button>
      <button class="big-btn primary" onclick="saveCategory()"><i class="fas fa-save"></i> حفظ</button>
    </div>
  </div>
</div>

<!-- Rule Modal -->
<div class="modal-overlay" id="ruleModal">
  <div class="modal-box">
    <h3><i class="fas fa-file-circle-plus"></i> <span id="ruleModalTitle">قانون جديد</span></h3>
    <input type="hidden" id="ruleId">
    <div class="form-group">
      <label>القسم</label>
      <select class="form-select" id="ruleCategory">
        <% categories.forEach(function(cat) { %>
        <option value="<%= cat.name %>"><%= cat.name %></option>
        <% }); %>
      </select>
    </div>
    <div class="form-group">
      <label>نص القانون</label>
      <textarea class="form-textarea" id="ruleText" rows="3"></textarea>
    </div>
    <div class="form-group">
      <label>الترتيب</label>
      <input type="number" class="form-input" id="ruleSort" value="0">
    </div>
    <div class="modal-actions">
      <button class="big-btn secondary" onclick="closeModal('ruleModal')">إلغاء</button>
      <button class="big-btn primary" onclick="saveRule()"><i class="fas fa-save"></i> حفظ</button>
    </div>
  </div>
</div>

<script>
var allRules = <%- JSON.stringify(rules) %>;
var allCats = <%- JSON.stringify(categories) %>;

function closeModal(id) { document.getElementById(id).classList.remove('show'); }

// Category
function openCatModal(id, name, icon, sort) {
  document.getElementById('catModalTitle').textContent = id ? 'تعديل القسم' : 'قسم جديد';
  document.getElementById('catId').value = id || '';
  document.getElementById('catName').value = name || '';
  document.getElementById('catIcon').value = icon || 'fa-gavel';
  document.getElementById('catSort').value = sort || 0;
  document.getElementById('catModal').classList.add('show');
}

async function saveCategory() {
  var id = document.getElementById('catId').value;
  var data = {
    name: document.getElementById('catName').value.trim(),
    icon: document.getElementById('catIcon').value.trim(),
    sort_order: parseInt(document.getElementById('catSort').value) || 0
  };
  if (!data.name) return alert('اسم القسم مطلوب');
  var url = id ? '/api/admin/rule-categories/' + id : '/api/admin/rule-categories';
  var method = id ? 'PUT' : 'POST';
  var res = await fetch(url, { method, headers: {'Content-Type':'application/json'}, body: JSON.stringify(data) });
  var r = await res.json();
  if (r.success) location.reload(); else alert(r.error || 'خطأ');
}

async function deleteCategory(id) {
  if (!confirm('حذف هذا القسم؟ القوانين اللي جواه هتنقل لقسم "أخرى"')) return;
  var res = await fetch('/api/admin/rule-categories/' + id, { method: 'DELETE' });
  var r = await res.json();
  if (r.success) location.reload(); else alert(r.error || 'خطأ');
}

// Rule
function openRuleModal(id, category, text, sort) {
  document.getElementById('ruleModalTitle').textContent = id ? 'تعديل القانون' : 'قانون جديد';
  document.getElementById('ruleId').value = id || '';
  document.getElementById('ruleCategory').value = category || '';
  document.getElementById('ruleText').value = text || '';
  document.getElementById('ruleSort').value = sort || 0;
  document.getElementById('ruleModal').classList.add('show');
}

async function saveRule() {
  var id = document.getElementById('ruleId').value;
  var data = {
    category: document.getElementById('ruleCategory').value,
    rule_text: document.getElementById('ruleText').value.trim(),
    sort_order: parseInt(document.getElementById('ruleSort').value) || 0
  };
  if (!data.rule_text) return alert('نص القانون مطلوب');
  var url = id ? '/api/admin/rules/' + id : '/api/admin/rules';
  var method = id ? 'PUT' : 'POST';
  var res = await fetch(url, { method, headers: {'Content-Type':'application/json'}, body: JSON.stringify(data) });
  var r = await res.json();
  if (r.success) location.reload(); else alert(r.error || 'خطأ');
}

async function deleteRule(id) {
  if (!confirm('حذف هذا القانون؟')) return;
  var res = await fetch('/api/admin/rules/' + id, { method: 'DELETE' });
  var r = await res.json();
  if (r.success) location.reload(); else alert(r.error || 'خطأ');
}

// Close modal on overlay click
document.querySelectorAll('.modal-overlay').forEach(function(m) {
  m.addEventListener('click', function(e) { if (e.target === this) this.classList.remove('show'); });
});
</script>
<%- include('admin_footer') %>
