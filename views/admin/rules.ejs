// Move category up/down
async function moveCat(id, dir) {
  var sorted = allCats.slice().sort(function(a,b){ return (a.sort_order||0)-(b.sort_order||0); });
  var idx = sorted.findIndex(function(c){ return c.id === id; });
  if (dir === 'up' && idx > 0) {
    var prev = sorted[idx-1];
    var cur = sorted[idx];
    var tmp = cur.sort_order;
    cur.sort_order = prev.sort_order;
    prev.sort_order = tmp;
    await fetch('/api/admin/rule-categories/' + cur.id, { method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ name: cur.name, icon: cur.icon||'fa-gavel', sort_order: cur.sort_order }) });
    await fetch('/api/admin/rule-categories/' + prev.id, { method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ name: prev.name, icon: prev.icon||'fa-gavel', sort_order: prev.sort_order }) });
    location.reload();
  } else if (dir === 'down' && idx < sorted.length - 1) {
    var next = sorted[idx+1];
    var cur2 = sorted[idx];
    var tmp2 = cur2.sort_order;
    cur2.sort_order = next.sort_order;
    next.sort_order = tmp2;
    await fetch('/api/admin/rule-categories/' + cur2.id, { method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ name: cur2.name, icon: cur2.icon||'fa-gavel', sort_order: cur2.sort_order }) });
    await fetch('/api/admin/rule-categories/' + next.id, { method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ name: next.name, icon: next.icon||'fa-gavel', sort_order: next.sort_order }) });
    location.reload();
  }
}

