<%- include('layout') %>
<script>document.getElementById('pageTitle').textContent = 'إدارة القوانين';</script>

<style>
.rules-topbar{display:flex;align-items:center;gap:12px;margin-bottom:20px;flex-wrap:wrap}
.rules-topbar h2{font-size:18px;font-weight:700;flex:1}
.rules-stats{display:flex;gap:16px;font-size:12px;color:var(--text-dim)}
.rules-stats span{display:flex;align-items:center;gap:4px}
.cat-section{margin-bottom:24px;background:rgba(var(--ac-rgb),.03);border:1px solid rgba(var(--ac-rgb),.1);border-radius:14px;padding:1.2rem}
.cat-header{display:flex;align-items:center;gap:10px;margin-bottom:1rem;padding-bottom:.8rem;border-bottom:1px solid rgba(var(--ac-rgb),.1)}
.cat-header h3{flex:1;font-size:1rem;font-weight:700;margin:0}
.cat-header .cat-count{font-size:.75rem;color:var(--text-dim);background:rgba(var(--ac-rgb),.1);padding:2px 10px;border-radius:12px}
.cat-actions{display:flex;gap:6px}
.cat-icon{width:32px;height:32px;border-radius:8px;background:rgba(var(--ac-rgb),.1);display:flex;align-items:center;justify-content:center;color:var(--ac);font-size:.85rem}
.rule-card{background:rgba(0,0,0,.2);border:1px solid rgba(var(--ac-rgb),.08);border-radius:10px;padding:10px 14px;margin-bottom:8px;display:flex;align-items:center;gap:10px;transition:all .2s}
.rule-card:hover{border-color:rgba(var(--ac-rgb),.2);background:rgba(var(--ac-rgb),.03)}
.rule-card.editing{background:rgba(var(--ac-rgb),.06);border-color:rgba(var(--ac-rgb),.3)}
.rule-num{width:28px;height:28px;border-radius:50%;background:rgba(var(--ac-rgb),.1);display:flex;align-items:center;justify-content:center;font-size:.7rem;font-weight:700;color:var(--ac);flex-shrink:0}
.rule-text{flex:1;font-size:.85rem;color:rgba(255,255,255,.8)}
.rule-order{font-size:.7rem;color:var(--text-dim);min-width:30px;text-align:center}
.rule-actions{display:flex;gap:4px}
.sm-btn{padding:4px 8px;border-radius:6px;border:none;font-size:.7rem;cursor:pointer;transition:all .2s;display:flex;align-items:center;gap:4px}
.sm-btn.edit{background:rgba(var(--ac-rgb),.1);color:var(--ac)}
.sm-btn.del{background:rgba(239,68,68,.1);color:#f87171}
.sm-btn.save{background:rgba(34,197,94,.1);color:#22c55e}
.sm-btn.cancel{background:rgba(255,255,255,.06);color:var(--text-dim)}
.sm-btn:hover{transform:scale(1.05)}
.add-rule-btn{width:100%;padding:8px;border:1px dashed rgba(var(--ac-rgb),.2);border-radius:8px;background:transparent;color:var(--ac);font-size:.8rem;font-weight:600;cursor:pointer;font-family:inherit;transition:all .2s;display:flex;align-items:center;justify-content:center;gap:6px}
.add-rule-btn:hover{background:rgba(var(--ac-rgb),.05);border-color:rgba(var(--ac-rgb),.4)}
.big-btn{padding:.6rem 1.5rem;border-radius:8px;border:none;font-weight:700;font-family:inherit;cursor:pointer;font-size:.85rem;transition:all .2s;display:flex;align-items:center;gap:6px}
.big-btn.primary{background:var(--ac);color:#fff}
.big-btn.primary:hover{opacity:.9}
.big-btn.secondary{background:rgba(255,255,255,.06);color:var(--text-dim);border:1px solid rgba(var(--ac-rgb),.15)}
.form-group{margin-bottom:1rem}
.form-group label{display:block;font-size:.8rem;color:var(--text-dim);margin-bottom:.3rem;font-weight:600}
.form-input,.form-textarea,.form-select{width:100%;padding:.55rem .8rem;background:rgba(255,255,255,.05);border:1px solid rgba(var(--ac-rgb),.15);border-radius:8px;color:#fff;font-family:inherit;font-size:.85rem}
.form-textarea{min-height:60px;resize:vertical}
.form-input:focus,.form-textarea:focus{outline:none;border-color:var(--ac)}
.form-select option{background:#1a1525;color:#fff}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
.inline-edit{display:flex;gap:8px;align-items:center;width:100%}
.inline-edit input,.inline-edit textarea{flex:1}
.new-rule-form{background:rgba(var(--ac-rgb),.05);border:1px solid rgba(var(--ac-rgb),.15);border-radius:10px;padding:12px;margin-top:8px;display:none}
.new-rule-form.show{display:block}
.new-cat-form{background:rgba(var(--ac-rgb),.05);border:1px solid rgba(var(--ac-rgb),.15);border-radius:12px;padding:16px;margin-bottom:20px;display:none}
.new-cat-form.show{display:block}
.empty-msg{text-align:center;padding:2rem;color:var(--text-dim);font-size:.85rem}
.stages-section{margin-top:28px;border-color:rgba(var(--ac-rgb),.18)}
.stages-hint{margin:0 0 12px;font-size:.75rem;color:var(--text-dim);display:flex;align-items:center;gap:6px}
.stage-badge{width:28px;height:28px;border-radius:8px;background:rgba(var(--ac-rgb),.12);display:flex;align-items:center;justify-content:center;color:var(--ac);font-size:.75rem;flex-shrink:0}
.stage-desc-preview{color:var(--text-dim);font-size:.78rem}
.stage-edit-grid{display:grid;grid-template-columns:1fr auto auto auto auto auto auto;gap:8px;align-items:center;flex:1}
@media(max-width:720px){.stage-edit-grid{grid-template-columns:1fr auto}}
.toast{position:fixed;top:20px;left:50%;transform:translateX(-50%);padding:10px 20px;border-radius:8px;font-weight:700;font-size:.85rem;z-index:99999;font-family:Cairo,sans-serif;animation:fadeInOut 2.5s forwards}
@keyframes fadeInOut{0%{opacity:0;transform:translateX(-50%) translateY(-10px)}10%{opacity:1;transform:translateX(-50%) translateY(0)}80%{opacity:1}100%{opacity:0}}
</style>

<div class="admin-content">
  <div class="rules-topbar">
    <h2><i class="fas fa-gavel" style="color:var(--ac)"></i> إدارة القوانين</h2>
    <div class="rules-stats">
      <span><i class="fas fa-layer-group" style="color:var(--ac)"></i> <%= categories.length %> أقسام</span>
      <span><i class="fas fa-file-lines" style="color:var(--ac)"></i> <%= rules.length %> قوانين</span>
      <span><i class="fas fa-stairs" style="color:var(--ac)"></i> <%= stages.length %> مراحل</span>
    </div>
    <button class="big-btn primary" onclick="toggleNewCatForm()"><i class="fas fa-folder-plus"></i> قسم جديد</button>
  </div>

  <div class="new-cat-form" id="newCatForm">
    <div class="form-row">
      <div class="form-group"><label>اسم القسم</label><input type="text" class="form-input" id="newCatName" placeholder="مثال: قوانين عامة"></div>
      <div class="form-group"><label>الأيقونة</label><input type="text" class="form-input" id="newCatIcon" placeholder="fa-gavel" value="fa-gavel"></div>
    </div>
    <div style="display:flex;gap:8px">
      <button class="big-btn primary" onclick="saveNewCat()"><i class="fas fa-save"></i> حفظ</button>
      <button class="big-btn secondary" onclick="toggleNewCatForm()">إلغاء</button>
    </div>
  </div>

  <div id="categoriesContainer">
    <% if (categories.length > 0) { %>
      <% categories.forEach(function(cat, ci) { %>
        <% var catRules = rules.filter(function(r) { return r.category === cat.name; }); %>
        <div class="cat-section" id="cat-<%= cat.id %>">
          <div class="cat-header">
            <div class="cat-icon"><i class="fas <%= cat.icon || 'fa-gavel' %>"></i></div>
            <h3 id="cat-name-<%= cat.id %>"><%= cat.name %></h3>
            <span class="cat-count"><%= catRules.length %> قوانين</span>
            <div class="cat-actions">
              <% if (ci > 0) { %><button class="sm-btn" onclick="moveCat(<%= cat.id %>, 'up')" title="تحريك لأعلى"><i class="fas fa-arrow-up"></i></button><% } %>
              <% if (ci < categories.length - 1) { %><button class="sm-btn" onclick="moveCat(<%= cat.id %>, 'down')" title="تحريك لأسفل"><i class="fas fa-arrow-down"></i></button><% } %>
              <button class="sm-btn edit" onclick="editCatInline(<%= cat.id %>)" title="تعديل"><i class="fas fa-pen"></i></button>
              <button class="sm-btn del" onclick="deleteCat(<%= cat.id %>)" title="حذف"><i class="fas fa-trash"></i></button>
            </div>
          </div>
          <div id="cat-edit-<%= cat.id %>" style="display:none;margin-bottom:10px">
            <div class="inline-edit">
              <input type="text" class="form-input" id="cat-edit-name-<%= cat.id %>" value="<%= cat.name %>">
              <input type="text" class="form-input" id="cat-edit-icon-<%= cat.id %>" value="<%= cat.icon || 'fa-gavel' %>" style="max-width:120px">
              <button class="sm-btn save" onclick="saveCat(<%= cat.id %>)"><i class="fas fa-check"></i></button>
              <button class="sm-btn cancel" onclick="cancelEditCat(<%= cat.id %>)"><i class="fas fa-times"></i></button>
            </div>
          </div>
          <div id="rules-<%= cat.id %>">
            <% catRules.forEach(function(rule, ri) { %>
              <div class="rule-card" id="rule-card-<%= rule.id %>">
                <span class="rule-num"><%= ri + 1 %></span>
                <span class="rule-text" id="rule-display-<%= rule.id %>"><%= rule.rule_text || rule.content || '' %></span>
                <span class="rule-order">#<%= rule.sort_order || 0 %></span>
                <div class="rule-actions" id="rule-actions-<%= rule.id %>">
                  <% if (ri > 0) { %><button class="sm-btn" onclick="moveRule(<%= rule.id %>, 'up')" title="تحريك لأعلى"><i class="fas fa-arrow-up"></i></button><% } %>
                  <% if (ri < catRules.length - 1) { %><button class="sm-btn" onclick="moveRule(<%= rule.id %>, 'down')" title="تحريك لأسفل"><i class="fas fa-arrow-down"></i></button><% } %>
                  <button class="sm-btn edit" onclick="editRuleInline(<%= rule.id %>)" title="تعديل"><i class="fas fa-pen"></i></button>
                  <button class="sm-btn del" onclick="deleteRule(<%= rule.id %>)" title="حذف"><i class="fas fa-trash"></i></button>
                </div>
              </div>
              <div class="rule-card editing" id="rule-edit-<%= rule.id %>" style="display:none">
                <span class="rule-num"><%= ri + 1 %></span>
                <div class="inline-edit" style="flex:1">
                  <textarea class="form-textarea" id="rule-edit-text-<%= rule.id %>" rows="2"><%= rule.rule_text || rule.content || '' %></textarea>
                  <input type="number" class="form-input" id="rule-edit-sort-<%= rule.id %>" value="<%= rule.sort_order || 0 %>" style="max-width:60px">
                  <button class="sm-btn save" onclick="saveRule(<%= rule.id %>)"><i class="fas fa-check"></i></button>
                  <button class="sm-btn cancel" onclick="cancelEditRule(<%= rule.id %>)"><i class="fas fa-times"></i></button>
                </div>
              </div>
            <% }); %>
          </div>
          <button class="add-rule-btn" onclick="showNewRuleForm(<%= cat.id %>)"><i class="fas fa-plus"></i> إضافة قانون</button>
          <div class="new-rule-form" id="new-rule-form-<%= cat.id %>">
            <textarea class="form-textarea" id="new-rule-text-<%= cat.id %>" rows="2" placeholder="نص القانون"></textarea>
            <div style="display:flex;gap:8px;margin-top:8px">
              <button class="big-btn primary" onclick="saveNewRule(<%= cat.id %>, '<%= cat.name.replace(/'/g, "\\'") %>')"><i class="fas fa-save"></i> حفظ</button>
              <button class="big-btn secondary" onclick="hideNewRuleForm(<%= cat.id %>)">إلغاء</button>
            </div>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <div class="empty-msg"><i class="fas fa-folder-open" style="font-size:2rem;display:block;margin-bottom:8px;opacity:.4"></i> لا توجد أقسام. أضف قسم أولاً.</div>
    <% } %>

    <%
      /* قوانين بلا قسم: تصنيفها ما يطابق أي قسم موجود (بقايا النظام القديم اللي كان ينقل قوانين
         القسم المحذوف إلى «أخرى») — تُعرض هنا حتى تديرها/تحذفها، وصفحة القوانين تعرضها بقسم «أخرى» لحين تنحذف */
      var wrOrphans = rules.filter(function(r) {
        var c = (r.category || '').toString();
        return !c || !categories.some(function(cc) { return cc.name === c; });
      });
    %>
    <% if (wrOrphans.length) { %>
    <div class="cat-section" id="orphanRulesSection" style="border-color:rgba(248,113,113,.3)">
      <div class="cat-header">
        <div class="cat-icon" style="color:#f87171;background:rgba(248,113,113,.12)"><i class="fas fa-box-archive"></i></div>
        <h3>قوانين بلا قسم</h3>
        <span class="cat-count"><%= wrOrphans.length %> قوانين</span>
      </div>
      <p class="stages-hint"><i class="fas fa-triangle-exclamation" style="color:#f87171"></i> قوانين قسمها انحذف قديماً (كانت تُنقل تلقائياً لقسم «أخرى») — احذفها من هنا وبتختفي من صفحة القوانين، ومن الآن حذف القسم يحذف قوانينه معه</p>
      <div>
        <% wrOrphans.forEach(function(rule, ri) { %>
          <div class="rule-card" id="rule-card-<%= rule.id %>">
            <span class="rule-num"><%= ri + 1 %></span>
            <span class="rule-text" id="rule-display-<%= rule.id %>"><%= rule.rule_text || rule.content || '' %></span>
            <span class="rule-order">#<%= rule.sort_order || 0 %></span>
            <div class="rule-actions" id="rule-actions-<%= rule.id %>">
              <% if (ri > 0) { %><button class="sm-btn" onclick="moveRule(<%= rule.id %>, 'up')" title="تحريك لأعلى"><i class="fas fa-arrow-up"></i></button><% } %>
              <% if (ri < wrOrphans.length - 1) { %><button class="sm-btn" onclick="moveRule(<%= rule.id %>, 'down')" title="تحريك لأسفل"><i class="fas fa-arrow-down"></i></button><% } %>
              <button class="sm-btn edit" onclick="editRuleInline(<%= rule.id %>)" title="تعديل"><i class="fas fa-pen"></i></button>
              <button class="sm-btn del" onclick="deleteRule(<%= rule.id %>)" title="حذف"><i class="fas fa-trash"></i></button>
            </div>
          </div>
          <div class="rule-card editing" id="rule-edit-<%= rule.id %>" style="display:none">
            <span class="rule-num"><%= ri + 1 %></span>
            <div class="inline-edit" style="flex:1">
              <textarea class="form-textarea" id="rule-edit-text-<%= rule.id %>" rows="2"><%= rule.rule_text || rule.content || '' %></textarea>
              <input type="number" class="form-input" id="rule-edit-sort-<%= rule.id %>" value="<%= rule.sort_order || 0 %>" style="max-width:60px">
              <button class="sm-btn save" onclick="saveRule(<%= rule.id %>)"><i class="fas fa-check"></i></button>
              <button class="sm-btn cancel" onclick="cancelEditRule(<%= rule.id %>)"><i class="fas fa-times"></i></button>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
    <% } %>
  </div>

  <!-- ═══ مراحل العقوبات — نظام مستقل تماماً عن القوانين والأقسام (فصل بطلب المستخدم) ═══ -->
  <div class="cat-section stages-section" id="stagesSection">
    <div class="cat-header">
      <div class="cat-icon"><i class="fas fa-stairs"></i></div>
      <h3>العقوبات</h3>
      <span class="cat-count"><%= stages.length %> مراحل</span>
      <div class="cat-actions">
        <button class="big-btn primary" onclick="toggleNewStageForm()"><i class="fas fa-plus"></i> مرحلة جديدة</button>
      </div>
    </div>
    <p class="stages-hint"><i class="fas fa-circle-info"></i> نظام مستقل عن القوانين والأقسام — ترتيب المراحل هنا هو ترتيب عرضها بصفحة القوانين (جنب بعض) — حرية كاملة: خصص لون كل مرحلة وأيقونتها كما تريد، ولو تركت اللون تلقائي يتحدد من العنوان (تحذير/ميوت/طرد/حظر/دائم) — والتسمية تلقائية حسب الترتيب: الأولى تنبيه رسمي ثم مخالفة أولى/ثانية/الخ</p>

    <datalist id="wrFaIcons">
      <option value="fa-flag"></option>
      <option value="fa-triangle-exclamation"></option>
      <option value="fa-volume-xmark"></option>
      <option value="fa-person-walking-arrow-right"></option>
      <option value="fa-gavel"></option>
      <option value="fa-ban"></option>
      <option value="fa-skull"></option>
      <option value="fa-clock"></option>
      <option value="fa-comment-slash"></option>
      <option value="fa-user-slash"></option>
      <option value="fa-shield-halved"></option>
      <option value="fa-fire"></option>
      <option value="fa-star"></option>
      <option value="fa-crown"></option>
    </datalist>

    <div class="new-cat-form" id="newStageForm">
      <div class="form-row">
        <div class="form-group"><label>عنوان المرحلة</label><input type="text" class="form-input" id="newStageTitle" placeholder="مثال: تحذير"></div>
        <div class="form-group"><label>الأيقونة (حرية كاملة)</label><div style="display:flex;align-items:center;gap:8px"><input type="text" class="form-input" id="newStageIcon" list="wrFaIcons" placeholder="fa-flag" value="fa-flag" style="flex:1" oninput="document.getElementById('newStageIconPrev').className='fas '+(this.value.trim()||'fa-flag')"><span class="stage-badge" style="width:34px;height:34px;font-size:.85rem"><i id="newStageIconPrev" class="fas fa-flag"></i></span></div></div>
        <div class="form-group"><label>اللون</label><div style="display:flex;align-items:center;gap:8px"><input type="color" id="newStageColor" value="#bc13fe" style="width:46px;height:38px;padding:2px;border:1px solid rgba(255,255,255,.12);border-radius:8px;background:transparent;cursor:pointer" disabled><label style="display:flex;align-items:center;gap:5px;font-size:.72rem;color:var(--text-dim);white-space:nowrap;cursor:pointer"><input type="checkbox" id="newStageAuto" checked onchange="document.getElementById('newStageColor').disabled=this.checked"> تلقائي</label></div></div>
      </div>
      <div class="form-group"><label>وصف المرحلة</label><textarea class="form-textarea" id="newStageDesc" rows="2" placeholder="مثال: تنبيه رسمي يُسجّل في الأرشيف"></textarea></div>
      <div style="display:flex;gap:8px">
        <button class="big-btn primary" onclick="saveNewStage()"><i class="fas fa-save"></i> حفظ</button>
        <button class="big-btn secondary" onclick="toggleNewStageForm()">إلغاء</button>
      </div>
    </div>

    <div id="stagesContainer">
      <% if (stages.length > 0) { %>
        <% stages.forEach(function(st, si) { %>
          <div class="rule-card" id="stage-card-<%= st.id %>">
            <span class="stage-badge"><i class="fas <%= st.icon || 'fa-flag' %>"></i></span>
            <span class="rule-text"><strong><%= st.title %></strong><% if (st.description) { %> <span class="stage-desc-preview">— <%= st.description %></span><% } %></span>
            <span class="rule-order">#<%= st.sort_order || 0 %></span>
            <div class="rule-actions" id="stage-actions-<%= st.id %>">
              <% if (si > 0) { %><button class="sm-btn" onclick="moveStage(<%= st.id %>, 'up')" title="تحريك لأعلى"><i class="fas fa-arrow-up"></i></button><% } %>
              <% if (si < stages.length - 1) { %><button class="sm-btn" onclick="moveStage(<%= st.id %>, 'down')" title="تحريك لأسفل"><i class="fas fa-arrow-down"></i></button><% } %>
              <button class="sm-btn edit" onclick="editStageInline(<%= st.id %>)" title="تعديل"><i class="fas fa-pen"></i></button>
              <button class="sm-btn del" onclick="deleteStage(<%= st.id %>)" title="حذف"><i class="fas fa-trash"></i></button>
            </div>
          </div>
          <div class="rule-card editing" id="stage-edit-<%= st.id %>" style="display:none">
            <span class="stage-badge"><i id="stage-edit-ico-<%= st.id %>" class="fas <%= st.icon || 'fa-flag' %>"></i></span>
            <div class="stage-edit-grid">
              <input type="text" class="form-input" id="stage-edit-title-<%= st.id %>" value="<%= st.title %>" placeholder="العنوان">
              <input type="text" class="form-input" id="stage-edit-icon-<%= st.id %>" value="<%= st.icon || 'fa-flag' %>" list="wrFaIcons" placeholder="fa-flag" style="max-width:110px" oninput="document.getElementById('stage-edit-ico-<%= st.id %>').className='fas '+(this.value.trim()||'fa-flag')">
              <input type="color" id="stage-edit-color-<%= st.id %>" value="<%= st.color || '#bc13fe' %>" style="width:42px;height:36px;padding:2px;border:1px solid rgba(255,255,255,.12);border-radius:8px;background:transparent;cursor:pointer" <%= st.color ? '' : 'disabled' %>>
              <label style="display:flex;align-items:center;gap:4px;font-size:.68rem;color:var(--text-dim);white-space:nowrap;cursor:pointer"><input type="checkbox" id="stage-edit-auto-<%= st.id %>" <%= st.color ? '' : 'checked' %> onchange="document.getElementById('stage-edit-color-<%= st.id %>').disabled=this.checked"> تلقائي</label>
              <input type="number" class="form-input" id="stage-edit-sort-<%= st.id %>" value="<%= st.sort_order || 0 %>" style="max-width:64px">
              <button class="sm-btn save" onclick="saveStage(<%= st.id %>)"><i class="fas fa-check"></i></button>
              <button class="sm-btn cancel" onclick="cancelEditStage(<%= st.id %>)"><i class="fas fa-times"></i></button>
              <textarea class="form-textarea" id="stage-edit-desc-<%= st.id %>" rows="2" placeholder="وصف المرحلة" style="grid-column:1/-1"><%= st.description || '' %></textarea>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="empty-msg"><i class="fas fa-stairs" style="font-size:2rem;display:block;margin-bottom:8px;opacity:.4"></i> لا توجد مراحل — صفحة القوانين ستعرض المراحل الافتراضية الخمس تلقائياً</div>
      <% } %>
    </div>
  </div>
</div>

<script>
function showToast(msg, color) {
  var d = document.createElement('div');
  d.className = 'toast';
  d.style.cssText = 'background:' + (color || '#22c55e') + ';color:#fff';
  d.textContent = msg;
  document.body.appendChild(d);
  setTimeout(function(){ d.remove(); }, 2500);
}

// New category form
function toggleNewCatForm() {
  var f = document.getElementById('newCatForm');
  f.classList.toggle('show');
