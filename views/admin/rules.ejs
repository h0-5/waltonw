function toggleNewStageForm() {
  var f = document.getElementById('newStageForm');
  f.classList.toggle('show');
  if (f.classList.contains('show')) document.getElementById('newStageTitle').focus();
}

async function saveNewStage() {
  var title = document.getElementById('newStageTitle').value.trim();
  var icon = document.getElementById('newStageIcon').value.trim();
  var description = document.getElementById('newStageDesc').value.trim();
  var color = document.getElementById('newStageAuto').checked ? '' : document.getElementById('newStageColor').value;
  if (!title) return alert('عنوان المرحلة مطلوب');
  var res = await fetch('/api/admin/rule-stages', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ title: title, icon: icon||'fa-flag', description: description, color: color, sort_order: 0 }) });
  var r = await res.json();
  if (r.success) location.reload(); else alert(r.error || 'خطأ');
}

async function moveStage(id, dir) {
  var st = allStages.find(function(s){ return s.id === id; });
  if (!st) return;
  var sorted = allStages.slice().sort(function(a,b){ return (a.sort_order||0)-(b.sort_order||0) || a.id-b.id; });
  var idx = sorted.findIndex(function(s){ return s.id === id; });
  var other = null;
  if (dir === 'up' && idx > 0) other = sorted[idx-1];
  if (dir === 'down' && idx < sorted.length - 1) other = sorted[idx+1];
  if (!other) return;
  var tmp = st.sort_order;
  st.sort_order = other.sort_order;
  other.sort_order = tmp;
  var body = function(s){ return JSON.stringify({ title: s.title, description: s.description||'', icon: s.icon||'fa-flag', color: s.color||'', sort_order: s.sort_order }); };
  await fetch('/api/admin/rule-stages/' + st.id, { method:'PUT', headers:{'Content-Type':'application/json'}, body: body(st) });
  await fetch('/api/admin/rule-stages/' + other.id, { method:'PUT', headers:{'Content-Type':'application/json'}, body: body(other) });
  location.reload();
}

