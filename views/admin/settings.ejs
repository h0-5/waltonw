<%- include('layout') %>
<script>document.getElementById('pageTitle').textContent = 'الإعدادات';</script>

<div class="admin-content">
  <div class="content-header">
    <h2><i class="fas fa-cog"></i> إعدادات الموقع</h2>
  </div>

  <!-- Pages Section -->
  <div class="settings-card" style="margin-bottom:1.5rem">
    <h3 style="color:var(--ac);margin-bottom:1rem"><i class="fas fa-th-large"></i> الصفحات</h3>
    <div style="display:flex;flex-wrap:wrap;gap:0.75rem">
      <a href="/admin/roles" style="display:inline-flex;align-items:center;gap:8px;padding:12px 20px;background:rgba(var(--ac-rgb),0.1);border:1px solid rgba(var(--ac-rgb),0.2);border-radius:12px;color:#fff;text-decoration:none;font-weight:700;font-size:0.9rem;transition:all 0.3s">
        <i class="fas fa-shield-halved" style="color:var(--ac)"></i> إدارة الصلاحيات
      </a>
      <a href="/admin/users" style="display:inline-flex;align-items:center;gap:8px;padding:12px 20px;background:rgba(var(--ac-rgb),0.1);border:1px solid rgba(var(--ac-rgb),0.2);border-radius:12px;color:#fff;text-decoration:none;font-weight:700;font-size:0.9rem;transition:all 0.3s">
        <i class="fas fa-users" style="color:var(--ac)"></i> إدارة المستخدمين
      </a>
      <a href="/admin/products" style="display:inline-flex;align-items:center;gap:8px;padding:12px 20px;background:rgba(var(--ac-rgb),0.1);border:1px solid rgba(var(--ac-rgb),0.2);border-radius:12px;color:#fff;text-decoration:none;font-weight:700;font-size:0.9rem;transition:all 0.3s">
        <i class="fas fa-box-open" style="color:var(--ac)"></i> إدارة المنتجات
      </a>
      <a href="/admin/orders" style="display:inline-flex;align-items:center;gap:8px;padding:12px 20px;background:rgba(var(--ac-rgb),0.1);border:1px solid rgba(var(--ac-rgb),0.2);border-radius:12px;color:#fff;text-decoration:none;font-weight:700;font-size:0.9rem;transition:all 0.3s">
        <i class="fas fa-truck" style="color:var(--ac)"></i> إدارة الطلبات
      </a>
      <a href="/admin/news" style="display:inline-flex;align-items:center;gap:8px;padding:12px 20px;background:rgba(var(--ac-rgb),0.1);border:1px solid rgba(var(--ac-rgb),0.2);border-radius:12px;color:#fff;text-decoration:none;font-weight:700;font-size:0.9rem;transition:all 0.3s">
        <i class="fas fa-newspaper" style="color:var(--ac)"></i> إدارة الأخبار
      </a>
      <a href="/admin/tickets" style="display:inline-flex;align-items:center;gap:8px;padding:12px 20px;background:rgba(var(--ac-rgb),0.1);border:1px solid rgba(var(--ac-rgb),0.2);border-radius:12px;color:#fff;text-decoration:none;font-weight:700;font-size:0.9rem;transition:all 0.3s">
        <i class="fas fa-ticket" style="color:var(--ac)"></i> إدارة التذاكر
      </a>
      <a href="/admin/applications" style="display:inline-flex;align-items:center;gap:8px;padding:12px 20px;background:rgba(var(--ac-rgb),0.1);border:1px solid rgba(var(--ac-rgb),0.2);border-radius:12px;color:#fff;text-decoration:none;font-weight:700;font-size:0.9rem;transition:all 0.3s">
        <i class="fas fa-file-alt" style="color:var(--ac)"></i> الطلبات المقدمة
      </a>
      <a href="/admin/manage-apps" style="display:inline-flex;align-items:center;gap:8px;padding:12px 20px;background:rgba(var(--ac-rgb),0.1);border:1px solid rgba(var(--ac-rgb),0.2);border-radius:12px;color:#fff;text-decoration:none;font-weight:700;font-size:0.9rem;transition:all 0.3s">
        <i class="fas fa-list-check" style="color:var(--ac)"></i> إدارة نظام التقديمات
      </a>
      <a href="/admin/rules" style="display:inline-flex;align-items:center;gap:8px;padding:12px 20px;background:rgba(var(--ac-rgb),0.1);border:1px solid rgba(var(--ac-rgb),0.2);border-radius:12px;color:#fff;text-decoration:none;font-weight:700;font-size:0.9rem;transition:all 0.3s">
        <i class="fas fa-gavel" style="color:var(--ac)"></i> إدارة القوانين
      </a>
      <a href="/admin/discounts" style="display:inline-flex;align-items:center;gap:8px;padding:12px 20px;background:rgba(var(--ac-rgb),0.1);border:1px solid rgba(var(--ac-rgb),0.2);border-radius:12px;color:#fff;text-decoration:none;font-weight:700;font-size:0.9rem;transition:all 0.3s">
        <i class="fas fa-tag" style="color:var(--ac)"></i> أكواد الخصم
      </a>
      <a href="/admin/about" style="display:inline-flex;align-items:center;gap:8px;padding:12px 20px;background:rgba(var(--ac-rgb),0.1);border:1px solid rgba(var(--ac-rgb),0.2);border-radius:12px;color:#fff;text-decoration:none;font-weight:700;font-size:0.9rem;transition:all 0.3s">
        <i class="fas fa-info-circle" style="color:var(--ac)"></i> صفحة من نحن
      </a>
      <a href="/admin/properties" style="display:inline-flex;align-items:center;gap:8px;padding:12px 20px;background:rgba(var(--ac-rgb),0.1);border:1px solid rgba(var(--ac-rgb),0.2);border-radius:12px;color:#fff;text-decoration:none;font-weight:700;font-size:0.9rem;transition:all 0.3s">
        <i class="fas fa-building" style="color:var(--ac)"></i> إدارة الممتلكات
      </a>
      <a href="/admin/broadcast" style="display:inline-flex;align-items:center;gap:8px;padding:12px 20px;background:rgba(var(--ac-rgb),0.1);border:1px solid rgba(var(--ac-rgb),0.2);border-radius:12px;color:#fff;text-decoration:none;font-weight:700;font-size:0.9rem;transition:all 0.3s">
        <i class="fas fa-bullhorn" style="color:var(--ac)"></i> البث
      </a>
      <a href="/admin/banned" style="display:inline-flex;align-items:center;gap:8px;padding:12px 20px;background:rgba(var(--ac-rgb),0.1);border:1px solid rgba(var(--ac-rgb),0.2);border-radius:12px;color:#fff;text-decoration:none;font-weight:700;font-size:0.9rem;transition:all 0.3s">
        <i class="fas fa-ban" style="color:var(--ac)"></i> المحظورين
      </a>
      <a href="/admin/logs" style="display:inline-flex;align-items:center;gap:8px;padding:12px 20px;background:rgba(var(--ac-rgb),0.1);border:1px solid rgba(var(--ac-rgb),0.2);border-radius:12px;color:#fff;text-decoration:none;font-weight:700;font-size:0.9rem;transition:all 0.3s">
        <i class="fas fa-history" style="color:var(--ac)"></i> السجلات
      </a>
    </div>
  </div>

  <form id="settingsForm" class="settings-form">
    <div class="settings-grid">
      <div class="settings-card">
        <h3><i class="fas fa-globe"></i> الإعدادات العامة</h3>
        <div class="form-group">
          <label>اسم الموقع</label>
          <input type="text" name="site_name" value="<%= settings.site_name || 'Walton Family' %>">
        </div>
        <div class="form-group">
          <label>رابط الموقع</label>
          <input type="url" name="site_url" value="<%= settings.site_url || '' %>">
        </div>
        <div class="form-group">
          <label>لون التمييز</label>
          <input type="color" name="accent_color" value="<%= settings.accent_color || '#f97316' %>">
        </div>
      </div>
      <div class="settings-card">
        <h3><i class="fas fa-shield-alt"></i> الأمان</h3>
        <div class="form-group">
          <label class="toggle-label">
            <input type="checkbox" name="maintenance_mode" <%= settings.maintenance_mode ? 'checked' : '' %>>
            <span class="toggle-slider"></span>
            وضع الصيانة
          </label>
        </div>
        <div class="form-group">
          <label class="toggle-label">
            <input type="checkbox" name="games_locked" <%= settings.games_locked ? 'checked' : '' %>>
            <span class="toggle-slider"></span>
            قفل الألعاب
          </label>
        </div>
      </div>
    </div>
    <button type="submit" class="submit-btn"><i class="fas fa-save"></i> حفظ الإعدادات</button>
  </form>
</div>

<script>
document.getElementById('settingsForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  const formData = new FormData(this);
  const data = Object.fromEntries(formData);
  data.maintenance_mode = formData.has('maintenance_mode') ? '1' : '0';
  data.games_locked = formData.has('games_locked') ? '1' : '0';
  const res = await fetch('/api/admin/settings', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(data)
  });
  const result = await res.json();
  if (result.success) WaltonAPI.showNotification('تم حفظ الإعدادات', 'success');
});
</script>

<%- include('admin_footer') %>
