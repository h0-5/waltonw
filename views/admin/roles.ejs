<%- include('layout') %>
<link rel="stylesheet" href="/css/admin-roles.css">

<div class="admin-content">
  <div class="roles-layout">
    <!-- Sidebar: Role List -->
    <div class="roles-sidebar" id="rolesSidebar">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem">
        <h3 style="font-size:1rem;font-weight:800;color:var(--ac)"><i class="fas fa-layer-group"></i> الرتب</h3>
        <button class="admin-btn small primary" onclick="openAddRole()"><i class="fas fa-plus"></i></button>
      </div>
      <input type="text" id="roleSearch" placeholder="بحث عن رتبة..." oninput="debounce(filterRoles,150)()" style="width:100%;padding:8px 12px;background:rgba(255,255,255,0.05);border:1px solid rgba(var(--ac-rgb),0.2);border-radius:8px;color:#fff;font-family:inherit;font-size:0.8rem;margin-bottom:0.75rem">
      <div id="roleList">
        <% if (typeof roles !== 'undefined' && roles && roles.length) { %>
          <% roles.forEach(function(r, i) { %>
            <div class="role-list-item <%= i === 0 ? 'selected' : '' %> <%= r.name === 'owner' ? 'owner-role' : '' %>" onclick="selectRole(<%= r.id %>)" data-id="<%= r.id %>" data-name="<%= (r.display_name || r.name).toLowerCase() %>" draggable="<%= r.name === 'owner' ? 'false' : 'true' %>" data-sort="<%= r.sort_order || 0 %>">
              <div style="display:flex;align-items:center;gap:10px;flex:1">
                <% if (r.name !== 'owner') { %><div class="drag-handle" title="اسحب للترتيب"><i class="fas fa-grip-vertical"></i></div><% } %>
                <div style="width:12px;height:12px;border-radius:50%;background:<%= r.color %>;flex-shrink:0;box-shadow:0 0 6px <%= r.color %>40"></div>
                <div style="flex:1;min-width:0">
                  <div style="font-weight:700;font-size:0.85rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                    <% if (r.emoji) { %><span><%= r.emoji %></span><% } %><%= r.display_name || r.name %>
                    <% if (r.name === 'owner') { %><i class="fas fa-crown" style="color:#f59e0b;margin-right:4px;font-size:0.7rem"></i><% } %>
                  </div>
                  <div style="font-size:0.7rem;color:rgba(255,255,255,0.35);display:flex;align-items:center;gap:6px">
                    <span><%= r.name %></span>
                    <% if (r.is_admin_role) { %><span class="badge-admin-sm">admin</span><% } %>
                    <% if (r.is_staff) { %><span class="badge-staff-sm">staff</span><% } %>
                    <% if (roleMemberCounts[r.name]) { %><span style="font-size:0.65rem;color:rgba(255,255,255,0.25)"><i class="fas fa-users" style="font-size:0.6rem"></i> <%= roleMemberCounts[r.name] %></span><% } %>
                  </div>
                </div>
              </div>
              <% if (r.name !== 'owner' && !r.is_default && !r.is_protected) { %>
                <button class="role-delete-btn" onclick="event.stopPropagation();deleteRole(<%= r.id %>)" title="حذف"><i class="fas fa-trash"></i></button>
              <% } %>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>

    <!-- Main: Editor -->
    <div style="flex:1;overflow-y:auto;max-height:85vh" id="editorPanel">
      <% if (typeof roles !== 'undefined' && roles && roles.length) { %>
        <% var r = roles[0]; %>
        <div id="roleEditor" data-role-id="<%= r.id %>">
          <!-- Header -->
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem;padding-bottom:1rem;border-bottom:1px solid rgba(var(--ac-rgb),0.1)">
            <div style="display:flex;align-items:center;gap:14px">
              <div id="rolePreviewBadge" class="role-preview-badge" style="background:<%= r.color %>20;border:1px solid <%= r.color %>40;color:<%= r.color %>;box-shadow:0 0 12px <%= r.color %>30">
                <% if (r.emoji) { %><span><%= r.emoji %></span><% } %><i class="fas <%= r.icon || 'fa-user' %>"></i> <%= r.display_name || r.name %>
              </div>
              <span style="font-size:0.8rem;color:rgba(255,255,255,0.4)"><%= r.name %>
                <% if (r.name === 'owner') { %> <i class="fas fa-crown" style="color:#f59e0b"></i> رتبة المالك — محمية بالكامل <% } %>
              </span>
            </div>
            <div id="roleActionsBtns" style="display:<%= r.name !== 'owner' ? 'flex' : 'none' %>;gap:8px">
              <button class="admin-btn" onclick="resetPermissions()" title="إعادة تعيين الصلاحيات"><i class="fas fa-undo"></i> إعادة تعيين</button>
              <button class="admin-btn" onclick="copyPermissionsFrom()" title="نسخ صلاحيات من رتبة أخرى"><i class="fas fa-copy"></i> نسخ</button>
              <button class="admin-btn primary" onclick="saveAll()"><i class="fas fa-save"></i> حفظ الكل</button>
            </div>
            <span id="roleActionsLocked" style="display:<%= r.name === 'owner' ? 'inline-flex' : 'none' %>;padding:6px 14px;background:rgba(245,158,11,0.15);border:1px solid rgba(245,158,11,0.3);border-radius:8px;color:#f59e0b;font-size:0.8rem;font-weight:700;align-items:center;gap:6px"><i class="fas fa-lock"></i> محمية — لا يمكن التعديل</span>
          </div>

          <!-- Tabs -->
          <div class="role-tabs">
            <button class="role-tab active" onclick="switchTab('roles')"><i class="fas fa-shield-halved"></i> الرتب</button>
            <button class="role-tab" onclick="switchTab('pages-access')"><i class="fas fa-eye"></i> الصفحات</button>
            <button class="role-tab" onclick="switchTab('admin-perms')"><i class="fas fa-lock"></i> صلاحيات الإدارة</button>
            <button class="role-tab" onclick="switchTab('site-perms')"><i class="fas fa-globe"></i> صلاحيات الموقع</button>
            <button class="role-tab" onclick="switchTab('side-roles')"><i class="fas fa-tags"></i> الأدوار الجانبية</button>
          </div>

          <!-- Tab: Role Settings -->
          <div class="tab-content active" id="tab-roles">
            <div id="ownerInfoBox" style="display:<%= r.name === 'owner' ? 'block' : 'none' %>;background:rgba(245,158,11,0.08);border:1px solid rgba(245,158,11,0.2);border-radius:12px;padding:1.5rem;margin-bottom:1.2rem">
              <div style="display:flex;align-items:center;gap:10px;margin-bottom:0.75rem">
                <i class="fas fa-crown" style="color:#f59e0b;font-size:1.2rem"></i>
                <h3 style="color:#f59e0b;margin:0">رتبة المالك</h3>
              </div>
              <p style="color:rgba(255,255,255,0.6);font-size:0.9rem;line-height:1.6">
                هذه الرتبة <strong>محمية بالكامل</strong> ولا يمكن تعديلها. المالك يملك <strong>كل الصلاحيات</strong> تلقائياً ولا يحتاج لأي إعداد.
              </p>
            </div>

            <div class="settings-section">
              <h3><i class="fas fa-info-circle"></i> معلومات الرتبة</h3>
              <div class="form-grid">
                <div class="form-group"><label>الاسم (إنجليزي)</label><input type="text" id="r_name" value="<%= r.name %>" oninput="updatePreview();markDirty()" <%= r.name === 'owner' ? 'disabled' : '' %>></div>
                <div class="form-group"><label>اسم العرض (عربي)</label><input type="text" id="r_display_name" value="<%= r.display_name || '' %>" oninput="updatePreview();markDirty()" <%= r.name === 'owner' ? 'disabled' : '' %>></div>
                <div class="form-group"><label>اللون</label><input type="color" id="r_color" value="<%= r.color || '#ffffff' %>" oninput="updatePreview();markDirty()" <%= r.name === 'owner' ? 'disabled' : '' %>></div>
                <div class="form-group"><label>الأيقونة</label><div style="display:flex;gap:6px;align-items:center"><i id="iconPreview" class="fas <%= r.icon || 'fa-user' %>" style="font-size:1.2rem;color:var(--ac)"></i><input type="text" id="r_icon" value="<%= r.icon || '' %>" placeholder="fa-shield-halved" oninput="updateIconPreview();markDirty()" style="flex:1" <%= r.name === 'owner' ? 'disabled' : '' %>></div></div>
                <div class="form-group"><label>الإيموجي</label><div style="display:flex;gap:6px;align-items:center"><span id="emojiPreview" style="font-size:1.3rem"><%= r.emoji || '' %></span><input type="text" id="r_emoji" value="<%= r.emoji || '' %>" placeholder="🎯" maxlength="10" oninput="updatePreview();markDirty()" style="flex:1" <%= r.name === 'owner' ? 'disabled' : '' %>><% if (r.name !== 'owner') { %><button class="admin-btn small" onclick="openEmojiPicker()" title="اختر إيموجي"><i class="fas fa-smile"></i></button><% } %></div></div>
                <div class="form-group" style="grid-column:1/-1"><label>الوصف</label><input type="text" id="r_description" value="<%= r.description || '' %>" placeholder="وصف الرتبة..." oninput="markDirty()" <%= r.name === 'owner' ? 'disabled' : '' %>></div>
              </div>
            </div>

            <div class="settings-section">
              <h3><i class="fas fa-shield-halved"></i> خيارات الرتبة</h3>
              <div class="toggle-grid">
                <label class="toggle-item"><input type="checkbox" id="r_is_admin" onchange="markDirty()" <%= r.is_admin_role ? 'checked' : '' %> <%= r.name === 'owner' ? 'disabled' : '' %>><span class="toggle-switch"></span><span>رتبة إدارية (صلاحيات الإدارة)</span></label>
                <label class="toggle-item"><input type="checkbox" id="r_is_protected" onchange="markDirty()" <%= r.is_protected ? 'checked' : '' %> <%= r.name === 'owner' ? 'disabled' : '' %>><span class="toggle-switch"></span><span>محمية (لا يمكن حذفها)</span></label>
                <label class="toggle-item"><input type="checkbox" id="r_is_default" onchange="markDirty()" <%= r.is_default ? 'checked' : '' %> <%= r.name === 'owner' ? 'disabled' : '' %>><span class="toggle-switch"></span><span>الرتبة الافتراضية</span></label>
                <label class="toggle-item"><input type="checkbox" id="r_is_staff" onchange="markDirty()" <%= r.is_staff ? 'checked' : '' %> <%= r.name === 'owner' ? 'disabled' : '' %>><span class="toggle-switch"></span><span>فريق عمل (staff)</span></label>
                <label class="toggle-item"><input type="checkbox" id="h_can_assign" onchange="markDirty()" <%= r.can_assign_roles ? 'checked' : '' %> <%= r.name === 'owner' ? 'disabled' : '' %>><span class="toggle-switch"></span><span>يمكنه تعيين رتب</span></label>
              </div>
            </div>

            <!-- Hierarchy preview -->
            <div class="settings-section">
              <h3><i class="fas fa-sitemap"></i> ترتيب الرتب</h3>
              <div class="hierarchy-tree">
                <% if (typeof roles !== 'undefined' && roles) { %>
                  <% roles.forEach(function(role, idx) { %>
                    <div class="tree-node" style="padding-left:<%= idx * 20 %>px">
                      <div class="tree-dot" style="background:<%= role.color %>"></div>
                      <span class="tree-name"><% if (role.emoji) { %><%= role.emoji %> <% } %><%= role.display_name || role.name %>
                        <% if (role.name === 'owner') { %><i class="fas fa-crown" style="color:#f59e0b;font-size:0.7rem;margin-right:4px"></i><% } %>
                      </span>
                      <% if (role.id === r.id) { %><span class="badge-current">حالي</span><% } %>
                      <% if (role.name === 'owner') { %><span class="badge-owner-sm">محمية</span><% } %>
                    </div>
                  <% }); %>
                <% } %>
              </div>
            </div>

            <!-- Members (view only — role assignment is done from /admin/users) -->
            <div class="settings-section">
              <h3><i class="fas fa-users"></i> الأعضاء بهذه الرتبة</h3>
              <div id="roleMembersList"><div class="skeleton" style="height:40px;margin-bottom:8px"></div><div class="skeleton" style="height:40px;margin-bottom:8px"></div></div>
              <p style="margin-top:0.75rem;font-size:0.8rem;color:rgba(255,255,255,0.3)"><i class="fas fa-info-circle"></i> لتعيين رتبة لمستخدم، اذهب إلى <a href="/admin/users" style="color:var(--ac);text-decoration:underline">إدارة المستخدمين</a></p>
            </div>
          </div>

          <!-- Tab: Pages Access -->
          <div class="tab-content" id="tab-pages-access">
            <div class="settings-section">
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem">
                <h3 style="margin-bottom:0"><i class="fas fa-eye"></i> الصفحات التي يمكن للرتبة رؤيتها</h3>
                <div style="display:flex;gap:8px;align-items:center">
                  <input type="text" id="pageAccessSearch" placeholder="🔍 بحث عن صفحة..." oninput="debounce(filterPagesAccess,150)()" style="padding:6px 12px;background:rgba(255,255,255,0.05);border:1px solid rgba(var(--ac-rgb),0.2);border-radius:8px;color:#fff;font-family:inherit;font-size:0.8rem;width:200px">
                  <button class="admin-btn small" onclick="toggleAllPages(true)">تحديد الكل</button>
                  <button class="admin-btn small" onclick="toggleAllPages(false)">إلغاء الكل</button>
                </div>
              </div>
              <p style="color:rgba(255,255,255,0.4);font-size:0.85rem;margin-bottom:1rem">حدد الصفحات التي يمكن لهذه الرتبة الوصول إليها.</p>
              <div id="pagesAccessContainer"><div class="skeleton" style="height:200px"></div></div>
            </div>
          </div>

          <!-- Tab: Admin Perms -->
          <div class="tab-content" id="tab-admin-perms">
            <div class="settings-section">
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem">
                <h3 style="margin-bottom:0"><i class="fas fa-lock"></i> صلاحيات الإدارة</h3>
                <input type="text" id="adminPermSearch" placeholder="🔍 بحث..." oninput="debounce(filterPerms,150)('admin')" style="padding:6px 12px;background:rgba(255,255,255,0.05);border:1px solid rgba(var(--ac-rgb),0.2);border-radius:8px;color:#fff;font-family:inherit;font-size:0.8rem;width:200px">
              </div>
              <div id="adminPermsContainer"><div class="skeleton" style="height:200px"></div></div>
            </div>
          </div>

          <!-- Tab: Site Perms -->
          <div class="tab-content" id="tab-site-perms">
            <div class="settings-section">
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem">
                <h3 style="margin-bottom:0"><i class="fas fa-globe"></i> صلاحيات الموقع</h3>
                <input type="text" id="sitePermSearch" placeholder="🔍 بحث..." oninput="debounce(filterPerms,150)('site')" style="padding:6px 12px;background:rgba(255,255,255,0.05);border:1px solid rgba(var(--ac-rgb),0.2);border-radius:8px;color:#fff;font-family:inherit;font-size:0.8rem;width:200px">
              </div>
              <div id="sitePermsContainer"><div class="skeleton" style="height:200px"></div></div>
            </div>
          </div>

          <!-- Tab: Side Roles -->
          <div class="tab-content" id="tab-side-roles">
            <div class="settings-section">
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem">
                <h3 style="margin-bottom:0"><i class="fas fa-tags"></i> الأدوار الجانبية</h3>
                <button class="admin-btn small primary" onclick="openAddSideRole()"><i class="fas fa-plus"></i> إضافة دور جانبي</button>
              </div>
              <p style="color:rgba(255,255,255,0.4);font-size:0.85rem;margin-bottom:1rem">الأدوار الجانبية تمنح صلاحيات <strong>إضافية فقط</strong> — لا تلغي صلاحيات الرتبة الأساسية.</p>
              <div id="sideRolesList"><div class="skeleton" style="height:60px;margin-bottom:8px"></div></div>
            </div>
          </div>
        </div>
      <% } else { %>
        <div style="text-align:center;padding:4rem;color:rgba(255,255,255,0.3)"><i class="fas fa-layer-group" style="font-size:3rem;margin-bottom:1rem;display:block"></i>لا توجد رتب</div>
      <% } %>
    </div>
  </div>
</div>

<!-- Add Role Modal -->
<div id="addRoleModal" class="admin-modal" style="display:none">
  <div class="admin-modal-content">
    <div class="admin-modal-header"><h3>إضافة رتبة جديدة</h3><button onclick="closeModal('addRoleModal')" style="background:none;border:none;color:rgba(255,255,255,0.5);font-size:1.2rem;cursor:pointer">&times;</button></div>
    <div style="padding:1.5rem">
      <div class="form-grid">
        <div class="form-group"><label>الاسم (إنجليزي)</label><input type="text" id="new_name" placeholder="مثال: member"></div>
        <div class="form-group"><label>اسم العرض (عربي)</label><input type="text" id="new_display_name" placeholder="مثال: عضو"></div>
        <div class="form-group"><label>اللون</label><input type="color" id="new_color" value="#ffffff"></div>
        <div class="form-group"><label>الأيقونة</label><input type="text" id="new_icon" placeholder="fa-user"></div>
        <div class="form-group"><label>الإيموجي</label><input type="text" id="new_emoji" placeholder="🎯" maxlength="10"></div>
        <div class="form-group" style="grid-column:1/-1"><label>الوصف</label><input type="text" id="new_description" placeholder="وصف الرتبة..."></div>
      </div>
    </div>
    <div class="admin-modal-footer">
      <button onclick="closeModal('addRoleModal')" class="admin-btn">إلغاء</button>
      <button onclick="createRole()" class="admin-btn primary">إنشاء</button>
    </div>
  </div>
</div>

<!-- Add Side Role Modal -->
<div id="addSideRoleModal" class="admin-modal" style="display:none">
  <div class="admin-modal-content" style="max-width:700px">
    <div class="admin-modal-header"><h3>إضافة دور جانبي</h3><button onclick="closeModal('addSideRoleModal')" style="background:none;border:none;color:rgba(255,255,255,0.5);font-size:1.2rem;cursor:pointer">&times;</button></div>
    <div style="padding:1.5rem">
      <div class="form-grid" style="margin-bottom:1rem">
        <div class="form-group"><label>الاسم</label><input type="text" id="sr_name" placeholder="مثال: vip"></div>
        <div class="form-group"><label>اسم العرض</label><input type="text" id="sr_display_name" placeholder="مثال: عضو مميز"></div>
        <div class="form-group"><label>اللون</label><input type="color" id="sr_color" value="#bc13fe"></div>
        <div class="form-group"><label>الأيقونة</label><input type="text" id="sr_icon" value="fa-tag"></div>
        <div class="form-group"><label>الإيموجي</label><input type="text" id="sr_emoji" placeholder="⭐" maxlength="10"></div>
      </div>
      <h4 style="margin-bottom:0.75rem;color:var(--ac)"><i class="fas fa-key"></i> صلاحيات إضافية (لا تلغي صلاحيات الرتبة الأساسية)</h4>
      <div id="newSideRolePermTabs" class="role-tabs" style="margin-bottom:1rem">
        <button class="role-tab active" onclick="switchSideRolePermTab('new','admin')"><i class="fas fa-lock"></i> الإدارة</button>
        <button class="role-tab" onclick="switchSideRolePermTab('new','site')"><i class="fas fa-globe"></i> الموقع</button>
        <button class="role-tab" onclick="switchSideRolePermTab('new','pages')"><i class="fas fa-eye"></i> الصفحات</button>
      </div>
      <div id="newSideRolePermContainer" style="max-height:300px;overflow-y:auto"></div>
    </div>
    <div class="admin-modal-footer">
      <button onclick="closeModal('addSideRoleModal')" class="admin-btn">إلغاء</button>
      <button onclick="createSideRole()" class="admin-btn primary">إنشاء</button>
    </div>
  </div>
</div>

<!-- Edit Side Role Modal -->
<div id="editSideRoleModal" class="admin-modal" style="display:none">
  <div class="admin-modal-content" style="max-width:700px">
    <div class="admin-modal-header"><h3 id="editSrTitle">تعديل دور جانبي</h3><button onclick="closeModal('editSideRoleModal')" style="background:none;border:none;color:rgba(255,255,255,0.5);font-size:1.2rem;cursor:pointer">&times;</button></div>
    <div style="padding:1.5rem">
      <div class="form-grid" style="margin-bottom:1rem">
        <div class="form-group"><label>الاسم</label><input type="text" id="edit_sr_name"></div>
        <div class="form-group"><label>اسم العرض</label><input type="text" id="edit_sr_display_name"></div>
        <div class="form-group"><label>اللون</label><input type="color" id="edit_sr_color"></div>
        <div class="form-group"><label>الأيقونة</label><input type="text" id="edit_sr_icon"></div>
        <div class="form-group"><label>الإيموجي</label><input type="text" id="edit_sr_emoji" maxlength="10"></div>
      </div>
      <h4 style="margin-bottom:0.75rem;color:var(--ac)"><i class="fas fa-key"></i> صلاحيات إضافية (لا تلغي صلاحيات الرتبة الأساسية)</h4>
      <div id="editSrPermTabs" class="role-tabs" style="margin-bottom:1rem">
        <button class="role-tab active" onclick="switchSideRolePermTab('edit','admin')"><i class="fas fa-lock"></i> الإدارة</button>
        <button class="role-tab" onclick="switchSideRolePermTab('edit','site')"><i class="fas fa-globe"></i> الموقع</button>
        <button class="role-tab" onclick="switchSideRolePermTab('edit','pages')"><i class="fas fa-eye"></i> الصفحات</button>
      </div>
      <div id="editSideRolePermContainer" style="max-height:300px;overflow-y:auto"></div>
    </div>
    <div class="admin-modal-footer">
      <button onclick="closeModal('editSideRoleModal')" class="admin-btn">إلغاء</button>
      <button onclick="saveSideRole()" class="admin-btn primary">حفظ</button>
    </div>
  </div>
</div>

<!-- Emoji Picker Modal -->
<div id="emojiPickerModal" class="admin-modal" style="display:none">
  <div class="admin-modal-content" style="max-width:360px">
    <div class="admin-modal-header"><h3>اختر إيموجي</h3><button onclick="closeModal('emojiPickerModal')" style="background:none;border:none;color:rgba(255,255,255,0.5);font-size:1.2rem;cursor:pointer">&times;</button></div>
    <div style="padding:1rem;display:flex;flex-wrap:wrap;gap:6px;max-height:300px;overflow-y:auto" id="emojiGrid"></div>
  </div>
</div>

<!-- Custom Confirm Modal -->
<div id="confirmModal" class="modal-overlay" style="display:none">
  <div style="background:#1a1525;border:1px solid rgba(var(--ac-rgb),0.2);border-radius:16px;padding:2rem;max-width:400px;width:90%;text-align:center">
    <div id="confirmIcon" style="font-size:2.5rem;margin-bottom:1rem"></div>
    <h3 id="confirmTitle" style="margin-bottom:0.5rem;color:#fff"></h3>
    <p id="confirmMsg" style="color:rgba(255,255,255,0.6);margin-bottom:1.5rem;font-size:0.9rem"></p>
    <div style="display:flex;gap:8px;justify-content:center">
      <button onclick="confirmResolve(false)" class="admin-btn" id="confirmCancelBtn">إلغاء</button>
      <button onclick="confirmResolve(true)" class="admin-btn primary" id="confirmOkBtn">تأكيد</button>
    </div>
  </div>
</div>

<!-- Copy Permissions Modal -->
<div id="copyPermsModal" class="modal-overlay" style="display:none">
  <div style="background:#1a1525;border:1px solid rgba(var(--ac-rgb),0.2);border-radius:16px;padding:2rem;max-width:400px;width:90%">
    <h3 style="margin-bottom:1rem;color:#fff;text-align:center"><i class="fas fa-copy" style="color:var(--ac)"></i> نسخ الصلاحيات</h3>
    <p style="color:rgba(255,255,255,0.5);font-size:0.85rem;margin-bottom:1rem;text-align:center">اختر الرتبة التي تريد نسخ صلاحياتها</p>
    <select id="copySourceRole" style="width:100%;padding:8px 12px;background:rgba(255,255,255,0.05);border:1px solid rgba(var(--ac-rgb),0.2);border-radius:8px;color:#fff;font-family:inherit;margin-bottom:1rem">
      <% if (roles) { roles.forEach(function(role) { %>
        <option value="<%= role.id %>"><%= role.display_name || role.name %></option>
      <% }); } %>
    </select>
    <div style="display:flex;gap:8px;justify-content:center">
      <button onclick="closeModal('copyPermsModal')" class="admin-btn">إلغاء</button>
      <button onclick="applyCopyPerms()" class="admin-btn primary">نسخ</button>
    </div>
  </div>
</div>

<script>
const PERMISSION_GROUPS = <%- JSON.stringify(PERMISSION_GROUPS || {}) %>;
const ALL_PAGES = [
  { path: '/', name: 'الرئيسية', icon: 'fa-home', category: 'site', desc: 'صفحة الدخول' },
  { path: '/about', name: 'من نحن', icon: 'fa-users', category: 'site', desc: 'معلومات عن العائلة' },
  { path: '/rules', name: 'القواعد', icon: 'fa-gavel', category: 'site', desc: 'قوانين المجتمع' },
  { path: '/store', name: 'المتجر', icon: 'fa-store', category: 'site', desc: 'شراء المنتجات' },
  { path: '/games', name: 'الألعاب', icon: 'fa-gamepad', category: 'site', desc: 'صفحة الألعاب' },
  { path: '/community', name: 'المجتمع', icon: 'fa-comments', category: 'site', desc: 'شات المجتمع' },
  { path: '/support', name: 'الدعم', icon: 'fa-headset', category: 'site', desc: 'نظام التذاكر' },
  { path: '/applications', name: 'التقديمات', icon: 'fa-file-alt', category: 'site', desc: 'تقديمات الانضمام' },
  { path: '/profile', name: 'الملف الشخصي', icon: 'fa-user', category: 'site', desc: 'صفحة المستخدم' },
  { path: '/contact', name: 'تواصل معنا', icon: 'fa-envelope', category: 'site', desc: 'نموذج التواصل' },
  { path: '/games/tictactoe', name: 'اكس أو', icon: 'fa-times', category: 'games', desc: 'لعبة اكس او' },
  { path: '/games/memory', name: 'الذاكرة', icon: 'fa-brain', category: 'games', desc: 'لعبة الذاكرة' },
  { path: '/games/snake', name: 'الثعبان', icon: 'fa-worm', category: 'games', desc: 'لعبة الثعبان' },
  { path: '/games/trivia', name: 'المعلومات العامة', icon: 'fa-question', category: 'games', desc: 'لعبة المعلومات' },
  { path: '/games/tetris', name: 'تتريس', icon: 'fa-cube', category: 'games', desc: 'لعبة تتريس' },
  { path: '/games/space-invaders', name: 'غزاة الفضاء', icon: 'fa-rocket', category: 'games', desc: 'لعبة غزاة الفضاء' },
  { path: '/games/flappy', name: 'فلابي بيرد', icon: 'fa-dove', category: 'games', desc: 'لعبة فلابي بيرد' },
  { path: '/games/pacman', name: '包acman', icon: 'fa-circle', category: 'games', desc: 'لعبة包acman' },
  { path: '/games/chess', name: 'الشطرنج', icon: 'fa-chess', category: 'games', desc: 'لعبة الشطرنج' },
  { path: '/games/checkers', name: 'الدمة', icon: 'fa-border-all', category: 'games', desc: 'لعبة الدمة' },
  { path: '/games/sudoku', name: 'سودوكو', icon: 'fa-th', category: 'games', desc: 'لعبة سودوكو' },
  { path: '/games/minesweeper', name: ' Minesweeper', icon: 'fa-bomb', category: 'games', desc: 'لعبة رمي الألغام' },
  { path: '/games/pong', name: 'بونج', icon: 'fa-table-tennis', category: 'games', desc: 'لعبة بونج' },
  { path: '/games/breakout', name: 'بريك أوت', icon: 'fa-brick', category: 'games', desc: 'لعبة بريك أوت' },
  { path: '/games/crossy-road', name: 'كروسي رود', icon: 'fa-road', category: 'games', desc: 'لعبة كروسي رود' },
  { path: '/admin', name: 'لوحة الإدارة', icon: 'fa-cog', category: 'admin', desc: 'لوحة التحكم' },
  { path: '/admin/users', name: 'المستخدمين', icon: 'fa-users', category: 'admin', desc: 'إدارة المستخدمين' },
  { path: '/admin/products', name: 'المنتجات', icon: 'fa-box', category: 'admin', desc: 'إدارة المنتجات' },
  { path: '/admin/orders', name: 'الطلبات', icon: 'fa-shopping-bag', category: 'admin', desc: 'إدارة الطلبات' },
  { path: '/admin/news', name: 'الأخبار', icon: 'fa-newspaper', category: 'admin', desc: 'إدارة الأخبار' },
  { path: '/admin/tickets', name: 'التذاكر', icon: 'fa-headset', category: 'admin', desc: 'إدارة التذاكر' },
  { path: '/admin/rules', name: 'القوانين', icon: 'fa-gavel', category: 'admin', desc: 'إدارة القوانين' },
  { path: '/admin/roles', name: 'الرتب', icon: 'fa-shield-halved', category: 'admin', desc: 'إدارة الصلاحيات' },
  { path: '/admin/settings', name: 'الإعدادات', icon: 'fa-cog', category: 'admin', desc: 'إعدادات الموقع' },
  { path: '/admin/broadcast', name: 'البث', icon: 'fa-bullhorn', category: 'admin', desc: 'نظام البث' },
  { path: '/admin/logs', name: 'السجلات', icon: 'fa-list', category: 'admin', desc: 'سجلات الإدارة' }
];
let roles = <%- JSON.stringify(roles || []) %>;
let unifiedPerms = <%- JSON.stringify(unifiedPerms || {}) %>;
let sideRoles = <%- JSON.stringify(sideRoles || []) %>;
let sideRolePermsData = <%- JSON.stringify(sideRolePerms || {}) %>;
let sideRolePageAccessData = <%- JSON.stringify(sideRolePageAccess || {}) %>;
let pageAccess = <%- JSON.stringify(pageAccess || {}) %>;
let selectedRoleId = roles.length ? roles[0].id : null;
let permState = {};
let hasUnsavedChanges = false;
let editingSideRoleId = null;
let sideRolePermState = {};
let sideRolePageState = {};

roles.forEach(r => {
  permState[r.id] = {};
  const saved = unifiedPerms[r.id] || {};
  if (Object.keys(saved).length === 0 && r.is_admin_role) {
    for (const [gKey, group] of Object.entries(PERMISSION_GROUPS)) {
      for (const pKey of Object.keys(group.permissions)) {
        permState[r.id][pKey] = 1;
      }
    }
  } else {
    permState[r.id] = { ...saved };
  }
});

function markDirty() { hasUnsavedChanges = true; }
window.addEventListener('beforeunload', function(e) { if (hasUnsavedChanges) { e.preventDefault(); e.returnValue = ''; } });

function debounce(fn, ms) { let t; return function() { clearTimeout(t); const args = arguments; const ctx = this; t = setTimeout(() => fn.apply(ctx, args), ms); }; }

function showConfirm(title, msg, icon, danger) {
  return new Promise(resolve => {
    document.getElementById('confirmTitle').textContent = title;
    document.getElementById('confirmMsg').textContent = msg;
    document.getElementById('confirmIcon').innerHTML = icon || '<i class="fas fa-question-circle" style="color:var(--ac)"></i>';
    const okBtn = document.getElementById('confirmOkBtn');
    if (danger) { okBtn.className = 'admin-btn'; okBtn.style.background = '#ef4444'; okBtn.style.color = '#fff'; }
    else { okBtn.className = 'admin-btn primary'; okBtn.style.background = ''; okBtn.style.color = ''; }
    document.getElementById('confirmModal').style.display = 'flex';
    window._confirmResolve = resolve;
  });
}
function confirmResolve(val) { document.getElementById('confirmModal').style.display = 'none'; if (window._confirmResolve) window._confirmResolve(val); }

function closeModal(id) { document.getElementById(id).style.display = 'none'; }
function openEmojiPicker() {
  const emojis = ['🎯','👑','⚔️','🛡️','🎮','🏆','⭐','💎','🔥','💜','🎨','🎭','🦊','🐺','🦁','🐉','⚡','🌟','💫','🎪','🎲','🧩','🎰','🗿','👤','👥','💬','📝','🔑','🏠','🌍','🗡️','🏹','🔮','🗡️','🏆','🎖️','🏅','☮️','☯️','💙','💚','💛','🧡','❤️','🖤','🤍','🏴','🚩','⚜️','🔱'];
  document.getElementById('emojiGrid').innerHTML = emojis.map(e => '<span style="font-size:1.5rem;cursor:pointer;padding:6px;border-radius:8px;transition:background 0.2s" onmouseover="this.style.background=\'rgba(255,255,255,0.1)\'" onmouseout="this.style.background=\'none\'" onclick="pickEmoji(\'' + e + '\')">' + e + '</span>').join('');
  document.getElementById('emojiPickerModal').style.display = 'flex';
}
function pickEmoji(e) { document.getElementById('r_emoji').value = e; document.getElementById('emojiPreview').textContent = e; closeModal('emojiPickerModal'); markDirty(); }

function updatePreview() {
  const badge = document.getElementById('rolePreviewBadge');
  if (!badge) return;
  const color = document.getElementById('r_color').value;
  const name = document.getElementById('r_display_name').value || document.getElementById('r_name').value;
  const emoji = document.getElementById('r_emoji').value;
  const icon = document.getElementById('r_icon').value || 'fa-user';
  badge.style.background = color + '20';
  badge.style.borderColor = color + '40';
  badge.style.color = color;
  badge.style.boxShadow = '0 0 12px ' + color + '30';
  badge.innerHTML = (emoji ? '<span>' + emoji + '</span>' : '') + '<i class="fas ' + icon + '"></i> ' + name;
  badge.classList.remove('animate');
  void badge.offsetWidth;
  badge.classList.add('animate');
}
function updateIconPreview() {
  const icon = document.getElementById('r_icon').value || 'fa-user';
  document.getElementById('iconPreview').className = 'fas ' + icon;
  updatePreview();
  markDirty();
}

// Tab switching
function switchTab(tab) {
  document.querySelectorAll('.role-tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
  event.target.closest('.role-tab').classList.add('active');
  document.getElementById('tab-' + tab).classList.add('active');
  if (tab === 'pages-access') renderPagesAccess();
  if (tab === 'admin-perms') renderPermGroup('admin');
  if (tab === 'site-perms') renderPermGroup('site');
  if (tab === 'side-roles') renderSideRoles();
  if (tab === 'roles' && selectedRoleId) loadMembers(selectedRoleId);
}

// Role selection
function selectRole(id) {
  if (hasUnsavedChanges) {
    showConfirm('تنبيه', 'لديك تغييرات غير محفوظة. هل تريد المتابعة؟', '<i class="fas fa-exclamation-triangle" style="color:#f59e0b"></i>', false).then(ok => {
      if (ok) { hasUnsavedChanges = false; doSelectRole(id); }
    });
    return;
  }
  doSelectRole(id);
}

function doSelectRole(id) {
  selectedRoleId = id;
  hasUnsavedChanges = false;
  document.querySelectorAll('.role-list-item').forEach(el => el.classList.toggle('selected', el.dataset.id == id));
  const role = roles.find(r => r.id === id);
  if (!role) return;
  document.getElementById('roleEditor').dataset.roleId = id;
  const isOwner = role.name === 'owner';
  document.getElementById('roleActionsBtns').style.display = isOwner ? 'none' : 'flex';
  document.getElementById('roleActionsLocked').style.display = isOwner ? 'inline-flex' : 'none';
  const ownerBox = document.getElementById('ownerInfoBox');
  if (ownerBox) ownerBox.style.display = isOwner ? 'block' : 'none';
  document.querySelectorAll('#roleEditor input[type="text"], #roleEditor input[type="color"]').forEach(inp => inp.disabled = isOwner);
  document.getElementById('r_name').value = role.name;
  document.getElementById('r_display_name').value = role.display_name || '';
  document.getElementById('r_color').value = role.color || '#ffffff';
  document.getElementById('r_icon').value = role.icon || '';
  document.getElementById('r_emoji').value = role.emoji || '';
  document.getElementById('r_description').value = role.description || '';
  document.getElementById('r_is_admin').checked = !!role.is_admin_role;
  document.getElementById('r_is_protected').checked = !!role.is_protected;
  document.getElementById('r_is_default').checked = !!role.is_default;
  document.getElementById('r_is_staff').checked = !!role.is_staff;
  document.getElementById('h_can_assign').checked = !!role.can_assign_roles;
  document.getElementById('iconPreview').className = 'fas ' + (role.icon || 'fa-user');
  document.getElementById('emojiPreview').textContent = role.emoji || '';
  updatePreview();
  const activeTab = document.querySelector('.role-tab.active')?.textContent || '';
  if (activeTab.includes('الصفحات')) renderPagesAccess();
  else if (activeTab.includes('الإدارة')) renderPermGroup('admin');
  else if (activeTab.includes('الموقع')) renderPermGroup('site');
  else if (activeTab.includes('الجانبية')) renderSideRoles();
  else if (activeTab.includes('الأعضاء')) loadMembers(id);
}

// Pages Access
function renderPagesAccess() {
  const container = document.getElementById('pagesAccessContainer');
  if (!container) return;
  const state = pageAccess[selectedRoleId] || {};
  const categories = { site: { label: 'الموقع الرئيسي', icon: 'fa-globe', color: '#3b82f6' }, games: { label: 'الألعاب', icon: 'fa-gamepad', color: '#a855f7' }, admin: { label: 'لوحة الإدارة', icon: 'fa-cog', color: '#ef4444' } };
  let html = '';
  for (const [catKey, cat] of Object.entries(categories)) {
    const pages = ALL_PAGES.filter(p => p.category === catKey);
    const enabledCount = pages.filter(p => state[p.path] !== 0).length;
    const pct = pages.length ? Math.round((enabledCount / pages.length) * 100) : 0;
    html += '<div class="perm-group" data-cat="' + catKey + '"><div class="perm-group-header" onclick="togglePageCat(\'' + catKey + '\')"><h4><i class="fas ' + cat.icon + '" style="color:' + cat.color + '"></i> ' + cat.label + ' <span class="group-count">' + enabledCount + '/' + pages.length + '</span></h4><div style="display:flex;align-items:center;gap:8px"><div class="perm-progress-bar" style="width:60px"><div style="width:' + pct + '%;background:' + cat.color + '"></div></div><i class="fas fa-chevron-right perm-group-arrow"></i></div></div><div class="perm-group-body">';
    pages.forEach(p => {
      const checked = state[p.path] !== 0 ? 'checked' : '';
      html += '<div class="perm-row" data-path="' + p.path + '"><div><div class="perm-label">' + p.name + '</div><div class="perm-desc">' + p.path + ' — ' + p.desc + '</div></div><label class="toggle-item" style="margin:0;padding:6px 10px;border:none;background:none"><input type="checkbox" ' + checked + ' onchange="togglePageAccess(\'' + p.path + '\',this.checked)"><span class="toggle-switch"></span></label></div>';
    });
    html += '</div></div>';
  }
  container.innerHTML = html;
}
function togglePageCat(cat) {
  const el = document.querySelector('.perm-group[data-cat="' + cat + '"]');
  if (el) el.classList.toggle('open');
}
function togglePageAccess(path, val) {
  if (!pageAccess[selectedRoleId]) pageAccess[selectedRoleId] = {};
  pageAccess[selectedRoleId][path] = val ? 1 : 0;
  markDirty();
  renderPagesAccess();
}
function toggleAllPages(val) {
  if (!pageAccess[selectedRoleId]) pageAccess[selectedRoleId] = {};
  ALL_PAGES.forEach(p => { pageAccess[selectedRoleId][p.path] = val ? 1 : 0; });
  markDirty();
  renderPagesAccess();
}
function filterPagesAccess() {
  const q = document.getElementById('pageAccessSearch').value.toLowerCase();
  document.querySelectorAll('#pagesAccessContainer .perm-row').forEach(el => {
    el.style.display = (el.dataset.path || '').includes(q) || el.textContent.toLowerCase().includes(q) ? '' : 'none';
  });
}

// Permission Groups
function renderPermGroup(type) {
  const container = document.getElementById(type === 'admin' ? 'adminPermsContainer' : 'sitePermsContainer');
  if (!container) return;
  const state = permState[selectedRoleId] || {};
  let html = '';
  for (const [gKey, group] of Object.entries(PERMISSION_GROUPS)) {
    if ((type === 'admin' && !group.is_site) || (type === 'site' && group.is_site)) {
      const permKeys = Object.keys(group.permissions);
      const enabledCount = permKeys.filter(k => state[k]).length;
      const pct = permKeys.length ? Math.round((enabledCount / permKeys.length) * 100) : 0;
      html += '<div class="perm-group" data-group="' + gKey + '"><div class="perm-group-header" onclick="toggleGroup(\'' + gKey + '\')"><h4><i class="fas ' + group.icon + '"></i> ' + group.label + ' <span class="group-count">' + enabledCount + '/' + permKeys.length + '</span></h4><div style="display:flex;align-items:center;gap:8px"><div class="perm-progress-bar" style="width:60px"><div style="width:' + pct + '%;background:var(--ac)"></div></div><button class="group-toggle-all" onclick="event.stopPropagation();toggleGroupAll(\'' + gKey + '\',\'' + type + '\')">تحديد الكل</button><i class="fas fa-chevron-right perm-group-arrow"></i></div></div><div class="perm-group-body">';
      permKeys.forEach(pKey => {
        const perm = group.permissions[pKey];
        html += '<div class="perm-row" data-key="' + pKey + '"><div><div class="perm-label">' + perm.label + '</div><div class="perm-desc">' + perm.desc + '</div></div><label class="toggle-item" style="margin:0;padding:6px 10px;border:none;background:none"><input type="checkbox" ' + (state[pKey] ? 'checked' : '') + ' onchange="togglePerm(\'' + pKey + '\',this.checked)"><span class="toggle-switch"></span></label></div>';
      });
      html += '</div></div>';
    }
  }
  container.innerHTML = html;
}
function toggleGroup(gKey) { const el = document.querySelector('.perm-group[data-group="' + gKey + '"]'); if (el) el.classList.toggle('open'); }
function toggleGroupAll(gKey, type) {
  if (!permState[selectedRoleId]) permState[selectedRoleId] = {};
  const group = PERMISSION_GROUPS[gKey];
  if (!group) return;
  const permKeys = Object.keys(group.permissions);
  const allEnabled = permKeys.every(k => permState[selectedRoleId][k]);
  permKeys.forEach(k => { permState[selectedRoleId][k] = allEnabled ? 0 : 1; });
  markDirty();
  renderPermGroup(type);
}
function togglePerm(key, enabled) {
  if (!permState[selectedRoleId]) permState[selectedRoleId] = {};
  permState[selectedRoleId][key] = enabled ? 1 : 0;
  markDirty();
  for (const [gKey, group] of Object.entries(PERMISSION_GROUPS)) {
    if (group.permissions[key]) {
      const el = document.querySelector('.perm-group[data-group="' + gKey + '"] .group-count');
      if (el) {
        const permKeys = Object.keys(group.permissions);
        const count = permKeys.filter(k => permState[selectedRoleId][k]).length;
        el.textContent = count + '/' + permKeys.length;
      }
    }
  }
}
function filterPerms(type) {
  const q = document.getElementById(type + 'PermSearch').value.toLowerCase();
  document.querySelectorAll('#' + type + 'PermsContainer .perm-row').forEach(el => {
    el.style.display = (el.dataset.key || '').includes(q) || el.textContent.toLowerCase().includes(q) ? '' : 'none';
  });
}

// Side Roles
function renderSideRoles() {
  const container = document.getElementById('sideRolesList');
  if (!container) return;
  if (!sideRoles.length) { container.innerHTML = '<div style="text-align:center;padding:2rem;color:rgba(255,255,255,0.3)">لا توجد أدوار جانبية</div>'; return; }
  container.innerHTML = sideRoles.map(sr => {
    const perms = sideRolePermsData[sr.id] || {};
    const permCount = Object.keys(perms).filter(k => perms[k]).length;
    const pages = sideRolePageAccessData[sr.id] || {};
    const pageCount = Object.keys(pages).filter(k => pages[k]).length;
    return '<div class="side-role-card" data-id="' + sr.id + '"><div class="side-role-badge" style="background:' + sr.color + '20;color:' + sr.color + ';border:1px solid ' + sr.color + '40">' + (sr.emoji ? '<span>' + sr.emoji + '</span>' : '') + '<i class="fas ' + (sr.icon || 'fa-tag') + '"></i> ' + sr.display_name + '</div><span style="font-size:0.75rem;color:rgba(255,255,255,0.3)">' + sr.name + '</span><span style="font-size:0.7rem;color:rgba(255,255,255,0.25)"><i class="fas fa-key"></i> ' + permCount + ' صلاحية</span><span style="font-size:0.7rem;color:rgba(255,255,255,0.25)"><i class="fas fa-eye"></i> ' + pageCount + ' صفحة</span><div class="side-role-actions"><button class="admin-btn small" onclick="editSideRole(' + sr.id + ')" title="تعديل"><i class="fas fa-edit"></i></button><button class="admin-btn small" style="color:#ef4444" onclick="deleteSideRole(' + sr.id + ')" title="حذف"><i class="fas fa-trash"></i></button></div></div>';
  }).join('');
}

let newSideRolePermTabType = 'admin';
let editSideRolePermTabType = 'admin';

function openAddSideRole() {
  document.getElementById('sr_name').value = '';
  document.getElementById('sr_display_name').value = '';
  document.getElementById('sr_color').value = '#bc13fe';
  document.getElementById('sr_icon').value = 'fa-tag';
  document.getElementById('sr_emoji').value = '';
  sideRolePermState = {};
  sideRolePageState = {};
  newSideRolePermTabType = 'admin';
  document.querySelectorAll('#newSideRolePermTabs .role-tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('#newSideRolePermTabs .role-tab')[0].classList.add('active');
  renderSideRolePermEditor('new');
  document.getElementById('addSideRoleModal').style.display = 'flex';
}

function editSideRole(id) {
  const sr = sideRoles.find(s => s.id === id);
  if (!sr) return;
  editingSideRoleId = id;
  document.getElementById('edit_sr_name').value = sr.name;
  document.getElementById('edit_sr_display_name').value = sr.display_name || '';
  document.getElementById('edit_sr_color').value = sr.color || '#bc13fe';
  document.getElementById('edit_sr_icon').value = sr.icon || 'fa-tag';
  document.getElementById('edit_sr_emoji').value = sr.emoji || '';
  document.getElementById('editSrTitle').textContent = 'تعديل: ' + (sr.display_name || sr.name);
  sideRolePermState[id] = { ...(sideRolePermsData[id] || {}) };
  sideRolePageState[id] = { ...(sideRolePageAccessData[id] || {}) };
  editSideRolePermTabType = 'admin';
  document.querySelectorAll('#editSrPermTabs .role-tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('#editSrPermTabs .role-tab')[0].classList.add('active');
  renderSideRolePermEditor('edit');
  document.getElementById('editSideRoleModal').style.display = 'flex';
}

function switchSideRolePermTab(mode, type) {
  if (mode === 'new') {
    newSideRolePermTabType = type;
    document.querySelectorAll('#newSideRolePermTabs .role-tab').forEach(t => t.classList.remove('active'));
    event.target.closest('.role-tab').classList.add('active');
  } else {
    editSideRolePermTabType = type;
    document.querySelectorAll('#editSrPermTabs .role-tab').forEach(t => t.classList.remove('active'));
    event.target.closest('.role-tab').classList.add('active');
  }
  renderSideRolePermEditor(mode);
}

function renderSideRolePermEditor(mode) {
  const containerId = mode === 'new' ? 'newSideRolePermContainer' : 'editSideRolePermContainer';
  const container = document.getElementById(containerId);
  if (!container) return;
  const tabType = mode === 'new' ? newSideRolePermTabType : editSideRolePermTabType;
  const stateKey = mode === 'new' ? '_new' : editingSideRoleId;
  if (tabType === 'pages') {
    const state = mode === 'new' ? sideRolePageState : (sideRolePageState[stateKey] || {});
    const categories = { site: 'الموقع', games: 'الألعاب', admin: 'الإدارة' };
    let html = '';
    for (const [cat, label] of Object.entries(categories)) {
      const pages = ALL_PAGES.filter(p => p.category === cat);
      html += '<div style="margin-bottom:1rem"><div style="font-weight:700;font-size:0.85rem;color:rgba(255,255,255,0.7);margin-bottom:0.5rem">' + label + '</div>';
      pages.forEach(p => {
        const checked = state[p.path] ? 'checked' : '';
        html += '<div class="perm-row" data-path="' + p.path + '"><div><div class="perm-label">' + p.name + '</div><div class="perm-desc">' + p.path + '</div></div><label class="toggle-item" style="margin:0;padding:6px 10px;border:none;background:none"><input type="checkbox" ' + checked + ' onchange="toggleSrPageAccess(\'' + mode + '\',\'' + p.path + '\',this.checked)"><span class="toggle-switch"></span></label></div>';
      });
      html += '</div>';
    }
    container.innerHTML = html;
    return;
  }
  const state = mode === 'new' ? sideRolePermState : (sideRolePermState[stateKey] || {});
  let html = '';
  for (const [gKey, group] of Object.entries(PERMISSION_GROUPS)) {
    if ((tabType === 'admin' && !group.is_site) || (tabType === 'site' && group.is_site)) {
      const permKeys = Object.keys(group.permissions);
      const enabledCount = permKeys.filter(k => state[k]).length;
      const pct = permKeys.length ? Math.round((enabledCount / permKeys.length) * 100) : 0;
      html += '<div class="perm-group" data-group="' + gKey + '"><div class="perm-group-header" onclick="this.parentElement.classList.toggle(\'open\')"><h4><i class="fas ' + group.icon + '"></i> ' + group.label + ' <span class="group-count">' + enabledCount + '/' + permKeys.length + '</span></h4><div style="display:flex;align-items:center;gap:8px"><div class="perm-progress-bar" style="width:60px"><div style="width:' + pct + '%;background:var(--ac)"></div></div><i class="fas fa-chevron-right perm-group-arrow"></i></div></div><div class="perm-group-body">';
      permKeys.forEach(pKey => {
        const perm = group.permissions[pKey];
        html += '<div class="perm-row"><div><div class="perm-label">' + perm.label + '</div><div class="perm-desc">' + perm.desc + '</div></div><label class="toggle-item" style="margin:0;padding:6px 10px;border:none;background:none"><input type="checkbox" ' + (state[pKey] ? 'checked' : '') + ' onchange="toggleSrPerm(\'' + mode + '\',\'' + pKey + '\',this.checked)"><span class="toggle-switch"></span></label></div>';
      });
      html += '</div></div>';
    }
  }
  container.innerHTML = html || '<div style="text-align:center;padding:2rem;color:rgba(255,255,255,0.3)">لا توجد صلاحيات</div>';
}

function toggleSrPerm(mode, key, val) {
  const stateKey = mode === 'new' ? '_new' : editingSideRoleId;
  if (mode === 'new') { if (!sideRolePermState._new) sideRolePermState._new = {}; sideRolePermState._new[key] = val ? 1 : 0; }
  else { if (!sideRolePermState[stateKey]) sideRolePermState[stateKey] = {}; sideRolePermState[stateKey][key] = val ? 1 : 0; }
}
function toggleSrPageAccess(mode, path, val) {
  if (mode === 'new') { if (!sideRolePageState._new) sideRolePageState._new = {}; sideRolePageState._new[path] = val ? 1 : 0; }
  else { const sk = editingSideRoleId; if (!sideRolePageState[sk]) sideRolePageState[sk] = {}; sideRolePageState[sk][path] = val ? 1 : 0; }
}

async function createSideRole() {
  const body = { name: document.getElementById('sr_name').value.trim(), display_name: document.getElementById('sr_display_name').value.trim(), color: document.getElementById('sr_color').value, icon: document.getElementById('sr_icon').value, emoji: document.getElementById('sr_emoji').value };
  if (!body.name || !body.display_name) return showConfirm('خطأ', 'أدخل الأسماء', '<i class="fas fa-exclamation-circle" style="color:#ef4444"></i>', true);
  try {
    const res = await fetch('/api/admin/side-roles', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    const data = await res.json();
    if (!data.success) return showConfirm('خطأ', data.error || 'خطأ', '<i class="fas fa-exclamation-circle" style="color:#ef4444"></i>', true);
    const srId = data.sideRole.id;
    sideRoles.push(data.sideRole);
    if (sideRolePermState._new && Object.keys(sideRolePermState._new).length) {
      await fetch('/api/admin/side-roles/' + srId + '/permissions', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ permissions: sideRolePermState._new }) });
      sideRolePermsData[srId] = { ...sideRolePermState._new };
    }
    if (sideRolePageState._new && Object.keys(sideRolePageState._new).length) {
      await fetch('/api/admin/side-roles/' + srId + '/page-access', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ pages: sideRolePageState._new }) });
      sideRolePageAccessData[srId] = { ...sideRolePageState._new };
    }
    renderSideRoles();
    closeModal('addSideRoleModal');
    showConfirm('تم', 'تم الإنشاء بنجاح', '<i class="fas fa-check-circle" style="color:#22c55e"></i>', false);
  } catch(e) { showConfirm('خطأ', 'حدث خطأ', '<i class="fas fa-exclamation-circle" style="color:#ef4444"></i>', true); }
}

async function saveSideRole() {
  if (!editingSideRoleId) return;
  const body = { name: document.getElementById('edit_sr_name').value.trim(), display_name: document.getElementById('edit_sr_display_name').value.trim(), color: document.getElementById('edit_sr_color').value, icon: document.getElementById('edit_sr_icon').value, emoji: document.getElementById('edit_sr_emoji').value, is_active: 1, sort_order: 0 };
  try {
    const res = await fetch('/api/admin/side-roles/' + editingSideRoleId, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    const data = await res.json();
    if (!data.success) return showConfirm('خطأ', data.error || 'خطأ', '<i class="fas fa-exclamation-circle" style="color:#ef4444"></i>', true);
    const sr = sideRoles.find(s => s.id === editingSideRoleId);
    if (sr) Object.assign(sr, body);
    if (sideRolePermState[editingSideRoleId]) {
      await fetch('/api/admin/side-roles/' + editingSideRoleId + '/permissions', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ permissions: sideRolePermState[editingSideRoleId] }) });
      sideRolePermsData[editingSideRoleId] = { ...sideRolePermState[editingSideRoleId] };
    }
    if (sideRolePageState[editingSideRoleId]) {
      await fetch('/api/admin/side-roles/' + editingSideRoleId + '/page-access', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ pages: sideRolePageState[editingSideRoleId] }) });
      sideRolePageAccessData[editingSideRoleId] = { ...sideRolePageState[editingSideRoleId] };
    }
    renderSideRoles();
    closeModal('editSideRoleModal');
    showConfirm('تم', 'تم الحفظ بنجاح', '<i class="fas fa-check-circle" style="color:#22c55e"></i>', false);
  } catch(e) { showConfirm('خطأ', 'حدث خطأ', '<i class="fas fa-exclamation-circle" style="color:#ef4444"></i>', true); }
}

async function deleteSideRole(id) {
  const ok = await showConfirm('حذف', 'هل تريد حذف هذا الدور الجانبي؟', '<i class="fas fa-trash" style="color:#ef4444"></i>', true);
  if (!ok) return;
  try { await fetch('/api/admin/side-roles/' + id, { method: 'DELETE' }); sideRoles = sideRoles.filter(s => s.id !== id); delete sideRolePermsData[id]; delete sideRolePageAccessData[id]; renderSideRoles(); } catch(e) {}
}

async function loadMembers(roleId) {
  try {
    const res = await fetch('/api/admin/roles/' + roleId + '/members');
    const data = await res.json();
    const list = document.getElementById('roleMembersList');
    if (!list) return;
    if (data.members?.length) {
      list.innerHTML = data.members.map(m => '<div class="member-item"><img src="' + (m.profile_picture || '/images/default-avatar.png') + '" alt=""><div class="member-info"><div class="member-name">' + m.username + '</div><div class="member-id">#' + m.id + '</div></div></div>').join('');
    } else {
      list.innerHTML = '<div style="text-align:center;padding:1.5rem;color:rgba(255,255,255,0.3)">لا يوجد أعضاء</div>';
    }
  } catch(e) {}
}

// Save everything
async function saveAll() {
  const id = selectedRoleId;
  if (!id) return;
  const role = roles.find(r => r.id === id);
  if (role && role.name === 'owner') return showConfirm('خطأ', 'لا يمكن تعديل رتبة المالك', '<i class="fas fa-lock" style="color:#f59e0b"></i>', true);
  const roleBody = {
    name: document.getElementById('r_name').value, display_name: document.getElementById('r_display_name').value,
    color: document.getElementById('r_color').value, icon: document.getElementById('r_icon').value,
    emoji: document.getElementById('r_emoji').value, description: document.getElementById('r_description').value,
    is_admin_role: document.getElementById('r_is_admin').checked ? 1 : 0, is_protected: document.getElementById('r_is_protected').checked ? 1 : 0,
    is_default: document.getElementById('r_is_default').checked ? 1 : 0, is_staff: document.getElementById('r_is_staff').checked ? 1 : 0,
    can_assign_roles: document.getElementById('h_can_assign').checked ? 1 : 0,
  };
  try {
    const res = await fetch('/api/admin/roles/' + id, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(roleBody) });
    const data = await res.json();
    if (!data.success) return showConfirm('خطأ', data.error || 'خطأ في حفظ الرتبة', '<i class="fas fa-exclamation-circle" style="color:#ef4444"></i>', true);
  } catch(e) { return showConfirm('خطأ', 'خطأ في الاتصال', '<i class="fas fa-exclamation-circle" style="color:#ef4444"></i>', true); }
  try {
    await fetch('/api/admin/roles/' + id + '/all-permissions', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ permissions: permState[id] || {} }) });
  } catch(e) {}
  try {
    await fetch('/api/admin/roles/' + id + '/page-access', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ pages: pageAccess[id] || {} }) });
  } catch(e) {}
  const idx = roles.findIndex(r => r.id == id);
  if (idx >= 0) Object.assign(roles[idx], roleBody);
  unifiedPerms[id] = { ...permState[id] };
  hasUnsavedChanges = false;
  showConfirm('تم', 'تم الحفظ بنجاح', '<i class="fas fa-check-circle" style="color:#22c55e"></i>', false);
}

function resetPermissions() {
  showConfirm('إعادة تعيين', 'هل أنت متأكد من إعادة تعيين كل الصلاحيات؟', '<i class="fas fa-undo" style="color:#f59e0b"></i>', false).then(ok => {
    if (!ok) return;
    permState[selectedRoleId] = {};
    pageAccess[selectedRoleId] = {};
    markDirty();
    const activeTab = document.querySelector('.role-tab.active')?.textContent || '';
    if (activeTab.includes('الصفحات')) renderPagesAccess();
    else if (activeTab.includes('الإدارة')) renderPermGroup('admin');
    else if (activeTab.includes('الموقع')) renderPermGroup('site');
    showConfirm('تم', 'تم إعادة التعيين — اضغط حفظ للتأكيد', '<i class="fas fa-check-circle" style="color:#22c55e"></i>', false);
  });
}

function copyPermissionsFrom() { document.getElementById('copyPermsModal').style.display = 'flex'; }
function applyCopyPerms() {
  const srcId = parseInt(document.getElementById('copySourceRole').value);
  if (!srcId || srcId === selectedRoleId) return;
  permState[selectedRoleId] = { ...(unifiedPerms[srcId] || {}) };
  pageAccess[selectedRoleId] = { ...(pageAccess[srcId] || {}) };
  markDirty();
  closeModal('copyPermsModal');
  const activeTab = document.querySelector('.role-tab.active')?.textContent || '';
  if (activeTab.includes('الصفحات')) renderPagesAccess();
  else if (activeTab.includes('الإدارة')) renderPermGroup('admin');
  else if (activeTab.includes('الموقع')) renderPermGroup('site');
  showConfirm('تم', 'تم نسخ الصلاحيات', '<i class="fas fa-check-circle" style="color:#22c55e"></i>', false);
}

// CRUD
async function createRole() {
  const body = { name: document.getElementById('new_name').value.trim(), display_name: document.getElementById('new_display_name').value.trim(), color: document.getElementById('new_color').value, icon: document.getElementById('new_icon').value, emoji: document.getElementById('new_emoji').value, description: document.getElementById('new_description').value };
  if (!body.name || !body.display_name) return showConfirm('خطأ', 'أدخل الأسماء', '<i class="fas fa-exclamation-circle" style="color:#ef4444"></i>', true);
