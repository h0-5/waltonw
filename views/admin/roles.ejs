<%- include('layout') %>

<div class="admin-content">
  <div style="display:flex;gap:1.5rem;min-height:80vh">
    <!-- Sidebar: Role List -->
    <div style="width:280px;flex-shrink:0;background:rgba(12,8,22,0.6);border:1px solid rgba(var(--ac-rgb),0.15);border-radius:16px;padding:1.2rem;overflow-y:auto;max-height:85vh">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem">
        <h3 style="font-size:1rem;font-weight:800;color:var(--ac)"><i class="fas fa-layer-group"></i> الرتب</h3>
        <button class="admin-btn small primary" onclick="openAddRole()"><i class="fas fa-plus"></i></button>
      </div>
      <input type="text" id="roleSearch" placeholder="بحث عن رتبة..." oninput="filterRoles()" style="width:100%;padding:8px 12px;background:rgba(255,255,255,0.05);border:1px solid rgba(var(--ac-rgb),0.2);border-radius:8px;color:#fff;font-family:inherit;font-size:0.8rem;margin-bottom:0.75rem">
      <div id="roleList">
        <% if (typeof roles !== 'undefined' && roles && roles.length) { %>
          <% roles.forEach(function(r, i) { %>
            <div class="role-list-item <%= i === 0 ? 'selected' : '' %> <%= r.name === 'owner' ? 'owner-role' : '' %>" onclick="selectRole(<%= r.id %>)" data-id="<%= r.id %>" data-name="<%= (r.display_name || r.name).toLowerCase() %>" draggable="<%= r.name === 'owner' ? 'false' : 'true' %>" data-sort="<%= r.sort_order || 0 %>">
              <div style="display:flex;align-items:center;gap:10px;flex:1">
                <% if (r.name !== 'owner') { %><div class="drag-handle" title="اسحب للترتيب"><i class="fas fa-grip-vertical"></i></div><% } %>
                <div style="width:12px;height:12px;border-radius:50%;background:<%= r.color %>;flex-shrink:0"></div>
                <div style="flex:1;min-width:0">
                  <div style="font-weight:700;font-size:0.85rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                    <% if (r.emoji) { %><span class="role-emoji-badge"><%= r.emoji %></span><% } %><%= r.display_name || r.name %>
                    <% if (r.name === 'owner') { %><i class="fas fa-crown" style="color:#f59e0b;margin-right:4px;font-size:0.7rem"></i><% } %>
                  </div>
                  <div style="font-size:0.7rem;color:rgba(255,255,255,0.35)"><%= r.name %>
                    <% if (r.is_admin_role) { %><span class="badge-admin-sm">admin</span><% } %>
                    <% if (r.is_staff) { %><span class="badge-staff-sm">staff</span><% } %>
                    <% if (r.name === 'owner') { %><span class="badge-owner-sm">owner</span><% } %>
                  </div>
                </div>
              </div>
              <% if (r.name !== 'owner' && !r.is_default && !r.is_protected) { %>
                <button class="role-delete-btn" onclick="event.stopPropagation();deleteRole(<%= r.id %>)" title="حذف"><i class="fas fa-trash"></i></button>
              <% } %>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>

    <!-- Main: Editor -->
    <div style="flex:1;overflow-y:auto;max-height:85vh" id="editorPanel">
      <% if (typeof roles !== 'undefined' && roles && roles.length) { %>
        <% var r = roles[0]; %>
        <div id="roleEditor" data-role-id="<%= r.id %>">
          <!-- Header with live badge preview -->
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem;padding-bottom:1rem;border-bottom:1px solid rgba(var(--ac-rgb),0.1)">
            <div style="display:flex;align-items:center;gap:14px">
              <div id="rolePreviewBadge" style="display:inline-flex;align-items:center;gap:6px;padding:6px 14px;border-radius:8px;background:<%= r.color %>20;border:1px solid <%= r.color %>40;font-weight:800;font-size:0.95rem;color:<%= r.color %>">
                <% if (r.emoji) { %><span><%= r.emoji %></span><% } %><i class="fas <%= r.icon || 'fa-user' %>"></i> <%= r.display_name || r.name %>
              </div>
              <span style="font-size:0.8rem;color:rgba(255,255,255,0.4)"><%= r.name %>
                <% if (r.name === 'owner') { %> <i class="fas fa-crown" style="color:#f59e0b"></i> رتبة المالك — محمية بالكامل <% } %>
              </span>
            </div>
            <div id="roleActionsBtns" style="display:<%= r.name !== 'owner' ? 'flex' : 'none' %>;gap:8px">
              <button class="admin-btn" onclick="resetPermissions()" title="إعادة تعيين الصلاحيات"><i class="fas fa-undo"></i> إعادة تعيين</button>
              <button class="admin-btn primary" onclick="saveAll()"><i class="fas fa-save"></i> حفظ الكل</button>
            </div>
            <span id="roleActionsLocked" style="display:<%= r.name === 'owner' ? 'inline-flex' : 'none' %>;padding:6px 14px;background:rgba(245,158,11,0.15);border:1px solid rgba(245,158,11,0.3);border-radius:8px;color:#f59e0b;font-size:0.8rem;font-weight:700;align-items:center;gap:6px"><i class="fas fa-lock"></i> محمية — لا يمكن التعديل</span>
          </div>

          <!-- Tabs -->
          <div class="role-tabs">
            <button class="role-tab active" onclick="switchTab('roles')"><i class="fas fa-shield-halved"></i> الرتب</button>
            <button class="role-tab" onclick="switchTab('pages-access')"><i class="fas fa-eye"></i> الصفحات</button>
            <button class="role-tab" onclick="switchTab('admin-perms')"><i class="fas fa-lock"></i> صلاحيات الإدارة</button>
            <button class="role-tab" onclick="switchTab('site-perms')"><i class="fas fa-globe"></i> صلاحيات الموقع</button>
            <button class="role-tab" onclick="switchTab('side-roles')"><i class="fas fa-tags"></i> الأدوار الجانبية</button>
          </div>

          <!-- Tab: Role Settings -->
          <div class="tab-content active" id="tab-roles">
            <div id="ownerInfoBox" style="display:<%= r.name === 'owner' ? 'block' : 'none' %>;background:rgba(245,158,11,0.08);border:1px solid rgba(245,158,11,0.2);border-radius:12px;padding:1.5rem;margin-bottom:1.2rem">
              <div style="display:flex;align-items:center;gap:10px;margin-bottom:0.75rem">
                <i class="fas fa-crown" style="color:#f59e0b;font-size:1.2rem"></i>
                <h3 style="color:#f59e0b;margin:0">رتبة المالك</h3>
              </div>
              <p style="color:rgba(255,255,255,0.6);font-size:0.9rem;line-height:1.6">
                هذه الرتبة <strong>محمية بالكامل</strong> ولا يمكن تعديلها. المالك يملك <strong>كل الصلاحيات</strong> تلقائياً ولا يحتاج لأي إعداد.
              </p>
            </div>

            <div class="settings-section">
              <h3><i class="fas fa-info-circle"></i> معلومات الرتبة</h3>
              <div class="form-grid">
                <div class="form-group">
                  <label>الاسم (إنجليزي)</label>
                  <input type="text" id="r_name" value="<%= r.name %>" oninput="updatePreview()" <%= r.name === 'owner' ? 'disabled' : '' %>>
                </div>
                <div class="form-group">
                  <label>اسم العرض (عربي)</label>
                  <input type="text" id="r_display_name" value="<%= r.display_name || '' %>" oninput="updatePreview()" <%= r.name === 'owner' ? 'disabled' : '' %>>
                </div>
                <div class="form-group">
                  <label>اللون</label>
                  <input type="color" id="r_color" value="<%= r.color || '#ffffff' %>" oninput="updatePreview()" <%= r.name === 'owner' ? 'disabled' : '' %>>
                </div>
                <div class="form-group">
                  <label>الأيقونة (Font Awesome)</label>
                  <div style="display:flex;gap:6px;align-items:center">
                    <i id="iconPreview" class="fas <%= r.icon || 'fa-user' %>" style="font-size:1.2rem;color:var(--ac)"></i>
                    <input type="text" id="r_icon" value="<%= r.icon || '' %>" placeholder="fa-shield-halved" oninput="updateIconPreview()" style="flex:1" <%= r.name === 'owner' ? 'disabled' : '' %>>
                  </div>
                </div>
                <div class="form-group">
                  <label>الإيموجي</label>
                  <div style="display:flex;gap:6px;align-items:center">
                    <span id="emojiPreview" style="font-size:1.3rem"><%= r.emoji || '' %></span>
                    <input type="text" id="r_emoji" value="<%= r.emoji || '' %>" placeholder="🎯" maxlength="10" oninput="updatePreview()" style="flex:1" <%= r.name === 'owner' ? 'disabled' : '' %>>
                    <% if (r.name !== 'owner') { %><button class="admin-btn small" onclick="openEmojiPicker()" title="اختر إيموجي"><i class="fas fa-smile"></i></button><% } %>
                  </div>
                </div>
                <div class="form-group" style="grid-column:1/-1">
                  <label>الوصف</label>
                  <input type="text" id="r_description" value="<%= r.description || '' %>" placeholder="وصف الرتبة..." <%= r.name === 'owner' ? 'disabled' : '' %>>
                </div>
              </div>
            </div>

            <div class="settings-section">
              <h3><i class="fas fa-shield-halved"></i> خيارات الرتبة</h3>
              <div class="toggle-grid">
                <label class="toggle-item"><input type="checkbox" id="r_is_admin" <%= r.is_admin_role ? 'checked' : '' %> <%= r.name === 'owner' ? 'disabled' : '' %>><span class="toggle-switch"></span><span>رتبة إدارية</span></label>
                <label class="toggle-item"><input type="checkbox" id="r_is_protected" <%= r.is_protected ? 'checked' : '' %> <%= r.name === 'owner' ? 'disabled' : '' %>><span class="toggle-switch"></span><span>محمية (لا يمكن حذفها)</span></label>
                <label class="toggle-item"><input type="checkbox" id="r_is_default" <%= r.is_default ? 'checked' : '' %> <%= r.name === 'owner' ? 'disabled' : '' %>><span class="toggle-switch"></span><span>رتبة افتراضية للأعضاء الجدد</span></label>
                <label class="toggle-item"><input type="checkbox" id="r_is_staff" <%= r.is_staff ? 'checked' : '' %> <%= r.name === 'owner' ? 'disabled' : '' %>><span class="toggle-switch"></span><span>Staff (تظهر في قائمة الفريق)</span></label>
                <label class="toggle-item"><input type="checkbox" id="h_can_assign" <%= r.can_assign_roles ? 'checked' : '' %> <%= r.name === 'owner' ? 'disabled' : '' %>><span class="toggle-switch"></span><span>يمكنه تعيين رتب</span></label>
              </div>
            </div>

            <!-- Hierarchy preview -->
            <div class="settings-section">
              <h3><i class="fas fa-sitemap"></i> ترتيب الرتب</h3>
              <div class="hierarchy-tree">
                <% if (typeof roles !== 'undefined' && roles) { %>
                  <% roles.forEach(function(role, idx) { %>
                    <div class="tree-node" style="padding-left:<%= idx * 20 %>px">
                      <div class="tree-dot" style="background:<%= role.color %>"></div>
                      <span class="tree-name"><% if (role.emoji) { %><%= role.emoji %> <% } %><%= role.display_name || role.name %>
                        <% if (role.name === 'owner') { %><i class="fas fa-crown" style="color:#f59e0b;font-size:0.7rem;margin-right:4px"></i><% } %>
                      </span>
                      <% if (role.id === r.id) { %><span class="badge-current">حالي</span><% } %>
                      <% if (role.name === 'owner') { %><span class="badge-owner-sm">محمية</span><% } %>
                    </div>
                  <% }); %>
                <% } %>
              </div>
            </div>

            <!-- Members -->
            <div class="settings-section">
              <h3><i class="fas fa-users"></i> الأعضاء بهذه الرتبة</h3>
              <div id="roleMembersList"><p style="color:rgba(255,255,255,0.4)">جاري التحميل...</p></div>
              <div style="margin-top:1rem;padding-top:1rem;border-top:1px solid rgba(255,255,255,0.05);display:flex;gap:0.5rem">
                <input type="text" id="assignUserId" placeholder="ID المستخدم" style="flex:1;padding:8px 12px;background:rgba(255,255,255,0.05);border:1px solid rgba(var(--ac-rgb),0.2);border-radius:8px;color:#fff;font-family:inherit">
                <input type="text" id="assignReason" placeholder="السبب" style="flex:2;padding:8px 12px;background:rgba(255,255,255,0.05);border:1px solid rgba(var(--ac-rgb),0.2);border-radius:8px;color:#fff;font-family:inherit">
                <button class="admin-btn primary small" onclick="assignRole()"><i class="fas fa-user-plus"></i></button>
              </div>
            </div>
          </div>

          <!-- Tab: Pages Access -->
          <div class="tab-content" id="tab-pages-access">
            <div class="settings-section">
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem">
                <h3 style="margin-bottom:0"><i class="fas fa-eye"></i> الصفحات التي يمكن للرتبة رؤيتها</h3>
                <div style="display:flex;gap:8px;align-items:center">
                  <input type="text" id="pageAccessSearch" placeholder="🔍 بحث عن صفحة..." oninput="filterPagesAccess()" style="padding:6px 12px;background:rgba(255,255,255,0.05);border:1px solid rgba(var(--ac-rgb),0.2);border-radius:8px;color:#fff;font-family:inherit;font-size:0.8rem;width:200px">
                  <button class="admin-btn small" onclick="toggleAllPages(true)">تحديد الكل</button>
                  <button class="admin-btn small" onclick="toggleAllPages(false)">إلغاء الكل</button>
                </div>
              </div>
              <p style="color:rgba(255,255,255,0.4);font-size:0.85rem;margin-bottom:1rem">حدد الصفحات التي يمكن لهذه الرتبة الوصول إليها. الصفحات المعطلة لن تظهر في القائمة ولن يمكن الوصول إليها.</p>
              <div id="pagesAccessContainer"></div>
            </div>
          </div>

          <!-- Tab: Admin Permissions -->
          <div class="tab-content" id="tab-admin-perms">
            <div class="settings-section">
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem">
                <h3 style="margin-bottom:0"><i class="fas fa-lock"></i> صلاحيات الإدارة</h3>
                <input type="text" id="adminPermSearch" placeholder="🔍 بحث عن صلاحية..." oninput="filterPerms('admin')" style="padding:6px 12px;background:rgba(255,255,255,0.05);border:1px solid rgba(var(--ac-rgb),0.2);border-radius:8px;color:#fff;font-family:inherit;font-size:0.8rem;width:220px">
              </div>
              <div id="adminPermsContainer"></div>
            </div>
          </div>

          <!-- Tab: Site Permissions -->
          <div class="tab-content" id="tab-site-perms">
            <div class="settings-section">
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem">
                <h3 style="margin-bottom:0"><i class="fas fa-globe"></i> صلاحيات الموقع</h3>
                <input type="text" id="sitePermSearch" placeholder="🔍 بحث عن صلاحية..." oninput="filterPerms('site')" style="padding:6px 12px;background:rgba(255,255,255,0.05);border:1px solid rgba(var(--ac-rgb),0.2);border-radius:8px;color:#fff;font-family:inherit;font-size:0.8rem;width:220px">
              </div>
              <div id="sitePermsContainer"></div>
            </div>
          </div>

          <!-- Tab: Side Roles -->
          <div class="tab-content" id="tab-side-roles">
            <div class="settings-section">
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem">
                <h3 style="margin-bottom:0"><i class="fas fa-tags"></i> الأدوار الجانبية</h3>
                <button class="admin-btn small primary" onclick="openAddSideRole()"><i class="fas fa-plus"></i> دور جديد</button>
              </div>
              <p style="color:rgba(255,255,255,0.4);font-size:0.85rem;margin-bottom:1rem">الأدوار الجانبية هي tags إضافية تُضاف للمستخدمين بجانب رتبتهم الأساسية</p>
              <div id="sideRolesList"></div>
            </div>
          </div>
        </div>
      <% } else { %>
        <div style="text-align:center;padding:4rem;color:rgba(255,255,255,0.3)">
          <i class="fas fa-layer-group" style="font-size:3rem;margin-bottom:1rem;display:block"></i>
          <h2>لا توجد رتب</h2>
          <p>أضف رتبة جديدة للبدء</p>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Add Role Modal -->
<div id="addRoleModal" class="admin-modal" style="display:none">
  <div class="admin-modal-content">
    <div class="admin-modal-header">
      <h3>رتبة جديدة</h3>
      <button class="admin-btn" onclick="closeModal('addRoleModal')"><i class="fas fa-times"></i></button>
    </div>
    <div class="form-grid">
      <div class="form-group"><label>الاسم (إنجليزي)</label><input type="text" id="new_name"></div>
      <div class="form-group"><label>اسم العرض (عربي)</label><input type="text" id="new_display_name"></div>
      <div class="form-group"><label>اللون</label><input type="color" id="new_color" value="#bc13fe"></div>
      <div class="form-group"><label>الأيقونة</label><input type="text" id="new_icon" value="fa-user"></div>
      <div class="form-group"><label>الإيموجي</label><input type="text" id="new_emoji" placeholder="🎯" maxlength="10"></div>
      <div class="form-group" style="grid-column:1/-1"><label>الوصف</label><input type="text" id="new_description" placeholder="وصف الرتبة..."></div>
    </div>
    <div class="admin-modal-footer">
      <button class="admin-btn" onclick="closeModal('addRoleModal')">إلغاء</button>
      <button class="admin-btn primary" onclick="createRole()"><i class="fas fa-plus"></i> إنشاء</button>
    </div>
  </div>
</div>

<!-- Add Side Role Modal -->
<div id="addSideRoleModal" class="admin-modal" style="display:none">
  <div class="admin-modal-content">
    <div class="admin-modal-header">
      <h3>دور جانبي جديد</h3>
      <button class="admin-btn" onclick="closeModal('addSideRoleModal')"><i class="fas fa-times"></i></button>
    </div>
    <div class="form-grid">
      <div class="form-group"><label>الاسم (إنجليزي)</label><input type="text" id="sr_name"></div>
      <div class="form-group"><label>اسم العرض (عربي)</label><input type="text" id="sr_display_name"></div>
      <div class="form-group"><label>اللون</label><input type="color" id="sr_color" value="#bc13fe"></div>
      <div class="form-group"><label>الأيقونة</label><input type="text" id="sr_icon" value="fa-tag"></div>
      <div class="form-group"><label>الإيموجي</label><input type="text" id="sr_emoji" placeholder="🏷️" maxlength="10"></div>
    </div>
    <div class="admin-modal-footer">
      <button class="admin-btn" onclick="closeModal('addSideRoleModal')">إلغاء</button>
      <button class="admin-btn primary" onclick="createSideRole()"><i class="fas fa-plus"></i> إنشاء</button>
    </div>
  </div>
</div>

<!-- Emoji Picker Modal -->
<div id="emojiPickerModal" class="admin-modal" style="display:none">
  <div class="admin-modal-content" style="max-width:360px">
    <div class="admin-modal-header">
      <h3>اختر إيموجي</h3>
      <button class="admin-btn" onclick="closeModal('emojiPickerModal')"><i class="fas fa-times"></i></button>
    </div>
    <div style="display:grid;grid-template-columns:repeat(8,1fr);gap:4px;max-height:300px;overflow-y:auto;padding:0.5rem">
      <% var emojis = ['🎯','👑','⚔️','🛡️','🎮','🏆','⭐','💎','🔥','💜','🎨','🎭','🦊','🐺','🦁','🐉','⚡','🌟','💫','🎪','🎭','🎯','🎲','🧩','🎰','🗿','👤','👥','💬','📝','🔑','🏠','🌍','💎','🗡️','🏹','🔮','🧿','ControlItem','👤','🏆','🎖️','🏅','☮️','☯️','💜','💙','💚','💛','🧡','❤️','🖤','🤍','💜','🏴','🚩','⚜️','🔱','🔯','暹','♒','♓','♈','♉','♊','♋','♌','♍','♎','♏','♐','♑']; %>
      <% emojis.forEach(function(e) { %>
        <button onclick="pickEmoji('<%= e %>')" style="font-size:1.4rem;padding:6px;background:none;border:1px solid rgba(255,255,255,0.06);border-radius:6px;cursor:pointer;transition:all 0.2s" onmouseover="this.style.borderColor='var(--ac)'" onmouseout="this.style.borderColor='rgba(255,255,255,0.06)'"><%= e %></button>
      <% }); %>
    </div>
  </div>
</div>

<style>
.role-tabs{display:flex;gap:0.25rem;margin-bottom:1.5rem;border-bottom:1px solid rgba(var(--ac-rgb),0.1);padding-bottom:0;overflow-x:auto}
.role-tab{padding:10px 18px;background:none;border:none;color:rgba(255,255,255,0.5);font-family:inherit;font-size:0.85rem;font-weight:600;cursor:pointer;border-bottom:2px solid transparent;transition:all 0.3s;white-space:nowrap;display:flex;align-items:center;gap:6px}
.role-tab:hover{color:rgba(255,255,255,0.8)}
.role-tab.active{color:var(--ac);border-bottom-color:var(--ac)}
.tab-content{display:none}.tab-content.active{display:block}
.settings-section{background:rgba(255,255,255,0.02);border:1px solid rgba(var(--ac-rgb),0.1);border-radius:14px;padding:1.5rem;margin-bottom:1.2rem}
.settings-section h3{font-size:1rem;font-weight:800;margin-bottom:1rem;color:var(--ac);display:flex;align-items:center;gap:8px}
.form-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:1rem}
.toggle-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:0.75rem}
.toggle-item{display:flex;align-items:center;gap:10px;padding:10px 14px;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06);border-radius:10px;cursor:pointer;transition:all 0.3s}
.toggle-item:hover{border-color:rgba(var(--ac-rgb),0.3)}
.toggle-item input{display:none}
.toggle-switch{width:36px;height:20px;background:rgba(255,255,255,0.15);border-radius:10px;position:relative;transition:background 0.3s;flex-shrink:0}
.toggle-switch::after{content:'';position:absolute;width:16px;height:16px;background:#fff;border-radius:50%;top:2px;right:2px;transition:transform 0.3s}
.toggle-item input:checked~.toggle-switch{background:var(--ac)}
.toggle-item input:checked~.toggle-switch::after{transform:translateX(-16px)}

/* Role list */
.role-list-item{display:flex;align-items:center;padding:10px 12px;border-radius:10px;cursor:pointer;transition:all 0.3s;border:1px solid transparent;margin-bottom:2px}
.role-list-item:hover{background:rgba(var(--ac-rgb),0.06)}
.role-list-item.selected{background:rgba(var(--ac-rgb),0.1);border-color:rgba(var(--ac-rgb),0.3)}
.role-list-item[draggable="true"]{cursor:grab}
.role-list-item.dragging{opacity:0.5;background:rgba(var(--ac-rgb),0.15)}
.drag-handle{color:rgba(255,255,255,0.2);cursor:grab;font-size:0.8rem}
.drag-handle:hover{color:rgba(255,255,255,0.5)}
.role-delete-btn{opacity:0;transition:opacity 0.3s;background:none;border:none;color:#ef4444;cursor:pointer;padding:4px 8px;border-radius:6px;font-size:0.8rem}
.role-list-item:hover .role-delete-btn{opacity:1}
.role-emoji-badge{margin-left:4px}

/* Permission groups */
.perm-group{background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.06);border-radius:12px;margin-bottom:0.75rem;overflow:hidden}
.perm-group-header{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;cursor:pointer;transition:background 0.2s}
.perm-group-header:hover{background:rgba(255,255,255,0.03)}
.perm-group-header h4{font-size:0.9rem;font-weight:700;display:flex;align-items:center;gap:8px;margin:0;color:rgba(255,255,255,0.8)}
.perm-group-header .group-count{font-size:0.7rem;color:rgba(255,255,255,0.3);background:rgba(255,255,255,0.05);padding:2px 8px;border-radius:10px}
.perm-group-body{padding:0 16px 12px;display:none}
.perm-group.open .perm-group-body{display:block}
.perm-group-arrow{transition:transform 0.3s;color:rgba(255,255,255,0.3)}
.perm-group.open .perm-group-arrow{transform:rotate(90deg)}
.perm-row{display:flex;align-items:center;justify-content:space-between;padding:8px 12px;border-radius:8px;transition:background 0.2s}
.perm-row:hover{background:rgba(255,255,255,0.03)}
.perm-label{font-size:0.85rem;font-weight:600;color:rgba(255,255,255,0.7)}
.perm-desc{font-size:0.75rem;color:rgba(255,255,255,0.3)}
.group-toggle-all{font-size:0.7rem;padding:4px 10px;border-radius:6px;border:1px solid rgba(var(--ac-rgb),0.3);background:rgba(var(--ac-rgb),0.1);color:var(--ac);cursor:pointer;font-family:inherit;font-weight:600;transition:all 0.2s}
.group-toggle-all:hover{background:rgba(var(--ac-rgb),0.2)}

/* Side roles */
.side-role-card{display:flex;align-items:center;gap:12px;padding:12px 16px;background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.06);border-radius:10px;margin-bottom:0.5rem;transition:all 0.3s}
.side-role-card:hover{border-color:rgba(var(--ac-rgb),0.2)}
.side-role-badge{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:6px;font-size:0.8rem;font-weight:700}
.side-role-actions{margin-right:auto;display:flex;gap:6px}

/* Badges */
.badge-admin-sm{padding:1px 5px;background:rgba(239,68,68,0.2);color:#ef4444;border-radius:4px;font-size:0.6rem;font-weight:700;margin-right:4px}
.badge-staff-sm{padding:1px 5px;background:rgba(59,130,246,0.2);color:#3b82f6;border-radius:4px;font-size:0.6rem;font-weight:700;margin-right:4px}
.badge-owner-sm{padding:1px 5px;background:rgba(245,158,11,0.2);color:#f59e0b;border-radius:4px;font-size:0.6rem;font-weight:700;margin-right:4px}
.owner-role{background:rgba(245,158,11,0.05)!important;border:1px solid rgba(245,158,11,0.15)!important}
.badge-current{padding:1px 6px;background:rgba(var(--ac-rgb),0.2);color:var(--ac);border-radius:4px;font-size:0.65rem;font-weight:700}
.hierarchy-tree{display:flex;flex-direction:column;gap:0.25rem}
.tree-node{display:flex;align-items:center;gap:8px;padding:6px 10px;border-radius:8px;transition:background 0.2s}
.tree-node:hover{background:rgba(255,255,255,0.03)}
.tree-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0}
.tree-name{font-weight:600;font-size:0.85rem}
.tree-level{font-size:0.7rem;color:rgba(255,255,255,0.3);margin-right:auto}
.member-item{display:flex;align-items:center;gap:10px;padding:8px 12px;border-radius:10px;transition:background 0.2s}
.member-item:hover{background:rgba(255,255,255,0.03)}
.member-item img{width:32px;height:32px;border-radius:50%}
.member-info{flex:1}.member-name{font-weight:700;font-size:0.85rem}.member-id{font-size:0.7rem;color:rgba(255,255,255,0.3)}
</style>

<script>
const PERMISSION_GROUPS = <%- JSON.stringify(PERMISSION_GROUPS || {}) %>;

const ALL_PAGES = [
  // ══════════════════════════════════════
  // الموقع الرئيسي
