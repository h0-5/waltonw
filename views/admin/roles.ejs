    const res = await fetch('/api/admin/roles', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    const data = await res.json();
    if (data.success) location.reload(); else showConfirm('خطأ', data.error || 'خطأ', '<i class="fas fa-exclamation-circle" style="color:#ef4444"></i>', true);
  } catch(e) { showConfirm('خطأ', 'حدث خطأ', '<i class="fas fa-exclamation-circle" style="color:#ef4444"></i>', true); }
}

async function deleteRole(id) {
  const ok = await showConfirm('حذف', 'هل تريد حذف هذه الرتبة؟', '<i class="fas fa-trash" style="color:#ef4444"></i>', true);
  if (!ok) return;
  try {
    const res = await fetch('/api/admin/roles/' + id, { method: 'DELETE' });
    const data = await res.json();
    if (data.success) location.reload(); else showConfirm('خطأ', data.error || 'خطأ', '<i class="fas fa-exclamation-circle" style="color:#ef4444"></i>', true);
  } catch(e) {}
}

// Drag & drop reorder
let draggedEl = null;
document.addEventListener('dragstart', function(e) {
  const item = e.target.closest('.role-list-item[draggable="true"]');
  if (!item) return;
  draggedEl = item;
  item.classList.add('dragging');
  e.dataTransfer.effectAllowed = 'move';
});
document.addEventListener('dragover', function(e) {
  const item = e.target.closest('.role-list-item');
  if (!item || item === draggedEl) return;
  e.preventDefault();
  item.classList.add('drag-over');
});
document.addEventListener('dragleave', function(e) {
  const item = e.target.closest('.role-list-item');
  if (item) item.classList.remove('drag-over');
});
document.addEventListener('drop', function(e) {
  const item = e.target.closest('.role-list-item');
  if (!item || !draggedEl || item === draggedEl) return;
  e.preventDefault();
  item.classList.remove('drag-over');
  const list = document.getElementById('roleList');
  const items = [...list.children];
  const dragIdx = items.indexOf(draggedEl);
  const dropIdx = items.indexOf(item);
  if (dragIdx < dropIdx) { list.insertBefore(draggedEl, item.nextSibling); } else { list.insertBefore(draggedEl, item); }
  const order = [...list.children].map((el, i) => ({ id: parseInt(el.dataset.id), sort_order: i }));
  fetch('/api/admin/roles/reorder', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ order }) });
});
document.addEventListener('dragend', function(e) {
  if (draggedEl) draggedEl.classList.remove('dragging');
  document.querySelectorAll('.role-list-item').forEach(el => el.classList.remove('drag-over'));
  draggedEl = null;
});

// Search
function filterRoles() {
  const q = document.getElementById('roleSearch').value.toLowerCase();
  document.querySelectorAll('.role-list-item').forEach(el => {
    const name = (el.dataset.name || '').toLowerCase();
    el.style.display = name.includes(q) ? '' : 'none';
  });
}

// Init
if (selectedRoleId) loadMembers(selectedRoleId);
</script>
