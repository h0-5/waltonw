  { id: 'admin_products', name: 'إدارة المنتجات', icon: 'fa-box-open' },
  { id: 'admin_orders', name: 'إدارة الطلبات', icon: 'fa-truck' },
  { id: 'admin_news', name: 'إدارة الأخبار', icon: 'fa-newspaper' },
  { id: 'admin_tickets', name: 'إدارة التذاكر', icon: 'fa-ticket' },
  { id: 'admin_settings', name: 'الإعدادات', icon: 'fa-cog' },
  { id: 'admin_roles', name: 'إدارة الصلاحيات', icon: 'fa-shield-halved' },
  { id: 'admin_logs', name: 'السجلات', icon: 'fa-history' },
  { id: 'admin_discounts', name: 'أكواد الخصم', icon: 'fa-tag' },
  { id: 'admin_rules', name: 'القوانين', icon: 'fa-gavel' },
  { id: 'admin_broadcast', name: 'البث', icon: 'fa-bullhorn' },
  { id: 'admin_banned', name: 'المحظورين', icon: 'fa-ban' },
];

let roles = <%- JSON.stringify(roles || []) %>;
let pagePerms = <%- JSON.stringify(pagePerms || {}) %>;
let elemPerms = <%- JSON.stringify(elemPerms || {}) %>;
let punishData = <%- JSON.stringify(punishData || {}) %>;
let selectedRoleId = roles.length ? roles[0].id : null;

function switchTab(tab) {
  document.querySelectorAll('.role-tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
  event.target.closest('.role-tab').classList.add('active');
  document.getElementById('tab-' + tab).classList.add('active');

  if (tab === 'members' && selectedRoleId) loadMembers(selectedRoleId);
  if (tab === 'pages') renderPagesGrid();
  if (tab === 'elements') loadElemPerms();
  if (tab === 'punishments') loadPunishments();
  if (tab === 'hierarchy') document.getElementById('h_max_assign_level').max = document.getElementById('r_level').value;
}

function renderPagesGrid() {
  const grid = document.getElementById('pagesGrid');
  if (!grid) return;
  const rp = pagePerms[selectedRoleId] || {};
  grid.innerHTML = ALL_PAGES.map(p => {
    const perm = rp[p.id] || {};
    const perms = ['can_view', 'can_create', 'can_edit', 'can_delete', 'can_manage', 'can_export', 'can_broadcast'];
    const labels = { can_view: 'عرض', can_create: 'إنشاء', can_edit: 'تعديل', can_delete: 'حذف', can_manage: 'إدارة', can_export: 'تصدير', can_broadcast: 'بث' };
    return `
      <div class="page-card">
        <h4><i class="fas ${p.icon}"></i> ${p.name}</h4>
        <div class="page-perms">
          ${perms.map(pr => `<span class="perm-chip ${perm[pr] ? 'active' : ''}" data-page="${p.id}" data-perm="${pr}" onclick="togglePagePerm(this)">${labels[pr]}</span>`).join('')}
        </div>
      </div>
    `;
  }).join('');
}

function togglePagePerm(el) {
  el.classList.toggle('active');
}

function loadElemPerms() {
  const ep = elemPerms[selectedRoleId] || {};
  document.querySelectorAll('.element-item input[type=checkbox]').forEach(cb => {
    const key = cb.dataset.page + ':' + cb.dataset.element;
    cb.checked = !!ep[key];
  });
}

function loadPunishments() {
  const p = punishData[selectedRoleId] || {};
  document.getElementById('p_can_ban').checked = !!p.can_ban;
  document.getElementById('p_can_mute').checked = !!p.can_mute;
  document.getElementById('p_can_warn').checked = !!p.can_warn;
  document.getElementById('p_can_kick').checked = !!p.can_kick;
  document.getElementById('p_max_ban_level').value = p.max_ban_level || 0;
}

async function loadMembers(roleId) {
  try {
    const res = await fetch('/api/admin/roles/' + roleId + '/members');
    const data = await res.json();
    const list = document.getElementById('roleMembersList');
    if (data.members && data.members.length) {
      list.innerHTML = data.members.map(m => `
        <div class="member-item">
          <img src="${m.profile_picture || '/images/default-avatar.png'}" alt="">
          <div class="member-info">
            <div class="member-name">${m.username}</div>
            <div class="member-id">#${m.id} • ${m.discord_id || 'N/A'}</div>
          </div>
          <span style="font-size:0.7rem;color:rgba(255,255,255,0.3)">${m.created_at ? new Date(m.created_at).toLocaleDateString('ar-EG') : ''}</span>
        </div>
      `).join('');
    } else {
      list.innerHTML = '<div style="text-align:center;padding:2rem;color:rgba(255,255,255,0.3)">لا يوجد أعضاء بهذه الرتبة</div>';
    }
  } catch(e) {}
}

function selectRole(id) {
  selectedRoleId = id;
  document.querySelectorAll('.hierarchy-item').forEach(el => el.classList.toggle('selected', el.dataset.id == id));
  const role = roles.find(r => r.id === id);
  if (!role) return;

  document.getElementById('roleEditor').dataset.roleId = id;
  document.getElementById('r_name').value = role.name;
  document.getElementById('r_display_name').value = role.display_name || '';
  document.getElementById('r_color').value = role.color || '#ffffff';
  document.getElementById('r_icon').value = role.icon || '';
  document.getElementById('r_level').value = role.level;
  document.getElementById('r_description').value = role.description || '';
  document.getElementById('r_is_admin').checked = !!role.is_admin_role;
  document.getElementById('r_is_protected').checked = !!role.is_protected;
  document.getElementById('r_is_default').checked = !!role.is_default;
  document.getElementById('h_can_assign').checked = !!role.can_assign_roles;
  document.getElementById('h_max_assign_level').value = role.max_role_level || 0;

  // Reload current tab content
  const activeTab = document.querySelector('.role-tab.active');
  if (activeTab) {
    const tabName = activeTab.textContent.includes('صفحات') ? 'pages' : activeTab.textContent.includes('عناصر') ? 'elements' : activeTab.textContent.includes('عقوبات') ? 'punishments' : activeTab.textContent.includes('أعضاء') ? 'members' : 'settings';
    if (tabName === 'pages') renderPagesGrid();
    if (tabName === 'elements') loadElemPerms();
    if (tabName === 'punishments') loadPunishments();
    if (tabName === 'members') loadMembers(id);
  }
}

async function saveRole() {
  const id = document.getElementById('roleEditor').dataset.roleId;
  if (!id) return;

  // Gather page permissions
  const pages = {};
  document.querySelectorAll('.perm-chip.active').forEach(chip => {
    const page = chip.dataset.page;
    const perm = chip.dataset.perm;
    if (!pages[page]) pages[page] = {};
    pages[page][perm] = 1;
  });

  // Gather element permissions
  const elements = {};
  document.querySelectorAll('.element-item input:checked').forEach(cb => {
    const key = cb.dataset.page + ':' + cb.dataset.element;
    elements[key] = 1;
  });

  const body = {
    name: document.getElementById('r_name').value,
    display_name: document.getElementById('r_display_name').value,
    color: document.getElementById('r_color').value,
    icon: document.getElementById('r_icon').value,
    level: parseInt(document.getElementById('r_level').value) || 0,
    description: document.getElementById('r_description').value,
    is_admin_role: document.getElementById('r_is_admin').checked ? 1 : 0,
    is_protected: document.getElementById('r_is_protected').checked ? 1 : 0,
    is_default: document.getElementById('r_is_default').checked ? 1 : 0,
    can_assign_roles: document.getElementById('h_can_assign').checked ? 1 : 0,
    max_role_level: parseInt(document.getElementById('h_max_assign_level').value) || 0,
    page_permissions: pages,
    element_permissions: elements,
    punishments: {
      can_ban: document.getElementById('p_can_ban').checked ? 1 : 0,
      can_mute: document.getElementById('p_can_mute').checked ? 1 : 0,
      can_warn: document.getElementById('p_can_warn').checked ? 1 : 0,
      can_kick: document.getElementById('p_can_kick').checked ? 1 : 0,
      max_ban_level: parseInt(document.getElementById('p_max_ban_level').value) || 0,
    }
  };

  try {
    const res = await fetch('/api/admin/roles/' + id, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    const data = await res.json();
    if (data.success) {
      pagePerms[id] = pages;
      elemPerms[id] = {};
      for (const k in elements) elemPerms[id][k] = 1;
      punishData[id] = body.punishments;
      const idx = roles.findIndex(r => r.id == id);
      if (idx >= 0) Object.assign(roles[idx], body);
      showToast('تم الحفظ بنجاح');
    } else showToast(data.error || 'حدث خطأ', true);
  } catch(e) { showToast('حدث خطأ', true); }
}

async function deleteRole(id) {
  if (!confirm('هل أنت متأكد من حذف هذه الرتبة؟')) return;
  try {
    const res = await fetch('/api/admin/roles/' + id, { method: 'DELETE' });
    const data = await res.json();
    if (data.success) location.reload();
    else showToast(data.error || 'حدث خطأ', true);
  } catch(e) { showToast('حدث خطأ', true); }
}

async function assignRole() {
  const userId = document.getElementById('assignUserId').value.trim();
  const reason = document.getElementById('assignReason').value.trim();
  if (!userId) return alert('أدخل ID المستخدم');
  try {
    const res = await fetch('/api/admin/roles/' + selectedRoleId + '/assign', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ user_id: parseInt(userId), reason })
    });
    const data = await res.json();
    if (data.success) { loadMembers(selectedRoleId); document.getElementById('assignUserId').value = ''; document.getElementById('assignReason').value = ''; showToast('تم التعيين'); }
    else showToast(data.error || 'حدث خطأ', true);
  } catch(e) { showToast('حدث خطأ', true); }
}

function openAddRole() { document.getElementById('addRoleModal').style.display = 'flex'; }
function closeAddRole() { document.getElementById('addRoleModal').style.display = 'none'; }

async function createRole() {
  const body = {
    name: document.getElementById('new_name').value.trim(),
    display_name: document.getElementById('new_display_name').value.trim(),
    color: document.getElementById('new_color').value,
    icon: document.getElementById('new_icon').value,
    level: parseInt(document.getElementById('new_level').value) || 0,
    description: document.getElementById('new_description').value
  };
  if (!body.name || !body.display_name) return alert('أدخل الأسماء');
  try {
    const res = await fetch('/api/admin/roles', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    const data = await res.json();
    if (data.success) location.reload();
    else showToast(data.error || 'حدث خطأ', true);
  } catch(e) { showToast('حدث خطأ', true); }
}

function showToast(msg, isError) {
  const t = document.createElement('div');
  t.style.cssText = 'position:fixed;bottom:2rem;left:50%;transform:translateX(-50%);padding:12px 24px;background:' + (isError ? '#ef4444' : '#22c55e') + ';color:#fff;border-radius:10px;font-weight:700;z-index:9999;font-size:0.9rem';
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(() => t.remove(), 3000);
}
</script>
