  { id: 'community', name: 'المجتمع', icon: 'fa-comments' },
  { id: 'applications', name: 'الطلبات', icon: 'fa-file-alt' },
  { id: 'support', name: 'الدعم الفني', icon: 'fa-headset' },
  { id: 'profile', name: 'الملف الشخصي', icon: 'fa-user' },
  { id: 'cart', name: 'السلة', icon: 'fa-shopping-cart' },
  { id: 'orders', name: 'الطلبات', icon: 'fa-box' },
  { id: 'checkout', name: 'الدفع', icon: 'fa-credit-card' },
