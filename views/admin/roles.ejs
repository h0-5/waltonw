<%- include('layout') %>

<div class="admin-content">
  <div style="display:flex;gap:1.5rem;min-height:80vh">
    <!-- Sidebar: Role Hierarchy -->
    <div style="width:280px;flex-shrink:0;background:rgba(12,8,22,0.6);border:1px solid rgba(var(--ac-rgb),0.15);border-radius:16px;padding:1.2rem;overflow-y:auto;max-height:85vh">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem">
        <h3 style="font-size:1rem;font-weight:800;color:var(--ac)"><i class="fas fa-layer-group"></i> الهرم</h3>
        <button class="admin-btn small primary" onclick="openAddRole()"><i class="fas fa-plus"></i></button>
      </div>

      <div id="roleHierarchy">
        <% if (typeof roles !== 'undefined' && roles && roles.length) { %>
          <% roles.sort((a,b) => b.level - a.level).forEach(function(r, i) { %>
            <div class="hierarchy-item <%= i === 0 ? 'selected' : '' %>" onclick="selectRole(<%= r.id %>)" data-id="<%= r.id %>">
              <div class="hierarchy-level" style="margin-right:<%= i * 12 %>px">
                <div class="hierarchy-dot" style="background:<%= r.color %>"></div>
                <div class="hierarchy-info">
                  <div class="hierarchy-name"><%= r.display_name || r.name %></div>
                  <div class="hierarchy-meta">
                    <span>Lv.<%= r.level %></span>
                    <% if (r.is_admin_role) { %><span class="badge-admin">admin</span><% } %>
                    <% if (r.is_protected) { %><span class="badge-protected"><i class="fas fa-lock"></i></span><% } %>
                  </div>
                </div>
              </div>
              <% if (!r.is_default && !r.is_protected) { %>
                <button class="hierarchy-delete" onclick="event.stopPropagation();deleteRole(<%= r.id %>)"><i class="fas fa-trash"></i></button>
              <% } %>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>

    <!-- Main: Role Editor -->
    <div style="flex:1;overflow-y:auto;max-height:85vh" id="roleEditorPanel">
      <% if (typeof roles !== 'undefined' && roles && roles.length) { %>
        <% var r = roles[0]; %>
        <div id="roleEditor" data-role-id="<%= r.id %>">
          <!-- Header -->
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem;padding-bottom:1rem;border-bottom:1px solid rgba(var(--ac-rgb),0.1)">
            <div style="display:flex;align-items:center;gap:12px">
              <div style="width:40px;height:40px;border-radius:50%;background:<%= r.color %>"></div>
              <div>
                <h2 style="font-size:1.3rem;font-weight:900"><%= r.display_name || r.name %></h2>
                <span style="font-size:0.8rem;color:rgba(255,255,255,0.4)">Level <%= r.level %> • <%= r.name %></span>
              </div>
            </div>
            <button class="admin-btn primary" onclick="saveRole()"><i class="fas fa-save"></i> حفظ</button>
          </div>

          <!-- Tabs -->
          <div class="role-tabs">
            <button class="role-tab active" onclick="switchTab('settings')"><i class="fas fa-gear"></i> الإعدادات</button>
            <button class="role-tab" onclick="switchTab('pages')"><i class="fas fa-file"></i> صفحات</button>
            <button class="role-tab" onclick="switchTab('elements')"><i class="fas fa-puzzle-piece"></i> عناصر</button>
            <button class="role-tab" onclick="switchTab('punishments')"><i class="fas fa-gavel"></i> عقوبات</button>
            <button class="role-tab" onclick="switchTab('hierarchy')"><i class="fas fa-sitemap"></i> الهرم</button>
            <button class="role-tab" onclick="switchTab('members')"><i class="fas fa-users"></i> الأعضاء</button>
          </div>

          <!-- Settings Tab -->
          <div class="tab-content active" id="tab-settings">
            <div class="settings-section">
              <h3><i class="fas fa-info-circle"></i> معلومات الرتبة</h3>
              <div class="form-grid">
                <div class="form-group">
                  <label>اسم الرتبة (إنجليزي)</label>
                  <input type="text" id="r_name" value="<%= r.name %>">
                </div>
                <div class="form-group">
                  <label>اسم العرض (عربي)</label>
                  <input type="text" id="r_display_name" value="<%= r.display_name || '' %>">
                </div>
                <div class="form-group">
                  <label>اللون</label>
                  <input type="color" id="r_color" value="<%= r.color || '#ffffff' %>">
                </div>
                <div class="form-group">
                  <label>الأيقونة (Font Awesome)</label>
                  <input type="text" id="r_icon" value="<%= r.icon || '' %>" placeholder="fa-shield-halved">
                </div>
                <div class="form-group">
                  <label>المستوى (0-100، الأعلى = أقوى)</label>
                  <input type="number" id="r_level" value="<%= r.level %>" min="0" max="100">
                </div>
                <div class="form-group" style="grid-column:1/-1">
                  <label>الوصف</label>
                  <input type="text" id="r_description" value="<%= r.description || '' %>" placeholder="وصف الرتبة...">
                </div>
              </div>
            </div>

            <div class="settings-section">
              <h3><i class="fas fa-shield-halved"></i> خيارات الرتبة</h3>
              <div class="toggle-grid">
                <label class="toggle-item">
                  <input type="checkbox" id="r_is_admin" <%= r.is_admin_role ? 'checked' : '' %>>
                  <span class="toggle-switch"></span>
                  <span>رتبة إدارية</span>
                </label>
                <label class="toggle-item">
                  <input type="checkbox" id="r_is_protected" <%= r.is_protected ? 'checked' : '' %>>
                  <span class="toggle-switch"></span>
                  <span>محمية (لا يمكن حذفها)</span>
                </label>
                <label class="toggle-item">
                  <input type="checkbox" id="r_is_default" <%= r.is_default ? 'checked' : '' %>>
                  <span class="toggle-switch"></span>
                  <span>رتبة افتراضية للأعضاء الجدد</span>
                </label>
              </div>
            </div>
          </div>

          <!-- Pages Tab -->
          <div class="tab-content" id="tab-pages">
            <div class="settings-section">
              <h3><i class="fas fa-file"></i> صلاحيات الصفحات</h3>
              <p style="color:rgba(255,255,255,0.4);font-size:0.85rem;margin-bottom:1rem">حدد الصلاحيات التفصيلية لكل صفحة</p>
              <div class="pages-grid" id="pagesGrid"></div>
            </div>
          </div>

          <!-- Elements Tab -->
          <div class="tab-content" id="tab-elements">
            <div class="settings-section">
              <h3><i class="fas fa-puzzle-piece"></i> صلاحيات العناصر</h3>
              <p style="color:rgba(255,255,255,0.4);font-size:0.85rem;margin-bottom:1rem">تحكم دقيق في الأزرار والقسمات والµโคمنتس</p>

              <div class="element-section">
                <h4><i class="fas fa-tachometer-alt"></i> لوحة التحكم</h4>
                <div class="elements-list">
                  <label class="element-item"><input type="checkbox" data-page="admin" data-element="dashboard_view" checked><span>عرض لوحة التحكم</span></label>
                  <label class="element-item"><input type="checkbox" data-page="admin" data-element="users_manage"><span>إدارة المستخدمين</span></label>
                  <label class="element-item"><input type="checkbox" data-page="admin" data-element="products_manage"><span>إدارة المنتجات</span></label>
                  <label class="element-item"><input type="checkbox" data-page="admin" data-element="orders_manage"><span>إدارة الطلبات</span></label>
                  <label class="element-item"><input type="checkbox" data-page="admin" data-element="news_manage"><span>إدارة الأخبار</span></label>
                  <label class="element-item"><input type="checkbox" data-page="admin" data-element="tickets_manage"><span>إدارة التذاكر</span></label>
                  <label class="element-item"><input type="checkbox" data-page="admin" data-element="settings_manage"><span>إدارة الإعدادات</span></label>
                  <label class="element-item"><input type="checkbox" data-page="admin" data-element="roles_manage"><span>إدارة الرتب</span></label>
                  <label class="element-item"><input type="checkbox" data-page="admin" data-element="logs_view"><span>عرض السجلات</span></label>
                  <label class="element-item"><input type="checkbox" data-page="admin" data-element="broadcast_send"><span>إرسال البث</span></label>
                </div>
              </div>

              <div class="element-section">
                <h4><i class="fas fa-home"></i> الموقع</h4>
                <div class="elements-list">
                  <label class="element-item"><input type="checkbox" data-page="store" data-element="buy"><span>شراء من المتجر</span></label>
                  <label class="element-item"><input type="checkbox" data-page="store" data-element="view_prices"><span>عرض الأسعار</span></label>
                  <label class="element-item"><input type="checkbox" data-page="community" data-element="send_message"><span>إرسال رسائل</span></label>
                  <label class="element-item"><input type="checkbox" data-page="community" data-element="view_chat"><span>عرض الشات</span></label>
                  <label class="element-item"><input type="checkbox" data-page="applications" data-element="submit"><span>تقديم طلب</span></label>
                  <label class="element-item"><input type="checkbox" data-page="support" data-element="submit_ticket"><span>إرسال تذكرة</span></label>
                  <label class="element-item"><input type="checkbox" data-page="profile" data-element="edit"><span>تعديل الملف الشخصي</span></label>
                  <label class="element-item"><input type="checkbox" data-page="games" data-element="play"><span>اللعب</span></label>
                </div>
              </div>
            </div>
          </div>

          <!-- Punishments Tab -->
          <div class="tab-content" id="tab-punishments">
            <div class="settings-section">
              <h3><i class="fas fa-gavel"></i> صلاحيات العقوبات</h3>
              <p style="color:rgba(255,255,255,0.4);font-size:0.85rem;margin-bottom:1rem">ما الذي يمكن لهذه الرتبة فعله مع الأعضاء</p>
              <div class="punish-grid" id="punishGrid">
                <label class="toggle-item">
                  <input type="checkbox" id="p_can_ban">
                  <span class="toggle-switch"></span>
                  <span><i class="fas fa-ban" style="color:#ef4444"></i> حظر</span>
                </label>
                <label class="toggle-item">
                  <input type="checkbox" id="p_can_mute">
                  <span class="toggle-switch"></span>
                  <span><i class="fas fa-microphone-slash" style="color:#f97316"></i> كتم</span>
                </label>
                <label class="toggle-item">
                  <input type="checkbox" id="p_can_warn">
                  <span class="toggle-switch"></span>
                  <span><i class="fas fa-exclamation-triangle" style="color:#eab308"></i> تحذير</span>
                </label>
                <label class="toggle-item">
                  <input type="checkbox" id="p_can_kick">
                  <span class="toggle-switch"></span>
                  <span><i class="fas fa-right-from-bracket" style="color:#22c55e"></i> طرد</span>
                </label>
                <div class="form-group" style="margin-top:1rem">
                  <label>الحد الأقصى لمستوى المحظورين которые يمكن حظرهم</label>
                  <input type="number" id="p_max_ban_level" value="0" min="0" max="100">
                  <small style="color:rgba(255,255,255,0.3)">0 = لا يمكن حظر أحد</small>
                </div>
              </div>
            </div>
          </div>

          <!-- Hierarchy Tab -->
          <div class="tab-content" id="tab-hierarchy">
            <div class="settings-section">
              <h3><i class="fas fa-sitemap"></i> إعدادات الهيكلية</h3>
              <div class="form-grid">
                <label class="toggle-item">
                  <input type="checkbox" id="h_can_assign" <%= r.can_assign_roles ? 'checked' : '' %>>
                  <span class="toggle-switch"></span>
                  <span>يمكنه تعيين رتب لأعضاء آخرين</span>
                </label>
                <div class="form-group" style="margin-top:1rem">
                  <label>أقصى مستوى للرتبة المسموح بتعيينها (0-<%= r.level %>)</label>
                  <input type="number" id="h_max_assign_level" value="<%= r.max_role_level || 0 %>" min="0" max="<%= r.level %>">
                  <small style="color:rgba(255,255,255,0.3)">لا يمكن تعيين رتبة بنفس المستوى أو أعلى</small>
                </div>
              </div>

              <div style="margin-top:1.5rem">
                <h4 style="margin-bottom:0.75rem">هيكل الرتب الحالي</h4>
                <div class="hierarchy-tree" id="hierarchyTree">
                  <% if (typeof roles !== 'undefined' && roles) { %>
                    <% roles.sort((a,b) => b.level - a.level).forEach(function(role, idx) { %>
                      <div class="tree-node" style="padding-left:<%= idx * 20 %>px">
                        <div class="tree-line"></div>
                        <div class="tree-dot" style="background:<%= role.color %>"></div>
                        <span class="tree-name"><%= role.display_name || role.name %></span>
                        <span class="tree-level">Lv.<%= role.level %></span>
                        <% if (role.id === r.id) { %><span class="badge-current">حالي</span><% } %>
                      </div>
                    <% }); %>
                  <% } %>
                </div>
              </div>
            </div>
          </div>

          <!-- Members Tab -->
          <div class="tab-content" id="tab-members">
            <div class="settings-section">
              <h3><i class="fas fa-users"></i> الأعضاء بهذه الرتبة</h3>
              <div id="roleMembersList">
                <p style="color:rgba(255,255,255,0.4)">جاري التحميل...</p>
              </div>
              <div style="margin-top:1rem;padding-top:1rem;border-top:1px solid rgba(255,255,255,0.05)">
                <h4 style="margin-bottom:0.5rem;font-size:0.9rem">تعيين عضو لهذه الرتبة</h4>
                <div style="display:flex;gap:0.5rem">
                  <input type="text" id="assignUserId" placeholder="ID المستخدم" style="flex:1;padding:8px 12px;background:rgba(255,255,255,0.05);border:1px solid rgba(var(--ac-rgb),0.2);border-radius:8px;color:#fff;font-family:inherit">
                  <input type="text" id="assignReason" placeholder="السبب" style="flex:2;padding:8px 12px;background:rgba(255,255,255,0.05);border:1px solid rgba(var(--ac-rgb),0.2);border-radius:8px;color:#fff;font-family:inherit">
                  <button class="admin-btn primary small" onclick="assignRole()"><i class="fas fa-user-plus"></i> تعيين</button>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% } else { %>
        <div style="text-align:center;padding:4rem;color:rgba(255,255,255,0.3)">
          <i class="fas fa-layer-group" style="font-size:3rem;margin-bottom:1rem;display:block"></i>
          <h2>لا توجد رتب</h2>
          <p>أضف رتبة جديدة للبدء</p>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Add Role Modal -->
<div id="addRoleModal" class="admin-modal" style="display:none">
  <div class="admin-modal-content">
    <div class="admin-modal-header">
      <h3>رتبة جديدة</h3>
      <button class="admin-btn" onclick="closeAddRole()"><i class="fas fa-times"></i></button>
    </div>
    <div class="form-grid">
      <div class="form-group"><label>الاسم (إنجليزي)</label><input type="text" id="new_name"></div>
      <div class="form-group"><label>اسم العرض (عربي)</label><input type="text" id="new_display_name"></div>
      <div class="form-group"><label>اللون</label><input type="color" id="new_color" value="#780ecf"></div>
      <div class="form-group"><label>الأيقونة</label><input type="text" id="new_icon" value="fa-user" placeholder="fa-shield-halved"></div>
      <div class="form-group"><label>المستوى (0-100)</label><input type="number" id="new_level" value="0" min="0" max="100"></div>
      <div class="form-group" style="grid-column:1/-1"><label>الوصف</label><input type="text" id="new_description" placeholder="وصف الرتبة..."></div>
    </div>
    <div class="admin-modal-footer">
      <button class="admin-btn" onclick="closeAddRole()">إلغاء</button>
      <button class="admin-btn primary" onclick="createRole()"><i class="fas fa-plus"></i> إنشاء</button>
    </div>
  </div>
</div>

<style>
.role-tabs { display: flex; gap: 0.25rem; margin-bottom: 1.5rem; border-bottom: 1px solid rgba(var(--ac-rgb),0.1); padding-bottom: 0; overflow-x: auto; }
.role-tab { padding: 10px 18px; background: none; border: none; color: rgba(255,255,255,0.5); font-family: inherit; font-size: 0.85rem; font-weight: 600; cursor: pointer; border-bottom: 2px solid transparent; transition: all 0.3s; white-space: nowrap; display: flex; align-items: center; gap: 6px; }
.role-tab:hover { color: rgba(255,255,255,0.8); }
.role-tab.active { color: var(--ac); border-bottom-color: var(--ac); }
.tab-content { display: none; }
.tab-content.active { display: block; }

.settings-section { background: rgba(255,255,255,0.02); border: 1px solid rgba(var(--ac-rgb),0.1); border-radius: 14px; padding: 1.5rem; margin-bottom: 1.2rem; }
.settings-section h3 { font-size: 1rem; font-weight: 800; margin-bottom: 1rem; color: var(--ac); display: flex; align-items: center; gap: 8px; }
.settings-section h4 { font-size: 0.9rem; font-weight: 700; margin-bottom: 0.75rem; color: rgba(255,255,255,0.7); }

.form-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1rem; }
.toggle-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 0.75rem; }
.toggle-item { display: flex; align-items: center; gap: 10px; padding: 10px 14px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); border-radius: 10px; cursor: pointer; transition: all 0.3s; }
.toggle-item:hover { border-color: rgba(var(--ac-rgb),0.3); }
.toggle-item input { display: none; }
.toggle-switch { width: 36px; height: 20px; background: rgba(255,255,255,0.15); border-radius: 10px; position: relative; transition: background 0.3s; flex-shrink: 0; }
.toggle-switch::after { content: ''; position: absolute; width: 16px; height: 16px; background: #fff; border-radius: 50%; top: 2px; right: 2px; transition: transform 0.3s; }
.toggle-item input:checked ~ .toggle-switch { background: var(--ac); }
.toggle-item input:checked ~ .toggle-switch::after { transform: translateX(-16px); }

.pages-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1rem; }
.page-card { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); border-radius: 12px; padding: 1rem; }
.page-card h4 { font-size: 0.9rem; font-weight: 700; margin-bottom: 0.75rem; display: flex; align-items: center; gap: 8px; color: var(--ac); }
.page-perms { display: flex; flex-wrap: wrap; gap: 0.4rem; }
.perm-chip { padding: 4px 10px; border-radius: 6px; font-size: 0.75rem; font-weight: 600; cursor: pointer; border: 1px solid rgba(255,255,255,0.1); background: rgba(255,255,255,0.03); transition: all 0.3s; user-select: none; }
.perm-chip.active { background: rgba(var(--ac-rgb),0.2); border-color: var(--ac); color: var(--ac); }
.perm-chip:hover { border-color: rgba(var(--ac-rgb),0.4); }

.element-section { margin-bottom: 1.5rem; }
.elements-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.5rem; }
.element-item { display: flex; align-items: center; gap: 8px; padding: 8px 12px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); border-radius: 8px; cursor: pointer; transition: all 0.3s; font-size: 0.85rem; }
.element-item:hover { border-color: rgba(var(--ac-rgb),0.3); }
.element-item input:checked ~ span { color: var(--ac); font-weight: 600; }

.punish-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 0.75rem; }

.hierarchy-tree { display: flex; flex-direction: column; gap: 0.25rem; }
.tree-node { display: flex; align-items: center; gap: 8px; padding: 6px 10px; border-radius: 8px; transition: background 0.2s; }
.tree-node:hover { background: rgba(255,255,255,0.03); }
.tree-line { width: 20px; height: 1px; background: rgba(255,255,255,0.1); flex-shrink: 0; }
.tree-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
.tree-name { font-weight: 600; font-size: 0.85rem; }
.tree-level { font-size: 0.7rem; color: rgba(255,255,255,0.3); margin-right: auto; }
.badge-admin { padding: 1px 6px; background: rgba(239,68,68,0.2); color: #ef4444; border-radius: 4px; font-size: 0.65rem; font-weight: 700; }
.badge-protected { padding: 1px 6px; background: rgba(234,179,8,0.2); color: #eab308; border-radius: 4px; font-size: 0.65rem; }
.badge-current { padding: 1px 6px; background: rgba(var(--ac-rgb),0.2); color: var(--ac); border-radius: 4px; font-size: 0.65rem; font-weight: 700; }

.hierarchy-item { display: flex; align-items: center; justify-content: space-between; padding: 10px 12px; border-radius: 10px; cursor: pointer; transition: all 0.3s; border: 1px solid transparent; margin-bottom: 2px; }
.hierarchy-item:hover { background: rgba(var(--ac-rgb),0.06); }
.hierarchy-item.selected { background: rgba(var(--ac-rgb),0.1); border-color: rgba(var(--ac-rgb),0.3); }
.hierarchy-level { display: flex; align-items: center; gap: 10px; flex: 1; }
.hierarchy-dot { width: 12px; height: 12px; border-radius: 50%; flex-shrink: 0; }
.hierarchy-name { font-weight: 700; font-size: 0.85rem; }
.hierarchy-meta { display: flex; gap: 4px; align-items: center; font-size: 0.7rem; color: rgba(255,255,255,0.4); }
.hierarchy-delete { opacity: 0; transition: opacity 0.3s; background: none; border: none; color: #ef4444; cursor: pointer; padding: 4px 8px; border-radius: 6px; }
.hierarchy-item:hover .hierarchy-delete { opacity: 1; }

.member-item { display: flex; align-items: center; gap: 10px; padding: 8px 12px; border-radius: 10px; transition: background 0.2s; }
.member-item:hover { background: rgba(255,255,255,0.03); }
.member-item img { width: 32px; height: 32px; border-radius: 50%; }
.member-info { flex: 1; }
.member-name { font-weight: 700; font-size: 0.85rem; }
.member-id { font-size: 0.7rem; color: rgba(255,255,255,0.3); }
</style>

<script>
const ALL_PAGES = [
  { id: 'home', name: 'الرئيسية', icon: 'fa-home' },
  { id: 'about', name: 'من نحن', icon: 'fa-users' },
  { id: 'rules', name: 'القواعد', icon: 'fa-gavel' },
