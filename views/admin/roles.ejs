  { path: '/support', name: 'الدعم الفني', icon: 'fa-headset', category: 'site', desc: 'فتح تذكرة' },
  { path: '/profile', name: 'الملف الشخصي', icon: 'fa-user', category: 'site', desc: 'بروفايل المستخدم' },
  { path: '/cart', name: 'السلة', icon: 'fa-shopping-cart', category: 'site', desc: 'سلة المشتريات' },
  { path: '/checkout', name: 'إتمام الشراء', icon: 'fa-credit-card', category: 'site', desc: 'صفحة الدفع' },
  { path: '/orders', name: 'طلباتي', icon: 'fa-box', category: 'site', desc: 'سجل الطلبات' },
  { path: '/my_discounts', name: 'خصوماتي', icon: 'fa-tag', category: 'site', desc: 'أكواد الخصم' },
  { path: '/contact', name: 'تواصل معنا', icon: 'fa-envelope', category: 'site', desc: 'معلومات التواصل' },
  { path: '/properties', name: 'الممتلكات', icon: 'fa-building', category: 'site', desc: 'الممتلكات والقصور' },
  { path: '/company', name: 'الشركة', icon: 'fa-briefcase', category: 'site', desc: 'معلومات الشركة' },

  // ══════════════════════════════════════
  // الألعاب
  // ══════════════════════════════════════
  { path: '/games/mafia', name: 'مافيا', icon: 'fa-mask', category: 'games', desc: 'لعبة المافيا' },
  { path: '/games/rps', name: 'حجر ورقة مقص', icon: 'fa-hand', category: 'games', desc: 'لعبة الكلاسيكية' },
  { path: '/games/memory', name: 'الذاكرة', icon: 'fa-brain', category: 'games', desc: 'لعبة الذاكرة' },
  { path: '/games/spin_wheel', name: 'عجلة الحظ', icon: 'fa-dharmachakra', category: 'games', desc: 'دورة عجلة الحظ' },
  { path: '/games/impostor', name: 'Impostor', icon: 'fa-user-secret', category: 'games', desc: 'لعبة الانتحال' },
  { path: '/games/trivia', name: 'Trivia', icon: 'fa-question-circle', category: 'games', desc: 'أسئلة معلومات عامة' },
  { path: '/games/uno', name: 'UNO', icon: 'fa-clone', category: 'games', desc: 'لعبة UNO' },
  { path: '/games/math_race', name: 'سباق الحساب', icon: 'fa-calculator', category: 'games', desc: 'تحدي الحساب' },
  { path: '/games/word_scramble', name: 'ترتيب الحروف', icon: 'fa-font', category: 'games', desc: 'ترتيب الحروف' },
  { path: '/games/quick_quiz', name: 'كويز سريع', icon: 'fa-bolt', category: 'games', desc: 'أسئلة سريعة' },
  { path: '/games/find_link', name: 'ابحث عن الرابط', icon: 'fa-link', category: 'games', desc: 'العثور على الرابط' },
  { path: '/games/crossword', name: 'أحجية الكلمات', icon: 'fa-th', category: 'games', desc: ' solve words' },
  { path: '/games/aviator', name: 'Aviator', icon: 'fa-plane', category: 'games', desc: 'لعبة الطائر' },

  // ══════════════════════════════════════
  // لوحة الإدارة
  // ══════════════════════════════════════
  { path: '/admin', name: 'لوحة التحكم', icon: 'fa-tachometer-alt', category: 'admin', desc: 'الصفحة الرئيسية للإدارة' },
  { path: '/admin/users', name: 'إدارة المستخدمين', icon: 'fa-users-cog', category: 'admin', desc: 'عرض وتعديل المستخدمين' },
  { path: '/admin/products', name: 'إدارة المنتجات', icon: 'fa-box-open', category: 'admin', desc: 'إضافة وتعديل المنتجات' },
  { path: '/admin/orders', name: 'إدارة الطلبات', icon: 'fa-truck', category: 'admin', desc: 'متابعة الطلبات' },
  { path: '/admin/news', name: 'إدارة الأخبار', icon: 'fa-newspaper', category: 'admin', desc: 'نشر وتعديل الأخبار' },
  { path: '/admin/tickets', name: 'إدارة التذاكر', icon: 'fa-ticket', category: 'admin', desc: 'الرد على التذاكر' },
  { path: '/admin/applications', name: 'الطلبات المقدمة', icon: 'fa-file-alt', category: 'admin', desc: 'مراجعة التقديمات' },
  { path: '/admin/manage-apps', name: 'إدارة نظام التقديمات', icon: 'fa-sliders-h', category: 'admin', desc: 'إعداد أنواع التقديمات' },
  { path: '/admin/settings', name: 'الإعدادات', icon: 'fa-cog', category: 'admin', desc: 'إعدادات الموقع' },
  { path: '/admin/roles', name: 'إدارة الصلاحيات', icon: 'fa-shield-halved', category: 'admin', desc: 'إدارة الرتب والصلاحيات' },
  { path: '/admin/rules', name: 'إدارة القوانين', icon: 'fa-gavel', category: 'admin', desc: 'إضافة وتعديل القوانين' },
  { path: '/admin/discounts', name: 'أكواد الخصم', icon: 'fa-percentage', category: 'admin', desc: 'إدارة أكواد الخصم' },
  { path: '/admin/banned', name: 'المحظورين', icon: 'fa-ban', category: 'admin', desc: 'قائمة المحظورين' },
  { path: '/admin/broadcast', name: 'البث', icon: 'fa-bullhorn', category: 'admin', desc: 'إرسال إشعارات' },
  { path: '/admin/about', name: 'من نحن (إدارة)', icon: 'fa-info-circle', category: 'admin', desc: 'تعديل صفحة من نحن' },
  { path: '/admin/properties', name: 'إدارة الممتلكات', icon: 'fa-building', category: 'admin', desc: 'إضافة وتعديل الممتلكات' },
  { path: '/admin/company', name: 'إدارة الشركة', icon: 'fa-briefcase', category: 'admin', desc: 'إدارة خدمات الشركة' },
  { path: '/admin/logs', name: 'السجلات', icon: 'fa-history', category: 'admin', desc: 'سجل الإجراءات' },
];
let roles = <%- JSON.stringify(roles || []) %>;
let unifiedPerms = <%- JSON.stringify(unifiedPerms || {}) %>;
let sideRoles = <%- JSON.stringify(sideRoles || []) %>;
let pageAccess = <%- JSON.stringify(pageAccess || {}) %>;
let selectedRoleId = roles.length ? roles[0].id : null;
let permState = {}; // { roleId: { perm_key: 1/0 } }

// Initialize permState from server data
roles.forEach(r => {
  permState[r.id] = {};
  const saved = unifiedPerms[r.id] || {};
  // If role has no permissions saved, default owner/admin to all enabled
  if (Object.keys(saved).length === 0 && r.is_admin_role) {
    for (const [gKey, group] of Object.entries(PERMISSION_GROUPS)) {
      for (const pKey of Object.keys(group.permissions)) {
        permState[r.id][pKey] = 1;
      }
    }
  } else {
    permState[r.id] = { ...saved };
  }
});

// Tab switching
function switchTab(tab) {
  document.querySelectorAll('.role-tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
  event.target.closest('.role-tab').classList.add('active');
  document.getElementById('tab-' + tab).classList.add('active');
  if (tab === 'pages-access') renderPagesAccess();
  if (tab === 'admin-perms') renderPermGroup('admin');
  if (tab === 'site-perms') renderPermGroup('site');
  if (tab === 'side-roles') renderSideRoles();
  if (tab === 'roles' && selectedRoleId) loadMembers(selectedRoleId);
}

// ══════════════════════════════════════
// Pages Access
// ══════════════════════════════════════
function renderPagesAccess() {
  const container = document.getElementById('pagesAccessContainer');
  if (!container) return;
  const state = pageAccess[selectedRoleId] || {};

  const categories = {
    site: { label: 'الموقع الرئيسي', icon: 'fa-globe', color: '#3b82f6' },
    games: { label: 'الألعاب', icon: 'fa-gamepad', color: '#a855f7' },
    admin: { label: 'لوحة الإدارة', icon: 'fa-cog', color: '#ef4444' },
  };

  let html = '';
  for (const [catKey, cat] of Object.entries(categories)) {
    const pages = ALL_PAGES.filter(p => p.category === catKey);
    const enabledCount = pages.filter(p => state[p.path] !== 0).length;

    html += `<div class="perm-group" data-cat="${catKey}">
      <div class="perm-group-header" onclick="togglePageCat('${catKey}')">
        <h4><i class="fas ${cat.icon}" style="color:${cat.color}"></i> ${cat.label} <span class="group-count">${enabledCount}/${pages.length}</span></h4>
        <div style="display:flex;align-items:center;gap:8px">
          <button class="group-toggle-all" onclick="event.stopPropagation();toggleAllPagesCat('${catKey}',true)">تحديد الكل</button>
          <button class="group-toggle-all" onclick="event.stopPropagation();toggleAllPagesCat('${catKey}',false)" style="border-color:rgba(239,68,68,0.3);background:rgba(239,68,68,0.1);color:#ef4444">إلغاء الكل</button>
          <i class="fas fa-chevron-right perm-group-arrow"></i>
        </div>
      </div>
      <div class="perm-group-body">
        ${pages.map(p => {
          const isEnabled = state[p.path] !== 0;
          return `<div class="perm-row page-access-row" data-path="${p.path}" data-search="${p.name} ${p.desc} ${p.path}">
            <div style="display:flex;align-items:center;gap:10px;flex:1">
              <i class="fas ${p.icon}" style="width:20px;text-align:center;color:${isEnabled ? cat.color : 'rgba(255,255,255,0.2)'};font-size:0.9rem"></i>
              <div>
                <div class="perm-label">${p.name}</div>
                <div class="perm-desc">${p.desc} <code style="font-size:0.65rem;opacity:0.5">${p.path}</code></div>
              </div>
            </div>
            <label class="toggle-item" style="margin:0;padding:6px 10px;border:none;background:none">
              <input type="checkbox" ${isEnabled ? 'checked' : ''} onchange="togglePageAccess('${p.path}',this.checked)">
              <span class="toggle-switch"></span>
            </label>
          </div>`;
        }).join('')}
      </div>
    </div>`;
  }
  container.innerHTML = html;
}

function togglePageCat(catKey) {
  const el = document.querySelector(`.perm-group[data-cat="${catKey}"]`);
  if (el) el.classList.toggle('open');
}

function togglePageAccess(path, enabled) {
  if (!pageAccess[selectedRoleId]) pageAccess[selectedRoleId] = {};
  pageAccess[selectedRoleId][path] = enabled ? 1 : 0;
  // Update count
  const cat = ALL_PAGES.find(p => p.path === path)?.category;
  if (cat) {
    const pages = ALL_PAGES.filter(p => p.category === cat);
    const state = pageAccess[selectedRoleId];
    const count = pages.filter(p => state[p.path] !== 0).length;
    const el = document.querySelector(`.perm-group[data-cat="${cat}"] .group-count`);
    if (el) el.textContent = count + '/' + pages.length;
  }
}

function toggleAllPagesCat(catKey, enabled) {
  if (!pageAccess[selectedRoleId]) pageAccess[selectedRoleId] = {};
  ALL_PAGES.filter(p => p.category === catKey).forEach(p => {
    pageAccess[selectedRoleId][p.path] = enabled ? 1 : 0;
  });
  renderPagesAccess();
}

function toggleAllPages(enabled) {
  if (!pageAccess[selectedRoleId]) pageAccess[selectedRoleId] = {};
  ALL_PAGES.forEach(p => {
    pageAccess[selectedRoleId][p.path] = enabled ? 1 : 0;
  });
  renderPagesAccess();
}

function filterPagesAccess() {
  const q = document.getElementById('pageAccessSearch')?.value?.toLowerCase() || '';
  document.querySelectorAll('.page-access-row').forEach(row => {
    const search = (row.dataset.search || '').toLowerCase() + (row.dataset.path || '').toLowerCase();
    row.style.display = search.includes(q) ? '' : 'none';
  });
  // Show/hide groups based on visible rows
  document.querySelectorAll('.perm-group[data-cat]').forEach(g => {
    const visible = g.querySelectorAll('.page-access-row:not([style*="display: none"])');
    g.style.display = visible.length ? '' : 'none';
  });
}

// ══════════════════════════════════════
// Permission Groups
// ══════════════════════════════════════
function renderPermGroup(type) {
  const container = document.getElementById(type === 'admin' ? 'adminPermsContainer' : 'sitePermsContainer');
  if (!container) return;
  const state = permState[selectedRoleId] || {};
  let html = '';
  for (const [gKey, group] of Object.entries(PERMISSION_GROUPS)) {
    if ((type === 'admin' && !group.is_site) || (type === 'site' && group.is_site)) {
      const permKeys = Object.keys(group.permissions);
      const enabledCount = permKeys.filter(k => state[k]).length;
      html += `<div class="perm-group" data-group="${gKey}">
        <div class="perm-group-header" onclick="toggleGroup('${gKey}')">
          <h4><i class="fas ${group.icon}"></i> ${group.label} <span class="group-count">${enabledCount}/${permKeys.length}</span></h4>
          <div style="display:flex;align-items:center;gap:8px">
            <button class="group-toggle-all" onclick="event.stopPropagation();toggleGroupAll('${gKey}',${type === 'admin' ? 'false' : 'true'})">تحديد الكل</button>
            <i class="fas fa-chevron-right perm-group-arrow"></i>
          </div>
        </div>
        <div class="perm-group-body">
          ${permKeys.map(pKey => {
            const perm = group.permissions[pKey];
            return `<div class="perm-row" data-key="${pKey}">
              <div><div class="perm-label">${perm.label}</div><div class="perm-desc">${perm.desc}</div></div>
              <label class="toggle-item" style="margin:0;padding:6px 10px;border:none;background:none">
                <input type="checkbox" ${state[pKey] ? 'checked' : ''} onchange="togglePerm('${pKey}',this.checked)">
                <span class="toggle-switch"></span>
              </label>
            </div>`;
          }).join('')}
        </div>
      </div>`;
    }
  }
  container.innerHTML = html;
}

function toggleGroup(gKey) {
  const el = document.querySelector(`.perm-group[data-group="${gKey}"]`);
  if (el) el.classList.toggle('open');
}

function toggleGroupAll(gKey) {
  if (!permState[selectedRoleId]) permState[selectedRoleId] = {};
  const group = PERMISSION_GROUPS[gKey];
  if (!group) return;
  const permKeys = Object.keys(group.permissions);
  const allEnabled = permKeys.every(k => permState[selectedRoleId][k]);
  permKeys.forEach(k => { permState[selectedRoleId][k] = allEnabled ? 0 : 1; });
  renderPermGroup(document.getElementById('adminPermsContainer')?.closest('.tab-content')?.id === 'tab-admin-perms' ? 'admin' : 'site');
}

function togglePerm(key, enabled) {
  if (!permState[selectedRoleId]) permState[selectedRoleId] = {};
  permState[selectedRoleId][key] = enabled ? 1 : 0;
  // Update group count
  for (const [gKey, group] of Object.entries(PERMISSION_GROUPS)) {
    if (group.permissions[key]) {
      const el = document.querySelector(`.perm-group[data-group="${gKey}"] .group-count`);
      if (el) {
        const permKeys = Object.keys(group.permissions);
        const count = permKeys.filter(k => permState[selectedRoleId][k]).length;
        el.textContent = count + '/' + permKeys.length;
      }
      break;
    }
  }
}

function filterPerms(type) {
  const searchId = type === 'admin' ? 'adminPermSearch' : 'sitePermSearch';
  const q = document.getElementById(searchId)?.value?.toLowerCase() || '';
  const container = document.getElementById(type === 'admin' ? 'adminPermsContainer' : 'sitePermsContainer');
  container.querySelectorAll('.perm-row').forEach(row => {
    const text = row.textContent.toLowerCase();
    row.style.display = text.includes(q) ? '' : 'none';
  });
  container.querySelectorAll('.perm-group').forEach(g => {
    const visibleRows = g.querySelectorAll('.perm-row:not([style*="display: none"])');
    g.style.display = visibleRows.length ? '' : 'none';
  });
}

// Role selection
function selectRole(id) {
  selectedRoleId = id;
  document.querySelectorAll('.role-list-item').forEach(el => el.classList.toggle('selected', el.dataset.id == id));
  const role = roles.find(r => r.id === id);
  if (!role) return;
  document.getElementById('roleEditor').dataset.roleId = id;
  const isOwner = role.name === 'owner';
  document.getElementById('roleActionsBtns').style.display = isOwner ? 'none' : 'flex';
  document.getElementById('roleActionsLocked').style.display = isOwner ? 'inline-flex' : 'none';
  const ownerBox = document.getElementById('ownerInfoBox');
  if (ownerBox) ownerBox.style.display = isOwner ? 'block' : 'none';
  document.querySelectorAll('#roleEditor input[type="text"], #roleEditor input[type="color"]').forEach(inp => inp.disabled = isOwner);
  document.getElementById('r_name').value = role.name;
  document.getElementById('r_display_name').value = role.display_name || '';
  document.getElementById('r_color').value = role.color || '#ffffff';
  document.getElementById('r_icon').value = role.icon || '';
  document.getElementById('r_emoji').value = role.emoji || '';
  document.getElementById('r_description').value = role.description || '';
  document.getElementById('r_is_admin').checked = !!role.is_admin_role;
  document.getElementById('r_is_protected').checked = !!role.is_protected;
  document.getElementById('r_is_default').checked = !!role.is_default;
  document.getElementById('r_is_staff').checked = !!role.is_staff;
  document.getElementById('h_can_assign').checked = !!role.can_assign_roles;
  updatePreview();
  // Re-render current tab
  const activeTab = document.querySelector('.role-tab.active')?.textContent || '';
  if (activeTab.includes('الصفحات')) renderPagesAccess();
  else if (activeTab.includes('الإدارة')) renderPermGroup('admin');
  else if (activeTab.includes('الموقع')) renderPermGroup('site');
  else if (activeTab.includes('الجانبية')) renderSideRoles();
  else if (activeTab.includes('الأعضاء')) loadMembers(id);
}

function updatePreview() {
  const color = document.getElementById('r_color').value;
  const name = document.getElementById('r_display_name').value || document.getElementById('r_name').value;
  const emoji = document.getElementById('r_emoji').value;
  const icon = document.getElementById('r_icon').value || 'fa-user';
  const badge = document.getElementById('rolePreviewBadge');
  if (badge) {
    badge.style.background = color + '20';
    badge.style.borderColor = color + '40';
    badge.style.color = color;
    badge.innerHTML = (emoji ? '<span>' + emoji + '</span>' : '') + '<i class="fas ' + icon + '"></i> ' + name;
  }
  const emojiPrev = document.getElementById('emojiPreview');
  if (emojiPrev) emojiPrev.textContent = emoji;
}

function updateIconPreview() {
  const icon = document.getElementById('r_icon').value || 'fa-user';
  const prev = document.getElementById('iconPreview');
  if (prev) { prev.className = 'fas ' + icon; }
  updatePreview();
}

// Emoji picker
function openEmojiPicker() { document.getElementById('emojiPickerModal').style.display = 'flex'; }
function pickEmoji(e) {
  document.getElementById('r_emoji').value = e;
  closeModal('emojiPickerModal');
  updatePreview();
}

// Drag & drop reorder
let draggedItem = null;
document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('.role-list-item[draggable]').forEach(item => {
    item.addEventListener('dragstart', e => { draggedItem = item; item.classList.add('dragging'); e.dataTransfer.effectAllowed = 'move'; });
    item.addEventListener('dragend', () => { draggedItem?.classList.remove('dragging'); draggedItem = null; });
    item.addEventListener('dragover', e => { e.preventDefault(); e.dataTransfer.dropEffect = 'move'; });
    item.addEventListener('drop', e => {
      e.preventDefault();
      if (draggedItem && draggedItem !== item) {
        const list = item.parentNode;
        const items = [...list.children];
        const fromIdx = items.indexOf(draggedItem);
        const toIdx = items.indexOf(item);
        if (fromIdx < toIdx) list.insertBefore(draggedItem, item.nextSibling);
        else list.insertBefore(draggedItem, item);
        saveRoleOrder();
      }
    });
  });
});

async function saveRoleOrder() {
  const items = document.querySelectorAll('.role-list-item');
  const order = [];
  items.forEach((item, i) => { order.push({ id: parseInt(item.dataset.id), sort_order: i }); });
  try { await fetch('/api/admin/roles/reorder', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ order }) }); } catch(e) {}
}

function filterRoles() {
  const q = document.getElementById('roleSearch')?.value?.toLowerCase() || '';
  document.querySelectorAll('.role-list-item').forEach(el => {
    el.style.display = (el.dataset.name || '').includes(q) ? '' : 'none';
  });
}

// Members
async function loadMembers(roleId) {
  try {
    const res = await fetch('/api/admin/roles/' + roleId + '/members');
    const data = await res.json();
    const list = document.getElementById('roleMembersList');
    if (!list) return;
    if (data.members?.length) {
      list.innerHTML = data.members.map(m => `<div class="member-item"><img src="${m.profile_picture || '/images/default-avatar.png'}" alt=""><div class="member-info"><div class="member-name">${m.username}</div><div class="member-id">#${m.id}</div></div></div>`).join('');
    } else {
      list.innerHTML = '<div style="text-align:center;padding:1.5rem;color:rgba(255,255,255,0.3)">لا يوجد أعضاء</div>';
    }
  } catch(e) {}
}

async function assignRole() {
  const userId = document.getElementById('assignUserId').value.trim();
  const reason = document.getElementById('assignReason').value.trim();
  if (!userId) return alert('أدخل ID');
  try {
    const res = await fetch('/api/admin/roles/' + selectedRoleId + '/assign', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ user_id: parseInt(userId), reason }) });
    const data = await res.json();
    if (data.success) { loadMembers(selectedRoleId); document.getElementById('assignUserId').value = ''; document.getElementById('assignReason').value = ''; showToast('تم التعيين'); }
    else showToast(data.error || 'خطأ', true);
  } catch(e) { showToast('خطأ', true); }
}

// Side Roles
function renderSideRoles() {
  const container = document.getElementById('sideRolesList');
  if (!container) return;
  if (!sideRoles.length) {
    container.innerHTML = '<div style="text-align:center;padding:2rem;color:rgba(255,255,255,0.3)">لا توجد أدوار جانبية</div>';
    return;
  }
  container.innerHTML = sideRoles.map(sr => `
    <div class="side-role-card" data-id="${sr.id}">
      <div class="side-role-badge" style="background:${sr.color}20;color:${sr.color};border:1px solid ${sr.color}40">
        ${sr.emoji ? '<span>' + sr.emoji + '</span>' : ''}<i class="fas ${sr.icon || 'fa-tag'}"></i> ${sr.display_name}
      </div>
      <span style="font-size:0.75rem;color:rgba(255,255,255,0.3)">${sr.name}</span>
      <div class="side-role-actions">
        <button class="admin-btn small" onclick="editSideRole(${sr.id})" title="تعديل"><i class="fas fa-edit"></i></button>
        <button class="admin-btn small" style="color:#ef4444" onclick="deleteSideRole(${sr.id})" title="حذف"><i class="fas fa-trash"></i></button>
      </div>
    </div>
  `).join('');
}

function openAddSideRole() { document.getElementById('addSideRoleModal').style.display = 'flex'; }

async function createSideRole() {
  const body = {
    name: document.getElementById('sr_name').value.trim(),
    display_name: document.getElementById('sr_display_name').value.trim(),
    color: document.getElementById('sr_color').value,
    icon: document.getElementById('sr_icon').value,
    emoji: document.getElementById('sr_emoji').value
  };
  if (!body.name || !body.display_name) return alert('أدخل الأسماء');
  try {
    const res = await fetch('/api/admin/side-roles', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    const data = await res.json();
    if (data.success) { sideRoles.push(data.sideRole); renderSideRoles(); closeModal('addSideRoleModal'); showToast('تم الإنشاء'); }
    else showToast(data.error || 'خطأ', true);
  } catch(e) { showToast('خطأ', true); }
}

async function deleteSideRole(id) {
  if (!confirm('هل أنت متأكد؟')) return;
  try {
    await fetch('/api/admin/side-roles/' + id, { method: 'DELETE' });
    sideRoles = sideRoles.filter(s => s.id !== id);
    renderSideRoles();
    showToast('تم الحذف');
  } catch(e) { showToast('خطأ', true); }
}

// Save everything
async function saveAll() {
  const id = selectedRoleId;
  if (!id) return;

  const role = roles.find(r => r.id === id);
  if (role && role.name === 'owner') return showToast('لا يمكن تعديل رتبة المالك', true);

  // 1. Save role settings
  const roleBody = {
    name: document.getElementById('r_name').value,
    display_name: document.getElementById('r_display_name').value,
    color: document.getElementById('r_color').value,
    icon: document.getElementById('r_icon').value,
    emoji: document.getElementById('r_emoji').value,
    description: document.getElementById('r_description').value,
    is_admin_role: document.getElementById('r_is_admin').checked ? 1 : 0,
    is_protected: document.getElementById('r_is_protected').checked ? 1 : 0,
    is_default: document.getElementById('r_is_default').checked ? 1 : 0,
    is_staff: document.getElementById('r_is_staff').checked ? 1 : 0,
    can_assign_roles: document.getElementById('h_can_assign').checked ? 1 : 0,
  };

  try {
    const res = await fetch('/api/admin/roles/' + id, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(roleBody) });
    const data = await res.json();
    if (!data.success) { showToast(data.error || 'خطأ في حفظ الرتبة', true); return; }
  } catch(e) { showToast('خطأ', true); return; }

  // 2. Save unified permissions
  try {
    const res = await fetch('/api/admin/roles/' + id + '/all-permissions', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ permissions: permState[id] || {} }) });
    const data = await res.json();
    if (!data.success) { showToast(data.error || 'خطأ في حفظ الصلاحيات', true); return; }
  } catch(e) { showToast('خطأ', true); return; }

  // 3. Save page access
  try {
    const res = await fetch('/api/admin/roles/' + id + '/page-access', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ pages: pageAccess[id] || {} }) });
    const data = await res.json();
    if (!data.success) { showToast(data.error || 'خطأ في حفظ صلاحيات الصفحات', true); return; }
  } catch(e) { showToast('خطأ', true); return; }

  // Update local state
  const idx = roles.findIndex(r => r.id == id);
  if (idx >= 0) Object.assign(roles[idx], roleBody);
  unifiedPerms[id] = { ...permState[id] };

  showToast('تم الحفظ بنجاح');
}

// Reset all permissions for current role
function resetPermissions() {
  if (!confirm('هل أنت متأكد من إعادة تعيين كل الصلاحيات؟')) return;
  const id = selectedRoleId;
  if (!id) return;
  permState[id] = {};
  pageAccess[id] = {};
  // Re-render current tab
  const activeTab = document.querySelector('.role-tab.active')?.textContent || '';
  if (activeTab.includes('الصفحات')) renderPagesAccess();
  else if (activeTab.includes('الإدارة')) renderPermGroup('admin');
  else if (activeTab.includes('الموقع')) renderPermGroup('site');
  showToast('تم إعادة التعيين — اضغط حفظ للتأكيد');
}

// CRUD
async function createRole() {
  const body = {
    name: document.getElementById('new_name').value.trim(),
    display_name: document.getElementById('new_display_name').value.trim(),
    color: document.getElementById('new_color').value,
    icon: document.getElementById('new_icon').value,
    emoji: document.getElementById('new_emoji').value,
    description: document.getElementById('new_description').value
  };
  if (!body.name || !body.display_name) return alert('أدخل الأسماء');
  try {
    const res = await fetch('/api/admin/roles', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    const data = await res.json();
    if (data.success) location.reload();
    else showToast(data.error || 'خطأ', true);
  } catch(e) { showToast('خطأ', true); }
}

async function deleteRole(id) {
  if (!confirm('هل أنت متأكد من حذف هذه الرتبة؟')) return;
  try {
    const res = await fetch('/api/admin/roles/' + id, { method: 'DELETE' });
    const data = await res.json();
    if (data.success) location.reload();
    else showToast(data.error || 'خطأ', true);
  } catch(e) { showToast('خطأ', true); }
}

function openAddRole() { document.getElementById('addRoleModal').style.display = 'flex'; }
function closeModal(id) { document.getElementById(id).style.display = 'none'; }

function showToast(msg, isError) {
  const t = document.createElement('div');
  t.style.cssText = 'position:fixed;bottom:2rem;left:50%;transform:translateX(-50%);padding:12px 24px;background:' + (isError ? '#ef4444' : '#22c55e') + ';color:#fff;border-radius:10px;font-weight:700;z-index:9999;font-size:0.9rem';
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(() => t.remove(), 3000);
}
</script>

