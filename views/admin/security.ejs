<%- include('layout') %>

<div class="admin-content">
  <!-- Status cards -->
  <div class="stats-row" style="margin-bottom:20px">
    <div class="stat-card">
      <div class="stat-icon tickets"><i class="fas fa-ban"></i></div>
      <div class="stat-info">
        <h3><%= sec.blockedNow %></h3>
        <p>IP محظور الآن</p>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon orders"><i class="fas fa-shield-halved"></i></div>
      <div class="stat-info">
        <h3><%= sec.blockedToday %></h3>
        <p>حظر اليوم (هجمات/فيضان)</p>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon products"><i class="fas fa-robot"></i></div>
      <div class="stat-info">
        <h3><%= sec.botVisitsToday %></h3>
        <p>زيارات بوتات اليوم</p>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon users"><i class="fas fa-toggle-on"></i></div>
      <div class="stat-info">
        <h3 style="font-size:16px"><%= !sec.guardCfg.enabled ? 'الدرع مطفي' : (sec.botMode === 'block' ? 'وضع صارم' : (sec.botMode === 'smart' ? 'درع ذكي' : 'مراقبة فقط')) %></h3>
        <p>الوضع: <%= sec.botMode %><%= sec.guardCfg.honeypot ? ' + فخ' : '' %></p>
      </div>
    </div>
  </div>

  <!-- ═══ الدرع الذكي — التحكم الكامل (يُطبّق فوراً بدون إعادة نشر) ═══ -->
  <div class="admin-card" style="margin-bottom:20px">
    <h3><i class="fas fa-robot"></i> الدرع الذكي — الحماية التلقائية ضد البوتات</h3>
    <p style="font-size:11.5px;color:rgba(255,255,255,0.4);margin:6px 0 14px">
      حظر تلقائي ذكي بنسبة خطأ تحت 1%: ما يُحظر إلا المتأكد من أنه بوت. محركات البحث الكبرى (Google/Bing/DuckDuckGo) تمر دائماً،
      ومتصفحات التطبيقات (ديسكورد/واتساب) محسوبة كزوار حقيقيين. كل التغييرات تُطبّق فوراً على السيرفر بدون إعادة تشغيل.
    </p>

    <form id="guardForm" style="display:flex;flex-direction:column;gap:14px">
      <div style="display:flex;gap:14px;flex-wrap:wrap;align-items:flex-end">
        <label style="display:flex;align-items:center;gap:8px;font-size:13px;cursor:pointer">
          <input type="checkbox" id="g_enabled" <%= sec.guardCfg.enabled ? 'checked' : '' %> style="width:16px;height:16px;accent-color:var(--ac)">
          الدرع مُفعّل
        </label>
        <label style="display:flex;align-items:center;gap:8px;font-size:13px;cursor:pointer">
          <input type="checkbox" id="g_honeypot" <%= sec.guardCfg.honeypot ? 'checked' : '' %> style="width:16px;height:16px;accent-color:var(--ac)">
          فخ البوتات (مسارات فخ تُحظر فوراً)
        </label>
        <label style="font-size:12px;color:rgba(255,255,255,0.55)">
          وضع التعامل مع البوتات:
          <select id="g_botMode" style="margin-right:6px;padding:8px 10px;background:rgba(var(--ac-rgb),0.05);border:1px solid var(--border);border-radius:8px;color:var(--text);outline:none">
            <option value="log" <%= sec.botMode === 'log' ? 'selected' : '' %>>مراقبة فقط (تسجيل بلا حظر)</option>
            <option value="smart" <%= sec.botMode === 'smart' ? 'selected' : '' %>>ذكي — يُحظر المتأكد بوت فقط (موصى به)</option>
            <option value="block" <%= sec.botMode === 'block' ? 'selected' : '' %>>صارم — حظر كل بوت</option>
          </select>
        </label>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px">
        <label style="font-size:11px;color:rgba(255,255,255,0.45)">حماية الفيضان (طلب/دقيقة)
          <input type="number" id="g_rateLimit" value="<%= sec.guardCfg.rateLimit %>" min="30" max="5000" style="width:100%;margin-top:4px;padding:9px 10px;background:rgba(var(--ac-rgb),0.05);border:1px solid var(--border);border-radius:8px;color:var(--text);outline:none">
        </label>
        <label style="font-size:11px;color:rgba(255,255,255,0.45)">انفجار لحظي (طلب/10 ثوان)
          <input type="number" id="g_burstLimit" value="<%= sec.guardCfg.burstLimit %>" min="10" max="2000" style="width:100%;margin-top:4px;padding:9px 10px;background:rgba(var(--ac-rgb),0.05);border:1px solid var(--border);border-radius:8px;color:var(--text);outline:none">
        </label>
        <label style="font-size:11px;color:rgba(255,255,255,0.45)">حظر الفيضان (دقيقة)
          <input type="number" id="g_autoBlockMinutes" value="<%= sec.guardCfg.autoBlockMinutes %>" min="5" max="1440" style="width:100%;margin-top:4px;padding:9px 10px;background:rgba(var(--ac-rgb),0.05);border:1px solid var(--border);border-radius:8px;color:var(--text);outline:none">
        </label>
        <label style="font-size:11px;color:rgba(255,255,255,0.45)">حظر الانفجار (دقيقة)
          <input type="number" id="g_burstBlockMinutes" value="<%= sec.guardCfg.burstBlockMinutes %>" min="5" max="1440" style="width:100%;margin-top:4px;padding:9px 10px;background:rgba(var(--ac-rgb),0.05);border:1px solid var(--border);border-radius:8px;color:var(--text);outline:none">
        </label>
        <label style="font-size:11px;color:rgba(255,255,255,0.45)">مسبار 404 (خطأ/دقيقة)
          <input type="number" id="g_probeLimit" value="<%= sec.guardCfg.probeLimit %>" min="5" max="500" style="width:100%;margin-top:4px;padding:9px 10px;background:rgba(var(--ac-rgb),0.05);border:1px solid var(--border);border-radius:8px;color:var(--text);outline:none">
        </label>
        <label style="font-size:11px;color:rgba(255,255,255,0.45)">حظر المسبار (دقيقة)
          <input type="number" id="g_probeBlockMinutes" value="<%= sec.guardCfg.probeBlockMinutes %>" min="5" max="1440" style="width:100%;margin-top:4px;padding:9px 10px;background:rgba(var(--ac-rgb),0.05);border:1px solid var(--border);border-radius:8px;color:var(--text);outline:none">
        </label>
        <label style="font-size:11px;color:rgba(255,255,255,0.45)">حظر الفخ (دقيقة)
          <input type="number" id="g_honeypotBlockMinutes" value="<%= sec.guardCfg.honeypotBlockMinutes %>" min="10" max="1440" style="width:100%;margin-top:4px;padding:9px 10px;background:rgba(var(--ac-rgb),0.05);border:1px solid var(--border);border-radius:8px;color:var(--text);outline:none">
        </label>
      </div>

      <label style="font-size:11px;color:rgba(255,255,255,0.45)">
        القائمة البيضاء (IP واحد بكل سطر — ما تنحظر تلقائياً أبداً):
        <textarea id="g_whitelist" rows="3" placeholder="192.168.1.50" style="width:100%;margin-top:4px;padding:9px 10px;background:rgba(var(--ac-rgb),0.05);border:1px solid var(--border);border-radius:8px;color:var(--text);outline:none;font-family:'Space Grotesk',monospace;font-size:12px;direction:ltr"><%= (sec.guardCfg.whitelist || []).join('\n') %></textarea>
      </label>

      <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
        <button type="submit" class="admin-btn success" id="guardSaveBtn"><i class="fas fa-floppy-disk"></i> حفظ وتفعيل فوري</button>
        <span id="guardMsg" style="font-size:12px;color:rgba(74,222,128,0.9)"></span>
      </div>
    </form>
  </div>

  <div class="admin-grid" style="margin-bottom:20px">
    <!-- Manual block -->
    <div class="admin-card">
      <h3><i class="fas fa-user-lock"></i> حظر IP يدوياً</h3>
      <form method="POST" action="/admin/security/block" style="display:flex;gap:10px;flex-wrap:wrap">
        <input type="text" name="ip" placeholder="مثال: 192.168.1.50" required
               style="flex:1;min-width:160px;padding:10px 12px;background:rgba(var(--ac-rgb),0.05);border:1px solid var(--border);border-radius:10px;color:var(--text);font-family:'Space Grotesk',monospace;outline:none">
        <input type="text" name="reason" placeholder="السبب (اختياري)"
               style="flex:1;min-width:160px;padding:10px 12px;background:rgba(var(--ac-rgb),0.05);border:1px solid var(--border);border-radius:10px;color:var(--text);outline:none">
        <button type="submit" class="admin-btn danger" style="flex:0"><i class="fas fa-ban"></i> حظر دائم</button>
      </form>
      <p style="font-size:11.5px;color:rgba(255,255,255,0.35);margin-top:10px">
        الحظر اليدوي دائم حتى الإزالة. الحظر التلقائي (فيضان/هجوم/فخ) مؤقت ويُظهر سببه بالقائمة أدناه.
      </p>
    </div>

    <!-- Top bots -->
    <div class="admin-card">
      <h3><i class="fas fa-robot"></i> أكثر بوتات تزور الآن <span style="font-size:10px;color:rgba(255,255,255,0.3);font-weight:400">(منذ آخر إقلاع)</span></h3>
      <% if (sec.topBots.length) { %>
        <div style="display:flex;flex-direction:column;gap:8px">
          <% sec.topBots.forEach(function(b) { %>
            <div style="display:flex;justify-content:space-between;gap:10px;align-items:center;background:rgba(var(--ac-rgb),0.05);border-radius:10px;padding:8px 12px">
              <span style="font-family:'Space Grotesk',monospace;font-size:11px;color:rgba(255,255,255,0.6);direction:ltr;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:75%"><%= b[0] %></span>
              <strong style="color:var(--ac);font-size:13px"><%= b[1] %></strong>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div style="text-align:center;padding:1.6rem;color:rgba(255,255,255,0.3)">
          <i class="fas fa-robot" style="font-size:1.4rem;display:block;margin-bottom:0.5rem"></i>
          لا توجد زيارات بوتات مسجلة بعد
        </div>
      <% } %>
    </div>
  </div>

  <!-- Blocked list -->
  <div class="admin-card">
    <h3 style="justify-content:space-between">
      <span><i class="fas fa-list"></i> قائمة المحظورين حالياً (<%= sec.blockedList.length %>)</span>
      <form method="POST" action="/admin/security/clear-expired" style="margin:0">
        <button type="submit" class="admin-btn small"><i class="fas fa-broom"></i> تنظيف المنتهية</button>
      </form>
    </h3>
    <% if (sec.blockedList.length) { %>
      <div class="admin-table-wrapper">
        <table class="admin-table">
          <thead>
            <tr><th>IP</th><th>السبب</th><th>User-Agent</th><th>وقت الحظر</th><th>النوع</th><th>إجراء</th></tr>
          </thead>
          <tbody>
            <% sec.blockedList.forEach(function(b) { %>
              <tr>
                <td style="font-family:'Space Grotesk',monospace;direction:ltr"><%= b.ip %></td>
                <td style="max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= b.reason %></td>
                <td style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;direction:ltr;font-size:11px;color:rgba(255,255,255,0.4)"><%= b.user_agent || '—' %></td>
                <td style="font-size:12px"><%= new Date(String(b.blocked_at).replace(' ', 'T')).toLocaleString('ar-EG') %></td>
                <td>
                  <% if (!b.expires_at) { %>
                    <span class="status-badge status-cancelled">دائم</span>
                  <% } else { %>
                    <span class="status-badge status-processing">مؤقت</span>
                  <% } %>
                </td>
                <td>
                  <form method="POST" action="/admin/security/unblock" style="margin:0">
                    <input type="hidden" name="ip" value="<%= b.ip %>">
                    <button type="submit" class="admin-btn small success"><i class="fas fa-unlock"></i> فك</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div style="text-align:center;padding:2.4rem;color:rgba(255,255,255,0.3)">
        <i class="fas fa-shield-halved" style="font-size:2rem;display:block;margin-bottom:0.6rem;color:rgba(74,222,128,0.5)"></i>
        لا يوجد أي IP محظور حالياً — كل شيء تحت السيطرة ✨
      </div>
    <% } %>
  </div>
</div>

<script>
(function() {
  var form = document.getElementById('guardForm');
  if (!form) return;
  form.addEventListener('submit', function(ev) {
    ev.preventDefault();
    var btn = document.getElementById('guardSaveBtn');
    var msg = document.getElementById('guardMsg');
    btn.disabled = true;
    msg.textContent = 'جاري الحفظ...';
    msg.style.color = 'rgba(255,255,255,0.5)';
    var wl = document.getElementById('g_whitelist').value.split('\n')
      .map(function(s) { return s.trim(); })
      .filter(function(s) { return s.length > 0 && /^[\d.a-fA-F:]+$/.test(s); })
      .slice(0, 50);
    var payload = {
      enabled: document.getElementById('g_enabled').checked,
      honeypot: document.getElementById('g_honeypot').checked,
      botMode: document.getElementById('g_botMode').value,
      rateLimit: +document.getElementById('g_rateLimit').value,
      burstLimit: +document.getElementById('g_burstLimit').value,
      autoBlockMinutes: +document.getElementById('g_autoBlockMinutes').value,
      burstBlockMinutes: +document.getElementById('g_burstBlockMinutes').value,
      probeLimit: +document.getElementById('g_probeLimit').value,
      probeBlockMinutes: +document.getElementById('g_probeBlockMinutes').value,
      honeypotBlockMinutes: +document.getElementById('g_honeypotBlockMinutes').value,
      whitelist: wl
    };
    fetch('/api/admin/security/guard-settings', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    })
    .then(function(r) { return r.json(); })
    .then(function(j) {
      if (j.success) {
        msg.textContent = '✓ تم الحفظ والتفعيل الفوري — الدرع يعمل بالإعدادات الجديدة الآن';
        msg.style.color = 'rgba(74,222,128,0.95)';
        setTimeout(function() { location.reload(); }, 900);
      } else {
        throw new Error(j.error || 'فشل غير معروف');
      }
    })
    .catch(function(e) {
      msg.textContent = '✗ فشل الحفظ: ' + e.message;
      msg.style.color = 'rgba(248,113,113,0.95)';
      btn.disabled = false;
    });
  });
})();
</script>

<style>
.stat-card { animation: fadeIn 0.4s ease both; }
@keyframes fadeIn { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:translateY(0); } }
.admin-card h3 { justify-content: flex-start; }
.admin-card h3 span:first-child { display: flex; align-items: center; gap: 8px; }
@media (max-width: 768px) {
  .admin-card h3 { flex-wrap: wrap; gap: 10px; }
}
</style>

<%- include('admin_footer') %>
