<%- include('layout') %>

<div class="admin-content">
  <div class="admin-header-bar">
    <h2><i class="fas fa-headset"></i> إدارة التذاكر</h2>
    <div class="admin-filters">
      <select id="statusFilter" onchange="filterTickets()" class="admin-select">
        <option value="">الكل</option>
        <option value="open">مفتوحة</option>
        <option value="reviewing">قيد المراجعة</option>
        <option value="replied">تم الرد</option>
        <option value="closed">مغلقة</option>
      </select>
    </div>
  </div>

  <% var canManageCats = typeof perms !== 'undefined' && perms && perms.can_manage_cats; %>
  <% var canBlacklist = typeof perms !== 'undefined' && perms && perms.can_blacklist; %>

  <% if (canManageCats) { %>
  <!-- ═══ إدارة الأقسام — الإدارة تضيف/تحذف أقسام التذاكر ═══ -->
  <div class="admin-card tg-panel">
    <details>
      <summary class="tg-summary"><i class="fas fa-layer-group"></i> إدارة الأقسام
        <span class="tg-count"><%= (typeof categories !== 'undefined' ? categories.length : 0) %> قسم</span>
      </summary>
      <div class="tg-body">
        <div class="tg-addrow">
          <input type="text" id="newCatName" class="admin-input" maxlength="80" placeholder="اسم القسم الجديد">
          <button class="admin-btn primary" onclick="addCategory()"><i class="fas fa-plus"></i> إضافة قسم</button>
        </div>
        <div class="tg-list" id="catsList">
          <% ((typeof categories !== 'undefined' ? categories : []) || []).forEach(function(c) { %>
            <div class="tg-row" data-id="<%= c.id %>">
              <span class="tg-name"><i class="fas fa-folder"></i> <%= c.name %></span>
              <span class="tg-meta"><%= c.tickets_count || 0 %> تذكرة</span>
              <button class="admin-btn danger small" onclick="deleteCategory(<%= c.id %>, '<%= c.name.replace(/'/g, "\\'") %>')" title="حذف القسم"><i class="fas fa-trash"></i></button>
            </div>
          <% }); %>
          <% if (!categories || !categories.length) { %>
            <div class="tg-empty">لا توجد أقسام بعد — أضف أول قسم فوق</div>
          <% } %>
        </div>
      </div>
    </details>
  </div>
  <% } %>

  <% if (canBlacklist) { %>
  <!-- ═══ القائمة السوداء — حظر شامل أو قسم محدد ═══ -->
  <div class="admin-card tg-panel">
    <details>
      <summary class="tg-summary"><i class="fas fa-ban"></i> القائمة السوداء
        <span class="tg-count"><%= (typeof blacklist !== 'undefined' ? blacklist.length : 0) %> محظور</span>
      </summary>
      <div class="tg-body">
        <div class="tg-addrow">
          <input type="text" id="blUsername" class="admin-input" maxlength="64" placeholder="اسم المستخدم">
          <select id="blCategory" class="admin-select">
            <option value="">حظر شامل — كل الأقسام</option>
            <% ((typeof categories !== 'undefined' ? categories : []) || []).forEach(function(c) { %>
              <option value="<%= c.id %>">قسم: <%= c.name %></option>
            <% }); %>
          </select>
          <input type="text" id="blReason" class="admin-input" maxlength="255" placeholder="السبب (اختياري)">
          <button class="admin-btn primary" onclick="addBlacklist()"><i class="fas fa-ban"></i> حظر</button>
        </div>
        <div class="tg-list" id="blList">
          <% ((typeof blacklist !== 'undefined' ? blacklist : []) || []).forEach(function(b) { %>
            <div class="tg-row" data-id="<%= b.id %>">
              <span class="tg-name"><i class="fas fa-user-slash"></i> <%= b.username || ('#' + b.user_id) %></span>
              <span class="tg-meta"><%= b.category_name ? ('قسم: ' + b.category_name) : 'شامل — كل الأقسام' %><%= b.reason ? ' · ' + b.reason : '' %></span>
              <button class="admin-btn danger small" onclick="deleteBlacklist(<%= b.id %>)" title="فك الحظر"><i class="fas fa-unlock"></i></button>
            </div>
          <% }); %>
          <% if (!blacklist || !blacklist.length) { %>
            <div class="tg-empty">لا يوجد أحد بالقائمة السوداء</div>
          <% } %>
        </div>
      </div>
    </details>
  </div>
  <% } %>

  <div class="admin-table-wrapper">
    <table class="admin-table" id="ticketsTable">
      <thead>
        <tr>
          <th>#</th>
          <th>المستخدم</th>
          <th>القسم</th>
          <th>الحالة</th>
          <th>التاريخ</th>
          <th>إجراءات</th>
        </tr>
      </thead>
      <tbody>
        <% if (typeof tickets !== 'undefined' && tickets && tickets.length) { %>
          <% tickets.forEach(function(t) { %>
            <tr data-status="<%= t.status %>">
              <td><strong>#<%= t.id %></strong></td>
              <td>
                <div class="user-cell">
                  <img src="<%= t.user_avatar || '/images/default-avatar.png' %>" alt="" style="width:28px;height:28px;border-radius:50%">
                  <span><%= t.username || t.name || 'مستخدم #' + t.user_id %></span>
                </div>
              </td>
              <td><%= t.category_name || '—' %></td>
              <td>
                <span class="status-badge status-<%= t.status === 'open' ? 'pending' : t.status === 'reviewing' ? 'processing' : t.status === 'replied' ? 'delivered' : 'closed' %>">
                  <% if (t.status === 'open') { %>مفتوحة
                  <% } else if (t.status === 'reviewing') { %>قيد المراجعة
                  <% } else if (t.status === 'replied') { %>تم الرد
                  <% } else { %>مغلقة<% } %>
                </span>
              </td>
              <td><%= new Date(t.created_at).toLocaleDateString('ar-EG') %></td>
              <td>
                <div class="action-btns">
                  <button class="admin-btn small" onclick="viewTicket(<%= t.id %>)"><i class="fas fa-eye"></i></button>
                  <% if (t.status !== 'closed') { %>
                    <button class="admin-btn success small" onclick="closeTicket(<%= t.id %>)"><i class="fas fa-lock"></i></button>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="6" style="text-align:center;padding:3rem;color:rgba(255,255,255,0.3)">
              <i class="fas fa-headset" style="font-size:2rem;margin-bottom:0.5rem;display:block"></i>
              لا توجد تذاكر بعد
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<div id="ticketModal" class="admin-modal" style="display:none">
  <div class="admin-modal-content" style="max-width:700px">
    <div class="admin-modal-header">
      <h3>تذكرة #<span id="ticketId"></span></h3>
      <button class="admin-btn" onclick="closeModal()"><i class="fas fa-times"></i></button>
    </div>
    <div id="ticketBody" style="max-height:400px;overflow-y:auto;padding:1rem;background:rgba(0,0,0,0.2);border-radius:12px;margin-bottom:1rem"></div>

    <!-- تحديث حالة التذكرة: قيد مراجعة / مغلق / إعادة الفتح (للمغلقة وبصلاحيتها) -->
    <div class="form-group" id="statusRow">
      <label><i class="fas fa-flag"></i> تحديث حالة التذكرة</label>
      <div class="tg-addrow">
        <select id="statusSelect" class="admin-select">
          <option value="">— اختر الحالة —</option>
        </select>
        <button class="admin-btn primary" onclick="applyStatus()"><i class="fas fa-check"></i> تطبيق</button>
      </div>
    </div>

    <div class="form-group">
      <label>رد سريع</label>
      <textarea id="replyMessage" rows="3" placeholder="اكتب ردك..."></textarea>
    </div>
    <div class="admin-modal-footer">
      <button class="admin-btn" onclick="closeModal()">إغلاق</button>
      <button class="admin-btn primary" onclick="sendReply()"><i class="fas fa-paper-plane"></i> إرسال الرد</button>
    </div>
  </div>
</div>

<script>
let currentTicketId = null;
let currentTicketStatus = null;

/* أعلام صلاحيات الإداري الحالي — من السيرفر */
const TG_PERMS = {
  review:  <%= JSON.stringify(!!(typeof perms !== 'undefined' && perms && perms.can_review)) %>,
  close:   <%= JSON.stringify(!!(typeof perms !== 'undefined' && perms && perms.can_close)) %>,
  reopen:  <%= JSON.stringify(!!(typeof perms !== 'undefined' && perms && perms.can_reopen)) %>,
  reply:   <%= JSON.stringify(!!(typeof perms !== 'undefined' && perms && perms.can_reply)) %>
};

function filterTickets() {
  const filter = document.getElementById('statusFilter').value;
  document.querySelectorAll('#ticketsTable tbody tr').forEach(row => {
    if (!filter || row.dataset.status === filter) row.style.display = '';
    else row.style.display = 'none';
  });
}

async function viewTicket(id) {
  currentTicketId = id;
  currentTicketStatus = null;
  document.getElementById('ticketId').textContent = id;
  try {
    const res = await fetch('/api/admin/tickets/' + id);
    const data = await res.json();
    if (data.ticket) {
      const t = data.ticket;
      currentTicketStatus = t.status;
      const replies = data.replies || [];
      const images = data.images || [];
      let html = '<div style="margin-bottom:1rem;padding:1rem;background:rgba(255,255,255,0.05);border-radius:10px">';
      html += '<strong>' + esc(t.category_name || 'بدون قسم') + '</strong>';
      html += '<p style="margin-top:0.5rem;color:rgba(255,255,255,0.7)">' + esc(t.message) + '</p>';
      html += '<small style="color:rgba(255,255,255,0.4)">' + new Date(t.created_at).toLocaleString('ar-EG') + '</small>';
      html += '</div>';
      if (images.length) {
        html += '<div style="margin-bottom:1rem"><small style="color:rgba(255,255,255,0.5)">الصور المرفقة (' + images.length + ')</small>';
        html += '<div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:6px">';
        images.forEach(im => {
          html += '<a href="' + esc(im.file_path) + '" target="_blank" rel="noopener">' +
                  '<img src="' + esc(im.file_path) + '" alt="' + esc(im.original_name || '') + '" loading="lazy" ' +
                  'style="width:74px;height:74px;object-fit:cover;border-radius:8px;border:1px solid rgba(255,255,255,0.15)"></a>';
        });
        html += '</div></div>';
      }
      replies.forEach(r => {
        html += '<div style="margin-bottom:0.5rem;padding:0.75rem;background:rgba(' + (r.is_admin ? '188, 19, 254,0.15' : '255,255,255,0.05') + ');border-radius:10px;border-right:3px solid ' + (r.is_admin ? '#bc13fe' : '#3b82f6') + '">';
        html += '<small style="color:rgba(255,255,255,0.5)">' + (r.is_admin ? 'الإدارة' : esc(r.username || 'المستخدم')) + ' - ' + new Date(r.created_at).toLocaleString('ar-EG') + '</small>';
        html += '<p style="margin-top:0.25rem">' + esc(r.message) + '</p>';
        html += '</div>';
      });
      document.getElementById('ticketBody').innerHTML = html;
      buildStatusSelect(t.status);
      document.getElementById('statusRow').style.display = 'flex';
      document.getElementById('ticketModal').style.display = 'flex';
    }
  } catch(e) { alert('حدث خطأ'); }
}

/* بناء خيارات الحالة حسب الصلاحيات وحالة التذكرة:
   قيد المراجعة (tickets_change_status) / مغلق (tickets_close)
   / إعادة الفتح تظهر فقط للتذكرة المغلقة ولمن معه tickets_reopen */
function buildStatusSelect(status) {
  const sel = document.getElementById('statusSelect');
  let opts = '<option value="">— اختر الحالة —</option>';
  const cur = { open: 'مفتوحة', reviewing: 'قيد المراجعة', replied: 'تم الرد', closed: 'مغلقة' }[status] || status;
  opts += '<option value="" disabled>الحالة الحالية: ' + cur + '</option>';
  if (status !== 'closed') {
    if (TG_PERMS.review) opts += '<option value="reviewing">قيد المراجعة</option>';
    if (TG_PERMS.close)  opts += '<option value="closed">مغلق</option>';
  } else if (TG_PERMS.reopen) {
    opts += '<option value="open">إعادة الفتح</option>';
  }
  sel.innerHTML = opts;
}

async function applyStatus() {
  if (!currentTicketId) return;
  const status = document.getElementById('statusSelect').value;
  if (!status) return alert('اختر الحالة أولاً');
  try {
    const res = await fetch('/api/admin/tickets/' + currentTicketId + '/status', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ status })
    });
    const data = await res.json();
    if (data.success) { viewTicket(currentTicketId); }
    else alert(data.error || 'حدث خطأ');
  } catch(e) { alert('حدث خطأ'); }
}

async function sendReply() {
  if (!currentTicketId) return;
  const message = document.getElementById('replyMessage').value.trim();
  if (!message) return alert('اكتب رسالة');

  try {
    const res = await fetch('/api/admin/tickets/' + currentTicketId + '/reply', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ message })
    });
    const data = await res.json();
    if (data.success) {
      document.getElementById('replyMessage').value = '';
      viewTicket(currentTicketId);
    } else alert(data.error || 'حدث خطأ');
  } catch(e) { alert('حدث خطأ'); }
}

async function closeTicket(id) {
  if (!confirm('إغلاق التذكرة؟')) return;
  try {
    const res = await fetch('/api/admin/tickets/' + id + '/close', { method: 'POST' });
    const data = await res.json();
    if (data.success) location.reload();
    else alert(data.error || 'حدث خطأ');
  } catch(e) { alert('حدث خطأ'); }
}

/* ═══ إدارة الأقسام ═══ */
async function addCategory() {
  const name = document.getElementById('newCatName').value.trim();
  if (!name) return alert('اكتب اسم القسم');
  try {
    const res = await fetch('/api/admin/ticket-categories', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name })
    });
    const data = await res.json();
    if (data.success) location.reload();
    else alert(data.error || 'حدث خطأ');
  } catch(e) { alert('حدث خطأ'); }
}

async function deleteCategory(id, name) {
  if (!confirm('حذف قسم «' + name + '»؟ التذاكر المرتبطة تبقى بلا قسم.')) return;
  try {
    const res = await fetch('/api/admin/ticket-categories/' + id + '/delete', { method: 'POST' });
    const data = await res.json();
    if (data.success) location.reload();
    else alert(data.error || 'حدث خطأ');
  } catch(e) { alert('حدث خطأ'); }
}

/* ═══ القائمة السوداء ═══ */
async function addBlacklist() {
  const username = document.getElementById('blUsername').value.trim();
  const category_id = document.getElementById('blCategory').value || null;
  const reason = document.getElementById('blReason').value.trim();
  if (!username) return alert('اكتب اسم المستخدم');
  try {
    const res = await fetch('/api/admin/tickets-blacklist', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ username, category_id, reason })
    });
    const data = await res.json();
    if (data.success) location.reload();
    else alert(data.error || 'حدث خطأ');
  } catch(e) { alert('حدث خطأ'); }
}

async function deleteBlacklist(id) {
  if (!confirm('فك الحظر عن هذا المستخدم؟')) return;
  try {
    const res = await fetch('/api/admin/tickets-blacklist/' + id + '/delete', { method: 'POST' });
    const data = await res.json();
    if (data.success) location.reload();
    else alert(data.error || 'حدث خطأ');
  } catch(e) { alert('حدث خطأ'); }
}

function closeModal() {
  document.getElementById('ticketModal').style.display = 'none';
  currentTicketId = null;
  currentTicketStatus = null;
}
</script>

<%- include('admin_footer') %>
