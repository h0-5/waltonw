<%- include('layout') %>
<script>document.getElementById('pageTitle').textContent = 'المحظورين';</script>

<style>
.banned-topbar{display:flex;align-items:center;gap:12px;margin-bottom:20px;flex-wrap:wrap}
.banned-topbar h2{font-size:18px;font-weight:700;flex:1}
.banned-stats{display:flex;gap:16px;font-size:12px;color:var(--text-dim)}
.banned-stats span{display:flex;align-items:center;gap:4px}
.banned-table{width:100%;border-collapse:separate;border-spacing:0 6px}
.banned-table th{text-align:right;padding:8px 14px;font-size:11px;font-weight:700;color:#ef4444;text-transform:uppercase;letter-spacing:1px;border-bottom:1px solid var(--border)}
.banned-table td{padding:10px 14px;background:var(--bg-card);font-size:13px}
.banned-table tr td:first-child{border-radius:0 var(--radius-sm) var(--radius-sm) 0}
.banned-table tr td:last-child{border-radius:var(--radius-sm) 0 0 var(--radius-sm)}
.banned-table tbody tr:hover td{background:rgba(239,68,68,.06)}
.banned-td-avatar{width:36px;height:36px;border-radius:50%;object-fit:cover;border:2px solid #ef4444}
.banned-td-name{font-weight:700}
.banned-td-email{color:var(--text-dim);font-size:12px}
.banned-td-reason{color:#ef4444;font-size:12px;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.banned-td-date{color:var(--text-dim);font-size:11px;white-space:nowrap}
.banned-td-type{font-size:11px;font-weight:700;padding:2px 8px;border-radius:6px;display:inline-block}
.banned-td-type.permanent{background:rgba(239,68,68,.15);color:#ef4444}
.banned-td-type.temporary{background:rgba(245,158,11,.15);color:#f59e0b}
.banned-td-by{color:var(--text-dim);font-size:12px}
.card-btn{padding:6px 10px;border-radius:6px;border:1px solid var(--border);background:transparent;color:var(--text-dim);cursor:pointer;font-size:11px;transition:all .3s;display:flex;align-items:center;gap:4px}
.card-btn:hover{background:rgba(34,197,94,.1);color:#22c55e;border-color:#22c55e}
.empty-state{text-align:center;padding:60px 20px;color:var(--text-dim)}
.empty-state i{font-size:48px;margin-bottom:16px;display:block;opacity:.5}
</style>

<div class="banned-topbar">
  <h2><i class="fas fa-ban" style="color:#ef4444"></i> المحظورين</h2>
  <div class="banned-stats">
    <span><i class="fas fa-ban" style="color:#ef4444"></i> <span id="bannedCount"><%= banned.length %></span> محظور</span>
    <span><i class="fas fa-clock" style="color:#f59e0b"></i> <%= banned.filter(b => b.ban_type === 'مؤقت').length %> مؤقت</span>
    <span><i class="fas fa-lock" style="color:#ef4444"></i> <%= banned.filter(b => b.ban_type === 'دائم').length %> دائم</span>
  </div>
</div>

<table class="banned-table" id="bannedTable">
  <thead>
    <tr>
      <th>#</th>
      <th>المستخدم</th>
      <th>سبب الحظر</th>
      <th>نوع الحظر</th>
      <th>حظره</th>
      <th>تاريخ الحظر</th>
      <th>ينتهي</th>
      <th>إجراءات</th>
    </tr>
  </thead>
  <tbody>
    <% if (banned.length > 0) { %>
      <% banned.forEach(function(u, i) { %>
      <tr>
        <td style="width:40px;text-align:center"><code style="color:#ef4444;font-size:11px">#<%= u.id %></code></td>
        <td>
          <div style="display:flex;align-items:center;gap:10px">
            <img src="<%= u.profile_picture || '/images/default-avatar.png' %>" class="banned-td-avatar" alt="">
            <div>
              <div class="banned-td-name"><%= u.username %></div>
              <div class="banned-td-email"><%= u.email || '-' %></div>
            </div>
          </div>
        </td>
        <td class="banned-td-reason"><%= u.ban_reason || 'لا يوجد سبب' %></td>
        <td><span class="banned-td-type <%= u.ban_type === 'دائم' ? 'permanent' : 'temporary' %>"><%= u.ban_type %></span></td>
        <td class="banned-td-by"><%= u.banned_by_name || '-' %></td>
        <td class="banned-td-date"><%= u.banned_at ? new Date(u.banned_at).toLocaleDateString('ar-SA', {year:'numeric',month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}) : '-' %></td>
        <td class="banned-td-date"><%= u.banned_until ? new Date(u.banned_until).toLocaleDateString('ar-SA', {year:'numeric',month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}) : 'دائم' %></td>
        <td>
          <button class="card-btn" data-action="unban" data-id="<%= u.id %>"><i class="fas fa-unlock"></i> فك الحظر</button>
        </td>
      </tr>
      <% }); %>
    <% } else { %>
      <tr><td colspan="8"><div class="empty-state"><i class="fas fa-check-circle" style="color:#22c55e"></i><p>لا يوجد محظورين</p></div></td></tr>
    <% } %>
  </tbody>
</table>

<script>
document.getElementById('bannedTable').addEventListener('click', async function(e) {
  const btn = e.target.closest('[data-action]');
  if (!btn) return;
  if (btn.dataset.action === 'unban') {
    if (!confirm('إلغاء حظر هذا المستخدم؟')) return;
    const res = await fetch('/api/admin/users/' + btn.dataset.id + '/unban', { method: 'POST', headers: {'Content-Type':'application/json'} });
    const data = await res.json();
    if (data.success) location.href = '/admin/banned';
    else alert(data.error || 'خطأ');
  }
});
</script>
<%- include('admin_footer') %>
