<%- include('layout') %>

<div class="admin-card" style="margin-bottom:20px">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;flex-wrap:wrap;gap:10px">
    <h3 style="margin:0;border:none;padding:0"><i class="fas fa-scroll"></i> السجلات</h3>
    <div style="display:flex;gap:8px;align-items:center">
      <a href="/admin/logs?cat=admin" class="admin-btn <%= cat === 'admin' ? 'primary' : '' %>"><i class="fas fa-shield-alt"></i> الإدارة</a>
      <a href="/admin/logs?cat=bot" class="admin-btn <%= cat === 'bot' ? 'primary' : '' %>"><i class="fas fa-robot"></i> البوت</a>
      <a href="/admin/logs?cat=products" class="admin-btn <%= cat === 'products' ? 'primary' : '' %>"><i class="fas fa-box"></i> المنتجات</a>
      <a href="/admin/logs?cat=games" class="admin-btn <%= cat === 'games' ? 'primary' : '' %>"><i class="fas fa-gamepad"></i> الألعاب</a>
      <a href="/admin/logs?cat=activity" class="admin-btn <%= cat === 'activity' ? 'primary' : '' %>"><i class="fas fa-clock"></i> النشاط</a>
    </div>
  </div>

  <div style="display:flex;gap:1rem;margin-bottom:1.5rem;flex-wrap:wrap">
    <div style="background:rgba(var(--ac-rgb),.05);border:1px solid rgba(var(--ac-rgb),.12);border-radius:12px;padding:.8rem 1.2rem;flex:1;min-width:120px;text-align:center">
      <div style="font-size:1.5rem;font-weight:900;color:var(--ac)"><%= total %></div>
      <div style="font-size:.7rem;color:var(--text-dim)">إجمالي السجلات</div>
    </div>
    <div style="background:rgba(var(--ac-rgb),.05);border:1px solid rgba(var(--ac-rgb),.12);border-radius:12px;padding:.8rem 1.2rem;flex:1;min-width:120px;text-align:center">
      <div style="font-size:1.5rem;font-weight:900;color:var(--ac)"><%= page %>/<%= totalPages || 1 %></div>
      <div style="font-size:.7rem;color:var(--text-dim)">صفحة</div>
    </div>
  </div>

  <table class="admin-table">
    <thead>
      <tr>
        <% var hdrs = { admin: ['#','المستخدم','الإجراء','النوع','التفاصيل','التاريخ'], bot: ['#','الإجراء','Discord ID','التفاصيل','التاريخ'], products: ['#','المستخدم','الإجراء','المنتج','التفاصيل','التاريخ'], games: ['#','المستخدم','اللعبة','نقاط','XP','التاريخ'], activity: ['#','المستخدم','الإجراء','التفاصيل','التاريخ'] }; var h = hdrs[cat] || hdrs.admin; %>
        <% h.forEach(function(th){ %><th><%= th %></th><% }); %>
      </tr>
    </thead>
    <tbody>
      <% if (!logs || logs.length === 0) { %>
        <tr><td colspan="6" style="text-align:center;padding:2rem;color:var(--text-dim)">لا توجد سجلات</td></tr>
      <% } else { %>
        <% for (var i = 0; i < logs.length; i++) { var log = logs[i]; var idx = (page - 1) * 30 + i + 1; %>
        <tr>
          <td><%= idx %></td>
          <% if (cat === 'admin') { %>
            <td style="font-weight:700;color:#fff"><%= log.username || '-' %></td>
            <td><span class="badge"><%= log.action || '-' %></span></td>
            <td><%= log.target_type || '-' %></td>
            <td style="max-width:250px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="<%= log.details || '' %>"><%= String(log.details || '-').substring(0, 80) %></td>
            <td style="font-size:.7rem;color:var(--text-dim)"><%= log.created_at ? new Date(log.created_at).toLocaleDateString('ar-SA') + ' ' + new Date(log.created_at).toLocaleTimeString('ar-SA', {hour:'2-digit',minute:'2-digit'}) : '-' %></td>
          <% } else if (cat === 'bot') { %>
            <td><span class="badge"><%= log.action || '-' %></span></td>
            <td style="font-family:monospace;font-size:.75rem"><%= log.discord_id || '-' %></td>
            <td style="max-width:250px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= String(log.details || '-').substring(0, 80) %></td>
            <td style="font-size:.7rem;color:var(--text-dim)"><%= log.created_at ? new Date(log.created_at).toLocaleDateString('ar-SA') : '-' %></td>
          <% } else if (cat === 'products') { %>
            <td style="font-weight:700;color:#fff"><%= log.username || '-' %></td>
            <td><span class="badge"><%= log.action || '-' %></span></td>
            <td><%= log.product_name || '-' %></td>
            <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= String(log.details || '-').substring(0, 60) %></td>
            <td style="font-size:.7rem;color:var(--text-dim)"><%= log.created_at ? new Date(log.created_at).toLocaleDateString('ar-SA') : '-' %></td>
          <% } else if (cat === 'games') { %>
            <td style="font-weight:700;color:#fff"><%= log.user_id || '-' %></td>
            <td><span class="badge"><%= log.game_type || '-' %></span></td>
            <td style="color:#22c55e"><%= log.pts_given || 0 %></td>
            <td style="color:#3b82f6"><%= log.xp_given || 0 %></td>
            <td style="font-size:.7rem;color:var(--text-dim)"><%= log.rewarded_at ? new Date(log.rewarded_at).toLocaleDateString('ar-SA') : '-' %></td>
          <% } else if (cat === 'activity') { %>
            <td style="font-weight:700;color:#fff"><%= log.user_id || '-' %></td>
            <td><span class="badge"><%= log.action || '-' %></span></td>
            <td style="max-width:250px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= String(log.details || '-').substring(0, 80) %></td>
            <td style="font-size:.7rem;color:var(--text-dim)"><%= log.created_at ? new Date(log.created_at).toLocaleDateString('ar-SA') : '-' %></td>
          <% } else { %>
            <td colspan="5">-</td>
          <% } %>
        </tr>
        <% } %>
      <% } %>
    </tbody>
  </table>

  <% if (totalPages > 1) { %>
  <div style="display:flex;justify-content:center;gap:6px;margin-top:1.5rem;flex-wrap:wrap">
    <% if (page > 1) { %>
    <a href="/admin/logs?cat=<%= cat %>&page=<%= page - 1 %>" class="admin-btn small">السابق</a>
    <% } %>
    <% for (var p = Math.max(1, page - 2); p <= Math.min(totalPages, page + 2); p++) { %>
    <a href="/admin/logs?cat=<%= cat %>&page=<%= p %>" class="admin-btn small <%= p === page ? 'primary' : '' %>"><%= p %></a>
    <% } %>
    <% if (page < totalPages) { %>
    <a href="/admin/logs?cat=<%= cat %>&page=<%= page + 1 %>" class="admin-btn small">التالي</a>
    <% } %>
  </div>
  <% } %>
</div>

<%- include('admin_footer') %>
