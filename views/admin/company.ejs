<%- include('layout') %>

<% /* صفحة إدارة الشركة — قسمين: معلومات الشركة / إدارة الخدمات (مزارع + خدمات + طلبات) */ %>
<div style="display:flex;gap:10px;margin-bottom:20px;flex-wrap:wrap">
  <button id="admCoTabBtn-info" class="admin-btn primary" onclick="admCoTab('info')" style="padding:.6rem 1.4rem"><i class="fas fa-briefcase"></i> معلومات الشركة</button>
  <button id="admCoTabBtn-services" class="admin-btn" onclick="admCoTab('services')" style="padding:.6rem 1.4rem"><i class="fas fa-concierge-bell"></i> إدارة الخدمات</button>
</div>

<!-- ═══════════ القسم الأول: معلومات الشركة ═══════════ -->
<div id="admCo-info">
<div class="admin-card" style="margin-bottom:20px">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px">
    <h3 style="margin:0;border:none;padding:0"><i class="fas fa-briefcase"></i> عناصر معلومات الشركة</h3>
    <button onclick="showAddItem('info')" class="admin-btn primary"><i class="fas fa-plus"></i> إضافة عنصر معلومات</button>
  </div>
  <table class="admin-table">
    <thead><tr><th>#</th><th>العنوان</th><th>الصورة</th><th>الحالة</th><th>إجراءات</th></tr></thead>
    <tbody>
      <% var infoItems = items.filter(function(i){ return i.category === 'info'; }); %>
      <% if (infoItems.length > 0) { %>
        <% infoItems.forEach(function(item, i) { %>
        <tr>
          <td><%= i + 1 %></td>
          <td><%= item.title %></td>
          <td><% if (item.image) { %><img src="<%= item.image %>" style="width:40px;height:40px;object-fit:cover;border-radius:8px"><% } else { %><span style="color:var(--text-dim)">—</span><% } %></td>
          <td><span class="badge">معلومات</span></td>
          <td style="display:flex;gap:6px">
            <button onclick="showEditItem(<%= item.id %>)" class="admin-btn small"><i class="fas fa-edit"></i></button>
            <button onclick="deleteItem(<%= item.id %>)" class="admin-btn danger small"><i class="fas fa-trash"></i></button>
          </td>
        </tr>
        <% }); %>
      <% } else { %>
        <tr><td colspan="5" style="text-align:center;padding:2rem;color:var(--text-dim)">لا توجد عناصر معلومات</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
</div>

<!-- ═══════════ القسم الثاني: إدارة الخدمات ═══════════ -->
<div id="admCo-services" style="display:none">

<!-- مدير المزارع — إضافة/حذف غير محددة -->
<div class="admin-card" style="margin-bottom:20px">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;flex-wrap:wrap;gap:10px">
    <h3 style="margin:0;border:none;padding:0"><i class="fas fa-warehouse"></i> مزارع الشركة — إضافة وحذف بلا حدود</h3>
  </div>
  <p style="color:var(--text-dim);font-size:.85rem;margin:0 0 14px">أضف أي عدد من المزارع أو احذف — إيقاف التفعيل يمنع الحجز الجديد عليها فقط ولا يمس الحجوزات القائمة. الحذف يُرفض إذا كانت عليها حجز قائم.</p>
  <div id="farmFarmsList" style="display:flex;flex-direction:column;gap:10px;margin-bottom:14px"></div>
  <div style="display:flex;gap:8px;flex-wrap:wrap">
    <input type="text" id="farmNewName" placeholder="اسم المزرعة الجديدة (مثال: المزرعة الشرقية)" style="flex:1;min-width:220px;padding:.6rem .9rem;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.12);border-radius:10px;color:var(--text)">
    <button class="admin-btn primary" onclick="farmAddFarm()"><i class="fas fa-plus"></i> إضافة مزرعة</button>
  </div>
</div>

<div class="admin-card" style="margin-bottom:20px">
  <h3 style="margin-bottom:6px"><i class="fas fa-seedling"></i> خدمة استئجار المزارع — الإعدادات والأسعار</h3>
  <p style="color:var(--text-dim);font-size:.85rem;margin:0 0 16px">الأسعار نص قابل للتعديل من هنا — المدد ثابتة (1/3/5/7/10/14 يوم).</p>
  <div id="farmCfgLoading" style="color:var(--text-dim)">جاري التحميل...</div>
  <form id="farmCfgForm" style="display:none" onsubmit="farmSaveCfg(event)">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:14px">
      <div class="form-group" style="margin:0"><label>سعر 1 يوم</label><input type="number" id="f_price_1d" min="0" style="direction:ltr"></div>
      <div class="form-group" style="margin:0"><label>سعر 3 أيام</label><input type="number" id="f_price_3d" min="0" style="direction:ltr"></div>
      <div class="form-group" style="margin:0"><label>سعر 5 أيام</label><input type="number" id="f_price_5d" min="0" style="direction:ltr"></div>
      <div class="form-group" style="margin:0"><label>سعر 7 أيام</label><input type="number" id="f_price_7d" min="0" style="direction:ltr"></div>
      <div class="form-group" style="margin:0"><label>سعر 10 أيام</label><input type="number" id="f_price_10d" min="0" style="direction:ltr"></div>
      <div class="form-group" style="margin:0"><label>سعر 14 يوم</label><input type="number" id="f_price_14d" min="0" style="direction:ltr"></div>
      <div class="form-group" style="margin:0"><label>سعر اضافة العامل (يدفعه الزبون لكل عامل يضيفه)</label><input type="number" id="f_worker_price" min="0" style="direction:ltr"></div>
      <div class="form-group" style="margin:0"><label>أقصى عدد عمال</label><input type="number" id="f_max_workers" min="0" max="20" style="direction:ltr"></div>
      <div class="form-group" style="margin:0"><label>نسبة العربون %</label><input type="number" id="f_deposit_pct" min="0" max="100" style="direction:ltr"></div>
      <div class="form-group" style="margin:0"><label>مهلة الدفع (ساعات)</label><input type="number" id="f_payment_window_hours" min="1" max="72" style="direction:ltr"></div>
      <div class="form-group" style="margin:0"><label>حد الإلغاء (ساعات قبل البداية)</label><input type="number" id="f_cancel_cutoff_hours" min="0" max="72" style="direction:ltr"></div>
      <div class="form-group" style="margin:0"><label>نافذة التمديد (ساعات قبل النهاية)</label><input type="number" id="f_extend_window_hours" min="1" max="72" style="direction:ltr"></div>
      <div class="form-group" style="margin:0"><label>مهلة النص الثاني (ساعات بعد تأكيد العربون)</label><input type="number" id="f_remainder_window_hours" min="1" max="72" style="direction:ltr"></div>
    </div>
    <div class="form-group"><label>حساب بنك الشركة</label><input type="text" id="f_bank_account" style="direction:ltr;text-align:left"></div>
    <div class="form-group"><label>منشن إشعارات الإدارة — يطلع مع كل حجز جديد / إعلان دفع / طلب خدمة — @here أو &lt;@&amp;ID&gt; رتبة أو &lt;@ID&gt; شخص</label><input type="text" id="f_ping_mention" placeholder="@here" style="direction:ltr;text-align:left"></div>
    <div id="farmWebhookWarn" style="display:none;margin-bottom:14px;padding:.8rem 1rem;border-radius:10px;background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.4);color:#fca5a5;font-size:.85rem;line-height:1.7"><i class="fas fa-triangle-exclamation"></i> <b>ويبهوك الإشعارات غير مضبوط!</b> لا يوجد WH_FARM ولا WH_COMPANY — كل إشعارات الحجز والطلبات راح تنفقد بدون ما توصل ديسكورد. <a href="/admin/bot/notify" style="color:#f0abfc;font-weight:700;text-decoration:underline">روح لإشعارات الديسكورد ← الصق الرابط واحفظ (بدون Railway)</a> أو أضف متغير Railway ثم أعد النشر.</div>
    <button type="submit" class="admin-btn primary"><i class="fas fa-save"></i> حفظ الإعدادات</button>
  </form>
</div>

<div class="admin-card" style="margin-bottom:20px">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
    <h3 style="margin:0;border:none;padding:0"><i class="fas fa-calendar-check"></i> حجوزات المزارع</h3>
    <button class="admin-btn small" onclick="farmLoad()"><i class="fas fa-rotate"></i> تحديث</button>
  </div>
  <div style="overflow-x:auto">
  <table class="admin-table" id="farmBkTable">
    <thead><tr><th>المرجع</th><th>المستأجر</th><th>المزرعة</th><th>المدة</th><th>الإيجار / العربون</th><th>الحالة</th><th>الفاكشن</th><th>البداية / النهاية</th><th>إجراءات</th></tr></thead>
    <tbody><tr><td colspan="9" style="text-align:center;padding:1.5rem;color:var(--text-dim)">جاري التحميل...</td></tr></tbody>
  </table>
  </div>
</div>

<div class="admin-card" style="margin-bottom:20px">
  <h3 style="margin-bottom:14px"><i class="fas fa-users"></i> عمال الحجوزات</h3>
  <div style="overflow-x:auto">
  <table class="admin-table" id="farmWkTable">
    <thead><tr><th>#</th><th>الحجز</th><th>اسم الشخصية</th><th>المبلغ</th><th>الحالة</th><th>إجراءات</th></tr></thead>
    <tbody><tr><td colspan="6" style="text-align:center;padding:1.5rem;color:var(--text-dim)">جاري التحميل...</td></tr></tbody>
  </table>
  </div>
</div>

<!-- خدمات الشركة (عناصر services) -->
<div class="admin-card" style="margin-bottom:20px">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;flex-wrap:wrap;gap:10px">
    <h3 style="margin:0;border:none;padding:0"><i class="fas fa-concierge-bell"></i> خدمات الشركة (بطاقات الصفحة)</h3>
    <button onclick="showAddItem('activities')" class="admin-btn primary"><i class="fas fa-plus"></i> إضافة خدمة جديدة</button>
  </div>
  <table class="admin-table">
    <thead><tr><th>#</th><th>الخدمة</th><th>الحالة</th><th>الأسئلة</th><th>البكجات</th><th>إجراءات</th></tr></thead>
    <tbody>
      <% var svcItems = items.filter(function(i){ return i.category === 'activities'; }); %>
      <% var qCount = {}; questions.forEach(function(q){ qCount[q.service_id] = (qCount[q.service_id]||0)+1; }); %>
      <% var pCount = {}; packages.forEach(function(p){ pCount[p.service_id] = (pCount[p.service_id]||0)+1; }); %>
      <% if (svcItems.length > 0) { %>
        <% svcItems.forEach(function(item, i) { %>
        <tr>
          <td><%= i + 1 %></td>
          <td><%= item.title %></td>
          <td>
            <select onchange="quickStatus(<%= item.id %>, this.value)" style="background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);color:var(--text);border-radius:8px;padding:4px 8px;font-size:.78rem">
              <option value="available" <%= item.service_status === 'available' ? 'selected' : '' %>>متوفر</option>
              <option value="coming_soon" <%= item.service_status === 'coming_soon' ? 'selected' : '' %>>قريباً</option>
              <option value="ended" <%= item.service_status === 'ended' ? 'selected' : '' %>>منتهي</option>
              <option value="" <%= !item.service_status ? 'selected' : '' %>>عنصر عادي (بدون طلبات)</option>
            </select>
          </td>
          <td><span class="badge"><%= qCount[item.id] || 0 %></span></td>
          <td><span class="badge"><%= pCount[item.id] || 0 %></span></td>
          <td style="display:flex;gap:6px">
            <button onclick="showEditItem(<%= item.id %>)" class="admin-btn small"><i class="fas fa-edit"></i></button>
            <button onclick="deleteItem(<%= item.id %>)" class="admin-btn danger small"><i class="fas fa-trash"></i></button>
          </td>
        </tr>
        <% }); %>
      <% } else { %>
        <tr><td colspan="6" style="text-align:center;padding:2rem;color:var(--text-dim)">لا توجد خدمات</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<!-- أسئلة وبكجات الخدمات -->
<div class="admin-card" style="margin-bottom:20px">
  <h3 style="margin-bottom:14px"><i class="fas fa-circle-question"></i> أسئلة وبكجات الخدمات</h3>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:20px">
    <div>
      <div style="display:flex;gap:8px;align-items:center;margin-bottom:10px;flex-wrap:wrap">
        <select id="qSvcSel" onchange="renderQs()" style="flex:1;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);color:var(--text);border-radius:8px;padding:.5rem">
          <% svcItems.forEach(function(item){ %><option value="<%= item.id %>"><%= item.title %></option><% }) %>
        </select>
      </div>
      <div id="qList" style="display:flex;flex-direction:column;gap:8px;margin-bottom:12px"></div>
      <div style="display:flex;gap:6px;flex-wrap:wrap">
        <input type="text" id="qText" placeholder="نص السؤال الجديد" style="flex:1;min-width:140px;padding:.5rem .8rem;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.12);border-radius:8px;color:var(--text)">
        <select id="qType" style="background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);color:var(--text);border-radius:8px;padding:.5rem">
          <option value="text">نص</option>
          <option value="character_name">اسم شخصية</option>
          <option value="image">صورة</option>
        </select>
        <label style="display:flex;align-items:center;gap:5px;font-size:.78rem;color:var(--text-dim);cursor:pointer"><input type="checkbox" id="qRequired"> إلزامي</label>
        <button class="admin-btn primary small" onclick="addQuestion()"><i class="fas fa-plus"></i></button>
      </div>
    </div>
    <div>
      <div style="display:flex;gap:8px;align-items:center;margin-bottom:10px;flex-wrap:wrap">
        <select id="pSvcSel" onchange="renderPs()" style="flex:1;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);color:var(--text);border-radius:8px;padding:.5rem">
          <% svcItems.forEach(function(item){ %><option value="<%= item.id %>"><%= item.title %></option><% }) %>
        </select>
      </div>
      <div id="pList" style="display:flex;flex-direction:column;gap:8px;margin-bottom:12px"></div>
      <div style="display:flex;gap:6px;flex-wrap:wrap">
        <input type="text" id="pName" placeholder="اسم البكج" style="flex:1;min-width:110px;padding:.5rem .8rem;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.12);border-radius:8px;color:var(--text)">
        <input type="number" id="pPrice" placeholder="السعر $" min="0" style="width:90px;padding:.5rem .8rem;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.12);border-radius:8px;color:var(--text);direction:ltr">
        <input type="number" id="pDays" placeholder="أيام" min="0" style="width:70px;padding:.5rem .8rem;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.12);border-radius:8px;color:var(--text);direction:ltr">
        <button class="admin-btn primary small" onclick="addPackage()"><i class="fas fa-plus"></i></button>
      </div>
    </div>
  </div>
</div>

<!-- طلبات الخدمة -->
<div class="admin-card" style="margin-bottom:20px">
  <h3 style="margin-bottom:14px"><i class="fas fa-clipboard-list"></i> طلبات الخدمة</h3>
  <table class="admin-table">
    <thead><tr><th>#</th><th>المستخدم</th><th>الخدمة</th><th>الإجابات</th><th>الحالة</th><th>إجراءات</th></tr></thead>
    <tbody>
      <% if (requests.length > 0) { %>
        <% requests.forEach(function(r, i) { %>
        <tr>
          <td><%= r.id %></td>
          <td><%= r.username || ('#' + r.user_id) %></td>
          <td><%= r.service_title || '—' %></td>
          <td style="max-width:340px">
            <details>
              <summary style="cursor:pointer;color:var(--accent);font-size:.8rem">عرض الإجابات</summary>
              <div style="font-size:.78rem;color:var(--text-dim);padding:.5rem 0;white-space:pre-wrap"><%= (function(){ try { var a = JSON.parse(r.answers || '[]'); return (Array.isArray(a) ? a : []).map(function(x){ return '• ' + x.q + ': ' + (x.type === 'image' && x.a ? '[صورة] ' + x.a : (x.a || '—')); }).join('\n') || 'بدون إجابات'; } catch(e) { return '—'; } })() %></div>
            </details>
          </td>
          <td><span class="badge"><%= r.status === 'pending' ? 'بانتظار المراجعة' : r.status === 'approved' ? 'مقبول' : r.status === 'rejected' ? 'مرفوض' : r.status %></span></td>
          <td style="display:flex;gap:4px">
            <% if (r.status === 'pending') { %>
              <button onclick="approveReq(<%= r.id %>)" class="admin-btn success small"><i class="fas fa-check"></i></button>
              <button onclick="rejectReq(<%= r.id %>)" class="admin-btn danger small"><i class="fas fa-times"></i></button>
            <% } %>
          </td>
        </tr>
        <% }); %>
      <% } else { %>
        <tr><td colspan="6" style="text-align:center;padding:2rem;color:var(--text-dim)">لا توجد طلبات</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<div class="admin-card">
  <h3 style="margin-bottom:14px"><i class="fas fa-clock-rotate-left"></i> سجل الأحداث</h3>
  <table class="admin-table" id="farmEvTable">
    <thead><tr><th>الوقت</th><th>الجهة</th><th>الحدث</th><th>التفاصيل</th></tr></thead>
    <tbody><tr><td colspan="4" style="text-align:center;padding:1.5rem;color:var(--text-dim)">جاري التحميل...</td></tr></tbody>
  </table>
</div>
</div>

<div id="addModal" class="admin-modal" style="display:none">
  <div class="modal-content">
    <h3>إضافة عنصر</h3>
    <form id="addForm" enctype="multipart/form-data">
      <div class="form-group"><label>العنوان</label><input type="text" name="title" required></div>
      <div class="form-group"><label>الوصف</label><textarea name="description" rows="3"></textarea></div>
      <div class="form-group"><label>التصنيف</label><select name="category" id="add_co_category"><option value="info">معلومات</option><option value="activities">خدمة</option></select></div>
      <div class="form-group"><label>حالة الخدمة (للخدمات فقط)</label><select name="service_status"><option value="available">متوفر</option><option value="coming_soon">قريباً</option><option value="ended">منتهي</option><option value="">بدون (عنصر عادي)</option></select></div>
      <div class="form-group"><label>أيقونة الخدمة (اختياري)</label><input type="text" name="icon" placeholder="fa-shirt أو إيموجي 🚗"><div style="font-size:.72rem;color:var(--text-dim);margin-top:4px">اسم أيقونة Font Awesome (بدون fas) أو إيموجي مباشر</div></div>
      <div class="form-group"><label>رابط الفيديو (اختياري)</label><input type="text" name="video_url"></div>
      <div class="form-group"><label>الصورة</label><input type="file" name="image_file" accept="image/*"></div>
      <div class="modal-actions">
        <button type="button" onclick="closeModal('addModal')" class="admin-btn">إلغاء</button>
        <button type="submit" class="admin-btn primary">حفظ</button>
      </div>
    </form>
  </div>
</div>

<div id="editModal" class="admin-modal" style="display:none">
  <div class="modal-content">
    <h3>تعديل العنصر</h3>
    <form id="editForm" enctype="multipart/form-data">
      <input type="hidden" name="id" id="edit_co_id">
      <div class="form-group"><label>العنوان</label><input type="text" name="title" id="edit_co_title" required></div>
      <div class="form-group"><label>الوصف</label><textarea name="description" id="edit_co_desc" rows="3"></textarea></div>
      <div class="form-group"><label>التصنيف</label><select name="category" id="edit_co_category"><option value="info">معلومات</option><option value="activities">خدمة</option></select></div>
      <div class="form-group"><label>حالة الخدمة</label><select name="service_status" id="edit_co_status"><option value="available">متوفر</option><option value="coming_soon">قريباً</option><option value="ended">منتهي</option><option value="">بدون (عنصر عادي)</option></select></div>
      <div class="form-group"><label>أيقونة الخدمة (اختياري)</label><input type="text" name="icon" id="edit_co_icon" placeholder="fa-shirt أو إيموجي 🚗"><div style="font-size:.72rem;color:var(--text-dim);margin-top:4px">اسم أيقونة Font Awesome (بدون fas) أو إيموجي مباشر</div></div>
      <div class="form-group"><label>رابط الفيديو</label><input type="text" name="video_url" id="edit_co_video"></div>
      <div class="form-group"><label>الصورة الحالية</label><div id="edit_co_image_preview" style="margin-bottom:8px"></div></div>
      <div class="form-group"><label>صورة جديدة</label><input type="file" name="image_file" accept="image/*"></div>
      <div class="modal-actions">
        <button type="button" onclick="closeModal('editModal')" class="admin-btn">إلغاء</button>
        <button type="submit" class="admin-btn primary">تحديث</button>
      </div>
    </form>
  </div>
</div>

<script>
var allItems = <%- JSON.stringify(items) %>;
var allQuestions = <%- JSON.stringify(questions) %>;
var allPackages = <%- JSON.stringify(packages) %>;
var svcItemIds = allItems.filter(i => i.category === 'activities').map(i => i.id);

function showAddItem(cat) {
  if (cat) document.getElementById('add_co_category').value = cat;
  document.getElementById('addModal').style.display = 'flex';
}
function closeModal(id) { document.getElementById(id).style.display = 'none'; }
function showEditItem(id) {
  var item = allItems.find(i => i.id === id);
  if (!item) return;
  document.getElementById('edit_co_id').value = item.id;
  document.getElementById('edit_co_title').value = item.title || '';
  document.getElementById('edit_co_desc').value = item.description || '';
  document.getElementById('edit_co_category').value = item.category || 'info';
  document.getElementById('edit_co_status').value = item.service_status || '';
  document.getElementById('edit_co_icon').value = item.icon || '';
  document.getElementById('edit_co_video').value = item.video_url || '';
  document.getElementById('edit_co_image_preview').innerHTML = item.image ? '<img src="' + item.image + '" style="width:60px;height:60px;object-fit:cover;border-radius:8px">' : '<span style="color:var(--text-dim)">لا توجد صورة</span>';
  document.getElementById('editModal').style.display = 'flex';
}
document.getElementById('addForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const fd = new FormData(e.target);
  const res = await fetch('/api/admin/company/items', { method: 'POST', body: fd });
  const data = await res.json();
  if (data.success) location.reload(); else alert(data.error || 'خطأ');
});
document.getElementById('editForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const id = document.getElementById('edit_co_id').value;
  const fd = new FormData(e.target);
  fd.delete('id');
  const res = await fetch('/api/admin/company/items/' + id, { method: 'PUT', body: fd });
  const data = await res.json();
  if (data.success) location.reload(); else alert(data.error || 'خطأ');
});
async function deleteItem(id) {
  if (!confirm('حذف هذا العنصر؟ راح تنحذف معه أسئلته وبكجاته.')) return;
  const res = await fetch('/api/admin/company/items/' + id, { method: 'DELETE' });
  const data = await res.json();
  if (data.success) location.reload();
}
async function quickStatus(id, status) {
  const fd = new FormData();
  const item = allItems.find(i => i.id === id);
  fd.append('title', item.title); fd.append('description', item.description || '');
  fd.append('category', item.category); fd.append('service_status', status);
  fd.append('icon', item.icon || '');
  fd.append('video_url', item.video_url || '');
  const res = await fetch('/api/admin/company/items/' + id, { method: 'PUT', body: fd });
  const data = await res.json();
  if (!data.success) alert(data.error || 'خطأ'); else location.reload();
}
async function approveReq(id) {
  const res = await fetch('/api/admin/company/requests/' + id + '/approve', { method: 'POST' });
  const data = await res.json();
  if (data.success) location.reload(); else alert(data.error || 'خطأ');
}
async function rejectReq(id) {
  const notes = prompt('سبب الرفض (اختياري — يوصل للمستخدم بإشعاره):') || '';
  const res = await fetch('/api/admin/company/requests/' + id + '/reject', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ notes }) });
  const data = await res.json();
  if (data.success) location.reload(); else alert(data.error || 'خطأ');
}

/* ═══ تبويبات الصفحة ═══ */
function admCoTab(t) {
  document.getElementById('admCo-info').style.display = t === 'info' ? '' : 'none';
  document.getElementById('admCo-services').style.display = t === 'services' ? '' : 'none';
  var bi = document.getElementById('admCoTabBtn-info'), bs = document.getElementById('admCoTabBtn-services');
  bi.className = 'admin-btn' + (t === 'info' ? ' primary' : '');
  bs.className = 'admin-btn' + (t === 'services' ? ' primary' : '');
}

/* ═══ مدير المزارع ═══ */
async function farmLoad() {
  try {
    const res = await fetch('/api/farm/admin/data', { cache: 'no-store' });
    farmData = await res.json();
    if (farmData.error) { alert(farmData.error); return; }
    farmRenderFarms(); farmRenderCfg(); farmRenderBookings(); farmRenderWorkers(); farmRenderEvents();
  } catch (e) { alert('خطأ بتحميل بيانات الخدمات'); }
}
function farmRenderFarms() {
  const box = document.getElementById('farmFarmsList');
  const list = farmData.farms || [];
  if (!list.length) { box.innerHTML = '<div style="color:var(--text-dim);font-size:.85rem">ما في مزارع — أضف أول مزرعة فوق</div>'; return; }
  box.innerHTML = list.map(f => `<div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.09);border-radius:12px;padding:.65rem .9rem">
    <input type="text" value="${(f.name || '').replace(/"/g, '&quot;')}" id="farmName_${f.id}" style="flex:1;min-width:160px;padding:.45rem .7rem;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.12);border-radius:8px;color:var(--text)">
    ${f.busy ? '<span style="font-size:.7rem;font-weight:800;color:#ef4444;background:rgba(239,68,68,.12);border:1px solid rgba(239,68,68,.35);padding:3px 9px;border-radius:7px">محجوزة الآن</span>' : ''}
    <label style="display:flex;align-items:center;gap:6px;font-size:.78rem;cursor:pointer;white-space:nowrap"><input type="checkbox" ${f.enabled ? 'checked' : ''} onchange="farmToggle(${f.id}, this.checked)"> مفعلة</label>
    <button class="admin-btn small" onclick="farmRename(${f.id})"><i class="fas fa-save"></i> حفظ الاسم</button>
    <button class="admin-btn danger small" onclick="farmDel(${f.id})"><i class="fas fa-trash"></i></button>
  </div>`).join('');
}
async function farmAddFarm() {
  const name = document.getElementById('farmNewName').value.trim();
  if (!name) return alert('اكتب اسم المزرعة');
  const res = await fetch('/api/farm/admin/farms', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name }) });
  const d = await res.json();
  if (d.success) { document.getElementById('farmNewName').value = ''; farmLoad(); } else alert(d.error || 'خطأ');
}
async function farmRename(id) {
  const name = document.getElementById('farmName_' + id).value.trim();
  if (!name) return alert('الاسم ما ينعكس فاضي');
  const res = await fetch('/api/farm/admin/farms/' + id, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name }) });
  const d = await res.json();
  if (d.success) farmLoad(); else alert(d.error || 'خطأ');
}
async function farmToggle(id, enabled) {
  const res = await fetch('/api/farm/admin/farms/' + id, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ enabled }) });
  const d = await res.json();
  if (d.success) farmLoad(); else alert(d.error || 'خطأ');
}
async function farmDel(id) {
  if (!confirm('حذف هذه المزرعة نهائياً؟')) return;
  const res = await fetch('/api/farm/admin/farms/' + id, { method: 'DELETE' });
  const d = await res.json();
  if (d.success) farmLoad(); else alert(d.error || 'خطأ');
}

/* ═══ إعدادات وأسعار استئجار المزارع ═══ */
var farmData = null;
const FARM_ST_BADGE = {
  pending_payment: ['بانتظار الدفع', '#eab308'],
  pending_confirm: ['بانتظار التأكيد', '#c084fc'],
  confirmed: ['مؤكد — بالنص الثاني', '#38bdf8'],
  active: ['فعال', '#34d399'],
  ended: ['منتهي', '#94a3b8'],
  cancelled: ['ملغي', '#ef4444'],
  expired: ['انتهت المهلة', '#ef4444']
};
const FARM_R_BADGE = {
  pending_payment: ['بانتظار تحويله', '#eab308'],
  pending_confirm: ['بانتظار التأكيد', '#c084fc'],
  confirmed: ['مؤكد', '#34d399'],
  rejected: ['مرفوض', '#ef4444']
};
const FARM_W_BADGE = {
  pending_payment: ['بانتظار الدفع', '#eab308'],
  pending_confirm: ['بانتظار التأكيد', '#c084fc'],
  confirmed: ['مؤكد', '#34d399'],
  rejected: ['مرفوض', '#ef4444']
};
function farmMoney(n) { return Number(n || 0).toLocaleString('en-US'); }
function farmDT(s) { return s ? String(s).slice(0, 16) : '—'; }
function farmBadge(map, st) {
  const m = map[st] || [st, '#94a3b8'];
  return `<span style="font-size:.72rem;font-weight:800;color:${m[1]};background:${m[1]}1f;border:1px solid ${m[1]}55;padding:3px 10px;border-radius:7px;white-space:nowrap">${m[0]}</span>`;
}
function farmRenderCfg() {
  const c = farmData.config;
  document.getElementById('farmCfgLoading').style.display = 'none';
  document.getElementById('farmCfgForm').style.display = '';
  document.getElementById('farmWebhookWarn').style.display = farmData.webhook_ok ? 'none' : '';
  document.getElementById('f_price_1d').value = c.price_1d;
  document.getElementById('f_price_3d').value = c.price_3d;
  document.getElementById('f_price_5d').value = c.price_5d;
  document.getElementById('f_price_7d').value = c.price_7d;
  document.getElementById('f_price_10d').value = c.price_10d;
  document.getElementById('f_price_14d').value = c.price_14d;
  document.getElementById('f_worker_price').value = c.worker_price;
  document.getElementById('f_max_workers').value = c.max_workers;
  document.getElementById('f_deposit_pct').value = c.deposit_pct;
  document.getElementById('f_payment_window_hours').value = c.payment_window_hours;
  document.getElementById('f_cancel_cutoff_hours').value = c.cancel_cutoff_hours;
  document.getElementById('f_extend_window_hours').value = c.extend_window_hours;
  document.getElementById('f_remainder_window_hours').value = (c.remainder_window_hours != null ? c.remainder_window_hours : 6);
  document.getElementById('f_bank_account').value = c.bank_account || '';
  document.getElementById('f_ping_mention').value = c.ping_mention || '';
}
async function farmSaveCfg(e) {
  e.preventDefault();
  const g = id => document.getElementById(id).value;
  const body = {
    price_1d: g('f_price_1d'), price_3d: g('f_price_3d'), price_5d: g('f_price_5d'),
    price_7d: g('f_price_7d'), price_10d: g('f_price_10d'), price_14d: g('f_price_14d'),
    worker_price: g('f_worker_price'), max_workers: g('f_max_workers'), deposit_pct: g('f_deposit_pct'),
    payment_window_hours: g('f_payment_window_hours'), cancel_cutoff_hours: g('f_cancel_cutoff_hours'),
    extend_window_hours: g('f_extend_window_hours'), remainder_window_hours: g('f_remainder_window_hours'), bank_account: g('f_bank_account'),
    ping_mention: g('f_ping_mention')
  };
  const res = await fetch('/api/farm/admin/config', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
  const d = await res.json();
  if (d.success) { alert('تم حفظ الإعدادات'); farmLoad(); } else alert(d.error || 'خطأ');
}
function farmBkActions(b) {
  const btn = (url, label, cls, confirmMsg) =>
    `<button class="admin-btn ${cls} small" onclick="farmAct('${url}','${confirmMsg || ''}')">${label}</button>`;
  let h = '';
  if (b.status === 'pending_confirm') h += btn(`/api/farm/admin/bookings/${b.id}/confirm-payment`, '<i class="fas fa-check"></i> تأكيد استلام العربون', 'success', 'تأكد أن العربون وصل بنك الشركة فعلاً — تأكيد الاستلام؟');
  if (b.status === 'confirmed' && (b.remainder_status || 'pending_payment') === 'pending_confirm') h += btn(`/api/farm/admin/bookings/${b.id}/confirm-remainder`, '<i class="fas fa-sack-dollar"></i> تأكيد استلام النص الثاني', 'success', 'تأكد أن النص الثاني وصل بنك الشركة فعلاً — بعد التأكيد ينبدا الحجز ويطلع اشعار إضافة المستأجر للفاكشن؟');
  if (b.status === 'confirmed' && (b.remainder_status || 'pending_payment') === 'pending_confirm') h += btn(`/api/farm/admin/bookings/${b.id}/reject-remainder`, '<i class="fas fa-xmark"></i> رفض النص الثاني', 'danger', 'رفض = إلغاء الحجز وخسارة المستأجر للعربون كاملاً والمزرعة ترجع متاحة — متأكد؟');
  if (b.status === 'active' && !b.faction_added) h += btn(`/api/farm/admin/bookings/${b.id}/faction-add`, '<i class="fas fa-users"></i> تمت إضافته للفاكشن', 'success', 'تأكيد أن المستأجر انضاف للفاكشن؟ (يوقف التنبيه الساعي)');
  if (b.extend_status === 'pending_confirm') h += btn(`/api/farm/admin/bookings/${b.id}/confirm-extension`, '<i class="fas fa-clock"></i> تأكيد عربون التمديد', 'success', 'تأكد وصول عربون التمديد — تأكيد التمديد؟');
  if (b.status === 'ended' && !b.faction_removed && !b.remove_confirm1_by) h += btn(`/api/farm/admin/bookings/${b.id}/remove-confirm-1`, '<i class="fas fa-user-minus"></i> تأكيد إزالة ١/٢', 'success', 'التأكيد الأول: تأكد أن المستأجر المنتهي راح ينزال من الفاكشن؟');
  if (b.status === 'ended' && !b.faction_removed && b.remove_confirm1_by) h += btn(`/api/farm/admin/bookings/${b.id}/remove-confirm-2`, '<i class="fas fa-user-minus"></i> تأكيد إزالة ٢/٢', 'danger', 'التأكيد الثاني النهائي: تمت إزالة المستأجر من الفاكشن فعلاً؟');
  if (['pending_payment','pending_confirm'].includes(b.status)) h += btn(`/api/farm/admin/bookings/${b.id}/release`, '<i class="fas fa-eject"></i> إبطال', 'danger', 'إبطال هذا الحجز المعلق؟');
  if (b.status === 'active') h += btn(`/api/farm/admin/bookings/${b.id}/force-end`, '<i class="fas fa-stop"></i> إنهاء يدوي', 'danger', 'إنهاء هذا الحجز يدوياً الآن؟');
  return h || '<span style="color:var(--text-dim)">—</span>';
}
function farmRenderBookings() {
  const tb = document.querySelector('#farmBkTable tbody');
  const list = farmData.bookings || [];
  if (!list.length) { tb.innerHTML = '<tr><td colspan="9" style="text-align:center;padding:1.5rem;color:var(--text-dim)">لا توجد حجوزات بعد</td></tr>'; return; }
  tb.innerHTML = list.map(b => `<tr>
    <td style="direction:ltr;font-family:ui-monospace,Menlo,monospace;color:var(--accent);font-weight:800">${b.ref}</td>
    <td>${b.username || '—'}</td>
    <td>${b.farm_name || '#' + (b.farm_id || b.farm_no)}</td>
    <td>${b.duration_days} يوم${b.extend_days && b.extend_status === 'confirmed' ? ` <span style="color:#34d399">+${b.extend_days}</span>` : ''}</td>
    <td style="direction:ltr">${farmMoney(b.rent_amount)}$ / <b style="color:var(--accent)">${farmMoney(b.deposit_amount)}$</b>${b.status === 'confirmed' ? `<br><span style="font-size:.72rem;color:#38bdf8">نص ثاني ${farmMoney(b.remainder_amount || (b.rent_amount - b.deposit_amount))}$</span>` : ''}</td>
    <td><div style="display:flex;flex-direction:column;align-items:flex-start;gap:5px">${farmBadge(FARM_ST_BADGE, b.status)}${b.status === 'confirmed' ? `<span style="display:flex;align-items:center;gap:5px;font-size:.7rem;color:var(--text-dim);white-space:nowrap">النص الثاني: ${farmBadge(FARM_R_BADGE, b.remainder_status || 'pending_payment')}</span>` : ''}${b.extend_status === 'pending_payment' || b.extend_status === 'pending_confirm' ? `<span style="display:flex;align-items:center;gap:5px;font-size:.7rem;color:var(--text-dim);white-space:nowrap">تمديد ${b.extend_days} يوم ${farmBadge(FARM_ST_BADGE, b.extend_status)}</span>` : ''}</div></td>
    <td>${b.status === 'active' || b.status === 'ended' ? (Number(b.faction_added) === 1 ? '<span style="color:#34d399">مضاف</span>' : '<span style="color:#eab308">بانتظار الإضافة</span>') + (b.status === 'ended' ? '<br>' + (Number(b.faction_removed) === 1 ? '<span style="color:#34d399">منزال</span>' : '<span style="color:#eab308">بانتظار الإزالة</span>') : '') : '—'}</td>
    <td style="font-size:.78rem">${farmDT(b.start_at)}<br>${farmDT(b.end_at)}</td>
    <td style="display:flex;gap:4px;flex-wrap:wrap">${farmBkActions(b)}</td>
  </tr>`).join('');
}
function farmRenderWorkers() {
  const tb = document.querySelector('#farmWkTable tbody');
  const list = farmData.workers || [];
  const refOf = {};
  (farmData.bookings || []).forEach(b => { refOf[b.id] = b.ref; });
  if (!list.length) { tb.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:1.5rem;color:var(--text-dim)">لا يوجد عمال بعد</td></tr>'; return; }
  tb.innerHTML = list.map((w, i) => `<tr>
    <td>${i + 1}</td>
    <td style="direction:ltr;font-family:ui-monospace,Menlo,monospace">${refOf[w.booking_id] || ('#' + w.booking_id)}</td>
    <td style="direction:ltr;font-weight:700">${w.character_name}</td>
    <td style="direction:ltr">${farmMoney(w.amount)}$</td>
    <td>${farmBadge(FARM_W_BADGE, w.status)}</td>
    <td style="display:flex;gap:4px;flex-wrap:wrap">
      <button class="admin-btn small" title="تعديل سعر العامل" onclick="farmWorkerEditPrice(${w.id})"><i class="fas fa-pen"></i></button>
      ${w.status === 'pending_confirm' ? `<button class="admin-btn success small" onclick="farmWorkerAct(${w.id},'confirm')"><i class="fas fa-check"></i></button>` : ''}
      ${['pending_payment','pending_confirm'].includes(w.status) ? `<button class="admin-btn danger small" onclick="farmWorkerAct(${w.id},'reject')"><i class="fas fa-times"></i></button>` : ''}
    </td>
  </tr>`).join('');
}
function farmRenderEvents() {
  const tb = document.querySelector('#farmEvTable tbody');
  const list = farmData.events || [];
  if (!list.length) { tb.innerHTML = '<tr><td colspan="4" style="text-align:center;padding:1.5rem;color:var(--text-dim)">لا يوجد سجل بعد</td></tr>'; return; }
  tb.innerHTML = list.map(ev => `<tr>
    <td style="font-size:.75rem;white-space:nowrap">${farmDT(ev.created_at)}</td>
    <td><span class="badge">${ev.actor_type === 'admin' ? 'إدارة: ' + ev.actor : ev.actor_type === 'user' ? 'مستخدم: ' + ev.actor : 'النظام'}</span></td>
    <td style="white-space:nowrap">${ev.action}</td>
    <td style="font-size:.8rem">${ev.details || ''}</td>
  </tr>`).join('');
}
async function farmAct(url, confirmMsg) {
  if (confirmMsg && !confirm(confirmMsg)) return;
  const res = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' } });
  const d = await res.json();
  if (d.success) farmLoad(); else alert(d.error || 'خطأ');
}
async function farmWorkerAct(id, act) {
  if (act === 'confirm' && !confirm('تأكد أن مبلغ العامل وصل بنك الشركة — تأكيد؟')) return;
  if (act === 'reject' && !confirm('رفض طلب العامل؟ (المبلغ يرجع للمستأجر)')) return;
  const res = await fetch(`/api/farm/admin/workers/${id}/${act}`, { method: 'POST', headers: { 'Content-Type': 'application/json' } });
  const d = await res.json();
  if (d.success) farmLoad(); else alert(d.error || 'خطأ');
}
async function farmWorkerEditPrice(id) {
  const w = (farmData.workers || []).find(x => x.id === id);
  if (!w) return;
  const input = prompt('السعر الجديد لإضافة العامل ' + w.character_name + ' (رقم كامل بالدولار):', Number(w.amount) || 0);
  if (input === null) return;
  const amount = Math.round(Number(input));
  if (!Number.isFinite(amount) || amount < 0) { alert('اكتب رقم صحيح أكبر أو يساوي صفر'); return; }
  const res = await fetch(`/api/farm/admin/workers/${id}/price`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ amount }) });
  const d = await res.json();
  if (d.success) farmLoad(); else alert(d.error || 'خطأ');
}

/* ═══ أسئلة وبكجات الخدمات ═══ */
function renderQs() {
  const sid = parseInt(document.getElementById('qSvcSel').value);
  const box = document.getElementById('qList');
  const list = allQuestions.filter(q => Number(q.service_id) === sid);
  if (!svcItemIds.length) { box.innerHTML = '<div style="color:var(--text-dim);font-size:.8rem">أضف خدمة أولاً</div>'; return; }
  if (!list.length) { box.innerHTML = '<div style="color:var(--text-dim);font-size:.8rem">لا توجد أسئلة لهذه الخدمة</div>'; return; }
  box.innerHTML = list.map(q => `<div style="display:flex;align-items:center;gap:8px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.08);border-radius:9px;padding:.5rem .8rem;font-size:.8rem">
    <span style="flex:1">${q.question} ${Number(q.required) === 1 ? '<span style="color:#ef4444">*</span>' : ''}</span>
    <span class="badge">${q.type === 'image' ? 'صورة' : q.type === 'character_name' ? 'اسم شخصية' : 'نص'}</span>
    <button class="admin-btn danger small" onclick="delQuestion(${q.id})"><i class="fas fa-trash"></i></button>
  </div>`).join('');
}
async function addQuestion() {
  const sid = parseInt(document.getElementById('qSvcSel').value);
  const question = document.getElementById('qText').value.trim();
  if (!sid || !question) return alert('اكتب السؤال واختر الخدمة');
  const res = await fetch('/api/admin/company/questions', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ service_id: sid, question, type: document.getElementById('qType').value, required: document.getElementById('qRequired').checked }) });
  const d = await res.json();
  if (d.success) location.reload(); else alert(d.error || 'خطأ');
}
async function delQuestion(id) {
  if (!confirm('حذف هذا السؤال؟')) return;
  const res = await fetch('/api/admin/company/questions/' + id, { method: 'DELETE' });
  const d = await res.json();
  if (d.success) location.reload();
}
function renderPs() {
  const sid = parseInt(document.getElementById('pSvcSel').value);
  const box = document.getElementById('pList');
  const list = allPackages.filter(p => Number(p.service_id) === sid);
  if (!svcItemIds.length) { box.innerHTML = '<div style="color:var(--text-dim);font-size:.8rem">أضف خدمة أولاً</div>'; return; }
  if (!list.length) { box.innerHTML = '<div style="color:var(--text-dim);font-size:.8rem">لا توجد بكجات — الطلب بدون بكج يشتغل عادي</div>'; return; }
  box.innerHTML = list.map(p => `<div style="display:flex;align-items:center;gap:8px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.08);border-radius:9px;padding:.5rem .8rem;font-size:.8rem">
    <span style="flex:1;font-weight:700">${p.name}</span>
    <span style="direction:ltr;color:var(--accent);font-weight:800">$${Number(p.price).toFixed(2)}</span>
    ${Number(p.days) > 0 ? `<span class="badge">${p.days} يوم</span>` : ''}
    <button class="admin-btn danger small" onclick="delPackage(${p.id})"><i class="fas fa-trash"></i></button>
  </div>`).join('');
}
async function addPackage() {
  const sid = parseInt(document.getElementById('pSvcSel').value);
  const name = document.getElementById('pName').value.trim();
  if (!sid || !name) return alert('اكتب اسم البكج واختر الخدمة');
  const res = await fetch('/api/admin/company/packages', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ service_id: sid, name, price: document.getElementById('pPrice').value, days: document.getElementById('pDays').value }) });
  const d = await res.json();
  if (d.success) location.reload(); else alert(d.error || 'خطأ');
}
async function delPackage(id) {
  if (!confirm('حذف هذا البكج؟')) return;
  const res = await fetch('/api/admin/company/packages/' + id, { method: 'DELETE' });
  const d = await res.json();
  if (d.success) location.reload();
}

if (svcItemIds.length) { renderQs(); renderPs(); }
farmLoad();
</script>
