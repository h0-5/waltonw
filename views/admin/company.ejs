<%- include('layout') %>
<div class="admin-card" style="margin-bottom:20px">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px">
    <h3 style="margin:0;border:none;padding:0"><i class="fas fa-briefcase"></i> إدارة الشركة</h3>
    <button onclick="showAddItem()" class="admin-btn primary"><i class="fas fa-plus"></i> إضافة عنصر</button>
  </div>
  <table class="admin-table">
    <thead><tr><th>#</th><th>العنوان</th><th>الصورة</th><th>التصنيف</th><th>الحالة</th><th>إجراءات</th></tr></thead>
    <tbody>
      <% if (items.length > 0) { %>
        <% items.forEach(function(item, i) { %>
        <tr>
          <td><%= i + 1 %></td>
          <td><%= item.title %></td>
          <td><% if (item.image) { %><img src="<%= item.image %>" style="width:40px;height:40px;object-fit:cover;border-radius:8px"><% } else { %><span style="color:var(--text-dim)">—</span><% } %></td>
          <td><span class="badge"><%= item.category === 'info' ? 'معلومات' : 'أنشطة' %></span></td>
          <td><span class="badge"><%= item.service_status || '—' %></span></td>
          <td style="display:flex;gap:6px">
            <button onclick="showEditItem(<%= item.id %>)" class="admin-btn small"><i class="fas fa-edit"></i></button>
            <button onclick="deleteItem(<%= item.id %>)" class="admin-btn danger small"><i class="fas fa-trash"></i></button>
          </td>
        </tr>
        <% }); %>
      <% } else { %>
        <tr><td colspan="6" style="text-align:center;padding:2rem;color:var(--text-dim)">لا توجد عناصر</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<div class="admin-card">
  <h3 style="margin-bottom:20px"><i class="fas fa-clipboard-list"></i> طلبات الخدمة</h3>
  <table class="admin-table">
    <thead><tr><th>#</th><th>المستخدم</th><th>الخدمة</th><th>الحالة</th><th>إجراءات</th></tr></thead>
    <tbody>
      <% if (requests.length > 0) { %>
        <% requests.forEach(function(r, i) { %>
        <tr>
          <td><%= i + 1 %></td>
          <td><%= r.username %></td>
          <td><%= r.service_title %></td>
          <td><span class="badge"><%= r.status %></span></td>
          <td style="display:flex;gap:4px">
            <% if (r.status === 'pending') { %>
              <button onclick="approveReq(<%= r.id %>)" class="admin-btn success small"><i class="fas fa-check"></i></button>
              <button onclick="rejectReq(<%= r.id %>)" class="admin-btn danger small"><i class="fas fa-times"></i></button>
            <% } %>
          </td>
        </tr>
        <% }); %>
      <% } else { %>
        <tr><td colspan="5" style="text-align:center;padding:2rem;color:var(--text-dim)">لا توجد طلبات</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<div id="addModal" class="admin-modal" style="display:none">
  <div class="modal-content">
    <h3>إضافة عنصر</h3>
    <form id="addForm" enctype="multipart/form-data">
      <div class="form-group"><label>العنوان</label><input type="text" name="title" required></div>
      <div class="form-group"><label>الوصف</label><textarea name="description" rows="3"></textarea></div>
      <div class="form-group"><label>التصنيف</label><select name="category"><option value="info">معلومات</option><option value="activities">أنشطة</option></select></div>
      <div class="form-group"><label>حالة الخدمة</label><select name="service_status"><option value="">بدون</option><option value="available">متوفر</option><option value="ended">منتهي</option><option value="coming_soon">قريباً</option></select></div>
      <div class="form-group"><label>رابط الفيديو (اختياري)</label><input type="text" name="video_url"></div>
      <div class="form-group"><label>الصورة</label><input type="file" name="image_file" accept="image/*"></div>
      <div class="modal-actions">
        <button type="button" onclick="closeModal('addModal')" class="admin-btn">إلغاء</button>
        <button type="submit" class="admin-btn primary">حفظ</button>
      </div>
    </form>
  </div>
</div>

<div id="editModal" class="admin-modal" style="display:none">
  <div class="modal-content">
    <h3>تعديل العنصر</h3>
    <form id="editForm" enctype="multipart/form-data">
      <input type="hidden" name="id" id="edit_co_id">
      <div class="form-group"><label>العنوان</label><input type="text" name="title" id="edit_co_title" required></div>
      <div class="form-group"><label>الوصف</label><textarea name="description" id="edit_co_desc" rows="3"></textarea></div>
      <div class="form-group"><label>التصنيف</label><select name="category" id="edit_co_category"><option value="info">معلومات</option><option value="activities">أنشطة</option></select></div>
      <div class="form-group"><label>حالة الخدمة</label><select name="service_status" id="edit_co_status"><option value="">بدون</option><option value="available">متوفر</option><option value="ended">منتهي</option><option value="coming_soon">قريباً</option></select></div>
      <div class="form-group"><label>رابط الفيديو</label><input type="text" name="video_url" id="edit_co_video"></div>
      <div class="form-group"><label>الصورة الحالية</label><div id="edit_co_image_preview" style="margin-bottom:8px"></div></div>
      <div class="form-group"><label>صورة جديدة</label><input type="file" name="image_file" accept="image/*"></div>
      <div class="modal-actions">
        <button type="button" onclick="closeModal('editModal')" class="admin-btn">إلغاء</button>
        <button type="submit" class="admin-btn primary">تحديث</button>
      </div>
    </form>
  </div>
</div>

<script>
var allItems = <%- JSON.stringify(items) %>;
function showAddItem() { document.getElementById('addModal').style.display = 'flex'; }
function closeModal(id) { document.getElementById(id).style.display = 'none'; }
function showEditItem(id) {
  var item = allItems.find(i => i.id === id);
  if (!item) return;
  document.getElementById('edit_co_id').value = item.id;
  document.getElementById('edit_co_title').value = item.title || '';
  document.getElementById('edit_co_desc').value = item.description || '';
  document.getElementById('edit_co_category').value = item.category || 'info';
  document.getElementById('edit_co_status').value = item.service_status || '';
  document.getElementById('edit_co_video').value = item.video_url || '';
  document.getElementById('edit_co_image_preview').innerHTML = item.image ? '<img src="' + item.image + '" style="width:60px;height:60px;object-fit:cover;border-radius:8px">' : '<span style="color:var(--text-dim)">لا توجد صورة</span>';
  document.getElementById('editModal').style.display = 'flex';
}
document.getElementById('addForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const fd = new FormData(e.target);
  const res = await fetch('/api/admin/company/items', { method: 'POST', body: fd });
  const data = await res.json();
  if (data.success) location.reload(); else alert(data.error || 'خطأ');
});
document.getElementById('editForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const id = document.getElementById('edit_co_id').value;
  const fd = new FormData(e.target);
  fd.delete('id');
  const res = await fetch('/api/admin/company/items/' + id, { method: 'PUT', body: fd });
  const data = await res.json();
  if (data.success) location.reload(); else alert(data.error || 'خطأ');
});
async function deleteItem(id) {
  if (!confirm('هل أنت متأكد؟')) return;
  const res = await fetch('/api/admin/company/items/' + id, { method: 'DELETE' });
  const data = await res.json();
  if (data.success) location.reload();
}
async function approveReq(id) {
  const res = await fetch('/api/admin/company/requests/' + id + '/approve', { method: 'POST' });
  const data = await res.json();
  if (data.success) location.reload();
}
async function rejectReq(id) {
  const res = await fetch('/api/admin/company/requests/' + id + '/reject', { method: 'POST' });
  const data = await res.json();
  if (data.success) location.reload();
}
</script>
<%- include('admin_footer') %>
