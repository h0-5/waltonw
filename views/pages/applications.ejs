<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/applications-page.css">
<%- include('../partials/navbar') %>

<div class="cy-apps-page">
    <!-- Hero Section -->
    <div class="cy-apps-hero">
        <div class="cy-apps-hero-icon">
            <div class="hex-ring"></div>
            <div class="hex-ring-inner"></div>
            <i class="fas fa-file-signature"></i>
        </div>
        <h1 class="page-heading">التقديمات</h1>
        <p class="cy-apps-hero-sub">اختر التقديم المناسب لك من القائمة أدناه، وكن جزءاً من مجتمعنا المتميز</p>
        <div class="cy-apps-hero-line"></div>
        <div class="hero-metrics">
            <div class="metric">
                <div class="metric-val"><%= applications.filter(function(a){ return a.status === 'open'; }).length %></div>
                <div class="metric-label">تقديم مفتوح</div>
            </div>
            <div class="metric">
                <div class="metric-val"><%= applications.length %></div>
                <div class="metric-label">إجمالي التقديمات</div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="cy-apps-main">
        <div class="sec-head reveal">
            <h2 class="sec-title">
                <span class="bar"></span>
                التقديمات المتاحة
            </h2>
            <span class="sec-badge"><%= applications.filter(function(a){ return a.status === 'open'; }).length %> مفتوح</span>
        </div>

        <div class="deck">
            <% if (applications.length > 0) { %>
                <% applications.forEach(function(app, ai) { %>
                <article class="card reveal stagger-<%= (ai % 6) + 1 %>">
                    <div class="holo-border"></div>
                    <div class="top-shine"></div>
                    <div class="inner-light"></div>

                    <div class="status <%= app.status === 'open' ? 'open' : 'closed' %>">
                        <span class="dot"></span>
                        <%= app.status === 'open' ? 'مفتوح للتقديم' : 'مغلق حالياً' %>
                    </div>

                    <div class="card-head">
                        <div class="icon-box">
                            <div class="icon">
                                <% if (app.image) { %>
                                    <img loading="lazy" src="<%= app.image %>" alt="<%= app.title || app.application_type %>">
                                <% } else { %>
                                    <div class="fallback">
                                        <i class="fas fa-<%= app.application_type === 'Join Family' ? 'users' : 'user-shield' %>"></i>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                        <div class="title-wrap">
                            <h3><%= app.title || app.application_type %></h3>
                            <span class="tag">
                                <i class="fas fa-<%= app.application_type === 'Join Family' ? 'users' : 'user-shield' %>"></i>
                                <%= app.application_type === 'Join Family' ? 'عضوية' : 'إدارة' %>
                            </span>
                        </div>
                    </div>

                    <div class="card-body">
                        <% if (app.description) { %>
                        <p class="desc"><%= app.description %></p>
                        <% } %>

                        <% if (app.requirements) { %>
                        <div class="reqs">
                            <div class="reqs-title">
                                <i class="fas fa-shield-alt"></i>
                                المتطلبات الأساسية
                            </div>
                            <ul>
                                <% app.requirements.split(/\r?\n/).filter(function(r){ return r.trim(); }).forEach(function(req) { %>
                                <li>
                                    <span class="check"><i class="fas fa-check"></i></span>
                                    <span><%= req.trim() %></span>
                                </li>
                                <% }); %>
                            </ul>
                        </div>
                        <% } %>

                        <div class="actions">
                            <% if (app.status === 'open') { %>
                                <% if (typeof user !== 'undefined' && user) { %>
                                <a href="/applications/form/<%= app.id %>" class="btn">
                                    <span class="shimmer"></span>
                                    <i class="fas fa-paper-plane"></i>
                                    تقديم الطلب الآن
                                </a>
                                <% } else { %>
                                <a href="/auth/discord" class="btn btn-login">
                                    <span class="shimmer"></span>
                                    <i class="fas fa-sign-in-alt"></i>
                                    تسجيل الدخول للتقديم
                                </a>
                                <% } %>
                            <% } else { %>
                            <button disabled class="btn-off">
                                <i class="fas fa-lock"></i>
                                غير متاح حالياً
                            </button>
                            <% } %>
                        </div>
                    </div>
                </article>
                <% }); %>
            <% } else { %>
            <div style="text-align: center; padding: 3rem; background: rgba(10,9,16,0.7); border-radius: 24px; border: 1px solid rgba(var(--ac-rgb),0.08); grid-column: 1/-1;">
                <i class="fas fa-inbox" style="font-size: 3rem; color: rgba(var(--ac-rgb),0.4); margin-bottom: 1rem; display: block;"></i>
                <p style="color: var(--text-dim);">لا توجد تقديمات متاحة حالياً</p>
            </div>
            <% } %>
        </div>

        <!-- Tip Card -->
        <div class="tip-sec reveal">
            <div class="tip-card">
                <div class="tip-inner">
                    <div class="tip-icon">
                        <i class="fas fa-lightbulb"></i>
                    </div>
                    <h3>نصائح هامة للتقديم</h3>
                    <p>تأكد من قراءة المتطلبات جيدًا قبل التقديم. اكتب معلومات دقيقة وصادقة، فجميع الطلبات تخضع للمراجعة الدقيقة من قبل فريق الإدارة.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
// Scroll Reveal
(function(){
    var els = document.querySelectorAll('.reveal');
    if (!els.length) return;
    var io = new IntersectionObserver(function(entries){
        entries.forEach(function(e){
            if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); }
        });
    }, { threshold: 0.12 });
    els.forEach(function(el){ io.observe(el); });
})();
</script>

<%- include('../partials/footer') %>
