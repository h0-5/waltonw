<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/applications-page.css">
<%- include('../partials/navbar') %>

<div class="cy-apps-page" dir="rtl">
    <!-- Hero -->
    <div class="cy-apps-hero">
        <div class="cy-apps-hero-icon">
            <div class="hex-ring"></div>
            <div class="hex-ring-inner"></div>
            <i class="fas fa-file-signature"></i>
        </div>
        <h1 class="page-heading">التقديمات</h1>
        <p class="cy-apps-hero-sub">اختر التقديم المناسب لك وكن جزءاً من عائلة والتون</p>
        <div class="cy-apps-hero-line"></div>
    </div>

    <div class="cy-apps-main">
        <!-- Stats -->
        <div class="apps-stats">
            <div class="apps-stat-card">
                <div class="apps-stat-icon"><i class="fas fa-door-open"></i></div>
                <div class="apps-stat-val"><%= applications.filter(function(a){ return a.status === 'open'; }).length %></div>
                <div class="apps-stat-label">متاح للتقديم</div>
            </div>
            <div class="apps-stat-card">
                <div class="apps-stat-icon"><i class="fas fa-layer-group"></i></div>
                <div class="apps-stat-val"><%= applications.length %></div>
                <div class="apps-stat-label">إجمالي التقديمات</div>
            </div>
        </div>

        <!-- Applications Grid -->
        <div class="apps-grid">
            <% if (applications.length > 0) { %>
                <% applications.forEach(function(app, i) { %>
                <div class="apps-card" style="--delay: <%= i * 0.1 %>s">
                    <div class="apps-card-glow"></div>
                    
                    <!-- Status Badge -->
                    <div class="apps-card-status <%= app.status %>">
                        <span class="apps-dot"></span>
                        <%= app.status === 'open' ? 'مفتوح' : 'مغلق' %>
                    </div>

                    <!-- Card Content -->
                    <div class="apps-card-body">
                        <div class="apps-card-img">
                            <% if (app.image) { %>
                                <img src="<%= app.image %>" alt="<%= app.title || app.application_type %>" loading="lazy">
                            <% } else { %>
                                <div class="apps-card-img-placeholder">
                                    <i class="fas fa-<%= app.application_type === 'Join Family' ? 'users' : 'user-shield' %>"></i>
                                </div>
                            <% } %>
                        </div>

                        <h3 class="apps-card-title"><%= app.title || app.application_type %></h3>
                        
                        <% if (app.description) { %>
                        <p class="apps-card-desc"><%= app.description %></p>
                        <% } %>

                        <% if (app.requirements) { %>
                        <div class="apps-card-reqs">
                            <div class="apps-reqs-title"><i class="fas fa-clipboard-check"></i> المتطلبات</div>
                            <% var reqs = app.requirements.split(/\r?\n/).filter(function(r){ return r.trim(); }); %>
                            <% reqs.forEach(function(req) { %>
                            <div class="apps-req-item">
                                <i class="fas fa-check-circle"></i>
                                <span><%= req.trim() %></span>
                            </div>
                            <% }); %>
                        </div>
                        <% } %>
                    </div>

                    <!-- Action -->
                    <div class="apps-card-footer">
                        <% if (app.status === 'open') { %>
                            <% if (typeof user !== 'undefined' && user) { %>
                            <a href="/applications/form/<%= app.id %>" class="apps-apply-btn">
                                <i class="fas fa-paper-plane"></i> قدّم الآن
                            </a>
                            <% } else { %>
                            <a href="/auth/discord" class="apps-apply-btn discord">
                                <i class="fab fa-discord"></i> سجّل دخول أولاً
                            </a>
                            <% } %>
                        <% } else { %>
                            <button class="apps-apply-btn disabled" disabled>
                                <i class="fas fa-lock"></i> مغلق حالياً
                            </button>
                        <% } %>
                    </div>
                </div>
                <% }); %>
            <% } else { %>
            <div class="apps-empty">
                <div class="apps-empty-icon"><i class="fas fa-inbox"></i></div>
                <h3>لا توجد تقديمات متاحة</h3>
                <p>تابعنا للحصول على فرص جديدة قريباً</p>
            </div>
            <% } %>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
