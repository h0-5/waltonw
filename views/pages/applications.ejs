<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/applications-page.css">
<%- include('../partials/navbar') %>

<%
/* عدّ مرة واحدة بدل إعادة الحساب في كل موضع — أخف على السيرفر */
/* صف «منظم فعاليات» مخفي من الصفحة نهائياً بطلب المالك — حُذفت بطاقته الثابتة كلياً */
var visibleApps = applications.filter(function(a) {
    return !/فعاليات/.test(((a.title || '') + ' ' + (a.application_type || '')).trim());
});
var openCount = visibleApps.filter(function(a) { return a.status === 'open'; }).length;
%>

<div class="cy-apps-page">
    <!-- Hero Section -->
    <div class="cy-apps-hero">
        <div class="cy-apps-hero-icon">
            <div class="hex-ring"></div>
            <div class="hex-ring-inner"></div>
            <i class="fas fa-file-signature"></i>
        </div>
        <h1 class="page-heading apps-title" data-text="التقديمات">التقديمات</h1>
        <p class="cy-apps-hero-sub">اختر التقديم المناسب لك من القائمة أدناه، وكن جزءاً من مجتمعنا المتميز</p>
        <div class="cy-apps-hero-line"></div>
        <div class="hero-metrics">
            <div class="metric">
                <div class="metric-val"><%= openCount %></div>
                <div class="metric-label">تقديم مفتوح</div>
            </div>
            <div class="metric">
                <div class="metric-val"><%= visibleApps.length %></div>
                <div class="metric-label">إجمالي التقديمات</div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="cy-apps-main">
        <div class="sec-head reveal">
            <h2 class="sec-title">
                <span class="bar"></span>
                التقديمات المتاحة
            </h2>
            <span class="sec-badge"><%= openCount %> مفتوح</span>
        </div>

        <div class="deck">
            <% if (visibleApps.length > 0) { %>
                <% visibleApps.forEach(function(app, ai) { %>
                <article class="hcard <%= ['rar-gold','rar-epic','rar-rare'][ai % 3] %> reveal stagger-<%= (ai % 6) + 1 %>">
                    <div class="h-shine"></div>
                    <div class="h-glare"></div>

                    <span class="h-rar <%= app.status === 'open' ? 'open' : 'closed' %>">
                        <span class="d"></span>
                        <%= app.status === 'open' ? 'متاح للتقديم' : 'مغلق حالياً' %>
                    </span>

                    <div class="h-core">
                        <% if (app.image && /^(https?:\/\/|\/)/i.test(String(app.image))) { %>
                            <img loading="lazy" src="<%= app.image %>" alt="<%= app.title || app.application_type %>">
                        <% } else { %>
                            <i class="fas fa-<%= app.application_type === 'Join Family' ? 'users' : 'user-shield' %>"></i>
                        <% } %>
                    </div>

                    <h3 class="h-name"><%= app.title || app.application_type %></h3>
                    <div class="h-type">
                        <i class="fas fa-<%= app.application_type === 'Join Family' ? 'users' : 'user-shield' %>"></i>
                        <%= app.application_type === 'Join Family' ? 'عضوية • متاحة للجميع' : 'إدارة' %>
                    </div>
                    <div class="h-div"></div>

                    <% if (app.description) { %>
                    <p class="h-desc"><%= app.description %></p>
                    <% } %>

                    <% if (app.requirements) { %>
                    <div class="h-reqs-head">
                        <i class="fas fa-clipboard-check"></i>
                        <span>شروط التقديم</span>
                    </div>
                    <ul class="h-reqs">
                        <% app.requirements.split(/\r?\n/).filter(function(r){ return r.trim(); }).forEach(function(req) { %>
                        <li>
                            <span class="check"><i class="fas fa-check"></i></span>
                            <span><%= req.trim() %></span>
                        </li>
                        <% }); %>
                    </ul>
                    <% } %>

                    <div class="h-act">
                        <% if (app.status === 'open') { %>
                            <% if (typeof user !== 'undefined' && user) { %>
                            <a href="/applications/form/<%= encodeURIComponent(app.application_type) %>" class="h-btn">
                                <span class="shimmer"></span>
                                <i class="fas fa-paper-plane"></i>
                                تقديم الطلب الآن
                            </a>
                            <% } else { %>
                            <a href="/auth/discord" class="h-btn h-btn-login">
                                <span class="shimmer"></span>
                                <i class="fas fa-sign-in-alt"></i>
                                تسجيل الدخول للتقديم
                            </a>
                            <% } %>
                        <% } else { %>
                        <button disabled class="h-btn-off">
                            <i class="fas fa-lock"></i>
                            غير متاح حالياً
                        </button>
                        <% } %>
                    </div>

                    <div class="h-foot" dir="ltr">— WALTON FAMILY —</div>
                </article>
                <% }); %>
            <% } else { %>
            <div style="text-align: center; padding: 3rem; background: rgba(10,9,16,0.7); border-radius: 24px; border: 1px solid rgba(var(--ac-rgb),0.08); grid-column: 1/-1;">
                <i class="fas fa-inbox" style="font-size: 3rem; color: rgba(var(--ac-rgb),0.4); margin-bottom: 1rem; display: block;"></i>
                <p style="color: var(--text-dim);">لا توجد تقديمات متاحة حالياً</p>
            </div>
            <% } %>
        </div>

        <!-- Tip Card -->
        <div class="tip-sec reveal">
            <div class="tip-card">
                <div class="tip-inner">
                    <div class="tip-icon">
                        <i class="fas fa-lightbulb"></i>
                    </div>
                    <h3>نصائح هامة للتقديم</h3>
                    <p>تأكد من قراءة المتطلبات جيدًا قبل التقديم. اكتب معلومات دقيقة وصادقة، فجميع الطلبات تخضع للمراجعة الدقيقة من قبل فريق الإدارة.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
// Scroll Reveal
(function(){
    var els = document.querySelectorAll('.reveal');
    if (!els.length) return;
    var io = new IntersectionObserver(function(entries){
        entries.forEach(function(e){
            if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); }
        });
    }, { threshold: 0.12 });
    els.forEach(function(el){ io.observe(el); });
})();

// Holo 3D Tilt — نفس فيزياء حروف WALTON بالفوتر: تتبّع المؤشر ل إطار + ارتداد نابض عند المغادرة
(function(){
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var MAX = 8, LIFT = 7, CHASE = 0.5, RELEASE = 0.72, MIN = 0.6;
    var live = null, touchGate = 0;
    // اللمس ما يولّد تمايل: أي لمس يمنع أحداث الماوس المزيفة 900ms
    document.addEventListener('touchstart', function(){ touchGate = Date.now(); }, { passive: true, capture: true });
    document.querySelectorAll('.deck .hcard').forEach(function(card){
        if (card.dataset.tilt) return;
        card.dataset.tilt = '1';
        var raf = null, active = false;
        var ax = 0, ay = 0, az = 0, tx = 0, ty = 0, tl = 0, rect = null;
        function frame(){
            var k = active ? CHASE : (1 - RELEASE);
            ax += (tx - ax) * k;
            ay += (ty - ay) * k;
            az += (tl - az) * k;
            card.style.transform = 'perspective(900px) translateY(' + az.toFixed(2) + 'px) rotateX(' + ax.toFixed(2) + 'deg) rotateY(' + ay.toFixed(2) + 'deg)';
            if (active || Math.abs(ax) > MIN || Math.abs(ay) > MIN || Math.abs(az) > 0.3) {
                raf = requestAnimationFrame(frame);
            } else {
                raf = null;
                card.style.transform = '';
                card.style.transition = '';
                card.classList.remove('tilting');
                if (live === card) live = null;
            }
        }
        card.addEventListener('mouseenter', function(e){
            if (Date.now() - touchGate < 900) return;
            rect = card.getBoundingClientRect();
            active = true; tx = 0; ty = 0; tl = -LIFT;
            card.style.transition = 'box-shadow .4s ease, border-color .4s ease';
            card.classList.add('tilting');
            live = card;
            if (!raf) raf = requestAnimationFrame(frame);
        });
        card.addEventListener('mousemove', function(e){
            if (Date.now() - touchGate < 900) return;
            if (!rect) rect = card.getBoundingClientRect();
            var px = (e.clientX - rect.left) / rect.width - 0.5;
            var py = (e.clientY - rect.top) / rect.height - 0.5;
            ty = px * MAX * 2;
            tx = -py * MAX * 2;
            card.style.setProperty('--mx', (e.clientX - rect.left).toFixed(1) + 'px');
            card.style.setProperty('--my', (e.clientY - rect.top).toFixed(1) + 'px');
        });
        card.addEventListener('mouseleave', function(){
            active = false; tx = 0; ty = 0; tl = 0; rect = null;
        });
        card.__invalidate = function(){ rect = null; };
    });
    window.addEventListener('scroll', function(){
        if (live && live.__invalidate) live.__invalidate();
    }, { passive: true });
})();
</script>

<%- include('../partials/footer') %>
