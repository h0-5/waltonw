<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/company-page.css">
<%- include('../partials/navbar') %>

<%
    /* ═══ حسابات عرض من بيانات الصفحة الحقيقية فقط (لا إضافات خارجية) ═══ */
    var realAvailable = activityItems.filter(function(i) { return i.service_status === 'available'; }).length;
    var myLiveBk = 0;
    if (farmState && farmState.myBookings) {
        farmState.myBookings.forEach(function(b) {
            if (['pending_payment','pending_confirm'].indexOf(b.status) !== -1 || (b.status === 'active' && !b.faction_removed)) myLiveBk++;
        });
    }
%>

<div class="cy-co-page" dir="rtl">
    <!-- ═══ HERO ═══ -->
    <header class="cy-co-hero">
        <% if (farmState && farmState.serviceOpen) { %>
        <div class="cy-co-hero-badge"><span class="pulse-dot"></span> خدمات الشركة تستقبل الطلبات الآن</div>
        <% } %>
        <div class="cy-co-hero-icon">
            <div class="hex-ring"></div>
            <div class="hex-ring2"></div>
            <div class="hex-core"><i class="fas fa-briefcase"></i></div>
        </div>
        <h1 class="page-heading">الشركة</h1>
        <p class="cy-co-hero-sub">معلومات و خدمات شركة والتون</p>
        <div class="cy-co-hero-line"></div>
    </header>

    <div class="cy-co-main">

        <!-- ═══ شريط الإحصائيات — أرقام حقيقية من بيانات الصفحة ═══ -->
        <section class="cy-co-stats cy-co-reveal">
            <div class="cy-co-stat">
                <div class="stat-ic"><i class="fas fa-concierge-bell"></i></div>
                <div><div class="stat-num"><%= realAvailable %></div><div class="stat-lbl">خدمات متاحة</div></div>
            </div>
            <% if (farmState) {
                var fsTxt = !farmState.serviceOpen ? 'مقفلة' : (farmState.anyFree ? 'متاحة' : (farmState.anyQueueable ? 'مشغولة' : 'غير متاحة'));
                var fsSt = !farmState.serviceOpen ? 'off' : (farmState.anyFree ? 'ok' : (farmState.anyQueueable ? 'future' : 'no'));
            %>
            <div class="cy-co-stat pu">
                <div class="stat-ic"><i class="fas fa-seedling"></i></div>
                <div><div class="stat-num stat-txt" id="cyStatFarm" data-st="<%= fsSt %>"><%= fsTxt %></div><div class="stat-lbl">حالة المزرعة</div></div>
            </div>
            <% } %>
            <% if (user && farmState) { %>
            <div class="cy-co-stat">
                <div class="stat-ic"><i class="fas fa-clock"></i></div>
                <div><div class="stat-num" id="cyStatFarms"><%= myLiveBk %></div><div class="stat-lbl">حجوزاتك القائمة</div></div>
            </div>
            <% } %>
            <% if (user) { %>
            <div class="cy-co-stat pu">
                <div class="stat-ic"><i class="fas fa-list-check"></i></div>
                <div><div class="stat-num" id="cyStatReqs">—</div><div class="stat-lbl">طلباتك المفتوحة</div></div>
            </div>
            <% } %>
        </section>

        <!-- ═══ تنقل سريع بين جزئي الصفحة — معلومات منفصلة عن الخدمات مثل الحال الحالي ═══ -->
        <div class="cy-co-nav cy-co-reveal" id="cyCoNav">
            <a href="#cy-info" class="cy-co-nav-btn active" data-target="cy-info"><i class="fas fa-info-circle"></i> معلومات الشركة</a>
            <a href="#cy-services" class="cy-co-nav-btn" data-target="cy-services"><i class="fas fa-concierge-bell"></i> الخدمات</a>
        </div>

        <!-- Info Section -->
        <div id="section-info" class="active">
        <div class="cy-co-sec-head cy-co-reveal" id="cy-info">
            <div class="cy-co-sec-ic"><i class="fas fa-info-circle"></i></div>
            <h2 class="cy-co-sec-title">معلومات الشركة</h2>
            <span class="cy-co-sec-line"></span>
        </div>
            <% if (infoItems.length === 0) { %>
            <div class="cy-co-empty cy-co-reveal">
                <div class="cy-co-empty-icon"><i class="fas fa-info-circle"></i></div>
                <h3>لا توجد معلومات مضافة حالياً</h3>
                <p>سيتم إضافة معلومات الشركة قريباً</p>
            </div>
            <% } else { %>
            <div class="cy-co-grid">
            <% infoItems.forEach(function(item, i) { %>
            <div class="cy-co-card cy-co-reveal" style="transition-delay:<%= i * 0.08 %>s">
                <div class="cy-co-header">
                    <div class="cy-co-icon<%= i % 2 === 1 ? ' pu' : '' %>"><i class="fas fa-building"></i></div>
                    <h3 class="cy-co-title"><%= item.title %></h3>
                </div>
                <div class="cy-co-body">
                    <% if (item.description) { %><p class="cy-co-desc"><%= item.description %></p><% } %>
                    <% if (item.image) { %>
                    <div class="cy-co-img-wrap" onclick="openLightbox(this.dataset.img)" data-img="<%= item.image %>">
                        <img src="<%= item.image %>" alt="<%= item.title %>" loading="<%= i <= 1 ? 'eager' : 'lazy' %>" decoding="async">
                        <div class="cy-co-img-hint"><i class="fas fa-search-plus"></i> تكبير</div>
                    </div>
                    <% } %>
                </div>
            </div>
            <% }); %>
            </div>
            <% } %>
        </div>

        <!-- Services Section (يظهر بس من زر «الخدمات» فوق) -->
        <div id="section-services">
        <div class="cy-co-sec-head cy-co-reveal" id="cy-services" style="margin-top:.5rem">
            <div class="cy-co-sec-ic"><i class="fas fa-concierge-bell"></i></div>
            <h2 class="cy-co-sec-title">خدمات الشركة</h2>
            <span class="cy-co-sec-line"></span>
            <% if (user) { %>
            <button class="cy-co-sec-btn" onclick="svcOpenMy()"><i class="fas fa-list-check"></i> طلباتي <span class="sec-btn-cnt" id="svcMyCount"></span></button>
            <% } %>
        </div>
            <% if (farmState) { %>
            <!-- خدمة استئجار المزارع — البطاقة المميزة -->
            <% /* بادج أولي من السيرفر — للمستخدم يعيد حسابه JS فوراً، وللزائر يبقى صحيحاً بدل «جاري التحديث» */ %>
            <% var fbTxt = !farmState.serviceOpen ? '<i class="fas fa-lock"></i> الخدمة مقفلة حالياً' : (farmState.anyFree ? '<i class="fas fa-check-circle"></i> متوفر — احجز الآن' : (farmState.anyQueueable ? '<i class="fas fa-clock"></i> مشغولة — تقدر تحجز للفترة الجاية' : '<i class="fas fa-times-circle"></i> غير متوفر'));
               var fbCls = !farmState.serviceOpen ? 'off' : (farmState.anyFree ? 'ok' : (farmState.anyQueueable ? 'future' : 'no')); %>
            <div class="cy-co-card farm cy-co-reveal">
                <div class="cy-co-header">
                    <div class="cy-co-icon"><i class="fas fa-seedling"></i></div>
                    <h3 class="cy-co-title">استئجار المزرعة</h3>
                    <span id="farmBadge" class="cy-farm-badge <%= fbCls %>"><%- fbTxt %></span>
                </div>
                <div class="cy-co-body">
                    <p class="cy-co-desc">احجز مزرعتك من شركة والتون — الأسعار والشروط وبيانات التحويل كلها داخل نافذة الحجز.</p>
                    <div class="cy-farm-chips">
                        <span class="f-chip"><i class="fas fa-coins"></i> العربون <b><%= farmState.config.deposit_pct %>%</b> من الإيجار</span>
                        <span class="f-chip"><i class="fas fa-hourglass-half"></i> مهلة الدفع <b><%= farmState.config.payment_window_hours %></b> ساعة</span>
                        <span class="f-chip"><i class="fas fa-users"></i> حتى <b><%= farmState.config.max_workers %></b> عمال — <b><%= Number(farmState.config.worker_price).toLocaleString('en-US') %>$</b> للعامل</span>
                        <span class="f-chip"><i class="fas fa-clock-rotate-left"></i> التمديد بآخر <b><%= farmState.config.extend_window_hours %></b> ساعة</span>
                    </div>
                    <div class="cy-farm-actions">
                        <% if (user) { %>
                        <button id="farmBookBtn" class="cy-farm-btn primary" onclick="openFarmBook()"><i class="fas fa-seedling"></i> حجز المزرعة</button>
                        <button class="cy-farm-btn ghost" onclick="openFarmMy()"><i class="fas fa-list-check"></i> حجوزاتي <span id="farmMyCount" style="color:var(--accent)"></span></button>
                        <% } else { %>
                        <a href="/auth/discord" class="cy-farm-btn ghost"><i class="fas fa-sign-in-alt"></i> سجل دخول للحجز</a>
                        <% } %>
                    </div>
                </div>
            </div>
            <% } %>

            <% if (activityItems.length === 0 && !farmState) { %>
            <div class="cy-co-empty cy-co-reveal">
                <div class="cy-co-empty-icon"><i class="fas fa-concierge-bell"></i></div>
                <h3>لا توجد خدمات مضافة حالياً</h3>
                <p>سيتم إضافة خدمات الشركة قريباً</p>
            </div>
            <% } else if (activityItems.length > 0) { %>
            <div class="cy-co-grid svc">
            <% activityItems.forEach(function(item, i) {
                /* خدمة حقيقية = حالة صريحة (متوفر/قريباً/منتهي) — العناصر العادية تنعرض بدون أزرار طلب */
                var isSvc = ['available','coming_soon','ended'].indexOf(item.service_status) !== -1;
                var chipCls = item.service_status === 'available' ? 'ok' : (item.service_status === 'coming_soon' ? 'soon' : (item.service_status === 'ended' ? 'end' : ''));
                var chipLbl = {available:'متوفر', coming_soon:'قريباً', ended:'منتهي'}[item.service_status] || '';
                var svcIcon = (item.icon || '').trim();
                var iconHtml = svcIcon ? (svcIcon.indexOf('fa') === 0 ? '<i class="fas ' + svcIcon + '"></i>' : '<span style="font-size:1.1rem;line-height:1">' + svcIcon + '</span>') : '<i class="fas fa-concierge-bell"></i>';
            %>
            <div class="cy-co-card cy-co-reveal<%= isSvc ? ' svc-card' : '' %><%= item.service_status === 'ended' ? ' ended' : '' %>" style="transition-delay:<%= i * 0.08 %>s">
                <% if (isSvc && chipLbl) { %>
                <span class="cy-co-chip <%= chipCls %>"><i class="dot"></i> <%= chipLbl %></span>
                <% } %>
                <div class="cy-co-header">
                    <div class="cy-co-icon<%= i % 2 === 1 ? ' pu' : '' %>"><%- iconHtml %></div>
                    <h3 class="cy-co-title"><%= item.title %></h3>
                </div>
                <div class="cy-co-body">
                    <% if (item.description) { %><p class="cy-co-desc"><%= item.description %></p><% } %>
                    <% if (item.image) { %>
                    <div class="cy-co-img-wrap" onclick="openLightbox(this.dataset.img)" data-img="<%= item.image %>">
                        <img src="<%= item.image %>" alt="<%= item.title %>" loading="<%= i <= 1 ? 'eager' : 'lazy' %>" decoding="async">
                        <div class="cy-co-img-hint"><i class="fas fa-search-plus"></i> تكبير</div>
                    </div>
                    <% } %>
                    <% if (isSvc && item.service_status !== 'ended') { %>
                    <div class="cy-co-card-actions">
                        <% if (item.service_status === 'coming_soon') { %>
                        <span class="cy-svc-btn soon"><i class="fas fa-clock"></i> قريباً</span>
                        <% } else if (user) { %>
                        <button class="cy-svc-btn" onclick="openSvcForm(<%= item.id %>)"><i class="fas fa-hand-paper"></i> استفادة من الخدمة</button>
                        <% } else { %>
                        <a href="/auth/discord" class="cy-svc-btn login"><i class="fas fa-sign-in-alt"></i> سجل دخول للاستفادة</a>
                        <% } %>
                    </div>
                    <% } %>
                </div>
            </div>
            <% }); %>
            </div>
            <% } %>
        </div>
    </div>
</div>

<% if (farmState && user) { %>
<!-- نافذة الحجز — بنفسجية زجاجية مع خطوات -->
<div id="farmBookModal" class="cy-f-modal" onclick="if(event.target===this)farmClose('farmBookModal')">
    <div class="cy-f-box">
        <div class="cy-f-box-head">
            <h3><i class="fas fa-seedling" style="color:var(--accent)"></i> حجز مزرعة</h3>
            <button class="cy-f-x" onclick="farmClose('farmBookModal')"><i class="fas fa-times"></i></button>
        </div>
        <div class="cy-f-box-body">
            <div class="cy-f-steps" id="farmSteps">
                <div class="cy-f-step now" data-s="1"><div class="step-dot">1</div><div class="step-lbl">اختر المدة</div></div>
                <div class="cy-f-step" data-s="2"><div class="step-dot">2</div><div class="step-lbl">أنشئ الحجز</div></div>
                <div class="cy-f-step" data-s="3"><div class="step-dot">3</div><div class="step-lbl">حوّل العربون</div></div>
            </div>

            <ul class="cy-farm-rules cy-f-rules-mini">
                <li><i class="fas fa-coins"></i><span><b>العربون:</b> <%= farmState.config.deposit_pct %>% من الإيجار على بنك الشركة — وبعد تأكيده تحوّل <b>النص الثاني</b> (باقي الإيجار) وإلا ما ينعكس الحجز.</span></li>
                <li><i class="fas fa-hourglass-half"></i><span><b>مهلة الدفع:</b> <%= farmState.config.payment_window_hours %> ساعات للعربون — بعدها ينلغى تلقائياً.</span></li>
                <li><i class="fas fa-hourglass-start"></i><span><b>النص الثاني:</b> بعد تأكيد العربون يبقى عندك <%= farmState.config.remainder_window_hours %> ساعات — وإلا قبل البداية بساعة ينلغي الحجز <b>وتخسر العربون</b>.</span></li>
                <li><i class="fas fa-ban"></i><span><b>الإلغاء:</b> يخسر <%= Math.round(farmState.config.deposit_pct / 2) %>% من العربون — آخر موعد قبل البداية بـ <%= farmState.config.cancel_cutoff_hours %> ساعات.</span></li>
                <li><i class="fas fa-clock-rotate-left"></i><span><b>التمديد:</b> فقط خلال آخر <%= farmState.config.extend_window_hours %> ساعة قبل الانتهاء.</span></li>
                <li><i class="fas fa-users"></i><span><b>اضافة عمال:</b> حتى <%= farmState.config.max_workers %> بـ <%= Number(farmState.config.worker_price).toLocaleString('en-US') %>$ للعامل — اسم شخصية كاملة وصحيحة.</span></li>
            </ul>

            <div class="cy-farm-warn cy-f-warn-mini">
                <i class="fas fa-triangle-exclamation"></i>
                <span>مسؤولية الاسم على صاحبها — أي خطأ بكتابة اسم الشخصية (المستأجر أو العامل) يتحمل صاحبه نتيجته.</span>
            </div>

            <div style="font-size:.8rem;color:rgba(255,255,255,.6);margin:.9rem 0 .5rem">حالة المزارع:</div>
            <div class="cy-farm-avail" id="farmAvail" style="margin-bottom:.9rem"></div>
            <div id="farmFutureNote" style="display:none;margin:-.3rem 0 .9rem;padding:.65rem .85rem;border-radius:10px;background:rgba(56,189,248,.07);border:1px solid rgba(56,189,248,.28);font-size:.78rem;color:rgba(255,255,255,.85);line-height:1.7"></div>

            <div style="font-size:.8rem;color:rgba(255,255,255,.6);margin-bottom:.8rem">اختر المدة — المدد ثابتة والأسعار من إدارة الشركة:</div>
            <div class="cy-f-dur-grid" id="farmDurGrid"></div>
            <div class="cy-f-summary" id="farmBookSummary" style="display:none">
                <div class="row"><span>قيمة الإيجار</span><b id="farmSumRent">—</b></div>
                <div class="row dep"><span>العربون المطلوب الآن (<%= farmState.config.deposit_pct %>%)</span><b id="farmSumDep">—</b></div>
                <div class="row muted"><span>مهلة الدفع</span><span><%= farmState.config.payment_window_hours %> ساعات — بعدها ينلغى تلقائياً</span></div>
            </div>

            <label class="cy-f-pledge" style="margin-top:.9rem">
                <input type="checkbox" id="farmPledge" onchange="farmPledgeTick()">
                <span><b>أتعهد أحوّل العربون</b> (<%= farmState.config.deposit_pct %>% من الإيجار) على بنك الشركة خلال <%= farmState.config.payment_window_hours %> ساعات من إنشاء الحجز — وإلا ينلغى الحجز تلقائياً.</span>
            </label>

            <div class="cy-farm-bank" style="margin-top:1rem">
                <i class="fas fa-building-columns"></i>
                <code id="farmBank"><%= farmState.config.bank_account %></code>
                <button onclick="farmCopyBank()"><i class="fas fa-copy"></i> نسخ</button>
            </div>

            <div class="cy-farm-actions" style="margin-top:1.1rem">
                <button class="cy-farm-btn primary" id="farmBookSubmit" onclick="farmSubmitBook()" disabled><i class="fas fa-check"></i> إنشاء الحجز</button>
                <button class="cy-farm-btn ghost" onclick="farmClose('farmBookModal')">إلغاء</button>
            </div>
        </div>
    </div>
</div>

<!-- نافذة حجوزاتي -->
<div id="farmMyModal" class="cy-f-modal" onclick="if(event.target===this)farmClose('farmMyModal')">
    <div class="cy-f-box" style="max-width:640px">
        <div class="cy-f-box-head">
            <h3><i class="fas fa-list-check" style="color:var(--accent)"></i> حجوزاتي</h3>
            <button class="cy-f-x" onclick="farmClose('farmMyModal')"><i class="fas fa-times"></i></button>
        </div>
        <div class="cy-f-box-body" id="farmMyList"></div>
    </div>
</div>

<!-- نافذة التمديد -->
<div id="farmExtModal" class="cy-f-modal" onclick="if(event.target===this)farmClose('farmExtModal')">
    <div class="cy-f-box">
        <div class="cy-f-box-head">
            <h3><i class="fas fa-clock-rotate-left" style="color:var(--accent)"></i> تمديد الحجز <span id="farmExtRef" style="color:var(--accent);font-family:ui-monospace,Menlo,monospace;direction:ltr;display:inline-block"></span></h3>
            <button class="cy-f-x" onclick="farmClose('farmExtModal')"><i class="fas fa-times"></i></button>
        </div>
        <div class="cy-f-box-body">
            <div style="font-size:.8rem;color:rgba(255,255,255,.6);margin-bottom:.8rem">اختر مدة التمديد — تنضاف على نهاية حجزك الحالي:</div>
            <div class="cy-f-dur-grid" id="farmExtDurGrid"></div>
            <div class="cy-f-summary" id="farmExtSummary" style="display:none">
                <div class="row"><span>قيمة إيجار التمديد</span><b id="farmExtRent">—</b></div>
                <div class="row dep"><span>عربون التمديد (<%= farmState.config.deposit_pct %>%)</span><b id="farmExtDep">—</b></div>
            </div>
            <div class="cy-farm-actions" style="margin-top:1.1rem">
                <button class="cy-farm-btn primary" id="farmExtSubmit" onclick="farmSubmitExtend()" disabled><i class="fas fa-check"></i> طلب التمديد</button>
                <button class="cy-farm-btn ghost" onclick="farmClose('farmExtModal')">إلغاء</button>
            </div>
        </div>
    </div>
</div>

<% } %>

<% /* توست خارج كل الشروط — الإشعارات تشتغل حتى لو قسم المزارع مقفل */ %>
<div id="farmToast" class="cy-f-toast"></div>

<!-- نافذة طلب خدمة -->
<div id="svcModal" class="cy-co-lightbox" style="display:none;z-index:200" onclick="closeSvcModal()">
    <div class="cy-svc-box" onclick="event.stopPropagation()">
        <div class="cy-svc-head">
            <h3 id="svcModalTitle"><i class="fas fa-concierge-bell" style="color:var(--accent)"></i> طلب خدمة</h3>
            <span id="svcPkgBadge" class="cy-svc-pkg-badge" style="display:none"></span>
        </div>
        <div id="svcPkgStep" class="cy-svc-pkg-step"></div>
        <form id="svcForm" class="cy-svc-form" style="display:none" onsubmit="submitServiceRequest(event)">
            <input type="hidden" name="service_id" id="svcFormSid">
            <input type="hidden" name="package_id" id="svcFormPkgId" value="0">
            <div id="svcFormQuestions"></div>
            <div class="cy-svc-form-actions">
                <button type="submit">إرسال الطلب</button>
                <button type="button" onclick="closeSvcModal()">إلغاء</button>
            </div>
        </form>
        <% /* شاشة النجاح — تظهر مكان الفورم أول ما يُرسل الطلب */ %>
        <div id="svcSuccess" class="cy-svc-success" style="display:none">
            <div class="ok-ic"><i class="fas fa-check"></i></div>
            <div class="ok-t">تم ارسال طلب بنجاح</div>
            <div class="ok-s">بانتظار رد الإدارة</div>
            <div class="ok-n">راح يوصلك إشعار بالنتيجة على جرس الإشعارات فوق</div>
            <button type="button" onclick="svcSuccessDone()">تم</button>
        </div>
    </div>
</div>

<div id="lightbox" class="cy-co-lightbox" onclick="closeLightbox()">
    <img id="lightboxImg" src="" alt="صورة مكبرة">
    <button class="cy-co-lightbox-close" onclick="closeLightbox()"><i class="fas fa-times"></i></button>
</div>

<script>
var svcQData = <%- JSON.stringify(servicesQuestions) %>;
var svcPkgData = <%- JSON.stringify(servicesPackages) %>;

function showTab(tab) { /* الأقسام صارت ظاهرة كلها بدون تابات */ }
/* تهريب HTML — أي نص من المستخدم ما يدخل كـ HTML (حماية من إدخال أكواد) */
function cyEsc(s) { return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); }
/* توست موحد — يستخدم توست المزرعة إذا موجود، وإلا يسوي عنصر خاص */
function cyToast(msg, err, ok) {
    var t = document.getElementById('farmToast');
    if (!t) {
        t = document.createElement('div');
        t.id = 'farmToast'; t.className = 'cy-f-toast';
        document.body.appendChild(t);
    }
    t.innerHTML = msg; t.className = 'cy-f-toast show' + (err ? ' err' : (ok ? ' ok' : ''));
    clearTimeout(t._h); t._h = setTimeout(function() { t.className = 'cy-f-toast' + (err ? ' err' : (ok ? ' ok' : '')); }, ok ? 7000 : 5200);
}
function openLightbox(src) { document.getElementById('lightboxImg').src = src; document.getElementById('lightbox').classList.add('open'); if (event) event.stopPropagation(); }
function closeLightbox() { document.getElementById('lightbox').classList.remove('open'); document.getElementById('lightboxImg').src = ''; }
document.addEventListener('keydown', function(e) { if (e.key === 'Escape') { closeLightbox(); closeSvcModal(); } });

function openSvcForm(sid) {
    document.getElementById('svcModal').style.display = 'flex';
    document.getElementById('svcFormSid').value = sid;
    document.getElementById('svcFormPkgId').value = '0';
    var pkgs = svcPkgData[sid] || [];
    if (pkgs.length > 0) {
        document.getElementById('svcPkgStep').style.display = '';
        document.getElementById('svcForm').style.display = 'none';
        document.getElementById('svcPkgBadge').style.display = 'none';
        var h = '<div style="text-align:center;margin-bottom:1.2rem"><div style="color:var(--accent);font-weight:700;font-size:.95rem">اختر البكج المناسب</div></div>';
        pkgs.forEach(function(pkg) {
            var img = pkg.image_type === 'emoji' ? '<span style="font-size:2.5rem">' + pkg.image_value + '</span>' : '<img src="' + pkg.image_value + '" style="width:64px;height:64px;border-radius:12px;object-fit:cover">';
            h += '<div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:14px;padding:1rem;margin-bottom:.8rem;display:flex;gap:.8rem;align-items:center;cursor:pointer;transition:all .2s" onclick="selectPackage(' + sid + ',' + pkg.id + ')">'
                + img + '<div style="flex:1"><div style="color:var(--text, #fff);font-weight:700">' + pkg.name + '</div>'
                + '<div style="color:var(--accent);font-weight:700;font-size:.85rem">$' + (+pkg.price).toFixed(2) + ' · ' + pkg.days + ' يوم</div></div></div>';
        });
        document.getElementById('svcPkgStep').innerHTML = h;
    } else { showSvcQuestions(sid); }
}
function selectPackage(sid, pkgId) {
    document.getElementById('svcFormPkgId').value = pkgId;
    var pkgs = svcPkgData[sid] || [];
    for (var i=0;i<pkgs.length;i++) { if (pkgs[i].id==pkgId) {
        document.getElementById('svcPkgBadge').style.display = 'inline-block';
        document.getElementById('svcPkgBadge').textContent = pkgs[i].name + ' · $' + (+pkgs[i].price).toFixed(2);
    }}
    showSvcQuestions(sid);
}
function showSvcQuestions(sid) {
    document.getElementById('svcPkgStep').style.display = 'none';
    document.getElementById('svcForm').style.display = '';
    var qs = svcQData[sid] || [{id:'d_name',question:'الاسم الكامل',type:'text',required:1},{id:'d_phone',question:'رقم الجوال',type:'text',required:1},{id:'d_notes',question:'ملاحظات',type:'text',required:0}];
    var h = '';
    qs.forEach(function(q) {
        var r = q.required == 1;
        h += '<div style="margin-bottom:1.2rem"><label style="color:var(--text, #fff);font-weight:600;font-size:.9rem;display:block;margin-bottom:.5rem">' + q.question + (r?' <span style="color:#ef4444">*</span>':'') + '</label>';
        if (q.type === 'text' || q.type === 'datetime' || q.type === 'character_name')
            h += '<input type="text" name="sq_' + q.id + '" ' + (r?'required':'') + (q.type === 'character_name' ? ' pattern="[A-Za-z]{2,16}_[A-Za-z]{2,16}(_[A-Za-z]{2,16})?" title="مثال: Hadi_Walton — اسم الشخصية كاملة كما هو بالسيرفر" placeholder="Hadi_Walton"' : ' placeholder="أدخل الإجابة..."') + ' style="width:100%;padding:.7rem;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);border-radius:10px;color:var(--text, #fff);font-size:.85rem;box-sizing:border-box">';
        else if (q.type === 'image')
            h += '<input type="file" name="sq_' + q.id + '" accept="image/*" ' + (r?'required':'') + ' style="width:100%;padding:.6rem;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);border-radius:10px;color:#fff;font-size:.85rem;box-sizing:border-box">';
        else if (q.type === 'price')
            h += '<div style="color:var(--accent);font-weight: 800;font-size:1.6rem;text-align:center">$' + (+q.price_per_day).toFixed(2) + '</div><input type="hidden" name="sq_' + q.id + '" value="1">';
        h += '</div>';
    });
    document.getElementById('svcFormQuestions').innerHTML = h;
}
function closeSvcModal() { document.getElementById('svcModal').style.display = 'none'; }

var svcSuccessTimer = null;
/* شاشة النجاح داخل النافذة — أول ما ينرسل الطلب يشوف التأكيد فوراً بمكانه + توست أخضر */
function showSvcSuccess() {
    document.getElementById('svcForm').style.display = 'none';
    document.getElementById('svcPkgStep').style.display = 'none';
    document.getElementById('svcSuccess').style.display = '';
    clearTimeout(svcSuccessTimer);
    svcSuccessTimer = setTimeout(svcSuccessDone, 4200);
}
function svcSuccessDone() {
    clearTimeout(svcSuccessTimer);
    document.getElementById('svcSuccess').style.display = 'none';
    closeSvcModal();
}
async function submitServiceRequest(e) {
    e.preventDefault();
    var btn = e.target.querySelector('button[type="submit"]');
    if (btn) btn.disabled = true;
    try {
        var fd = new FormData(e.target);
        var res = await fetch('/api/company/service-request', { method: 'POST', body: fd });
        var data = await res.json();
        if (data.success) {
            showSvcSuccess();
            cyToast('✅ تم ارسال طلب بنجاح — بانتظار رد الإدارة', false, true);
        } else {
            cyToast(cyEsc(data.error || 'خطأ'), true);
        }
    } catch (err) { cyToast('خطأ بالاتصال', true); }
    if (btn) btn.disabled = false;
}
</script>

<% if (farmState && user) { %>
<script>
/* ═══ نظام استئجار المزارع ═══ */
var farmState = <%- JSON.stringify(farmState) %>;
var farmSelDur = null, farmExtBid = null, farmExtDur = null;

function farmMoney(n) { return Number(n || 0).toLocaleString('en-US'); }
function farmFmtDT(iso) {
    if (!iso) return '—';
    var d = new Date(iso), p = function(x) { return (x < 10 ? '0' : '') + x; };
    return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()) + ' ' + p(d.getHours()) + ':' + p(d.getMinutes());
}
function farmToast(msg, err) {
    var t = document.getElementById('farmToast');
    t.innerHTML = msg; t.className = 'cy-f-toast show' + (err ? ' err' : '');
    clearTimeout(t._h); t._h = setTimeout(function() { t.className = 'cy-f-toast' + (err ? ' err' : ''); }, 5200);
}
function farmClose(id) { document.getElementById(id).classList.remove('open'); }
function farmCopyBank() {
    var txt = document.getElementById('farmBank').textContent.trim();
    if (navigator.clipboard) navigator.clipboard.writeText(txt);
    farmToast('تم نسخ رقم بنك الشركة: ' + txt);
}

async function farmRefresh() {
    try {
        var r = await fetch('/api/farm/state', { cache: 'no-store' });
        farmState = await r.json();
        farmRenderCard(); farmRenderMy();
    } catch (e) {}
}

function openFarmMy() {
    document.getElementById('farmMyModal').classList.add('open');
    farmRenderMy();
}

/* مؤشر الخطوات داخل نافذة الحجز — عنصر بصري فقط ما يغيّر أي منطق */
function farmSetStep(n) {
    var steps = document.querySelectorAll('#farmSteps .cy-f-step');
    steps.forEach(function(s) {
        var v = +s.dataset.s;
        s.classList.toggle('done', v < n);
        s.classList.toggle('now', v === n);
    });
}

function farmRenderCard() {
    var badge = document.getElementById('farmBadge');
    var avail = document.getElementById('farmAvail');
    var btn = document.getElementById('farmBookBtn');
    if (!badge || !farmState) return;
    var myLive = (farmState.myBookings || []).filter(function(b) {
        return ['pending_payment','pending_confirm'].indexOf(b.status) !== -1 ||
               (b.status === 'active' && !b.faction_removed);
    }).length;
    var cnt = document.getElementById('farmMyCount');
    if (cnt) cnt.textContent = myLive ? '(' + myLive + ' قائم)' : '';
    /* تحديث إحصائيات الصفحة — نفس البيانات الحقيقية */
    var stFarms = document.getElementById('cyStatFarms');
    if (stFarms) stFarms.textContent = myLive;
    var stFarm = document.getElementById('cyStatFarm');
    if (stFarm) {
        if (!farmState.serviceOpen) { stFarm.textContent = 'مقفلة'; stFarm.dataset.st = 'off'; }
        else if (farmState.anyFree) { stFarm.textContent = 'متاحة'; stFarm.dataset.st = 'ok'; }
        else if (farmState.anyQueueable) { stFarm.textContent = 'مشغولة'; stFarm.dataset.st = 'future'; }
        else { stFarm.textContent = 'غير متاحة'; stFarm.dataset.st = 'no'; }
    }
    if (!farmState.serviceOpen) {
        badge.className = 'cy-farm-badge off'; badge.innerHTML = '<i class="fas fa-lock"></i> الخدمة مقفلة حالياً';
    } else if (farmState.anyFree) {
        badge.className = 'cy-farm-badge ok'; badge.innerHTML = '<i class="fas fa-check-circle"></i> متوفر — احجز الآن';
    } else if (farmState.anyQueueable) {
        badge.className = 'cy-farm-badge future'; badge.innerHTML = '<i class="fas fa-clock"></i> مشغولة — تقدر تحجز للفترة الجاية';
    } else {
        badge.className = 'cy-farm-badge no'; badge.innerHTML = '<i class="fas fa-times-circle"></i> غير متوفر';
    }
    if (avail) {
        avail.innerHTML = farmState.farms.map(function(f) {
            var cls, ic, txt;
            if (!f.enabled) { cls = 'disabled'; ic = 'fa-pause'; txt = f.name + ' — موقوفة'; }
            else if (f.free) { cls = 'free'; ic = 'fa-check'; txt = f.name + ' — متاحة الآن'; }
            else if (f.queueable && f.busy_until_iso) { cls = 'future'; ic = 'fa-clock'; txt = f.name + ' — مشغولة، الحجز الجديد يبدأ ' + farmFmtDT(f.busy_until_iso); }
            else { cls = 'busy'; ic = 'fa-lock'; txt = f.name + ' — محجوزة'; }
            return '<span class="' + cls + '"><i class="fas ' + ic + '"></i> ' + txt + '</span>';
        }).join('');
    }
    if (btn) {
        if (!farmState.serviceOpen) { btn.disabled = true; btn.innerHTML = '<i class="fas fa-lock"></i> الخدمة مقفلة'; }
        else if (farmState.anyFree) { btn.disabled = false; btn.innerHTML = '<i class="fas fa-seedling"></i> حجز المزرعة'; }
        else if (farmState.anyQueueable) { btn.disabled = false; btn.innerHTML = '<i class="fas fa-clock"></i> حجز — يبدأ بعد الحجز الحالي'; }
        else { btn.disabled = true; btn.innerHTML = '<i class="fas fa-times-circle"></i> غير متوفر'; }
    }
}

/* ── نافذة الحجز ── */
function openFarmBook() {
    farmSelDur = null;
    farmSetStep(1);
    var g = document.getElementById('farmDurGrid');
    g.innerHTML = farmState.config.prices.map(function(p) {
        return '<div class="cy-f-dur-chip" data-d="' + p.days + '" onclick="farmPickDur(' + p.days + ')"><b>' + p.days + ' يوم</b><span>' + farmMoney(p.price) + '$</span></div>';
    }).join('');
    var fn = document.getElementById('farmFutureNote');
    if (fn) {
        if (!farmState.anyFree && farmState.anyQueueable) {
            var earliest = null;
            (farmState.farms || []).forEach(function(f) {
                if (f.enabled && f.queueable && f.busy_until_iso && (!earliest || f.busy_until_iso < earliest)) earliest = f.busy_until_iso;
            });
            fn.style.display = '';
            fn.innerHTML = '<i class="fas fa-clock" style="color:#38bdf8"></i> <b style="color:#38bdf8">حجز مستقبلي:</b> كل المزارع مشغولة حالياً — حجزك راح يبدأ تلقائياً بعد انتهاء الحجز الحالي' +
                (earliest ? ' (أقرب بداية متاحة: <b>' + farmFmtDT(earliest) + '</b>)' : '') + '. ' +
                '<b>العربون يتحول اليوم (أول يوم حجز)</b> — وعداد النص الثاني يبدأ آخر ' + farmState.config.remainder_window_hours + ' ساعات قبل بداية حجزك.';
        } else fn.style.display = 'none';
    }
    document.getElementById('farmBookSummary').style.display = 'none';
    var cb = document.getElementById('farmPledge');
    if (cb) cb.checked = false;
    document.getElementById('farmBookSubmit').disabled = true;
    document.getElementById('farmBookModal').classList.add('open');
}
/* زر إنشاء الحجز يشتغل فقط بعد اختيار المدة + التعهد بتحويل العربون */
function farmPledgeTick() {
    var cb = document.getElementById('farmPledge');
    document.getElementById('farmBookSubmit').disabled = !(farmSelDur && cb && cb.checked);
    if (farmSelDur && cb && cb.checked) farmSetStep(3); else if (farmSelDur) farmSetStep(2);
}
function farmPickDur(d) {
    farmSelDur = d;
    var chips = document.querySelectorAll('#farmDurGrid .cy-f-dur-chip');
    for (var i = 0; i < chips.length; i++) chips[i].classList.toggle('sel', +chips[i].dataset.d === d);
    var price = 0;
    farmState.config.prices.forEach(function(p) { if (p.days === d) price = p.price; });
    var dep = Math.round(price * farmState.config.deposit_pct / 100);
    document.getElementById('farmSumRent').textContent = farmMoney(price) + '$';
    document.getElementById('farmSumDep').textContent = farmMoney(dep) + '$';
    document.getElementById('farmBookSummary').style.display = '';
    farmSetStep(2);
    farmPledgeTick();
}
async function farmSubmitBook() {
    if (!farmSelDur) return;
    var btn = document.getElementById('farmBookSubmit');
    btn.disabled = true;
    try {
        var r = await fetch('/api/farm/book', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ duration_days: farmSelDur })
        });
        var data = await r.json();
        if (data.success) {
            farmClose('farmBookModal');
            farmToast('🌾 ' + data.message);
            await farmRefresh();
            openFarmMy();
        } else { farmToast(data.error || 'خطأ', true); btn.disabled = false; }
    } catch (e) { farmToast('خطأ بالاتصال', true); btn.disabled = false; }
}

/* ── نافذة حجوزاتي ── */
function farmStBadge(b) { return '<span class="cy-f-st ' + b.status + '">' + b.statusLabel + '</span>'; }
function farmWorkerRow(w) {
    var del = w.status === 'pending_payment' ? ' <button class="del" onclick="farmWorkerDel(' + w.id + ')"><i class="fas fa-trash"></i> حذف</button>' : '';
    var pay = w.status === 'pending_payment' ? ' <button class="cy-farm-btn warn small" style="margin-right:4px" onclick="farmWorkerPaid(' + w.id + ')"><i class="fas fa-money-bill"></i> دفعت</button>' : '';
    return '<div class="cy-f-worker-row"><i class="fas fa-user"></i> <span style="direction:ltr;font-weight:700">' + w.name + '</span>' +
           '<span class="cy-f-st ' + w.status + '">' + w.statusLabel + '</span>' + farmMoney(w.amount) + '$' + pay + del + '</div>';
}
function farmBkActions(b) {
    var h = '';
    if (b.can.pay) h += '<button class="cy-farm-btn warn small" onclick="farmPaid(' + b.id + ')"><i class="fas fa-money-bill"></i> دفعت العربون</button>';
    if (b.can.payRemainder) h += '<button class="cy-farm-btn warn small" onclick="farmRemainderPaid(' + b.id + ')"><i class="fas fa-sack-dollar"></i> دفعت النص الثاني</button>';
    if (b.can.extend) h += '<button class="cy-farm-btn primary small" onclick="openFarmExt(' + b.id + ')"><i class="fas fa-clock-rotate-left"></i> تمديد</button>';
    if (b.can.addWorker) h += '<button class="cy-farm-btn ghost small" onclick="farmWorkerAdd(' + b.id + ')"><i class="fas fa-user-plus"></i> اضافة عامل</button>';
    if (b.can.cancel) {
        var warn = b.can.cancelPenalty > 0 ? 'الإلغاء راح يخسرك ' + farmMoney(b.can.cancelPenalty) + '$ (50% من العربون). متأكد؟' : 'متأكد من إلغاء الحجز؟';
        h += '<button class="cy-farm-btn danger small" onclick="if(confirm(\'' + warn.replace(/'/g, '') + '\'))farmCancel(' + b.id + ')"><i class="fas fa-ban"></i> إلغاء الحجز</button>';
    }
    return h;
}
async function farmWorkerAdd(bid) {
    var name = prompt('اسم الشخصية الكاملة للعامل كما هو بالسيرفر (مثال: Hadi_Walton):\nأي خطأ بالاسم مسؤولية صاحبه.');
    if (name === null) return;
    name = name.trim();
    if (!name) return;
    try {
        var r = await fetch('/api/farm/bookings/' + bid + '/workers', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ character_name: name })
        });
        var data = await r.json();
        if (data.success) {
            farmToast('👤 ' + data.message);
            await farmRefresh();
            openFarmMy();
        } else farmToast(data.error || 'خطأ', true);
    } catch (e) { farmToast('خطأ بالاتصال', true); }
}
function farmRenderMy() {
    var box = document.getElementById('farmMyList');
    if (!box) return;
    var list = farmState.myBookings || [];
    if (!list.length) {
        box.innerHTML = '<div style="text-align:center;padding:2rem;color:rgba(255,255,255,.5)"><i class="fas fa-inbox" style="font-size:2rem;display:block;margin-bottom:.7rem;color:rgba(var(--accent-rgb),.5)"></i>ما عندك حجوزات — أول ما تحجز يظهر هنا</div>';
        return;
    }
    box.innerHTML = list.map(function(b) {
        var h = '<div class="cy-f-bk">';
        h += '<div class="cy-f-bk-head"><span class="ref">' + b.ref + '</span>' + farmStBadge(b) +
             '<span style="font-size:.72rem;color:rgba(255,255,255,.55)">' + (b.farm_name || ('مزرعة ' + b.farm_no)) + '</span></div>';
        h += '<div class="cy-f-meta">' +
             '<span>المدة: <b>' + b.duration_days + ' يوم</b></span>' +
             '<span>الإيجار: <b>' + farmMoney(b.rent_amount) + '$</b></span>' +
             '<span>العربون: <b style="color:var(--accent)">' + farmMoney(b.deposit_amount) + '$</b></span>' +
             '<span>الإنشاء: <b>' + farmFmtDT(b.created_iso) + '</b></span>' +
             (b.is_future && b.scheduled_start_iso ? '<span style="color:#38bdf8"><i class="fas fa-clock"></i> البداية المتوقعة: <b>' + farmFmtDT(b.scheduled_start_iso) + '</b></span>' : '') +
             (b.start_iso ? '<span>البداية: <b>' + farmFmtDT(b.start_iso) + '</b></span>' : '') +
             (b.end_iso ? '<span>النهاية: <b>' + farmFmtDT(b.end_iso) + '</b></span>' : '') +
             '</div>';
        if (b.status === 'pending_payment' && b.deadline_iso) {
            h += '<div style="margin-top:.6rem;font-size:.8rem;color:rgba(255,255,255,.7)">' +
                 (b.is_future ? '<b style="color:#38bdf8">حجز مستقبلي</b> — يبدأ ' + farmFmtDT(b.scheduled_start_iso) + ' بعد انتهاء الحجز الحالي، والعربون اليوم (أول يوم حجز) — ' : '') +
                 'مهلة الدفع تنتهي خلال <span class="cy-f-count" data-dl="' + b.deadline_iso + '">—</span> — حوّل ' + farmMoney(b.deposit_amount) + '$ على <b style="direction:ltr;display:inline-block">' + farmState.config.bank_account + '</b> واضغط «دفعت العربون»</div>';
        }
        if (b.status === 'pending_confirm') {
            h += '<div style="margin-top:.6rem;font-size:.8rem;color:#c084fc"><i class="fas fa-hourglass-half"></i> أعلنت الدفع — بانتظار تأكيد الإدارة لوصول المبلغ</div>';
        }
        if (b.status === 'confirmed' && b.remainder) {
            h += '<div style="margin-top:.7rem;padding:.65rem .85rem;border-radius:10px;background:rgba(56,189,248,.07);border:1px solid rgba(56,189,248,.28);font-size:.8rem;color:rgba(255,255,255,.85);line-height:1.7">';
            h += '<b style="color:#38bdf8"><i class="fas fa-sack-dollar"></i> النص الثاني: ' + farmMoney(b.remainder.amount) + '$</b> — حوّله على <b style="direction:ltr;display:inline-block">' + farmState.config.bank_account + '</b> ';
            if (b.remainder.status === 'confirmed' && b.is_future) {
                h += '— <b style="color:#34d399">انسدد كامل الإيجار ✅</b> حجزك راح يبدأ تلقائياً ' + farmFmtDT(b.scheduled_start_iso) + ' وتجيك إشعار الإضافة لفاكشن العائلة وقتها';
            } else if (b.remainder.status === 'pending_payment' && b.remainder.counter_start_iso && !b.remainder.counter_open) {
                h += '— عداد النص الثاني يبدأ خلال <span class="cy-f-count" data-dl="' + b.remainder.counter_start_iso + '">—</span> (آخر ' + farmState.config.remainder_window_hours + ' ساعات قبل بداية حجزك' + (b.scheduled_start_iso ? ' — ' + farmFmtDT(b.scheduled_start_iso) : '') + ') — وإذا وصل قبل البداية بساعة وما انحول <b style="color:#ef4444">ينلغي الحجز وتخسر العربون ' + farmMoney(b.deposit_amount) + '$</b>';
            } else if (b.remainder.status === 'pending_payment' && b.remainder.forfeit_iso) {
                h += 'قبل <span class="cy-f-count" data-dl="' + b.remainder.forfeit_iso + '">—</span> — إذا وصل قبل بداية الحجز بساعة وما انحول <b style="color:#ef4444">ينلغي الحجز وتخسر العربون ' + farmMoney(b.deposit_amount) + '$</b>';
            } else if (b.remainder.status === 'pending_confirm') {
                h += '— أعلنت الدفع ✅ بانتظار تأكيد الإدارة، وبعد التأكيد ينبدا حجزك';
            }
            h += '</div>';
        }
        if (b.status === 'active' && !b.faction_added) {
            h += '<div style="margin-top:.6rem;font-size:.8rem;color:#34d399"><i class="fas fa-users"></i> بانتظار إضافتك لفاكشن العائلة — الإدارة تتولاه</div>';
        }
        if (b.status === 'cancelled' && b.cancel_penalty > 0) {
            h += '<div style="margin-top:.6rem;font-size:.8rem;color:#ef4444"><i class="fas fa-ban"></i> أُلغي الحجز وخسرت ' + farmMoney(b.cancel_penalty) + '$ من العربون — الباقي ' + farmMoney(b.deposit_amount - b.cancel_penalty) + '$ راجع لك</div>';
        }
        if (b.extend && ['pending_payment','pending_confirm'].indexOf(b.extend.status) !== -1) {
            h += '<div style="margin-top:.7rem;padding:.6rem .8rem;border-radius:9px;background:rgba(var(--accent-rgb),.08);border:1px solid rgba(var(--accent-rgb),.25);font-size:.8rem">';
            h += '<b style="color:var(--accent)">طلب تمديد ' + b.extend.days + ' يوم</b> — ' + (b.extend.status === 'pending_payment'
                ? 'حوّل ' + farmMoney(b.extend.deposit) + '$ واضغط «دفعت» — المهلة <span class="cy-f-count" data-dl="' + b.extend.deadline_iso + '">—</span> <button class="cy-farm-btn warn small" style="margin-right:6px" onclick="farmExtPaid(' + b.id + ')"><i class="fas fa-money-bill"></i> دفعت عربون التمديد</button>'
                : 'بانتظار تأكيد الإدارة');
            h += '</div>';
        }
        if (b.workers && b.workers.length) {
            h += '<div class="cy-f-workers"><div class="cy-f-workers-title"><i class="fas fa-users" style="color:var(--accent)"></i> العمال (' + b.workers.length + '/' + farmState.config.max_workers + ')</div>';
            b.workers.forEach(function(w) { h += farmWorkerRow(w); });
            h += '</div>';
        }
        if (b.can.addWorker) {
            h += '<div class="cy-f-workers" style="border-top:none;padding-top:.2rem"><div style="display:flex;gap:8px">' +
                 '<input type="text" id="farmWName_' + b.id + '" placeholder="اسم شخصية العامل كما بالسيرفر (مثال: Hadi_Walton)" style="flex:1;box-sizing:border-box;padding:.55rem .8rem;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:9px;color:var(--text, #fff);font-size:.8rem;direction:ltr;text-align:left">' +
                 '<button class="cy-farm-btn ok small" onclick="farmAddWorker(' + b.id + ')"><i class="fas fa-plus"></i> اضافة عامل (' + farmMoney(farmState.config.worker_price) + '$)</button></div></div>';
        }
        var acts = farmBkActions(b);
        if (acts) h += '<div class="cy-f-bk-actions">' + acts + '</div>';
        h += '</div>';
        return h;
    }).join('');
    farmTick();
}

/* ── إجراءات ── */
async function farmPost(url, body) {
    var r = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}) });
    return await r.json();
}
async function farmPaid(id) {
    var d = await farmPost('/api/farm/bookings/' + id + '/mark-paid');
    farmToast(d.success ? '💰 ' + d.message : (d.error || 'خطأ'), !d.success);
    if (d.success) farmRefresh();
}
async function farmRemainderPaid(id) {
    var d = await farmPost('/api/farm/bookings/' + id + '/remainder-mark-paid');
    farmToast(d.success ? '💵 ' + d.message : (d.error || 'خطأ'), !d.success);
    if (d.success) farmRefresh();
}
async function farmCancel(id) {
    var d = await farmPost('/api/farm/bookings/' + id + '/cancel');
    farmToast(d.success ? '🚫 ' + d.message : (d.error || 'خطأ'), !d.success);
    if (d.success) farmRefresh();
}
async function farmExtPaid(id) {
    var d = await farmPost('/api/farm/bookings/' + id + '/extend-mark-paid');
    farmToast(d.success ? '💰 ' + d.message : (d.error || 'خطأ'), !d.success);
    if (d.success) farmRefresh();
}
async function farmAddWorker(bid) {
    var el = document.getElementById('farmWName_' + bid);
    if (!el || !el.value.trim()) return;
    var d = await farmPost('/api/farm/bookings/' + bid + '/workers', { character_name: el.value.trim() });
    farmToast(d.success ? '👷 ' + d.message : (d.error || 'خطأ'), !d.success);
    if (d.success) farmRefresh();
}
async function farmWorkerPaid(wid) {
    var d = await farmPost('/api/farm/workers/' + wid + '/mark-paid');
    farmToast(d.success ? '💰 ' + d.message : (d.error || 'خطأ'), !d.success);
    if (d.success) farmRefresh();
}
async function farmWorkerDel(wid) {
    if (!confirm('حذف هذا العامل؟')) return;
    var r = await fetch('/api/farm/workers/' + wid, { method: 'DELETE' });
    var d = await r.json();
    if (d.success) farmRefresh(); else farmToast(d.error || 'خطأ', true);
}

/* ── التمديد ── */
function openFarmExt(bid) {
    farmExtBid = bid; farmExtDur = null;
    var b = (farmState.myBookings || []).find(function(x) { return x.id === bid; });
    document.getElementById('farmExtRef').textContent = b ? b.ref : '';
    var g = document.getElementById('farmExtDurGrid');
    g.innerHTML = farmState.config.prices.map(function(p) {
        return '<div class="cy-f-dur-chip" data-d="' + p.days + '" onclick="farmPickExtDur(' + p.days + ')"><b>' + p.days + ' يوم</b><span>' + farmMoney(p.price) + '$</span></div>';
    }).join('');
    document.getElementById('farmExtSummary').style.display = 'none';
    document.getElementById('farmExtSubmit').disabled = true;
    document.getElementById('farmExtModal').classList.add('open');
}
function farmPickExtDur(d) {
    farmExtDur = d;
    var chips = document.querySelectorAll('#farmExtDurGrid .cy-f-dur-chip');
    for (var i = 0; i < chips.length; i++) chips[i].classList.toggle('sel', +chips[i].dataset.d === d);
    var price = 0;
    farmState.config.prices.forEach(function(p) { if (p.days === d) price = p.price; });
    var dep = Math.round(price * farmState.config.deposit_pct / 100);
    document.getElementById('farmExtRent').textContent = farmMoney(price) + '$';
    document.getElementById('farmExtDep').textContent = farmMoney(dep) + '$';
    document.getElementById('farmExtSummary').style.display = '';
    document.getElementById('farmExtSubmit').disabled = false;
}
async function farmSubmitExtend() {
    if (!farmExtDur || !farmExtBid) return;
    var btn = document.getElementById('farmExtSubmit');
    btn.disabled = true;
    var d = await farmPost('/api/farm/bookings/' + farmExtBid + '/extend', { duration_days: farmExtDur });
    if (d.success) {
        farmClose('farmExtModal');
        farmToast('⏳ ' + d.message);
        farmRefresh();
    } else { farmToast(d.error || 'خطأ', true); btn.disabled = false; }
}

/* ── العدّادات ── */
function farmTick() {
    var els = document.querySelectorAll('[data-dl]');
    els.forEach(function(el) {
        var ms = new Date(el.dataset.dl).getTime() - Date.now();
        if (ms <= 0) { el.textContent = 'انتهت'; return; }
        var s = Math.floor(ms / 1000), h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), ss = s % 60;
        var p = function(x) { return (x < 10 ? '0' : '') + x; };
        el.textContent = p(h) + ':' + p(m) + ':' + p(ss);
    });
}
setInterval(farmTick, 1000);
document.addEventListener('keydown', function(e) { if (e.key === 'Escape') { farmClose('farmBookModal'); farmClose('farmMyModal'); farmClose('farmExtModal'); } });

farmRenderCard(); farmRenderMy();
setTimeout(farmRefresh, 800);
setInterval(farmRefresh, 60000);
</script>
<% } %>

<% if (user) { %>
<!-- نافذة طلباتي من خدمات الشركة -->
<div id="svcMyModal" class="cy-f-modal" onclick="if(event.target===this)svcCloseMy()">
    <div class="cy-f-box" style="max-width:640px">
        <div class="cy-f-box-head">
            <h3><i class="fas fa-list-check" style="color:var(--accent)"></i> طلباتي من خدمات الشركة</h3>
            <button class="cy-f-x" onclick="svcCloseMy()"><i class="fas fa-times"></i></button>
        </div>
        <div class="cy-f-box-body" id="svcMyList"></div>
    </div>
</div>
<script>
var SVC_ST = { pending: ['بانتظار المراجعة', '#eab308'], approved: ['مقبول', '#34d399'], rejected: ['مرفوض', '#ef4444'] };
function svcCloseMy() { document.getElementById('svcMyModal').classList.remove('open'); }
async function svcOpenMy() {
    document.getElementById('svcMyModal').classList.add('open');
    var box = document.getElementById('svcMyList');
    box.innerHTML = '<div style="text-align:center;padding:1.5rem;color:rgba(255,255,255,.5)"><i class="fas fa-circle-notch fa-spin"></i> جاري التحميل...</div>';
    try {
        var r = await fetch('/api/company/my-requests', { cache: 'no-store' });
        var list = await r.json();
        if (!list.length) { box.innerHTML = '<div style="text-align:center;padding:2rem;color:rgba(255,255,255,.5)"><i class="fas fa-inbox" style="font-size:2rem;display:block;margin-bottom:.7rem;color:rgba(var(--accent-rgb),.5)"></i>ما عندك طلبات — قدّم طلبك من بطاقة الخدمة</div>'; return; }
        box.innerHTML = list.map(function(q) {
            var st = SVC_ST[q.status] || [q.status, '#94a3b8'];
            var h = '<div class="cy-f-bk">';
            h += '<div class="cy-f-bk-head"><span class="ref">#' + Number(q.id) + '</span><span class="cy-f-st ' + q.status + '">' + st[0] + '</span></div>';
            h += '<div style="font-weight:700;color:var(--text,#fff);margin:.3rem 0 .5rem"><i class="fas fa-concierge-bell" style="color:var(--accent)"></i> ' + cyEsc(q.service_title || 'خدمة') + '</div>';
            (q.answers || []).forEach(function(a) {
                if (a.type === 'image' && a.a) h += '<div style="font-size:.78rem;color:rgba(255,255,255,.65);margin-bottom:.3rem"><i class="fas fa-image"></i> ' + cyEsc(a.q) + ': <a href="' + cyEsc(a.a) + '" target="_blank" rel="noopener" style="color:var(--accent)">عرض الصورة</a></div>';
                else h += '<div style="font-size:.78rem;color:rgba(255,255,255,.65);margin-bottom:.3rem">' + cyEsc(a.q) + ': <b style="color:rgba(255,255,255,.85)">' + cyEsc(a.a || '—') + '</b></div>';
            });
            h += '<div style="font-size:.7rem;color:rgba(255,255,255,.4)">' + (q.created_iso || '') + '</div>';
            h += '</div>';
            return h;
        }).join('');
    } catch (e) { box.innerHTML = '<div style="text-align:center;padding:1.5rem;color:#ef4444">خطأ بالتحميل</div>'; }
}
document.addEventListener('keydown', function(e) { if (e.key === 'Escape') svcCloseMy(); });

/* ═══ إحصائية «طلباتك المفتوحة» — جلب واحد عند فتح الصفحة فقط (بدون أي تكرار حفاظاً على الاستهلاك) ═══ */
(async function() {
    var el = document.getElementById('cyStatReqs');
    var cnt = document.getElementById('svcMyCount');
    if (!el && !cnt) return;
    try {
        var r = await fetch('/api/company/my-requests', { cache: 'no-store' });
        var list = await r.json();
        var open = Array.isArray(list) ? list.filter(function(q) { return q.status === 'pending'; }).length : 0;
        if (el) el.textContent = open;
        if (cnt) cnt.textContent = open ? '(' + open + ')' : '';
    } catch (e) { if (el) el.textContent = '—'; }
})();
</script>
<% } %>

<script>
/* نظام التابات — معلومات الشركة لحالها، والخدمات تظهر من زر «الخدمات» فوق */
(function() {
    var nav = document.getElementById('cyCoNav');
    if (!nav) return;
    function cyCoShow(id, push) {
        var info = document.getElementById('section-info');
        var svc = document.getElementById('section-services');
        if (!info || !svc) return;
        var isSvc = id === 'cy-services';
        info.classList.toggle('active', !isSvc);
        svc.classList.toggle('active', isSvc);
        var btns = nav.querySelectorAll('.cy-co-nav-btn');
        for (var i = 0; i < btns.length; i++) btns[i].classList.toggle('active', btns[i].dataset.target === id);
        if (push && history.replaceState) history.replaceState(null, '', isSvc ? '#services' : '#info');
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }
    nav.addEventListener('click', function(e) {
        var a = e.target.closest('.cy-co-nav-btn');
        if (!a) return;
        e.preventDefault();
        cyCoShow(a.dataset.target, true);
    });
    cyCoShow(location.hash === '#services' ? 'cy-services' : 'cy-info', false);
})();
</script>

