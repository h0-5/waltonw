<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<%
  /* ===== تجميع القوانين حسب القسم ===== */
  var wrGrouped = {}, wrOrder = [], wrStatic = false;
  if (typeof rules !== 'undefined' && rules && rules.length) {
    rules.forEach(function(r) {
      var cat = (r && r.category) ? r.category : 'أخرى';
      if (!wrGrouped[cat]) { wrGrouped[cat] = []; wrOrder.push(cat); }
      wrGrouped[cat].push(r);
    });
  }
  /* نص القانون: يدعم rule_text و content معاً (اختلاف مخطط الجدول بين النسخ) */
  var wrText = function(it) {
    if (typeof it === 'string') return it;
    return (it && (it.rule_text || it.content)) ? (it.rule_text || it.content) : '';
  };
  /* خريطة أيقونات الأقسام من جدول rule_categories */
  var wrCatIcons = {};
  if (typeof categories !== 'undefined' && categories && categories.length) {
    categories.forEach(function(c) { if (c && c.name) wrCatIcons[c.name] = c.icon || ''; });
  }
  var wrFallbackIcons = ['fa-shield-alt','fa-gavel','fa-globe','fa-user-shield','fa-ban','fa-balance-scale','fa-comment-slash','fa-check-circle'];
  /* وضع بلا قوانين بالقاعدة: قوانين ثابتة (نفس نصوص النسخة السابقة) */
  if (!wrOrder.length) {
    wrStatic = true;
    wrGrouped = {
      'قوانين عامة': [
        'احترم جميع الأعضاء وتجنب الإساءة أو الإهانة في المحادثات',
        'يمنع السبام أو المنشن المزعج',
        'يجب أن يكون اسم المستخدم لائقاً',
        'يمنع الخوض في النقاشات الحساسة أو الجدلية.',
        'يمنع الابتزاز ممنوع منعاً باتاً ويعرضك للحظر'
      ]
    };
    wrOrder = ['قوانين عامة'];
  }
  /* ===== مراحل العقوبات: نظام مستقل تماماً عن القوانين — من جدول rule_stages مع fallback ثابت ===== */
  var wrStages = (typeof stages !== 'undefined' && stages && stages.length) ? stages : [
    { title: 'تحذير',     icon: 'fa-triangle-exclamation',        description: 'تنبيه رسمي يُسجّل في الأرشيف — تكرار المخالفة يوصلك للمرحلة التالية' },
    { title: 'ميوت',      icon: 'fa-volume-xmark',                description: 'كتم من المحادثات مدة تتراوح بين ساعة وسبعة أيام حسب نوع المخالفة' },
    { title: 'طرد مؤقت',  icon: 'fa-person-walking-arrow-right',  description: 'طرد من السيرفر مؤقتاً مع بقاء سجل المخالفات محفوظاً بالكامل' },
    { title: 'حظر مؤقت',  icon: 'fa-gavel',                       description: 'حظر مؤقت من السيرفر لمدة تحددها الإدارة حسب جسامة المخالفة' },
    { title: 'حظر دائم',  icon: 'fa-ban',                         description: 'حظر نهائي من المجتمع — قرار الطاقم في هذه المرحلة نهائي' }
  ];
  /* لون المرحلة يُكشف من عنوانها — الترتيب مهم: «دائم» قبل «حظر» */
  var wsLv = function(t) {
    t = t || '';
    if (t.indexOf('دائم') !== -1) return 5;
    if (t.indexOf('حظر') !== -1) return 4;
    if (t.indexOf('طرد') !== -1) return 3;
    if (t.indexOf('ميوت') !== -1 || t.indexOf('كتم') !== -1) return 2;
    if (t.indexOf('تحذير') !== -1 || t.indexOf('إنذار') !== -1 || t.indexOf('انذار') !== -1) return 1;
    return 0;
  };
  var wrOrd = ['الأولى','الثانية','الثالثة','الرابعة','الخامسة','السادسة','السابعة','الثامنة','التاسعة','العاشرة'];
  /* تسمية المرحلة تلقائية من موقعها: الأولى تنبيه رسمي (ليست مخالفة) ثم مخالفة أولى/ثانية/الخ */
  var wsKicker = function(n) { return n === 1 ? 'تنبيه رسمي' : 'مخالفة ' + (n - 1 <= 10 ? wrOrd[n - 2] : String(n - 1)); };
  var wrTotal = 0;
  wrOrder.forEach(function(c) { wrTotal += wrGrouped[c].length; });
  var wrPad = function(n) { return (n < 10 ? '0' : '') + n; };
%>

<div class="wr-page">

  <!-- ═══ هيرو الميثاق — كروم سائل ═══ -->
  <div class="wr-hero">
    <div class="wr-hero-icon">
      <span class="wr-hex"></span>
      <span class="wr-hex wr-hex-in"></span>
      <i class="fas fa-gavel"></i>
    </div>
    <h1 class="wr-title">قوانين المجتمع</h1>
    <p class="wr-sub">ميثاق والتون — اقرأ القوانين والتزم بها لنحافظ على بيئة آمنة ومحترمة للجميع</p>
    <div class="wr-hero-chips">
      <span class="wr-chip"><i class="fas fa-layer-group"></i><%= wrOrder.length %> أقسام</span>
      <span class="wr-chip"><i class="fas fa-file-lines"></i><%= wrTotal %> مادة</span>
      <% if (wrStages.length) { %>
      <span class="wr-chip"><i class="fas fa-arrow-down"></i><%= wrStages.length %> عقوبات</span>
      <% } %>
    </div>
    <div class="wr-hero-line"></div>
  </div>

  <!-- ═══ شرائح الأقسام (هاتف — لاصقة تحت الهدر) ═══ -->
  <nav class="wr-chips" aria-label="فهرس الأقسام">
    <div class="wr-chips-track">
      <% wrOrder.forEach(function(cat, ci) { %>
      <a href="#wr-cat-<%= ci %>" class="wr-chip-link<%= ci === 0 ? ' active' : '' %>">
        <i class="fas <%= wrCatIcons[cat] || wrFallbackIcons[ci % wrFallbackIcons.length] %>"></i><%= cat %>
      </a>
      <% }); %>
    </div>
  </nav>

  <!-- ═══ المحتوى: فهرس جانبي (ديسكتوب) + الأقسام ═══ -->
  <div class="wr-main">
    <aside class="wr-aside">
      <div class="wr-aside-box">
        <div class="wr-aside-title"><i class="fas fa-list-check"></i> فهرس الميثاق</div>
        <% wrOrder.forEach(function(cat, ci) { %>
        <a href="#wr-cat-<%= ci %>" class="wr-aside-link<%= ci === 0 ? ' active' : '' %>">
          <span class="wr-aside-num"><%= wrPad(ci + 1) %></span>
          <span class="wr-aside-name"><%= cat %></span>
          <span class="wr-aside-count"><%= wrGrouped[cat].length %></span>
        </a>
        <% }); %>
        <div class="wr-aside-note"><i class="fas fa-wand-magic-sparkles"></i> الفهرس يتولد تلقائياً من الأقسام — أي قسم تضيفه من لوحة الإدارة يظهر هنا فوراً</div>
      </div>
    </aside>

    <div class="wr-sections">
      <% wrOrder.forEach(function(cat, ci) { %>
      <section class="wr-cat wf-reveal" id="wr-cat-<%= ci %>" style="transition-delay:<%= Math.min(ci * 0.08, 0.4) %>s">
        <div class="wr-cat-glow"></div>
        <header class="wr-cat-head">
          <span class="wr-cat-idx"><%= wrPad(ci + 1) %></span>
          <span class="wr-cat-ico"><i class="fas <%= wrCatIcons[cat] || wrFallbackIcons[ci % wrFallbackIcons.length] %>"></i></span>
          <h2 class="wr-cat-name"><%= cat %></h2>
          <span class="wr-cat-count"><%= wrGrouped[cat].length %> مواد</span>
        </header>
        <div class="wr-rules">
          <% wrGrouped[cat].forEach(function(rule, index) { %>
          <div class="wr-rule" style="transition-delay:<%= Math.min(index * 0.05, 0.5) %>s">
            <span class="wr-rule-no"><%= index + 1 %></span>
            <p class="wr-rule-text"><%= wrText(rule) %></p>
          </div>
          <% }); %>
        </div>
      </section>
      <% }); %>
    </div>
  </div>

  <!-- ═══ مراحل العقوبات — بطاقات جنب بعض، نظام مستقل تحت جميع الأقسام وخارج الفهرس ═══ -->
  <% if (wrStages.length) { %>
  <section class="wr-ladder wf-reveal" id="wr-ladder" aria-label="العقوبات">
    <div class="wl-head">
      <span class="wl-ico"><i class="fas fa-gavel"></i></span>
      <h2 class="wl-title">العقوبات</h2>
      <p class="wl-sub">كل مخالفة توصلك للمرحلة التالية — والمرحلة الأخيرة نهائية</p>
    </div>
    <div class="wl-stages">
      <% wrStages.forEach(function(st, si) {
           var lv = wsLv(st.title);
           var stDesc = (st.description || '').toString();
           var stColor = (st.color || '').toString().trim();
           if (!/^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/.test(stColor)) stColor = '';
      %>
      <div class="ws-card ws-lv<%= lv %><%= stColor ? ' ws-custom' : '' %>"<% if (stColor) { %> style="--ws-c:<%= stColor %>"<% } %>>
        <div class="ws-top">
          <span class="ws-ico"><i class="fas <%= st.icon || 'fa-flag' %>"></i></span>
          <div class="ws-head">
            <span class="ws-kicker"><%= wsKicker(si + 1) %>:</span>
            <h3 class="ws-name"><%= st.title %></h3>
          </div>
        </div>
        <div class="ws-desc"><p><%= stDesc %></p></div>
      </div>
      <% }); %>
    </div>
    <div class="wl-foot">
      <span><i class="fas fa-box-archive"></i> العقوبات تُسجّل بأرشيفنا</span>
      <span><i class="fas fa-scale-balanced"></i> قرار الطاقم نهائي</span>
    </div>
  </section>
  <% } %>

  <div class="wr-foot wf-reveal">
    <p><i class="fas fa-circle-info"></i> آخر تحديث للميثاق: <%= new Date().toISOString().split('T')[0] %></p>
    <p class="wr-foot-note"><i class="fas fa-shield-heart"></i> الالتزام بالقوانين مسؤولية الجميع — مخالفتها عرضة للعقوبات الموضحة أعلاه</p>
  </div>
</div>

<%- include('../partials/footer') %>
<script src="/js/main.js"></script>
<script>
/* Scroll-spy — متتبع خفيف بـ IntersectionObserver (بدون أي مستمع سكرول) */
(function(){
  var links = document.querySelectorAll('.wr-chip-link, .wr-aside-link');
  var secs = [].slice.call(document.querySelectorAll('.wr-cat'));
  if (!links.length || secs.length < 2 || !('IntersectionObserver' in window)) return;
  var map = {};
  links.forEach(function(a){
    var id = (a.getAttribute('href') || '').slice(1);
    if (!id) return;
    (map[id] = map[id] || []).push(a);
  });
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if (!e.isIntersecting) return;
      links.forEach(function(a){ a.classList.remove('active'); });
      (map[e.target.id] || []).forEach(function(a){ a.classList.add('active'); });
    });
  }, { rootMargin: '-40% 0px -55% 0px', threshold: 0 });
  secs.forEach(function(s){ io.observe(s); });
})();
</script>
</body>
</html>
