<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/footer.css">
  <title>تسجيل الدخول | Walton Family</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    :root {
      --ac: #780ecf;
      --ac-rgb: 120, 14, 207;
      --ac-dark: #600ba5;
      --ac-light: #9b30ff;
    }

    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    
    body {
      font-family: 'Cairo', sans-serif;
      background: #06040a;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      position: relative;
    }

    /* Animated background grid */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background:
        repeating-linear-gradient(0deg, transparent, transparent 59px, rgba(var(--ac-rgb),0.04) 59px, rgba(var(--ac-rgb),0.04) 60px),
        repeating-linear-gradient(90deg, transparent, transparent 59px, rgba(var(--ac-rgb),0.04) 59px, rgba(var(--ac-rgb),0.04) 60px);
      z-index: 0;
      animation: gridMove 20s linear infinite;
    }

    @keyframes gridMove {
      0% { transform: translate(0, 0); }
      100% { transform: translate(60px, 60px); }
    }

    /* Floating orbs */
    .orb {
      position: fixed;
      border-radius: 50%;
      filter: blur(80px);
      pointer-events: none;
      z-index: 0;
    }
    .orb-1 { width: 400px; height: 400px; background: rgba(var(--ac-rgb),0.12); top: -100px; right: -100px; animation: orbFloat1 8s ease-in-out infinite; }
    .orb-2 { width: 300px; height: 300px; background: rgba(88,101,242,0.1); bottom: -80px; left: -80px; animation: orbFloat2 10s ease-in-out infinite; }
    .orb-3 { width: 200px; height: 200px; background: rgba(var(--ac-rgb),0.08); top: 50%; left: 50%; animation: orbFloat3 6s ease-in-out infinite; }

    @keyframes orbFloat1 { 0%, 100% { transform: translate(0, 0) scale(1); } 50% { transform: translate(-30px, 30px) scale(1.1); } }
    @keyframes orbFloat2 { 0%, 100% { transform: translate(0, 0) scale(1); } 50% { transform: translate(20px, -20px) scale(1.15); } }
    @keyframes orbFloat3 { 0%, 100% { transform: translate(-50%, -50%) scale(1); } 50% { transform: translate(-50%, -50%) scale(1.2); } }

    /* Login container */
    .login-container {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 420px;
      padding: 1.5rem;
    }

    .login-card {
      background: rgba(12, 8, 22, 0.85);
      backdrop-filter: blur(24px);
      border: 1px solid rgba(var(--ac-rgb),0.2);
      border-radius: 24px;
      padding: 3rem 2.5rem;
      text-align: center;
      position: relative;
      overflow: hidden;
      animation: cardReveal 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
      opacity: 0;
      transform: translateY(30px) scale(0.95);
    }

    @keyframes cardReveal {
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    /* Card glow border */
    .login-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent, var(--ac), rgba(var(--ac-rgb),0.5), var(--ac), transparent);
      animation: glowLine 3s linear infinite;
    }

    @keyframes glowLine {
      0% { background-position: -200% 0; }
      100% { background-position: 200% 0; }
    }

    .login-card::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent, rgba(var(--ac-rgb),0.3), transparent);
    }

    /* Corner accents */
    .corner-tl, .corner-br {
      position: absolute;
      width: 20px;
      height: 20px;
      opacity: 0.4;
    }
    .corner-tl { top: 8px; left: 8px; border-top: 2px solid var(--ac); border-left: 2px solid var(--ac); border-radius: 8px 0 0 0; }
    .corner-br { bottom: 8px; right: 8px; border-bottom: 2px solid var(--ac); border-right: 2px solid var(--ac); border-radius: 0 0 8px 0; }

    /* Logo */
    .login-logo {
      position: relative;
      width: 100px;
      height: 100px;
      margin: 0 auto 1.5rem;
    }

    .login-logo::before {
      content: '';
      position: absolute;
      inset: -4px;
      border-radius: 50%;
      background: conic-gradient(from 0deg, var(--ac), rgba(var(--ac-rgb),0.3), var(--ac), rgba(var(--ac-rgb),0.1), var(--ac));
      animation: ringRotate 12s linear infinite;
    }

    @keyframes ringRotate { to { transform: rotate(360deg); } }

    .login-logo::after {
      content: '';
      position: absolute;
      inset: 2px;
      border-radius: 50%;
      background: #0a0612;
    }

    .login-logo img {
      position: relative;
      z-index: 1;
      width: 100%;
      height: 100%;
      object-fit: contain;
      border-radius: 50%;
      filter: drop-shadow(0 0 15px rgba(var(--ac-rgb),0.5));
    }

    .login-logo .glow {
      position: absolute;
      inset: 8px;
      border-radius: 50%;
      background: radial-gradient(circle at 40% 40%, rgba(var(--ac-rgb),0.3), transparent 70%);
      z-index: 0;
      animation: innerGlow 2s ease-in-out infinite;
    }

    @keyframes innerGlow {
      0%, 100% { opacity: 0.4; }
      50% { opacity: 0.8; }
    }

    /* Title */
    .login-title {
      font-size: 1.6rem;
      font-weight: 900;
      background: linear-gradient(135deg, #fff, rgba(255,255,255,0.7), var(--ac));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: 0.5rem;
    }

    .login-subtitle {
      font-size: 0.88rem;
      color: rgba(255,255,255,0.45);
      margin-bottom: 2rem;
      line-height: 1.6;
    }

    /* Discord Button */
    .discord-login-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      width: 100%;
      padding: 16px 24px;
      background: #5865F2;
      color: #fff;
      border: none;
      border-radius: 16px;
      font-family: 'Cairo', sans-serif;
      font-size: 1rem;
      font-weight: 800;
      cursor: pointer;
      transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      position: relative;
      overflow: hidden;
      text-decoration: none;
      box-shadow: 0 8px 25px rgba(88,101,242,0.35);
    }

    .discord-login-btn::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.12), transparent);
      transform: translateX(-100%);
      transition: transform 0.6s;
    }

    .discord-login-btn:hover::before { transform: translateX(100%); }

    .discord-login-btn:hover {
      transform: translateY(-3px) scale(1.02);
      box-shadow: 0 12px 35px rgba(88,101,242,0.5);
    }

    .discord-login-btn:active {
      transform: translateY(0) scale(0.98);
    }

    .discord-login-btn i {
      font-size: 1.3rem;
    }

    /* Features list */
    .login-features {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid rgba(var(--ac-rgb),0.15);
    }

    .feature-item {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 0.82rem;
      color: rgba(255,255,255,0.4);
    }

    .feature-item i {
      color: var(--ac);
      font-size: 0.75rem;
      width: 16px;
      text-align: center;
    }

    /* Error message */
    .error-msg {
      background: rgba(239,68,68,0.12);
      border: 1px solid rgba(239,68,68,0.3);
      border-radius: 12px;
      padding: 12px 16px;
      margin-bottom: 1.5rem;
      color: #fca5a5;
      font-size: 0.85rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 8px;
      animation: errorShake 0.5s ease-out;
    }

    @keyframes errorShake {
      0%, 100% { transform: translateX(0); }
      20% { transform: translateX(-8px); }
      40% { transform: translateX(8px); }
      60% { transform: translateX(-4px); }
      80% { transform: translateX(4px); }
    }

    /* Back link */
    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-top: 1.5rem;
      color: rgba(255,255,255,0.3);
      font-size: 0.82rem;
      text-decoration: none;
      transition: color 0.3s;
    }

    .back-link:hover { color: var(--ac); }

    /* Particles */
    .particles {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
    }

    .particle {
      position: absolute;
      width: 2px;
      height: 2px;
      border-radius: 50%;
      background: var(--ac);
      opacity: 0.3;
      animation: particleUp linear infinite;
    }

    @keyframes particleUp {
      0% { transform: translateY(100vh) scale(0); opacity: 0; }
      10% { opacity: 0.3; }
      90% { opacity: 0.3; }
      100% { transform: translateY(-10vh) scale(1); opacity: 0; }
    }

    @media (max-width: 480px) {
      .login-card { padding: 2.5rem 1.5rem; }
      .login-title { font-size: 1.3rem; }
    }
  </style>
</head>
<body>
  <!-- Background effects -->
  <div class="orb orb-1"></div>
  <div class="orb orb-2"></div>
  <div class="orb orb-3"></div>
  <div class="particles" id="particles"></div>

  <div class="login-container">
    <div class="login-card">
      <div class="corner-tl"></div>
      <div class="corner-br"></div>

      <!-- Logo -->
      <div class="login-logo">
        <div class="glow"></div>
        <img src="/images/logo.png" alt="Walton Family">
      </div>

      <!-- Title -->
      <h1 class="login-title"> Walton Family</h1>
      <p class="login-subtitle">سجّل دخولك بحساب Discord وكن جزءاً من مجتمعنا</p>

      <!-- Error -->
      <% if (typeof error !== 'undefined' && error) { %>
      <div class="error-msg">
        <i class="fas fa-exclamation-circle"></i>
        <% if (error === 'failed') { %>
          فشل تسجيل الدخول. حاول مرة أخرى.
        <% } else { %>
          <%= error %>
        <% } %>
      </div>
      <% } %>

      <!-- Discord Login Button -->
      <a href="/auth/discord" class="discord-login-btn" id="discordBtn">
        <i class="fab fa-discord"></i>
        <span>تسجيل الدخول بـ Discord</span>
      </a>

      <!-- Features -->
      <div class="login-features">
        <div class="feature-item">
          <i class="fas fa-gamepad"></i>
          <span>العب ألعاب واحسب نقاط</span>
        </div>
        <div class="feature-item">
          <i class="fas fa-store"></i>
          <span>اشتر من المتجر بالنقاط</span>
        </div>
        <div class="feature-item">
          <i class="fas fa-comments"></i>
          <span>تفاعل في مجتمع العائلة</span>
        </div>
        <div class="feature-item">
          <i class="fas fa-trophy"></i>
          <span>ابدأ وابقى&_zwnj; najlepszym</span>
        </div>
      </div>

      <!-- Back -->
      <a href="/" class="back-link">
        <i class="fas fa-arrow-right"></i>
        العودة للرئيسية
      </a>
    </div>
  </div>

  <script>
    // Particles
    (function() {
      const container = document.getElementById('particles');
      for (let i = 0; i < 25; i++) {
        const p = document.createElement('div');
        p.className = 'particle';
        p.style.left = Math.random() * 100 + '%';
        p.style.animationDuration = (6 + Math.random() * 10) + 's';
        p.style.animationDelay = Math.random() * 6 + 's';
        p.style.width = p.style.height = (1.5 + Math.random() * 2.5) + 'px';
        container.appendChild(p);
      }
    })();
  </script>
<%- include('../partials/footer') %>
</body>
</html>
