<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<%
  /* ===== تجهيزات خفيفة بمنطق الصفحة (بلا أي استعلام إضافي) ===== */
  var hxUser = typeof user !== 'undefined' ? user : null;
  var hxMy = (typeof myStats !== 'undefined' && myStats) ? myStats : null;
  var hxSettings = typeof settings !== 'undefined' ? settings : {};
  var hxDiscord = hxSettings.discord_server_url || '#';
  var hxLogo = hxSettings.site_logo_url || '/images/logo.png';
  var hxNews = (typeof news !== 'undefined' && news) ? news.slice(0, 6) : [];
  var hxGaws = (typeof activeGiveaways !== 'undefined' && activeGiveaways) ? activeGiveaways.length : 0;
  /* الشروط: من صفحة التقديمات نفسها (حقل المتطلبات بتقديم Join Family) — وإن لا توجد: بدائل ثابتة */
  var hxReqs = (typeof joinReqs !== 'undefined' && joinReqs && joinReqs.length)
    ? joinReqs.slice(0, 5)
    : ['حساب ديسكورد فعّال', 'قراءة قوانين العائلة والالتزام بها', 'احترام الأعضاء والنشاط الإيجابي'];
  /* عناصر نجوم الهيرو أُزيلت نهائياً بطلب المستخدم (Task 42): الوهج البنفسجي بالزوايا
     والزخرفة خلف الإحصائيات شُلت كلها — الخلفية الآن صورة الموقع فقط */
%>

<main class="hx-page" id="main">

  <!-- ═══════════ الهيرو — ختم بحلقة دوّارة + عنوان متدرج (الوهج والنجوم أُزيلت بطلب المستخدم) ═══════════ -->
  <section class="hx-hero" aria-labelledby="hxHeroTitle">
    <div class="ds-container hx-hero-inner">
      <div class="hx-orb wf-reveal">
        <span class="hx-orb-ring" aria-hidden="true"></span>
        <span class="hx-orb-glow" aria-hidden="true"></span>
        <img src="<%= hxLogo %>" alt="شعار Walton Family" width="240" height="240" decoding="async">
      </div>

      <span class="hx-eyebrow wf-reveal" style="transition-delay:.05s">
        <span class="hx-eyebrow-dot" aria-hidden="true"></span>
        مجتمع والتون فاميلي الرسمي
      </span>

      <h1 class="hx-title wf-reveal" style="transition-delay:.1s" id="hxHeroTitle">
        أكثر من <span class="hx-grad">مجرد عائلة</span>
      </h1>

      <p class="hx-sub wf-reveal" style="transition-delay:.15s">
        ألعاب ومسابقات ونقاط وأخبار — مجتمع عربي واحد يجمعنا بعض، وهنا مكانك بيننا
      </p>

      <div class="hx-cta wf-reveal" style="transition-delay:.2s">
        <% if (hxUser) { %>
        <a href="/applications" class="ds-btn ds-btn-primary hx-btn-big"><i class="fas fa-file-signature" aria-hidden="true"></i> قدّم طلب الانضمام</a>
        <a href="#hx-news" class="ds-btn ds-btn-secondary hx-btn-big">شاهد الأخبار <i class="fas fa-arrow-down" aria-hidden="true"></i></a>
        <% } else { %>
        <a href="<%= hxDiscord %>" target="_blank" rel="noopener" class="ds-btn ds-btn-primary hx-btn-big"><i class="fab fa-discord" aria-hidden="true"></i> انضم الآن</a>
        <a href="#hx-news" class="ds-btn ds-btn-secondary hx-btn-big">اكتشف الموقع <i class="fas fa-arrow-down" aria-hidden="true"></i></a>
        <% } %>
      </div>
    </div>
    <% /* سهم النزول حُذف كلياً (بلاغ المستخدم): كان ينغرس نصفه خلف بطاقة الإحصائيات
          (margin-top سالب) فتبرز قوسه فوق حدود البطاقة ويظهر شبحه عبرها خلف
          «عدد أفراد العائلة» — نفس الشكل الذي وسمه المستخدم «ذول لساتها» */ %>
  </section>

  <!-- ═══════════ شريط الإحصائيات الحقيقية + بطاقة نقاطك ═══════════ -->
  <section class="hx-statsband" id="hx-stats" aria-label="إحصائيات العائلة">
    <div class="ds-container">
      <div class="hx-stats wf-reveal">
        <div class="hx-stat">
          <span class="hx-stat-ic" aria-hidden="true"><i class="fas fa-users"></i></span>
          <div class="hx-stat-val"><%= stats.members %></div>
          <div class="hx-stat-lbl">عضو بالعائلة</div>
        </div>
        <div class="hx-stat">
          <span class="hx-stat-ic" aria-hidden="true"><i class="fas fa-gift"></i></span>
          <div class="hx-stat-val"><%= hxGaws %></div>
          <div class="hx-stat-lbl">فعاليات ومسابقات نشطة</div>
        </div>
        <div class="hx-stat">
          <span class="hx-stat-ic" aria-hidden="true"><i class="fas fa-shield-halved"></i></span>
          <div class="hx-stat-val"><%= stats.staff %></div>
          <div class="hx-stat-lbl">فريق إداري</div>
        </div>
        <div class="hx-stat">
          <span class="hx-stat-ic" aria-hidden="true"><i class="fas fa-headset"></i></span>
          <div class="hx-stat-val"><%= stats.support %></div>
          <div class="hx-stat-lbl">دعم فني</div>
        </div>
      </div>

      <% if (hxUser && hxMy) { %>
      <div class="hx-personal wf-reveal" style="transition-delay:.06s">
        <span class="hx-personal-wel">هلا <b><%= hxUser.username %></b>، نورت الصفحة</span>
        <span class="hx-personal-item"><i class="fas fa-coins" aria-hidden="true"></i> نقاطك <b><%= hxMy.points.toLocaleString('en') %></b></span>
        <span class="hx-personal-item"><i class="fas fa-medal" aria-hidden="true"></i> رتبتك <b>#<%= hxMy.rank %></b></span>
        <span class="hx-personal-item"><i class="fas fa-arrow-trend-up" aria-hidden="true"></i> إجمالي المكتسب <b><%= hxMy.total_earned.toLocaleString('en') %></b></span>
        <a href="/profile" class="hx-personal-link">ملفي الشخصي <i class="fas fa-angle-left" aria-hidden="true"></i></a>
      </div>
      <% } %>
    </div>
  </section>

  <!-- ═══════════ أحدث الأخبار والمسابقات — بطاقات بلمسة ضوء تتبع الماوس ═══════════ -->
  <section class="hx-section" id="hx-news" aria-labelledby="hxNewsTitle">
    <div class="ds-container">
      <div class="ds-sect-head wf-reveal">
        <div>
          <span class="hx-kicker">جديد العائلة</span>
          <h2 class="ds-sect-title" id="hxNewsTitle">أحدث الأخبار والمسابقات</h2>
        </div>
        <a href="/community" class="ds-sect-link">كل الأخبار <i class="fas fa-arrow-left" aria-hidden="true"></i></a>
      </div>

      <% if (hxNews.length) { %>
      <div class="hx-news-grid">
        <% hxNews.forEach(function(item, index) { %>
        <article class="hx-card wf-reveal" style="transition-delay:<%= Math.min(index, 3) * 0.06 %>s">
          <div class="hx-card-media">
            <% if (item.image) { %>
            <img src="<%= item.image %>" alt="<%= item.title %>" width="640" height="360" loading="lazy" decoding="async">
            <% } else { %>
            <span class="hx-card-ph" aria-hidden="true"><i class="fas <%= item.type === 'giveaway' ? 'fa-gift' : 'fa-bullhorn' %>"></i></span>
            <% } %>
            <span class="ds-badge <%= item.type === 'giveaway' ? 'ds-badge-pending hx-badge-gaw' : '' %> hx-badge">
              <i class="fas <%= item.type === 'giveaway' ? 'fa-gift' : 'fa-bullhorn' %>" aria-hidden="true"></i>
              <%= item.type === 'giveaway' ? 'مسابقة' : 'خبر' %>
            </span>
            <% if (item.type === 'giveaway' && item.expires_at) { %>
            <span class="hx-count" data-end="<%= new Date(item.expires_at).toISOString() %>"><i class="fas fa-hourglass-half" aria-hidden="true"></i> <b class="hx-count-val">—</b></span>
            <% } %>
          </div>
          <div class="hx-card-body">
            <h3 class="hx-card-title"><%= item.title %></h3>
            <% if (item.content) { %><p class="hx-card-txt"><%= item.content.substring(0, 120) %></p><% } %>
            <div class="hx-card-foot">
              <span class="hx-card-date"><i class="fas fa-clock" aria-hidden="true"></i> <%= new Date(item.created_at).toLocaleDateString('ar-SA') %></span>
              <span class="hx-card-go" aria-hidden="true"><i class="fas fa-arrow-left"></i></span>
            </div>
          </div>
        </article>
        <% }); %>
      </div>
      <% } else { %>
      <div class="ds-empty wf-reveal">
        <i class="fas fa-newspaper" aria-hidden="true"></i>
        <p>لا توجد أخبار أو مسابقات حالياً — تابع سيرفر الديسكورد لتصلك الجديدة</p>
        <a href="<%= hxDiscord %>" target="_blank" rel="noopener" class="ds-btn ds-btn-secondary ds-btn-sm"><i class="fab fa-discord" aria-hidden="true"></i> انضم للسيرفر</a>
      </div>
      <% } %>
    </div>
  </section>

  <!-- ═══════════ كيف تنضم للعائلة — ثلاث خطوات بخط متصل ═══════════ -->
  <section class="hx-section hx-join" aria-labelledby="hxJoinTitle">
    <div class="ds-container">
      <div class="hx-join-head wf-reveal">
        <span class="hx-kicker">الانضمام</span>
        <h2 class="hx-join-title" id="hxJoinTitle">كيف تنضم للعائلة؟</h2>
        <p class="hx-join-sub">ثلاث خطوات بس وانت من العائلة</p>
      </div>

      <ol class="hx-steps">
        <li class="hx-step wf-reveal">
          <div class="hx-step-top" aria-hidden="true">
            <span class="hx-step-no">٠١</span>
            <span class="hx-step-ic"><i class="fab fa-discord"></i></span>
          </div>
          <h3 class="hx-step-title">انضم لسيرفر الديسكورد</h3>
          <p class="hx-step-txt">سيرفر العائلة الرسمي — من هناك يبدأ كل شيء: التعارف، الألعاب، والمسابقات</p>
          <a href="<%= hxDiscord %>" target="_blank" rel="noopener" class="ds-btn ds-btn-secondary ds-btn-sm hx-step-btn"><i class="fab fa-discord" aria-hidden="true"></i> سيرفر الديسكورد</a>
        </li>

        <li class="hx-step wf-reveal" style="transition-delay:.08s">
          <div class="hx-step-top" aria-hidden="true">
            <span class="hx-step-no">٠٢</span>
            <span class="hx-step-ic"><i class="fas fa-clipboard-check"></i></span>
          </div>
          <h3 class="hx-step-title">تأكد إنك تحقق الشروط</h3>
          <ul class="hx-conds">
            <% hxReqs.forEach(function(c) { %><li><%= c %></li><% }); %>
          </ul>
          <a href="/rules" class="hx-step-link">القوانين كاملة <i class="fas fa-angle-left" aria-hidden="true"></i></a>
        </li>

        <li class="hx-step wf-reveal" style="transition-delay:.16s">
          <div class="hx-step-top" aria-hidden="true">
            <span class="hx-step-no">٠٣</span>
            <span class="hx-step-ic"><i class="fas fa-file-signature"></i></span>
          </div>
          <h3 class="hx-step-title">قدّم من صفحة التقديمات</h3>
          <p class="hx-step-txt">عبّي نموذج الطلب — وبعد الموافقة تصير رسمياً من العائلة</p>
          <a href="/applications" class="ds-btn ds-btn-primary ds-btn-sm hx-step-btn"><i class="fas fa-file-signature" aria-hidden="true"></i> صفحة التقديمات</a>
        </li>
      </ol>
    </div>
  </section>

  <!-- ═══════════ بطاقة الدعم الفني — مكان بانر الانضمام السابق (كان يكرر قسم الخطوات فوقه) ═══════════
       «الدعم» خرج من الهدر بطلب المستخدم — مدخله الرئيسي الآن هنا + فوتر تواصل معنا -->
  <section class="hx-ctasec" aria-labelledby="hxCtaTitle">
    <div class="ds-container">
      <div class="hx-banner wf-reveal">
        <span class="hx-banner-ghost" aria-hidden="true">WALTON</span>
        <div class="hx-banner-body">
          <span class="hx-banner-ic" aria-hidden="true"><i class="fas fa-headset"></i></span>
          <h2 class="hx-banner-title" id="hxCtaTitle">محتاج دعم؟ إحنا موجودين</h2>
          <p class="hx-banner-sub">عندك مشكلة بالمتجر أو النقاط أو استفسار عام عن العائلة — افتح تذكرة بصفحة الدعم وفريق الإدارة يرد عليك بأسرع وقت</p>
          <div class="hx-banner-btns">
            <a href="/support" class="ds-btn ds-btn-primary hx-btn-big"><i class="fas fa-headset" aria-hidden="true"></i> صفحة الدعم الفني</a>
            <a href="<%= hxDiscord %>" target="_blank" rel="noopener" class="ds-btn ds-btn-ghost hx-btn-big"><i class="fab fa-discord" aria-hidden="true"></i> سيرفر الديسكورد</a>
          </div>
        </div>
      </div>
    </div>
  </section>

</main>

<%- include('../partials/footer') %>
<script src="/js/home.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
