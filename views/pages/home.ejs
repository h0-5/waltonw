<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<%
  /* تجهيزات خفيفة — الشعار من الإعدادات فقط (بلا أي استعلام) */
  var hwSettings = typeof settings !== 'undefined' ? settings : {};
  var hwLogo = hwSettings.site_logo_url || '/images/logo.png';
%>

<main class="hw2-page" id="main">

  <!-- ══ الهيرو: الشعار بإطار دائري بنفسجي + جملة واحدة فقط ══ -->
  <section class="hw2-hero" aria-labelledby="heroTitle">
    <div class="hw2-orb wf-reveal">
      <img src="<%= hwLogo %>" alt="شعار Walton Family" width="280" height="280" decoding="async">
    </div>
    <h1 class="hw2-title wf-reveal" style="transition-delay:.06s" id="heroTitle">أكثر من مجرد عائلة</h1>
  </section>

</main>

<%- include('../partials/footer') %>
<script src="/js/main.js"></script>
</body>
</html>
