<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/properties.css">
<link rel="stylesheet" href="/css/properties-inline.css">
<%- include('../partials/navbar') %>

<%
/* ثلاثة أقسام: «الكل» (كل ممتلكات مهما كان نوعها) + الأصول (القصور) + المركبات
   الحلقات متشابهة لكنها مقصودة منفصلة — لكل قسم أيقونته وكلمة نوعه (قصر/مركبة) */
%>

<div class="cy-props-page" dir="rtl">
    <div class="cy-props-hero">
        <div class="wf-orb">
            <span class="wf-orb-glow" aria-hidden="true"></span>
            <span class="wf-orb-ring" aria-hidden="true"></span>
            <span class="wf-orb-core"><i class="fas fa-building" aria-hidden="true"></i></span>
        </div>
        <h1 class="page-heading">ممتلكات <span>العائلة</span></h1>
        <p class="cy-props-hero-sub">جولة داخل خزنة عائلة والتون — من القصور إلى المركبات</p>
        <div class="cy-props-hero-line"></div>
        <div class="cy-props-metrics">
            <div class="cy-pm">
                <div class="cy-pm-val"><%= palaces.length %></div>
                <div class="cy-pm-label">قصر</div>
            </div>
            <div class="cy-pm">
                <div class="cy-pm-val"><%= vehicles.length %></div>
                <div class="cy-pm-label">مركبة</div>
            </div>
            <div class="cy-pm">
                <div class="cy-pm-val"><%= palaces.length + vehicles.length %></div>
                <div class="cy-pm-label">إجمالي الممتلكات</div>
            </div>
        </div>
    </div>

    <div class="cy-props-main">
        <%
        /* قسم «الكل» = القصور + المركبات معاً بنفس ترتيبهما */
        var allAssets = [];
        palaces.forEach(function(p) { allAssets.push({ p: p, palace: true }); });
        vehicles.forEach(function(v) { allAssets.push({ p: v, palace: false }); });
        %>
        <div class="cy-props-tabs">
            <button onclick="showTab('all')" id="tab-all" class="cy-props-tab cy-props-tab-active">
                <i class="fas fa-layer-group"></i>الكل
                <span class="cy-tab-count"><%= allAssets.length %></span>
            </button>
            <button onclick="showTab('palaces')" id="tab-palaces" class="cy-props-tab">
                <i class="fas fa-landmark"></i>الأصول
                <span class="cy-tab-count"><%= palaces.length %></span>
            </button>
            <button onclick="showTab('vehicles')" id="tab-vehicles" class="cy-props-tab">
                <i class="fas fa-car"></i>المركبات
                <span class="cy-tab-count"><%= vehicles.length %></span>
            </button>
        </div>

        <div id="section-all" class="active">
            <% if (allAssets.length === 0) { %>
            <div class="cy-empty">
                <div class="cy-empty-icon"><i class="fas fa-layer-group"></i></div>
                <h3>لا توجد ممتلكات مضافة حالياً</h3>
                <p>سيتم إضافة الممتلكات قريباً</p>
            </div>
            <% } else { %>
            <div class="cy-prop-grid">
                <% allAssets.forEach(function(it, i) { %>
                <article class="cy-prop-card" style="animation-delay:<%= i * 0.06 %>s"
                         data-img="<%= it.p.image %>" data-title="<%= it.p.title %>"
                         onclick="openLightbox(<%= i %>, 'section-all')">
                    <div class="cy-prop-shine"></div>
                    <div class="cy-prop-glare"></div>
                    <span class="cy-prop-idx">القطعة <%= String(i + 1).padStart(2, '0') %></span>
                    <span class="cy-prop-kind-chip"><i class="fas <%= it.palace ? 'fa-landmark' : 'fa-car' %>"></i><%= it.palace ? 'قصر' : 'مركبة' %></span>
                    <div class="cy-prop-media">
                        <img src="<%= it.p.image %>" alt="<%= it.p.title %>" loading="<%= i <= 3 ? 'eager' : 'lazy' %>" decoding="async"
                             onerror="this.closest('.cy-prop-card').classList.add('img-fail')">
                    </div>
                    <div class="cy-prop-body">
                        <div class="cy-prop-row">
                            <h3 class="cy-prop-title"><%= it.p.title %></h3>
                            <span class="cy-prop-zoom"><i class="fas fa-search-plus"></i></span>
                        </div>
                        <span class="cy-prop-kind"><%= it.palace ? 'قصر من ممتلكات العائلة' : 'مركبة من أسطول العائلة' %></span>
                    </div>
                </article>
                <% }); %>
            </div>
            <% } %>
        </div>

        <div id="section-palaces">
            <% if (palaces.length === 0) { %>
            <div class="cy-empty">
                <div class="cy-empty-icon"><i class="fas fa-landmark"></i></div>
                <h3>لا توجد أصول مضافة حالياً</h3>
                <p>سيتم إضافة الممتلكات قريباً</p>
            </div>
            <% } else { %>
            <div class="cy-prop-grid">
                <% palaces.forEach(function(p, i) { %>
                <article class="cy-prop-card" style="animation-delay:<%= i * 0.06 %>s"
                         data-img="<%= p.image %>" data-title="<%= p.title %>"
                         onclick="openLightbox(<%= i %>, 'section-palaces')">
                    <div class="cy-prop-shine"></div>
                    <div class="cy-prop-glare"></div>
                    <span class="cy-prop-idx">القطعة <%= String(i + 1).padStart(2, '0') %></span>
                    <span class="cy-prop-kind-chip"><i class="fas fa-landmark"></i>قصر</span>
                    <div class="cy-prop-media">
                        <img src="<%= p.image %>" alt="<%= p.title %>" loading="<%= i <= 3 ? 'eager' : 'lazy' %>" decoding="async"
                             onerror="this.closest('.cy-prop-card').classList.add('img-fail')">
                    </div>
                    <div class="cy-prop-body">
                        <div class="cy-prop-row">
                            <h3 class="cy-prop-title"><%= p.title %></h3>
                            <span class="cy-prop-zoom"><i class="fas fa-search-plus"></i></span>
                        </div>
                        <span class="cy-prop-kind">قصر من ممتلكات العائلة</span>
                    </div>
                </article>
                <% }); %>
            </div>
            <% } %>
        </div>

        <div id="section-vehicles">
            <% if (vehicles.length === 0) { %>
            <div class="cy-empty">
                <div class="cy-empty-icon"><i class="fas fa-car"></i></div>
                <h3>لا توجد مركبات مضافة حالياً</h3>
                <p>سيتم إضافة المركبات قريباً</p>
            </div>
            <% } else { %>
            <div class="cy-prop-grid">
                <% vehicles.forEach(function(p, i) { %>
                <article class="cy-prop-card" style="animation-delay:<%= i * 0.06 %>s"
                         data-img="<%= p.image %>" data-title="<%= p.title %>"
                         onclick="openLightbox(<%= i %>, 'section-vehicles')">
                    <div class="cy-prop-shine"></div>
                    <div class="cy-prop-glare"></div>
                    <span class="cy-prop-idx">القطعة <%= String(i + 1).padStart(2, '0') %></span>
                    <span class="cy-prop-kind-chip"><i class="fas fa-car"></i>مركبة</span>
                    <div class="cy-prop-media">
                        <img src="<%= p.image %>" alt="<%= p.title %>" loading="<%= i <= 3 ? 'eager' : 'lazy' %>" decoding="async"
                             onerror="this.closest('.cy-prop-card').classList.add('img-fail')">
                    </div>
                    <div class="cy-prop-body">
                        <div class="cy-prop-row">
                            <h3 class="cy-prop-title"><%= p.title %></h3>
                            <span class="cy-prop-zoom"><i class="fas fa-search-plus"></i></span>
                        </div>
                        <span class="cy-prop-kind">مركبة من أسطول العائلة</span>
                    </div>
                </article>
                <% }); %>
            </div>
            <% } %>
        </div>
    </div>
</div>

<div id="lightbox" class="cy-lightbox" onclick="closeLightbox(event)">
    <button class="cy-lb-nav cy-lb-prev" onclick="lbNav(event, -1)" aria-label="السابق"><i class="fas fa-chevron-right"></i></button>
    <figure class="cy-lb-fig" onclick="lbNav(event, 1)">
        <img id="lightboxImg" src="" alt="صورة مكبرة">
        <figcaption class="cy-lb-cap">
            <span class="cy-lb-title" id="lbTitle"></span>
            <span class="cy-lb-count" id="lbCount" dir="ltr"></span>
        </figcaption>
    </figure>
    <button class="cy-lb-nav cy-lb-next" onclick="lbNav(event, 1)" aria-label="التالي"><i class="fas fa-chevron-left"></i></button>
    <button class="cy-lightbox-close" onclick="closeLightbox(event)"><i class="fas fa-times"></i></button>
</div>

<script>
function showTab(tab) {
    /* تبديل عام لأي عدد من التبويبات — الكل / أصول / المركبات */
    ['all', 'palaces', 'vehicles'].forEach(function(n) {
        document.getElementById('section-' + n).classList.toggle('active', n === tab);
        document.getElementById('tab-' + n).classList.toggle('cy-props-tab-active', n === tab);
    });
}

/* ── Lightbox كمعرض: تجميع بطاقات القسم الحالي + تنقّل سابق/تالي + عدّاد ── */
var lbItems = [], lbIdx = 0;
function renderLB() {
    var it = lbItems[lbIdx];
    if (!it) return;
    document.getElementById('lightboxImg').src = it.img;
    document.getElementById('lbTitle').textContent = it.title;
    document.getElementById('lbCount').textContent = (lbIdx + 1) + ' / ' + lbItems.length;
    var one = lbItems.length < 2;
    document.querySelector('.cy-lb-prev').style.display = one ? 'none' : 'flex';
    document.querySelector('.cy-lb-next').style.display = one ? 'none' : 'flex';
}
function openLightbox(idx, sectionId) {
    lbItems = Array.prototype.map.call(document.querySelectorAll('#' + sectionId + ' .cy-prop-card'), function(c) {
        return { img: c.getAttribute('data-img'), title: c.getAttribute('data-title') };
    });
    lbIdx = idx;
    renderLB();
    document.getElementById('lightbox').classList.add('open');
}
function lbNav(e, d) {
    if (e) e.stopPropagation();
    if (lbItems.length < 2) return;
    lbIdx = (lbIdx + d + lbItems.length) % lbItems.length;
    renderLB();
}
function closeLightbox(e) {
    if (e) e.stopPropagation();
    document.getElementById('lightbox').classList.remove('open');
    document.getElementById('lightboxImg').src = '';
}
document.addEventListener('keydown', function(e) {
    if (!document.getElementById('lightbox').classList.contains('open')) return;
    if (e.key === 'Escape') closeLightbox();
    /* RTL: السهم اليمين يرجع للسابق واليسار يتقدّم للتالي */
    if (e.key === 'ArrowRight') lbNav(null, -1);
    if (e.key === 'ArrowLeft') lbNav(null, 1);
});

/* ── Holo 3D Tilt — نفس محرك بطاقات التقديمات حرفياً: تتبّع المؤشر لإطار البطاقة
   + ارتداد نابض عند المغادرة + بوابة لمس تمنع أحداث الماوس المزيفة ── */
(function(){
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var MAX = 8, LIFT = 7, CHASE = 0.5, RELEASE = 0.72, MIN = 0.6;
    var live = null, touchGate = 0;
    document.addEventListener('touchstart', function(){ touchGate = Date.now(); }, { passive: true, capture: true });
    document.querySelectorAll('.cy-prop-grid .cy-prop-card').forEach(function(card){
        if (card.dataset.tilt) return;
        card.dataset.tilt = '1';
        var raf = null, active = false;
        var ax = 0, ay = 0, az = 0, tx = 0, ty = 0, tl = 0, rect = null;
        function frame(){
            var k = active ? CHASE : (1 - RELEASE);
            ax += (tx - ax) * k;
            ay += (ty - ay) * k;
            az += (tl - az) * k;
            card.style.transform = 'perspective(900px) translateY(' + az.toFixed(2) + 'px) rotateX(' + ax.toFixed(2) + 'deg) rotateY(' + ay.toFixed(2) + 'deg)';
            if (active || Math.abs(ax) > MIN || Math.abs(ay) > MIN || Math.abs(az) > 0.3) {
                raf = requestAnimationFrame(frame);
            } else {
                raf = null;
                card.style.transform = '';
                card.style.transition = '';
                card.classList.remove('tilting');
                if (live === card) live = null;
            }
        }
        card.addEventListener('mouseenter', function(e){
            if (Date.now() - touchGate < 900) return;
            rect = card.getBoundingClientRect();
            active = true; tx = 0; ty = 0; tl = -LIFT;
            card.style.transition = 'box-shadow .4s ease, border-color .4s ease';
            card.classList.add('tilting');
            live = card;
            if (!raf) raf = requestAnimationFrame(frame);
        });
        card.addEventListener('mousemove', function(e){
            if (Date.now() - touchGate < 900) return;
            if (!rect) rect = card.getBoundingClientRect();
            var px = (e.clientX - rect.left) / rect.width - 0.5;
            var py = (e.clientY - rect.top) / rect.height - 0.5;
            ty = px * MAX * 2;
            tx = -py * MAX * 2;
            card.style.setProperty('--mx', (e.clientX - rect.left).toFixed(1) + 'px');
            card.style.setProperty('--my', (e.clientY - rect.top).toFixed(1) + 'px');
        });
        card.addEventListener('mouseleave', function(){
            active = false; tx = 0; ty = 0; tl = 0; rect = null;
        });
        card.__invalidate = function(){ rect = null; };
    });
    window.addEventListener('scroll', function(){
        if (live && live.__invalidate) live.__invalidate();
    }, { passive: true });
})();
</script>

<%- include('../partials/footer') %>
