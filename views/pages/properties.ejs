<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/properties.css">
<link rel="stylesheet" href="/css/properties-inline.css">
<%- include('../partials/navbar') %>

<%- include('../partials/page-hero', { pageTitle: 'الممتلكات', pageIcon: 'fas fa-building', pageDesc: 'استكشف ممتلكات عائلة والتون الفاخرة', pageStats: [{ value: palaces.length, label: 'قصور' }, { value: vehicles.length, label: 'مركبات' }] }) %>

<div class="cy-props-page" dir="rtl">

    <div class="cy-props-main">
        <div class="cy-props-tabs">
            <button onclick="showTab('palaces')" id="tab-palaces" class="cy-props-tab cy-props-tab-active">
                <i class="fas fa-landmark"></i>القصور
            </button>
            <button onclick="showTab('vehicles')" id="tab-vehicles" class="cy-props-tab">
                <i class="fas fa-car"></i>المركبات
            </button>
        </div>

        <div id="section-palaces" class="active">
            <% if (palaces.length === 0) { %>
            <div class="cy-empty wf-reveal">
                <div class="cy-empty-icon"><i class="fas fa-landmark"></i></div>
                <h3>لا توجد قصور مضافة حالياً</h3>
                <p>سيتم إضافة الممتلكات قريباً</p>
            </div>
            <% } else { %>
            <% palaces.forEach(function(p, i) { %>
            <div class="cy-prop-card wf-reveal" style="transition-delay:<%= i * 0.08 %>s">
                <div class="corner-tl"></div>
                <div class="corner-br"></div>
                <div class="cy-prop-header">
                    <div class="cy-prop-icon"><i class="fas fa-landmark"></i></div>
                    <h3 class="cy-prop-title"><%= p.title %></h3>
                </div>
                <div class="cy-prop-img-wrap" onclick="openLightbox(this.dataset.img)" data-img="<%= p.image %>">
                    <img src="<%= p.image %>" alt="<%= p.title %>" loading="<%= i <= 1 ? 'eager' : 'lazy' %>" decoding="async">
                    <div class="cy-prop-img-hint"><i class="fas fa-search-plus"></i> تكبير</div>
                </div>
            </div>
            <% }); %>
            <% } %>
        </div>

        <div id="section-vehicles">
            <% if (vehicles.length === 0) { %>
            <div class="cy-empty wf-reveal">
                <div class="cy-empty-icon"><i class="fas fa-car"></i></div>
                <h3>لا توجد مركبات مضافة حالياً</h3>
                <p>سيتم إضافة المركبات قريباً</p>
            </div>
            <% } else { %>
            <% vehicles.forEach(function(p, i) { %>
            <div class="cy-prop-card wf-reveal" style="transition-delay:<%= i * 0.08 %>s">
                <div class="corner-tl"></div>
                <div class="corner-br"></div>
                <div class="cy-prop-header">
                    <div class="cy-prop-icon"><i class="fas fa-car"></i></div>
                    <h3 class="cy-prop-title"><%= p.title %></h3>
                </div>
                <div class="cy-prop-img-wrap" onclick="openLightbox(this.dataset.img)" data-img="<%= p.image %>">
                    <img src="<%= p.image %>" alt="<%= p.title %>" loading="<%= i <= 1 ? 'eager' : 'lazy' %>" decoding="async">
                    <div class="cy-prop-img-hint"><i class="fas fa-search-plus"></i> تكبير</div>
                </div>
            </div>
            <% }); %>
            <% } %>
        </div>
    </div>
</div>

<div id="lightbox" class="cy-lightbox" onclick="closeLightbox()">
    <img id="lightboxImg" src="" alt="صورة مكبرة">
    <button class="cy-lightbox-close" onclick="closeLightbox()"><i class="fas fa-times"></i></button>
</div>

<script>
function showTab(tab) {
    var palaces = document.getElementById('section-palaces');
    var vehicles = document.getElementById('section-vehicles');
    var tabP = document.getElementById('tab-palaces');
    var tabV = document.getElementById('tab-vehicles');
    if (tab === 'palaces') {
        palaces.classList.add('active'); vehicles.classList.remove('active');
        tabP.classList.add('cy-props-tab-active'); tabV.classList.remove('cy-props-tab-active');
    } else {
        vehicles.classList.add('active'); palaces.classList.remove('active');
        tabV.classList.add('cy-props-tab-active'); tabP.classList.remove('cy-props-tab-active');
    }
}
function openLightbox(src) { document.getElementById('lightboxImg').src = src; document.getElementById('lightbox').classList.add('open'); if (event) event.stopPropagation(); }
function closeLightbox() { document.getElementById('lightbox').classList.remove('open'); document.getElementById('lightboxImg').src = ''; }
document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeLightbox(); });
</script>

<%- include('../partials/footer') %>
