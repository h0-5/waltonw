<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<%
  /* ===== بيانات محمية من غياب أي locals (ترجمة الاختبار/بيانات ناقصة) ===== */
  var _pfUser = (typeof user !== 'undefined' && user) ? user : {};
  var _pfPts = 0, _pfEarned = 0;
  if (typeof userPoints !== 'undefined') {
    if (typeof userPoints === 'number') { _pfPts = userPoints || 0; }
    else if (userPoints && typeof userPoints === 'object') {
      _pfPts = userPoints.points || 0;
      _pfEarned = userPoints.total_earned || 0;
    }
  }
  var _pfAch = (typeof achievements !== 'undefined' && achievements && achievements.length) ? achievements : [];
  var _pfNotif = (typeof notifCount !== 'undefined' && notifCount) ? notifCount : 0;
  var _pfGamePts = _pfUser.total_game_points || 0;
  var _pfTickets = _pfUser.tickets_closed || 0;
  var _pfWarns = _pfUser.warn_count || 0;
  var _pfLevel = Math.floor(_pfPts / 100) + 1;
  var _pfProg = _pfPts % 100;
  var _pfRoleMap = {
    'owner': 'المالك', 'founder': 'المؤسس', 'developer': 'المطور',
    'admin': 'إداري', 'moderator': 'مشرف', 'support': 'الدعم', 'user': 'عضو'
  };
  var _pfRoleIconMap = {
    'owner': 'fa-crown', 'founder': 'fa-flag', 'developer': 'fa-code',
    'admin': 'fa-user-shield', 'moderator': 'fa-shield-halved',
    'support': 'fa-headset', 'user': 'fa-user'
  };
  var _pfRoleKey = _pfUser.role || 'user';
  var _pfRoleName = _pfRoleMap[_pfRoleKey] || _pfRoleKey;
  var _pfRoleIcon = _pfRoleIconMap[_pfRoleKey] || 'fa-user';
  var _pfInitial = (_pfUser.username || 'و').charAt(0).toUpperCase();
  var _pfJoined = '', _pfLastLogin = '';
  try { _pfJoined = _pfUser.created_at ? new Date(_pfUser.created_at).toLocaleDateString('ar-SA') : ''; } catch (e) { _pfJoined = ''; }
  try { _pfLastLogin = _pfUser.last_login ? new Date(_pfUser.last_login).toLocaleString('ar-SA') : ''; } catch (e) { _pfLastLogin = ''; }
%>

<main class="pfw-page">
  <div class="pfw-wrap">
    <div class="pfw-shell">

      <!-- ═══ بطاقة العضو (الجانب) ═══ -->
      <aside class="pfw-side wf-reveal">
        <div class="pfw-side-cover">
          <% if (_pfUser.cover_photo) { %>
          <img src="<%= _pfUser.cover_photo %>" alt="cover" class="pfw-side-cover-img">
          <% } %>
          <div class="pfw-side-cover-fx"></div>
        </div>
        <div class="pfw-side-body">
          <div class="pfw-avatar">
            <% if (_pfUser.profile_picture) { %>
            <img src="<%= _pfUser.profile_picture %>" alt="avatar" class="pfw-avatar-img">
            <% } else { %>
            <div class="pfw-avatar-ph"><%= _pfInitial %></div>
            <% } %>
          </div>
          <h1 class="pfw-name"><%= _pfUser.username || 'عضو' %></h1>
          <div class="pfw-chips">
            <span class="pfw-role pfw-role-<%= _pfRoleKey %>"><i class="fas <%= _pfRoleIcon %>"></i><%= _pfRoleName %></span>
            <% if (_pfJoined) { %>
            <span class="pfw-chip"><i class="fas fa-calendar"></i>انضم <%= _pfJoined %></span>
            <% } %>
            <% if (_pfNotif > 0) { %>
            <span class="pfw-chip pfw-chip-warn"><i class="fas fa-bell"></i><%= _pfNotif %> إشعار جديد</span>
            <% } %>
          </div>

          <a href="/store" class="pfw-cta"><i class="fas fa-store"></i>اذهب للمتجر</a>

          <div class="pfw-level">
            <div class="pfw-level-head">
              <span class="pfw-level-lbl"><i class="fas fa-bolt"></i>المستوى <%= _pfLevel %></span>
              <span class="pfw-level-pts"><%= _pfPts %> نقطة</span>
            </div>
            <div class="pfw-level-bar"><span class="pfw-level-fill pfw-barfill" data-width="<%= _pfProg %>" style="width:<%= _pfProg %>%"></span></div>
            <div class="pfw-level-sub"><%= _pfProg %> / 100 نحو المستوى <%= _pfLevel + 1 %></div>
          </div>

          <div class="pfw-info">
            <div class="pfw-info-row">
              <span class="pfw-info-ico"><i class="fas fa-user"></i></span>
              <span class="pfw-info-block"><span class="pfw-info-lbl">اسم المستخدم</span><span class="pfw-info-val"><%= _pfUser.username || '—' %></span></span>
            </div>
            <% if (_pfUser.discord_id) { %>
            <div class="pfw-info-row">
              <span class="pfw-info-ico"><i class="fab fa-discord"></i></span>
              <span class="pfw-info-block"><span class="pfw-info-lbl">ديسكورد ID</span><span class="pfw-info-val" dir="ltr"><%= _pfUser.discord_id %></span></span>
            </div>
            <% } %>
            <div class="pfw-info-row">
              <span class="pfw-info-ico"><i class="fas fa-envelope"></i></span>
              <span class="pfw-info-block"><span class="pfw-info-lbl">البريد</span><span class="pfw-info-val"><%= _pfUser.email || 'غير محدد' %></span></span>
            </div>
            <div class="pfw-info-row">
              <span class="pfw-info-ico"><i class="fas fa-right-to-bracket"></i></span>
              <span class="pfw-info-block"><span class="pfw-info-lbl">آخر دخول</span><span class="pfw-info-val"><%= _pfLastLogin || 'غير معروف' %></span></span>
            </div>
          </div>
        </div>
      </aside>

      <!-- ═══ اللوحة: تبويبات ═══ -->
      <div class="pfw-main wf-reveal" style="transition-delay:.08s">
        <div class="pfw-tabs" role="tablist">
          <button type="button" class="pfw-tab active" data-pane="ov"><i class="fas fa-gauge-high"></i>نظرة عامة</button>
          <button type="button" class="pfw-tab" data-pane="achs"><i class="fas fa-trophy"></i>إنجازاتي<span class="pfw-tab-badge"><%= _pfAch.length %></span></button>
          <button type="button" class="pfw-tab" data-pane="set"><i class="fas fa-gear"></i>إعداداتي</button>
        </div>

        <!-- ── نظرة عامة ── -->
        <section class="pfw-pane active" id="pfw-pane-ov">
          <div class="pfw-hero">
            <div class="pfw-hero-card pfw-hero-accent">
              <span class="pfw-hero-ico"><i class="fas fa-coins"></i></span>
              <div class="pfw-hero-body">
                <span class="pfw-hero-lbl">رصيد نقاطي</span>
                <span class="pfw-hero-num"><span class="pfw-count" data-count="<%= _pfPts %>"><%= _pfPts %></span> <small>نقطة</small></span>
              </div>
            </div>
            <div class="pfw-hero-card">
              <span class="pfw-hero-ico"><i class="fas fa-bolt"></i></span>
              <div class="pfw-hero-body">
                <span class="pfw-hero-lbl">المستوى <%= _pfLevel %></span>
                <div class="pfw-hero-bar"><span class="pfw-barfill" data-width="<%= _pfProg %>" style="width:<%= _pfProg %>%"></span></div>
                <span class="pfw-hero-sub"><%= _pfProg %> / 100 نحو المستوى <%= _pfLevel + 1 %></span>
              </div>
            </div>
          </div>

          <div class="pfw-mini">
            <div class="pfw-mini-item">
              <span class="pfw-mini-num pfw-count" data-count="<%= _pfGamePts %>"><%= _pfGamePts %></span>
              <span class="pfw-mini-lbl">نقاط الألعاب</span>
            </div>
            <div class="pfw-mini-item">
              <span class="pfw-mini-num pfw-count" data-count="<%= _pfEarned %>"><%= _pfEarned %></span>
              <span class="pfw-mini-lbl">إجمالي المكتسب</span>
            </div>
            <div class="pfw-mini-item">
              <span class="pfw-mini-num pfw-count" data-count="<%= _pfTickets %>"><%= _pfTickets %></span>
              <span class="pfw-mini-lbl">تذاكر مغلقة</span>
            </div>
            <div class="pfw-mini-item<%= _pfWarns > 0 ? ' pfw-mini-warn' : '' %>">
              <span class="pfw-mini-num pfw-count" data-count="<%= _pfWarns %>"><%= _pfWarns %></span>
              <span class="pfw-mini-lbl">تحذيرات</span>
            </div>
          </div>

          <h3 class="pfw-sec-title"><i class="fas fa-list-ul"></i>كل أمور حسابك</h3>
          <div class="pfw-tiles">
            <a href="/orders" class="pfw-tile">
              <span class="pfw-tile-ico"><i class="fas fa-box"></i></span>
              <span class="pfw-tile-name">طلباتي</span>
              <span class="pfw-tile-desc">تتبع مشترياتك وحالتها</span>
            </a>
            <a href="/cart" class="pfw-tile">
              <span class="pfw-tile-ico"><i class="fas fa-cart-shopping"></i></span>
              <span class="pfw-tile-name">سلة المشتريات</span>
              <span class="pfw-tile-desc">منتجاتك المعلقة</span>
            </a>
            <a href="/my_discounts" class="pfw-tile">
              <span class="pfw-tile-ico"><i class="fas fa-tag"></i></span>
              <span class="pfw-tile-name">خصوماتي</span>
              <span class="pfw-tile-desc">كوبوناتك الحصرية</span>
            </a>
            <a href="/applications/my" class="pfw-tile">
              <span class="pfw-tile-ico"><i class="fas fa-file-lines"></i></span>
              <span class="pfw-tile-name">تقديماتي</span>
              <span class="pfw-tile-desc">حالة طلبات الانضمام</span>
            </a>
            <a href="/support/my-tickets" class="pfw-tile">
              <span class="pfw-tile-ico"><i class="fas fa-headset"></i></span>
              <span class="pfw-tile-name">تذاكري</span>
              <span class="pfw-tile-desc">الدعم الفني والردود</span>
            </a>
            <a href="/games" class="pfw-tile">
              <span class="pfw-tile-ico"><i class="fas fa-gamepad"></i></span>
              <span class="pfw-tile-name">الألعاب</span>
              <span class="pfw-tile-desc">العب واجمع النقاط</span>
            </a>
          </div>
        </section>

        <!-- ── إنجازاتي ── -->
        <section class="pfw-pane" id="pfw-pane-achs">
          <% if (_pfAch.length) { %>
          <div class="pfw-achs">
            <% _pfAch.forEach(function(a) { %>
            <div class="pfw-ach">
              <span class="pfw-ach-ico"><i class="fas fa-medal"></i></span>
              <div class="pfw-ach-body">
                <div class="pfw-ach-name"><%= a.achievement_name || 'إنجاز' %></div>
                <% if (a.earned_at) { %>
                <div class="pfw-ach-date"><i class="fas fa-clock"></i><%= new Date(a.earned_at).toLocaleDateString('ar-SA') %></div>
                <% } %>
              </div>
            </div>
            <% }); %>
          </div>
          <% } else { %>
          <div class="pfw-empty">
            <span class="pfw-empty-ico"><i class="fas fa-medal"></i></span>
            <p>لا إنجازات بعد — العب الألعاب واجمع النقاط لتحصل على إنجازاتك</p>
            <a href="/games" class="pfw-empty-btn"><i class="fas fa-gamepad"></i>اذهب للألعاب</a>
          </div>
          <% } %>
        </section>

        <!-- ── إعداداتي ── -->
        <section class="pfw-pane" id="pfw-pane-set">
          <h3 class="pfw-sec-title pfw-sec-first"><i class="fas fa-user-pen"></i>تعديل الملف الشخصي</h3>
          <form id="profileForm" class="pfw-form">
            <div class="pfw-field">
              <label for="username"><i class="fas fa-user"></i>اسم المستخدم</label>
              <input type="text" id="username" value="<%= _pfUser.username || '' %>" minlength="3" maxlength="30" required>
              <span class="pfw-field-hint"><i class="fas fa-circle-info"></i>اسمك يظهر لبقية الأعضاء — من 3 إلى 30 حرفاً</span>
            </div>
            <button type="submit" class="pfw-save"><i class="fas fa-floppy-disk"></i>حفظ التغييرات</button>
          </form>
        </section>
      </div>

    </div>
  </div>
</main>

<%- include('../partials/footer') %>
<script src="/js/main.js"></script>
<script>
/* شريط المستوى + العدّادات + التبويبات — rAF واحد + IntersectionObserver، بلا مكتبات */
(function(){
  var reduced = false;
  try { reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
  var fmt = function(n){ return String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ','); };

  /* أشرطة التقدم: من 0 إلى العرض الفعلي مرة واحدة */
  var fills = [].slice.call(document.querySelectorAll('.pfw-barfill'));
  if (fills.length && !reduced) {
    fills.forEach(function(f){ f.dataset.target = f.getAttribute('data-width') || '0'; f.style.width = '0%'; });
    requestAnimationFrame(function(){
      setTimeout(function(){
        fills.forEach(function(f){ f.style.width = f.dataset.target + '%'; });
      }, 120);
    });
  }

  /* عدّاد صاعد لكل رقم بـ data-count */
  var els = [].slice.call(document.querySelectorAll('.pfw-count[data-count]'));
  var run = function(el){
    var target = parseInt(el.getAttribute('data-count'), 10) || 0;
    if (reduced || target <= 0) { el.textContent = fmt(target); return; }
    var t0 = null, dur = 950;
    var step = function(ts){
      if (!t0) t0 = ts;
      var p = Math.min((ts - t0) / dur, 1);
      p = 1 - Math.pow(1 - p, 3);
      el.textContent = fmt(Math.round(target * p));
      if (p < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };
  if (!els.length) return;
  if (!('IntersectionObserver' in window)) { els.forEach(run); return; }
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if (e.isIntersecting) { run(e.target); io.unobserve(e.target); }
    });
  }, { threshold: 0.3 });
  els.forEach(function(el){ io.observe(el); });
})();

/* التبويبات — كلاسات فقط، بلا أي مستمعات سكرول */
(function(){
  var tabs = document.querySelectorAll('.pfw-tab');
  if (!tabs.length) return;
  tabs.forEach(function(t){
    t.addEventListener('click', function(){
      [].forEach.call(document.querySelectorAll('.pfw-tab'), function(x){ x.classList.remove('active'); });
      [].forEach.call(document.querySelectorAll('.pfw-pane'), function(x){ x.classList.remove('active'); });
      t.classList.add('active');
      var p = document.getElementById('pfw-pane-' + t.getAttribute('data-pane'));
      if (p) p.classList.add('active');
    });
  });
})();
</script>
<script>
document.getElementById('profileForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  const username = document.getElementById('username').value;

  try {
    const res = await fetch('/api/profile/update', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ username })
    });
    const data = await res.json();
    if (data.success) {
      WaltonAPI.showNotification('تم التحديث بنجاح!', 'success');
      setTimeout(() => location.reload(), 1000);
    } else {
      WaltonAPI.showNotification(data.error || 'فشل التحديث', 'error');
    }
  } catch(e) {
    WaltonAPI.showNotification('حدث خطأ', 'error');
  }
});
</script>
</body>
</html>
