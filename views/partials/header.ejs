<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%
    var _siteName = typeof siteName !== 'undefined' ? siteName : 'Walton Family';
    var _accentColor = typeof accentColor !== 'undefined' ? accentColor : '#bc13fe';
    var _rgbArr = _accentColor.replace('#', '').match(/.{2}/g).map(function(h){ return parseInt(h, 16); });
    var _acRgb = _rgbArr.join(', ');
    var _clampC = function(v){ return Math.max(0, Math.min(255, Math.round(v))); };
    var _acDark = _rgbArr.map(function(v){ return _clampC(v * 0.72); }).join(', ');
    var _acLight = _rgbArr.map(function(v){ return _clampC(v * 1.18 + 22); }).join(', ');
    var _bgUrl = typeof bgUrl !== 'undefined' ? bgUrl : '';
    var _mobileBgUrl = typeof mobileBgUrl !== 'undefined' ? mobileBgUrl : '';
    /* الثيم الأساسي البنفسجي مرجعه main.css :root — قيم الإعدادات تُطبق فقط عند تخصيص فعلي
       (قيمة فارغة = اترك المتغير لـ main.css، فلا تُكسر بنفسجية الثيم بقيم سوداء افتراضية) */
    var _bgColor = typeof bgColor === 'string' ? bgColor : '';
    var _textColor = typeof textColor === 'string' ? textColor : '';
    var _cardColor = typeof cardColor === 'string' ? cardColor : '';
    var _borderColor = typeof borderColor === 'string' ? borderColor : '';
  %>
  <meta name="description" content="<%= _siteName %> - مجتمعنا الرقمي">
  <meta name="theme-color" content="<%= _accentColor %>">
  <%
    /* تسليح ظهور التمرير مبكراً: كلاس على <html> قبل أي رسم — قواعد إخفاء .wf-reveal
       في CSS الصفحات تُطبق فقط وهوه موجود، فلو تعطل JS (أو مات الـ Observer) تبقى
       كل الأقسام ظاهرة بدل فراغ أبيض — نفس عائلة بلاغ «صفحة من نحن مو ظاهرة كاملة» */
  %>
  <script>if('IntersectionObserver' in window){document.documentElement.className+=' wf-reveal-armed';}</script>
  <%
    /* حارس الافتتاحية: تُعرض مرة واحدة فقط لكل تبويب (sessionStorage) — لا تتكرر مع
       التنقل بين الصفحات ولا مع الرجوع للرئيسية. يُقرأ هنا قبل أي رسم فلا وميض:
       - wf-no-intro   : شفتها سابقاً → الافتتاحية display:none فوراً
       - wf-intro-armed: أول مرة بهذا التبويب → تُعرض، والعلامة تُكتب من الحين */
  %>
  <script>(function(){var s=null;try{s=sessionStorage.getItem('wfIntroDone');}catch(e){}
    var force=location.search.indexOf('wfiforce')!==-1; /* وضع التصوير/التصحيح فقط */
    if(s==='1'&&!force){document.documentElement.className+=' wf-no-intro';}
    else{document.documentElement.className+=' wf-intro-armed';try{sessionStorage.setItem('wfIntroDone','1');}catch(e){}}})();</script>
  <% /* مود ليل/نهار أُزيل كلياً (طلب المستخدم) — لا wfTheme ولا data-theme: الثيم الداكن القديم دائم */ %>
  <%
    /* عنوان التبويب: «اسم الصفحة | اسم الموقع» — لكن لو عنوان الصفحة هو اسم الموقع
       نفسه (الرئيسية تُمرر site_name كعنوان) يُعرض مرة واحدة بلا تكرار */
    var _tabTitle = (typeof title !== 'undefined' && title && title !== _siteName) ? (title + ' | ' + _siteName) : _siteName;
  %>
  <title><%= _tabTitle %></title>

  <!-- أيقونة التبويب: لوغو العيلة (W بالتاج) — بدل كرة الأرض الافتراضية -->
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png">
  <link rel="icon" type="image/png" sizes="64x64" href="/images/favicon-64.png">
  <link rel="shortcut icon" href="/favicon.ico">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">

  <!-- Preload الصور الحرجة (اللوغو والخلفية المحلية فقط) — أول ما تفتح الصفحة تبدأ بالتحميل فوراً مع الكاش 7 أيام فما تعيد التحميل مع كل تنقل -->
  <% var _logoUrl = (typeof settings !== 'undefined' && settings && settings.site_logo_url) ? settings.site_logo_url : '/images/logo.png'; %>
  <% if (_logoUrl.indexOf('/') === 0) { %><link rel="preload" as="image" href="<%= _logoUrl %>"><% } %>
  <% if (_bgUrl && _bgUrl.indexOf('/images/') === 0) { %><link rel="preload" as="image" href="<%= _bgUrl %>" media="(min-width: 769px)"><% } %>
  <% if (_mobileBgUrl && _mobileBgUrl.indexOf('/images/') === 0) { %><link rel="preload" as="image" href="<%= _mobileBgUrl %>" media="(max-width: 768px)"><% } %>
  
  <!-- Fonts — أوزان مستخدمة فعلياً فقط (تقليم ٦ ملفات خطوط عربية ثقيلة ≈ ‎250KB+‎ من أول تحميل) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
  <!-- خطان للهوية الجديدة (Cairo عناوين + IBM Plex Sans Arabic نصوص) — Space Grotesk وCinzel تبقى لصفحات/أنميشن قديمة حتى مرحلتها — حذف Noto Sans Arabic وفّر 4 ملفات
       الأوزان المحمّلة = كل الأوزان المستخدمة فعلاً بالكود (بلاغ المستخدم: «طبق نفس الموضوع ع خطوط كل الموقع»):
       أي وزن غير محمّل كان المتصفح يصنعه مصطنعاً فيبدو مشوشاً — كايرو اكتمل 400-800 وPlex حتى 700 (أقصاه المتاح) — ملفات variable نفسها بلا زيادة حجم -->
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=Cinzel+Decorative:wght@700&display=swap" rel="stylesheet">
  
  <!-- Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <!-- Styles — الأساسيات على كل صفحة، وCSS كل صفحة يُحمّل بصفحته فقط (أخف بـ ‎~150KB‎ للصفحة)
       نظام التصميم الموحد بعد main/footer ليحسم أي تعارض بأسماء قديمة، وقبل CSS الصفحات المتبقية -->
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="/css/design-system.css">
  <% var _pCss = (typeof currentPath === 'string' ? currentPath : ''); %>
  <% if (_pCss === '/' || _pCss === '/home') { %>
  <!-- خط Rubik عصري — يُحمَّل بصفحة الرئيسية فقط (بطاقة الدعم بالهيرو السفلي) لا على كل الصفحات -->
  <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/home.css">
  <% } %>
  <link rel="stylesheet" href="/css/page-hero.css">
  <% if (_pCss.indexOf('/store') === 0 || _pCss.indexOf('/products') === 0) { %>
  <link rel="stylesheet" href="/css/store.css">
  <link rel="stylesheet" href="/css/products.css">
  <% } %>
  <% if (_pCss.indexOf('/games') === 0) { %>
  <link rel="stylesheet" href="/css/games-page.css">
  <% } %>
  <% if (_pCss.indexOf('/rules') === 0) { %>
  <link rel="stylesheet" href="/css/rules-page.css">
  <% } %>
  <% if (_pCss.indexOf('/about') === 0) { %>
  <link rel="stylesheet" href="/css/about.css">
  <% } %>
  <% if (_pCss.indexOf('/applications') === 0) { %>
  <link rel="stylesheet" href="/css/applications-page.css">
  <% } %>
  <% if (_pCss.indexOf('/community') === 0) { %>
  <link rel="stylesheet" href="/css/community.css">
  <% } %>
  <% if (_pCss.indexOf('/profile') === 0) { %>
  <link rel="stylesheet" href="/css/profile.css">
  <% } %>
  
  <style>
    :root {
      --ac: <%= _accentColor %>;
      --ac-rgb: <%= _acRgb %>;
      --ac-dark: rgb(<%= _acDark %>);
      --ac-dark-rgb: <%= _acDark %>;
      --ac-light: rgb(<%= _acLight %>);
      --bg-url: url('<%= _bgUrl %>');
      --mobile-bg-url: url('<%= _mobileBgUrl %>');
      <% if (_bgColor) { %>--bg-body: <%= _bgColor %>;
      --bg-deep: <%= _bgColor %>;<% } %>
      <% if (_cardColor) { %>--bg-card: <%= _cardColor %>;
      --bg-card-solid: <%= _cardColor %>;
      --bg-glass: <%= _cardColor %>;<% } %>
      <% if (_textColor) { %>--text: <%= _textColor %>;
      --text-dim: <%= _textColor %>99;<% } %>
      <% if (_borderColor) { %>--border: <%= _borderColor %>;
      --border-user: <%= _borderColor %>;<% } %>
    }
    <% /* خلفية الموقع الموحدة لكل الصفحات — الرئيسية مثلها. لون الخلفية الأساسي يترك لـ main.css
          (بنفسجي داكن #0b0c18) ما لم يخصص المستخدم لوناً من الإعدادات */ %>
    body {
      <% if (_bgColor) { %>background-color: var(--bg-body);
      <% } %>background-image: var(--bg-url);
      background-size: cover;
      background-position: center;
      background-attachment: fixed;
      background-repeat: no-repeat;
    }
    /* الهاتف: طبقة خلفية ثابتة بـ position:fixed — نفس شكل الثبات بدون إعادة رسم كل إطار
       (background-attachment:fixed على body يسبب تقطيع بالهاتف، والـ scroll يمدد الصورة على طول الصفحة كلها = تختفي) */
    #wfBgFix {
      display: none;
      position: fixed;
      inset: 0;
      z-index: -1;
      background-image: var(--mobile-bg-url);
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      pointer-events: none;
    }
    @media (max-width: 768px) {
      body { background-image: none; }
      #wfBgFix { display: block; }
    }
  </style>

  <style>
    .loading-bar {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 3px;
      z-index: 99999;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.2s;
    }
    .loading-bar.active { opacity: 1; }
    .loading-bar-progress {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, var(--ac), var(--ac-light), var(--ac));
      background-size: 200% 100%;
      animation: loadingBarShimmer 1.5s linear infinite;
      border-radius: 0 2px 2px 0;
      transition: width 0.3s ease;
      box-shadow: 0 0 10px var(--ac), 0 0 5px var(--ac);
    }
    @keyframes loadingBarShimmer {
      0% { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }
    .loading-bar.active .loading-bar-progress {
      animation: loadingBarProgress 2s ease-in-out forwards, loadingBarShimmer 1.5s linear infinite;
    }
    @keyframes loadingBarProgress {
      0% { width: 0%; }
      20% { width: 30%; }
      50% { width: 60%; }
      80% { width: 85%; }
      100% { width: 95%; }
    }
    .loading-bar.done .loading-bar-progress {
      width: 100% !important;
      animation: none;
      transition: width 0.2s ease;
    }
  </style>

  <%
    /* ══════════ افتتاحية Walton Family ══════════
       بنفسجية واضحة بأسلوب بلورة الهدر — تظهر مرة واحدة لكل تبويب فقط.
       المراحل (كلها CSS animations ذاتية بلا JS timing — JS فقط يقيس عرض الكلمة ويشغل ويكمل):
         1) اللوغو ينفرط وسط الشاشة بتوهج (0.1 → 1.05s)
         2) اللوغو ينزلق لليسار وكلمة alton Family تُكتب حرف حرف بجنبه (1.15 → 2.45s)
            — حرف W هو اللوغو نفسه مب حرف عادي، والباقي كلمة عادية
         3) لمعة تمر على الكلمة (2.55s) ثم البراند يختفي (3.3s)
         4) الخلفية تنقسم نصين: النص العلوي يطلع فوق ويصفر، السفلي ينزل تحت ويصفر،
            والصفحة الحقيقية تنكشف بينهم (3.72s) — وبعدها ينشال العنصر من DOM كلياً
       حمايات: wf-no-intro (تكرار) / prefers-reduced-motion (تخطي) / failsafe CSS
       يخفي الافتتاحية عند 6.2s لو JS مات بنص الطريق / أي لمسة = تخطي سريع */
  %>
  <%
    /* ألوان الافتتاحية كلها مشتقة من لون الموقع (accentColor من إعدادات لوحة الإدارة)
       — لو غيّرت اللون من الإعدادات تتغير خلفية الافتتاحية وتوهجاتها لنفس اللون مثل باقي الصفحات */
    var _wfiR = _rgbArr[0], _wfiG = _rgbArr[1], _wfiB = _rgbArr[2];
    function _wfiHex2(v){ return ('0' + v.toString(16)).slice(-2); }
    function _wfiShade(f){ return '#' + _wfiHex2(Math.round(_wfiR*f)) + _wfiHex2(Math.round(_wfiG*f)) + _wfiHex2(Math.round(_wfiB*f)); }
    function _wfiMix(t){ return [Math.round(_wfiR+(255-_wfiR)*t), Math.round(_wfiG+(255-_wfiG)*t), Math.round(_wfiB+(255-_wfiB)*t)]; }
    var _wfiC = _wfiR + ',' + _wfiG + ',' + _wfiB;
    var _wfiLA = _wfiMix(0.72); var _wfiLC = _wfiLA[0] + ',' + _wfiLA[1] + ',' + _wfiLA[2];
    var _wfiBgTop = _wfiShade(0.12), _wfiG1 = _wfiShade(0.19), _wfiG2 = _wfiShade(0.33), _wfiG3 = _wfiShade(0.47);
    var _wfiLight = '#' + _wfiHex2(_wfiLA[0]) + _wfiHex2(_wfiLA[1]) + _wfiHex2(_wfiLA[2]);
  %>
  <style>
    html.wf-no-intro #wfIntro{display:none!important}
    @media (prefers-reduced-motion: reduce){#wfIntro{display:none!important}}
    #wfIntro{position:fixed;inset:0;z-index:200000;overflow:hidden;visibility:hidden;background:<%= _wfiBgTop %>}
    #wfIntro.wfi-go{visibility:visible}
    #wfIntro.wfi-hold *{animation-play-state:paused!important}
    /* نصفي الخلفية: تدرج واحد متصل (background-size 200%) — لحظة الانقسام كل نصف يحمل نصيبه */
    .wfi-half{position:absolute;left:0;width:100%;height:50.25%;z-index:1;
      background-image:linear-gradient(180deg,<%= _wfiBgTop %> 0%,<%= _wfiG1 %> 42%,<%= _wfiG2 %> 78%,<%= _wfiG3 %> 100%);
      background-size:100% 200%;background-repeat:no-repeat;will-change:transform,opacity}
    .wfi-top{top:0;background-position:top}
    .wfi-bot{bottom:0;background-position:bottom}
    /* خط ضوء يشتعل عند خط الفصل لحظة الانقسام */
    .wfi-seam{position:absolute;top:50%;left:6%;width:88%;height:2px;margin-top:-1px;z-index:2;
      background:linear-gradient(90deg,transparent,rgba(<%= _wfiC %>,.95) 18%,<%= _wfiLight %> 50%,rgba(<%= _wfiC %>,.95) 82%,transparent);
      opacity:0;pointer-events:none;border-radius:2px}
    /* البراند: [اللوغو = حرف W] + [alton Family] — صف flex واحد، اتجاه ltr للكلمة الإنجليزية.
       --wfiDx يقيسه JS = إزاحة تُبقي اللوغو وسط الشاشة تماماً في المرحلة الأولى */
    .wfi-brand{position:absolute;top:50%;left:50%;z-index:4;display:flex;align-items:center;gap:3px;
      --wfilw:clamp(108px,18.4vw,245px);--wfifs:clamp(1.35rem,5.4vw,3.2rem);
      transform:translate(-50%,-50%);direction:ltr;opacity:1;
      will-change:transform,opacity,filter}
    /* اللوغو كبير — والهامش السالب يمتص البادجة الشفافة جوة ملف اللوغو (~12% من عرضه يمين)
       عشان حرف a ولقطة الكلمة يلصقون بالـ W مثل حرف عادي بكلمة Walton مو كلمة منفصلة */
    .wfi-logo{width:var(--wfilw);height:auto;flex-shrink:0;margin-right:calc(var(--wfilw)*-0.075);
      filter:drop-shadow(0 0 18px rgba(<%= _wfiC %>,.85)) drop-shadow(0 4px 22px rgba(0,0,0,.55));opacity:0}
    .wfi-wfb{font-family:'Cinzel Decorative',serif;font-weight:700;font-size:clamp(6rem,13.1vw,10.9rem);
      color:#fff;line-height:1;display:flex;align-items:center;justify-content:center}
    /* هالة ضوء دائرية فوق اللوغو بالضبط — تتمركز بالـ calc وتتبع حجم اللوغو (بلا filter حماية من علة blur+transform بالكروم) */
    .wfi-flare{position:absolute;width:30vmax;height:30vmax;left:calc(var(--wfilw)/2 - 15vmax);top:calc(50% - 15vmax);z-index:-1;
      background:radial-gradient(circle,rgba(<%= _wfiLC %>,.34),rgba(<%= _wfiC %>,.18) 42%,rgba(<%= _wfiC %>,.06) 58%,transparent 72%);
      pointer-events:none;opacity:0;border-radius:50%}
    .wfi-word{position:relative;font-family:'Cinzel Decorative',serif;font-weight:700;font-size:var(--wfifs);
      line-height:1.15;color:#fff;white-space:nowrap;display:inline-flex;align-items:baseline;letter-spacing:.5px;
      text-shadow:0 0 26px rgba(<%= _wfiC %>,.6),0 2px 14px rgba(0,0,0,.5)}
    .wfi-word i{display:inline-block;font-style:normal;opacity:0}
    .wfi-sp{width:.34em}
    /* لمعة ناعمة مموّهة تمر على الكلمة بعد اكتمالها */
    .wfi-word::after{content:'';position:absolute;top:-16%;bottom:-16%;left:0;width:30%;
      background:linear-gradient(100deg,transparent,rgba(255,255,255,.45),transparent);
      filter:blur(12px);transform:translateX(-260%) rotate(8deg);opacity:0;pointer-events:none}
    /* ─── المراحل (تفعّل فقط مع .wfi-go) ─── */
    #wfIntro.wfi-go .wfi-flare{animation:wfiFlareIn .9s cubic-bezier(.2,.9,.3,1.3) .12s forwards,wfiFlareGone .6s ease var(--wfiS2,1.15s) forwards}
    @keyframes wfiFlareIn{from{opacity:0;transform:scale(.4)}to{opacity:1;transform:scale(1)}}
    /* الوهج جميل بالمرحلة 1 (اللوغو وسط الشاشة) وينطفي مع بداية الانزلاق — المراحل 2 و3 تصير نظيفة تماماً */
    @keyframes wfiFlareGone{to{opacity:0}}
    #wfIntro.wfi-go .wfi-logo{animation:wfiLogoIn .95s cubic-bezier(.2,.9,.3,1.25) .1s forwards,wfiFloat 3.4s ease-in-out 1.15s infinite}
    @keyframes wfiLogoIn{0%{opacity:0;transform:scale(.35)}60%{opacity:1;transform:scale(1.14)}100%{opacity:1;transform:scale(1)}}
    @keyframes wfiFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}
    /* المرحلة 2: الانزلاق لليسار + كتابة الكلمة — fill:both عشان إزاحة المرحلة الأولى
       (من keyframes from) تنطبق من لحظة wfi-go مو بس من بداية الأنميشن */
    #wfIntro.wfi-go .wfi-brand{animation:wfiShift .85s cubic-bezier(.7,0,.25,1) var(--wfiS2,1.15s) both,wfiBrandOut .5s ease 3.3s forwards}
    @keyframes wfiShift{from{opacity:1;transform:translate(calc(-50% + var(--wfiDx,0px)),-50%)}to{opacity:1;transform:translate(-50%,-50%)}}
    @keyframes wfiBrandOut{to{opacity:0;transform:translate(-50%,-50%) scale(.94);filter:blur(6px)}}
    #wfIntro.wfi-go .wfi-l{animation:wfiL .5s cubic-bezier(.2,.9,.3,1.2) forwards;
      animation-delay:calc(var(--wfiS2,1.15s) + .12s + var(--i,0)*.062s)}
    @keyframes wfiL{from{opacity:0;transform:translateY(16px) scale(.7);filter:blur(6px)}to{opacity:1;transform:none;filter:blur(0)}}
    #wfIntro.wfi-go .wfi-word::after{animation:wfiShine 1.05s cubic-bezier(.4,0,.2,1) 2.55s forwards}
    @keyframes wfiShine{0%{opacity:0;transform:translateX(-260%) rotate(8deg)}12%{opacity:1}100%{opacity:0;transform:translateX(760%) rotate(8deg)}}
    /* المرحلة 4: الانقسام — الفوق يطلع والتحت ينزل وكلاهم يصفر والصفحة تنكشف */
    #wfIntro.wfi-go .wfi-seam{animation:wfiSeam .6s ease-out 3.68s forwards}
    @keyframes wfiSeam{0%{opacity:0;transform:scaleX(.4)}35%{opacity:1;transform:scaleX(1)}100%{opacity:0;transform:scaleX(1.25)}}
    #wfIntro.wfi-go .wfi-top{animation:wfiTop .95s cubic-bezier(.75,0,.25,1) 3.72s forwards}
    #wfIntro.wfi-go .wfi-bot{animation:wfiBot .95s cubic-bezier(.75,0,.25,1) 3.8s forwards}
    @keyframes wfiTop{0%{transform:translateY(0);opacity:1}75%{opacity:1}100%{transform:translateY(-104%);opacity:0}}
    @keyframes wfiBot{0%{transform:translateY(0);opacity:1}75%{opacity:1}100%{transform:translateY(104%);opacity:0}}
    /* فشل آمن: لو JS مات بنص الطريق تختفي الافتتاحية بحد ذاتها بعد 6.2s */
    #wfIntro.wfi-go{animation:wfiKill .01s linear 6.2s forwards}
    @keyframes wfiKill{to{opacity:0;visibility:hidden}}
    /* تخطي سريع بأي لمسة */
    #wfIntro.wfi-skip .wfi-brand{animation:wfiBrandOut .3s ease forwards!important}
    #wfIntro.wfi-skip .wfi-top{animation:wfiTop .5s cubic-bezier(.7,0,.3,1) .15s forwards!important}
    #wfIntro.wfi-skip .wfi-bot{animation:wfiBot .5s cubic-bezier(.7,0,.3,1) .22s forwards!important}
    #wfIntro.wfi-skip .wfi-seam{animation:wfiSeam .4s ease-out .1s forwards!important}
    @media (max-width:520px){.wfi-brand{gap:2px}}
  </style>
</head>
<body>
  <!-- الخلفية الثابتة للهاتف (فوقها كل المحتوى) -->
  <div id="wfBgFix" aria-hidden="true"></div>
  <!-- Loading Bar -->
  <div id="loadingBar" class="loading-bar">
    <div class="loading-bar-progress"></div>
  </div>

  <!-- ═══ افتتاحية Walton Family — مرة واحدة لكل تبويب ═══ -->
  <div id="wfIntro" aria-hidden="true">
    <div class="wfi-half wfi-top"></div>
    <div class="wfi-half wfi-bot"></div>
    <div class="wfi-seam"></div>
    <div class="wfi-brand">
      <span class="wfi-flare"></span>
      <img class="wfi-logo" src="<%= _logoUrl %>" alt="">
      <span class="wfi-word" dir="ltr"><% var _wfiTxt='alton Family'; for(var _wi=0;_wi<_wfiTxt.length;_wi++){ var _wc=_wfiTxt.charAt(_wi); if(_wc===' '){ %><i class="wfi-sp" style="--i:<%= _wi %>"></i><% } else { %><i class="wfi-l" style="--i:<%= _wi %>"><%= _wc %></i><% } } %></span>
    </div>
  </div>
  <script>
  (function(){
    var intro=document.getElementById('wfIntro');
    if(!intro)return;
    var finished=false;
    function finish(){
      if(finished)return;
      /* وضع التجميد (التصوير): العقدة تبقى مجمدة ما تنشال */
      try{if(intro&&intro.classList.contains('wfi-hold'))return;}catch(e){}
      finished=true;
      try{sessionStorage.setItem('wfIntroDone','1');}catch(e){}
      if(intro&&intro.parentNode){intro.parentNode.removeChild(intro);intro=null;}
      startPrefetch();
    }
    /* تخطي سريع بأي لمسة/عجلة/زر — خروج أنيق بنصف ثانية */
    var skipped=false;
    function skip(){
      if(skipped||finished||!intro)return;skipped=true;
      try{intro.classList.add('wfi-skip');}catch(e){}
      setTimeout(finish,700);
    }
    window.addEventListener('pointerdown',skip,{capture:true,passive:true});
    window.addEventListener('touchstart',skip,{capture:true,passive:true});
    window.addEventListener('wheel',skip,{capture:true,passive:true});
    window.addEventListener('keydown',skip,{capture:true});
    if(window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches){finish();return;}
    /* لو اللوغو المخصص فشل تحميله: حرف W بخط البراند بداله */
    try{
      var _lg=intro.querySelector('.wfi-logo');
      if(_lg)_lg.addEventListener('error',function(){
        var fb=document.createElement('span');fb.className='wfi-logo wfi-wfb';fb.textContent='W';
        if(_lg.parentNode)_lg.parentNode.replaceChild(fb,_lg);
      });
    }catch(e){}
    /* الانطلاق: نقيس عرض الكلمة بعد جاهزية الخط (بحد أقصى 900ms) نحسب إزاحة
       المرحلة الأولى --wfiDx اللي تُبقي اللوغو وسط الشاشة تماماً قبل الانزلاق لليسار */
    var started=false;
    function measureAndGo(){
      if(finished)return;
      var dx=0;
      try{
        var brand=intro.querySelector('.wfi-brand');
        var logo=intro.querySelector('.wfi-logo');
        var word=intro.querySelector('.wfi-word');
        var gap=parseFloat(getComputedStyle(brand).columnGap)||3;
        var lgm=logo?parseFloat(getComputedStyle(logo).marginRight)||0:0;
        var ww=word?word.scrollWidth:0;
        dx=Math.max(0,(ww+gap+lgm)/2);
      }catch(e){}
      intro.style.setProperty('--wfiDx',dx.toFixed(1)+'px');
      intro.style.setProperty('--wfiS2','1.15s');
      intro.classList.add('wfi-go');
      setTimeout(finish,5200);
      /* وضع تجميد للتصوير والتصحيح: ?wfihold=1300 يجمّد الأنميشن عند اللحظة المحددة */
      var m=location.search.match(/wfihold=(\d+)/);
      if(m){setTimeout(function(){try{if(intro)intro.classList.add('wfi-hold');}catch(e){}},parseInt(m[1],10));}
      /* وضع تشخيص: ?wfidbg=1 يعرض حالة الافتتاحية على الشاشة */
      if(location.search.indexOf('wfidbg=1')!==-1){
        setTimeout(function(){
          try{
            var lg=intro.querySelector('.wfi-logo');
            var br=intro.querySelector('.wfi-brand');
            var wd=intro.querySelector('.wfi-word');
            var cs=getComputedStyle(lg);
            var d=document.createElement('div');
            d.style.cssText='position:fixed;bottom:8px;left:8px;z-index:999999;background:rgba(0,0,0,.85);color:#0f0;font:12px monospace;padding:8px 10px;direction:ltr;white-space:pre;border-radius:6px';
            d.textContent='go='+intro.classList.contains('wfi-go')+
              ' hold='+intro.classList.contains('wfi-hold')+
              '\nlogo.complete='+lg.complete+' natural='+lg.naturalWidth+'x'+lg.naturalHeight+
              '\nlogo.opacity='+cs.opacity+' display='+cs.display+' rect='+lg.getBoundingClientRect().width+'x'+lg.getBoundingClientRect().height+
              '\nbrand.rect='+br.getBoundingClientRect().width+'x'+br.getBoundingClientRect().height+
              ' word.scrollW='+wd.scrollWidth+
              '\nbrandPos='+getComputedStyle(br).transform;
            document.body.appendChild(d);
          }catch(e){}
        },1600);
      }
    }
    function start(){
      if(started||finished)return;started=true;
      if(document.fonts&&document.fonts.ready){document.fonts.ready.then(function(){requestAnimationFrame(measureAndGo);});}
      else{requestAnimationFrame(measureAndGo);}
    }
    setTimeout(start,900);
    if(document.readyState==='complete'){start();}
    else{window.addEventListener('load',start);}
  })();

  /* ═══ التحميل الخفي للصفحات الأساسية (شغل خلفي ما يشوفه اللاعب) ═══
     بعد ما تخلص الافتتاحية — ولا لو انخطفت — يسحب الصفحات الرئيسية بكاش
     المتصفح فالتنقل بينها يصير لحظي. متسلسل بفواصل 350ms عشان ما يزاحم
     أول تحميل، ويتوقف كلياً لو وضع توفير البيانات أو شبكة 2G */
  var WFI_USER=<%= (typeof user !== 'undefined' && user) ? 'true' : 'false' %>;
  var WFI_PAGES=['/about','/rules','/store','/games','/community','/applications','/support','/profile','/properties','/company','/contact'];
  var WFI_STARTED=false;
  function startPrefetch(){
    if(WFI_STARTED)return;WFI_STARTED=true;
    if(!WFI_USER)return; /* زائر غير مسجل: الصفحات تعيد توجيه للدخول — لا نحمّل شي */
    try{
      if(navigator.connection&&(navigator.connection.saveData||/^(slow-)?2g$/.test(navigator.connection.effectiveType||'')))return;
    }catch(e){}
    var i=0;
    function step(){
      if(i>=WFI_PAGES.length)return;
      var p=WFI_PAGES[i++];
      if(location.pathname===p){step();return;}
      var f=null;
      try{f=fetch(p,{credentials:'same-origin',cache:'default',priority:'low'});}catch(e){}
      var done=function(){setTimeout(step,350);};
      if(f&&f.then){f.then(function(){},function(){}).then(done);}
      else{done();}
    }
    var kick=window.requestIdleCallback||function(cb){return setTimeout(cb,1100);};
    kick(function(){setTimeout(step,250);});
  }
  </script>

  <script>
    (function() {
      var bar = document.getElementById('loadingBar');
      var progress = bar ? bar.querySelector('.loading-bar-progress') : null;

      function startLoading() {
        if (!bar) return;
        bar.classList.add('active');
        bar.classList.remove('done');
        progress.style.width = '0%';
      }
      function endLoading() {
        if (!bar) return;
        bar.classList.add('done');
        setTimeout(function() {
          bar.classList.remove('active', 'done');
          progress.style.width = '0%';
        }, 400);
      }

      document.addEventListener('click', function(e) {
        var link = e.target.closest('a[href]');
        if (!link) return;
        var href = link.getAttribute('href');
        if (!href || href.startsWith('#') || href.startsWith('javascript:') || href.startsWith('mailto:')) return;
        if (link.target === '_blank') return;
        if (link.hasAttribute('download')) return;
        if (link.hostname && link.hostname !== location.hostname) return;
        startLoading();
      });

      window.addEventListener('pageshow', endLoading);
      setTimeout(endLoading, 8000);
    })();
  </script>
  <!-- News Ticker Bar -->
  <style>
    .news-ticker{display:none;background:linear-gradient(90deg,rgba(var(--ac-rgb),0.12),rgba(var(--ac-rgb),0.04),rgba(var(--ac-rgb),0.12));border-bottom:1px solid rgba(var(--ac-rgb),0.15);padding:10px 16px;position:relative;z-index:50;
      /* يبدأ تحت الهدر الثابت مباشرة — بدونه الشريط يرندر من فوق الصفحة مخفياً كلياً خلف النافبار */
      margin-top:var(--nav-h,70px)}
    .news-ticker.show{display:block}
    .news-ticker-inner{max-width:1200px;margin:0 auto;display:flex;align-items:center;gap:12px}
    .news-ticker-icon{flex-shrink:0;width:28px;height:28px;border-radius:50%;background:rgba(var(--ac-rgb),0.15);display:flex;align-items:center;justify-content:center;color:var(--ac);font-size:0.75rem;animation:tickPulse 2s ease-in-out infinite}
    @keyframes tickPulse{0%,100%{opacity:1}50%{opacity:0.5}}
    .news-ticker-label{flex-shrink:0;font-size:0.7rem;font-weight:700;color:var(--ac);background:rgba(var(--ac-rgb),0.12);padding:3px 10px;border-radius:6px;letter-spacing:0.5px}
    .news-ticker-content{flex:1;overflow:hidden;position:relative;height:22px}
    .news-ticker-item{position:absolute;width:100%;opacity:0;transform:translateY(20px);transition:all 0.5s ease;font-size:0.82rem;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .news-ticker-item.active{opacity:1;transform:translateY(0)}
    .news-ticker-item strong{color:var(--ac);margin-left:6px}
    .news-ticker-timer{flex-shrink:0;font-size:0.65rem;color:var(--ac);background:rgba(var(--ac-rgb),0.15);padding:3px 8px;border-radius:6px;font-weight:700;font-family:monospace;display:flex;align-items:center;gap:4px;white-space:nowrap}
    .news-ticker-timer i{font-size:0.6rem}
    .news-ticker-close{flex-shrink:0;background:none;border:none;color:var(--text-dim);cursor:pointer;font-size:0.8rem;padding:4px;border-radius:4px;transition:color 0.2s}
    .news-ticker-close:hover{color:var(--text)}
  </style>
  <div class="news-ticker" id="newsTicker">
    <div class="news-ticker-inner">
      <div class="news-ticker-icon"><i class="fas fa-bullhorn"></i></div>
      <div class="news-ticker-label">أخبار</div>
      <div class="news-ticker-content" id="tickerContent"></div>
      <button class="news-ticker-close" id="tickerClose" title="إغلاق"><i class="fas fa-times"></i></button>
    </div>
  </div>
  <script>
  (function() {
    var dismissed = {};
    try { dismissed = JSON.parse(localStorage.getItem('wf_ticker_dismissed') || '{}'); } catch(e) {}
    function saveDismissed() { try { localStorage.setItem('wf_ticker_dismissed', JSON.stringify(dismissed)); } catch(e) {} }
    var ticker = document.getElementById('newsTicker');
    var content = document.getElementById('tickerContent');
    var closeBtn = document.getElementById('tickerClose');
    var currentIndex = 0;
    var items = [];
    var interval = null;

    closeBtn.addEventListener('click', function() {
      ticker.classList.remove('show');
      dismissed['_all'] = Date.now();
      saveDismissed();
    });

    fetch('/api/broadcasts').then(function(r){return r.json()}).then(function(broadcasts) {
      if (!broadcasts || !broadcasts.length) return;
      items = broadcasts.filter(function(b) {
        if (dismissed[b.id] && (Date.now() - dismissed[b.id]) < 86400000) return false;
        return true;
      });
      if (!items.length) return;
      function formatCountdown(ms) {
        if (ms <= 0) return 'منتهي';
        var s = Math.floor(ms / 1000);
        var d = Math.floor(s / 86400); s %= 86400;
        var h = Math.floor(s / 3600); s %= 3600;
        var m = Math.floor(s / 60); s %= 60;
        if (d > 0) return d + ' يوم ' + h + ' س';
        if (h > 0) return h + ' س ' + m + ' د';
        if (m > 0) return m + ' د ' + s + ' ث';
        return s + ' ث';
      }
      content.innerHTML = items.map(function(b, i) {
        var timerHtml = '';
        if (b.expires_at) {
          var diff = new Date(b.expires_at).getTime() - Date.now();
          if (diff > 0) {
            timerHtml = '<span class="news-ticker-timer" data-expires="' + b.expires_at + '"><i class="fas fa-hourglass-half"></i> ' + formatCountdown(diff) + '</span>';
          }
        }
        return '<div class="news-ticker-item' + (i === 0 ? ' active' : '') + '">' +
          (b.title ? '<strong>' + b.title + '</strong>' : '') + b.message + timerHtml +
        '</div>';
      }).join('');
      ticker.classList.add('show');
      if (items.length > 1) {
        interval = setInterval(function() {
          var all = content.querySelectorAll('.news-ticker-item');
          all[currentIndex].classList.remove('active');
          currentIndex = (currentIndex + 1) % all.length;
          all[currentIndex].classList.add('active');
        }, 4000);
      }
      setInterval(function() {
        var timers = content.querySelectorAll('.news-ticker-timer');
        timers.forEach(function(el) {
          var expires = el.getAttribute('data-expires');
          if (!expires) return;
          var diff = new Date(expires).getTime() - Date.now();
          if (diff <= 0) {
            el.innerHTML = '<i class="fas fa-hourglass-end"></i> منتهي';
            el.style.color = '#ef4444';
            el.style.background = 'rgba(239,68,68,0.15)';
          } else {
            el.innerHTML = '<i class="fas fa-hourglass-half"></i> ' + formatCountdown(diff);
          }
        });
      }, 1000);
      items.forEach(function(b) { dismissed[b.id] = Date.now(); });
      saveDismissed();
    });
  })();
  </script>
  <!-- سكربت حماية المحتوى في الفوتر المشترك — يغطي كل الصفحات بما فيها دخول/404 (لا تستخدم هذا الهيدر) -->
