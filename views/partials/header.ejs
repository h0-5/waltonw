<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%
    var _siteName = typeof siteName !== 'undefined' ? siteName : 'Walton Family';
    var _accentColor = typeof accentColor !== 'undefined' ? accentColor : '#780ecf';
    var _acRgb = _accentColor.replace('#', '').match(/.{2}/g).map(function(h){ return parseInt(h, 16); }).join(', ');
    var _bgUrl = typeof bgUrl !== 'undefined' ? bgUrl : '';
    var _mobileBgUrl = typeof mobileBgUrl !== 'undefined' ? mobileBgUrl : '';
  %>
  <meta name="description" content="<%= _siteName %> - مجتمعنا الرقمي">
  <title><%= title %> | <%= _siteName %></title>
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;800&family=Tajawal:wght@400;500;700&family=Cinzel+Decorative:wght@700&family=Space+Grotesk:wght@400;500;600;700&family=Noto+Sans+Arabic:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  
  <!-- Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <!-- Styles - Old site CSS files -->
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/site-header.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="/css/home.css">
  <link rel="stylesheet" href="/css/store.css">
  <link rel="stylesheet" href="/css/games-page.css">
  <link rel="stylesheet" href="/css/page-hero.css">
  <link rel="stylesheet" href="/css/rules-page.css">
  <link rel="stylesheet" href="/css/about.css">
  <link rel="stylesheet" href="/css/applications-page.css">
  <link rel="stylesheet" href="/css/community.css">
  <link rel="stylesheet" href="/css/profile.css">
  <link rel="stylesheet" href="/css/products.css">
  
  <style>
    :root {
      --ac: <%= _accentColor %>;
      --ac-rgb: <%= _acRgb %>;
      --ac-dark: <%= _accentColor %>;
      --ac-light: <%= _accentColor %>;
      --bg-url: url('<%= _bgUrl %>');
      --mobile-bg-url: url('<%= _mobileBgUrl %>');
    }
    body {
      background-image: var(--bg-url);
      background-size: cover;
      background-position: center;
      background-attachment: fixed;
      background-repeat: no-repeat;
    }
    @media (max-width: 768px) {
      body {
        background-image: var(--mobile-bg-url);
      }
    }
  </style>

  <style>
    .loading-bar {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 3px;
      z-index: 99999;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.2s;
    }
    .loading-bar.active { opacity: 1; }
    .loading-bar-progress {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, var(--ac), #f97316, var(--ac));
      background-size: 200% 100%;
      animation: loadingBarShimmer 1.5s linear infinite;
      border-radius: 0 2px 2px 0;
      transition: width 0.3s ease;
      box-shadow: 0 0 10px var(--ac), 0 0 5px var(--ac);
    }
    @keyframes loadingBarShimmer {
      0% { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }
    .loading-bar.active .loading-bar-progress {
      animation: loadingBarProgress 2s ease-in-out forwards, loadingBarShimmer 1.5s linear infinite;
    }
    @keyframes loadingBarProgress {
      0% { width: 0%; }
      20% { width: 30%; }
      50% { width: 60%; }
      80% { width: 85%; }
      100% { width: 95%; }
    }
    .loading-bar.done .loading-bar-progress {
      width: 100% !important;
      animation: none;
      transition: width 0.2s ease;
    }
  </style>
</head>
<body>
  <!-- Loading Bar -->
  <div id="loadingBar" class="loading-bar">
    <div class="loading-bar-progress"></div>
  </div>

  <script>
    (function() {
      var bar = document.getElementById('loadingBar');
      var progress = bar ? bar.querySelector('.loading-bar-progress') : null;

      function startLoading() {
        if (!bar) return;
        bar.classList.add('active');
        bar.classList.remove('done');
        progress.style.width = '0%';
      }
      function endLoading() {
        if (!bar) return;
        bar.classList.add('done');
        setTimeout(function() {
          bar.classList.remove('active', 'done');
          progress.style.width = '0%';
        }, 400);
      }

      document.addEventListener('click', function(e) {
        var link = e.target.closest('a[href]');
        if (!link) return;
        var href = link.getAttribute('href');
        if (!href || href.startsWith('#') || href.startsWith('javascript:') || href.startsWith('mailto:')) return;
        if (link.target === '_blank') return;
        if (link.hasAttribute('download')) return;
        if (link.hostname && link.hostname !== location.hostname) return;
        startLoading();
      });

      window.addEventListener('pageshow', endLoading);
      setTimeout(endLoading, 8000);
    })();
  </script>
