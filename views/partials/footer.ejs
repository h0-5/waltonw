<%
  var _ftSettings = typeof settings !== 'undefined' ? settings : {};
%>
<footer class="wf-footer compact-footer">
    <div class="ft-glow-top"></div>
    <div class="ft-inner">
        <!-- Right: Brand -->
        <div class="ft-brand-col">
            <div class="ft-brand-logo">
                <img src="<%= _ftSettings.site_logo_url || '/images/walton-logo.svg' %>" alt="WF">
            </div>
            <div class="ft-brand-name">Walton Family</div>
            <p class="ft-brand-desc">مجتمع والتون فاميلي — أكثر من مجرد عائلة</p>
        </div>

        <!-- Middle: Links -->
        <div class="ft-links-col">
            <div class="ft-links-group">
                <h4 class="ft-col-title">القائمة</h4>
                <a href="/" class="ft-link">الرئيسية</a>
                <a href="/applications" class="ft-link">التقديمات</a>
                <a href="/rules" class="ft-link">القوانين</a>
                <a href="/store" class="ft-link">المتجر</a>
            </div>
            <div class="ft-links-group">
                <h4 class="ft-col-title">الدعم الفني</h4>
                <a href="/support" class="ft-link">مركز المساعدة</a>
                <a href="/about" class="ft-link">من نحن</a>
                <a href="<%= _ftSettings.discord_server_url || '#' %>" target="_blank" class="ft-link">ديسكورد الدعم</a>
            </div>
        </div>
    </div>

    <!-- Bottom Bar -->
    <div class="ft-bottom">
        <div class="ft-bottom-cr-badge">
            <i class="fas fa-lock ft-cr-lock"></i>
            <span>والتون فاميلي &copy; <%= new Date().getFullYear() %>. جميع الحقوق محفوظة.</span>
        </div>
        <div class="ft-bottom-dev">
            <span>تم التطوير بواسطة <strong>KHARBOSH · h05</strong></span>
            <span class="ft-dev-team-label">Developer Team</span>
        </div>
    </div>
</footer>

<script>(function(){var els=document.querySelectorAll('.wf-reveal,.wf-reveal-left,.wf-reveal-right,.wf-reveal-scale');if(!els.length)return;var io=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('visible');io.unobserve(e.target);}});},{threshold:0.12});els.forEach(function(el){io.observe(el);});})();</script>
