<%
  var _ftSettings = typeof settings !== 'undefined' ? settings : {};
  var _ftYear = new Date().getFullYear();
  var _ftDiscord = _ftSettings.discord_server_url || '#';
%>
<footer class="wf-footer ftv2">
  <div class="ftv2-card">
    <div class="ftv2-bg" aria-hidden="true"></div>

    <div class="ftv2-inner">
      <!-- ══ Brand — اللوغو بمكانه كما هو (بطلب المستخدم) ══ -->
      <div class="ftv2-brand">
        <div class="ftv2-brand-logo">
          <img src="<%= _ftSettings.site_logo_url || '/images/logo.png' %>" alt="WF">
        </div>
        <div class="ftv2-brand-name">Walton Family</div>
        <p class="ftv2-brand-desc">مجتمع والتون فاميلي — أكثر من مجرد عائلة</p>
      </div>

      <!-- روابط -->
      <nav class="ftv2-col" aria-label="روابط الموقع">
        <h4 class="ftv2-title">القائمة</h4>
        <a href="/" class="ftv2-link">الرئيسية</a>
        <a href="/applications" class="ftv2-link">التقديمات</a>
        <a href="/rules" class="ftv2-link">القوانين</a>
        <a href="/store" class="ftv2-link">المتجر</a>
      </nav>

      <nav class="ftv2-col" aria-label="الدعم الفني">
        <h4 class="ftv2-title">الدعم الفني</h4>
        <a href="/support" class="ftv2-link">مركز المساعدة<span class="ftv2-pulse" aria-hidden="true"></span></a>
        <a href="/about" class="ftv2-link">من نحن</a>
        <a href="<%= _ftDiscord %>" target="_blank" rel="noopener" class="ftv2-link">ديسكورد الدعم</a>
      </nav>

      <!-- تواصل -->
      <div class="ftv2-col ftv2-contact">
        <h4 class="ftv2-title">تواصل معنا</h4>
        <a href="<%= _ftDiscord %>" target="_blank" rel="noopener" class="ftv2-contact-item">
          <i class="fab fa-discord" aria-hidden="true"></i><span>سيرفر الديسكورد</span>
        </a>
        <a href="/support" class="ftv2-contact-item">
          <i class="fas fa-headset" aria-hidden="true"></i><span>الدعم الفني</span>
        </a>
        <a href="/" class="ftv2-contact-item">
          <i class="fas fa-globe" aria-hidden="true"></i><span>waltonfamily.gg</span>
        </a>
      </div>
    </div>

    <div class="ftv2-divider" aria-hidden="true"></div>

    <div class="ftv2-bottom">
      <div class="ftv2-social">
        <a href="<%= _ftDiscord %>" target="_blank" rel="noopener" aria-label="Discord" class="ftv2-soc"><i class="fab fa-discord"></i></a>
        <a href="/support" aria-label="الدعم الفني" class="ftv2-soc"><i class="fas fa-headset"></i></a>
        <a href="/" aria-label="الرئيسية" class="ftv2-soc"><i class="fas fa-globe"></i></a>
      </div>
      <div class="ftv2-cr">
        <div class="ftv2-cr-badge">
          <i class="fas fa-lock ftv2-lock" aria-hidden="true"></i>
          <span>والتون فاميلي &copy; <%= _ftYear %>. جميع الحقوق محفوظة.</span>
        </div>
        <div class="ftv2-dev">
          <span>تم التطوير بواسطة <strong>KHARBOSH · h05</strong></span>
          <span class="ftv2-dev-label">Developer Team</span>
        </div>
      </div>
    </div>

    <!-- ══ الكلمة الكبيرة: كشف بالماوس على الديسكتوب / ثابتة على الهاتف ══ -->
    <div class="ftv2-word" aria-hidden="true">
      <svg id="ftv2WordSvg" viewBox="0 0 300 100" xmlns="http://www.w3.org/2000/svg" role="presentation" focusable="false">
        <defs>
          <linearGradient id="ftv2TextGradient" gradientUnits="userSpaceOnUse" cx="50%" cy="50%" r="25%">
            <stop offset="0%" stop-color="#b026ff"/>
            <stop offset="25%" stop-color="#ff2d6f"/>
            <stop offset="50%" stop-color="#ff1744"/>
            <stop offset="75%" stop-color="#29c9ff"/>
            <stop offset="100%" stop-color="#b026ff"/>
          </linearGradient>
          <radialGradient id="ftv2RevealMask" gradientUnits="userSpaceOnUse" cx="50%" cy="50%" r="20%">
            <stop offset="0%" stop-color="white"/>
            <stop offset="100%" stop-color="black"/>
          </radialGradient>
          <mask id="ftv2TextMask">
            <rect x="0" y="0" width="300" height="100" fill="url(#ftv2RevealMask)"/>
          </mask>
        </defs>
        <!-- طبقة 1: حدود رمادية تظهر مع المرور -->
        <text class="ftv2-w1" x="50%" y="54" text-anchor="middle" textLength="264" lengthAdjust="spacingAndGlyphs">WALTON</text>
        <!-- طبقة 2: حدود سماوية مرسومة مرة واحدة -->
        <text class="ftv2-w2" x="50%" y="54" text-anchor="middle" textLength="264" lengthAdjust="spacingAndGlyphs">WALTON</text>
        <!-- طبقة 3: تدرج الثيم يُكشف بمكان المؤشر -->
        <text class="ftv2-w3" x="50%" y="54" text-anchor="middle" textLength="264" lengthAdjust="spacingAndGlyphs" mask="url(#ftv2TextMask)">WALTON</text>
      </svg>
    </div>
  </div>
</footer>

<script>(function(){
  var svg = document.getElementById('ftv2WordSvg');
  if (!svg) return;
  var wrap = svg.closest('.ftv2-word');
  var card = svg.closest('.ftv2-card');
  var maskG = document.getElementById('ftv2RevealMask');
  // الهاتف/اللمس: تبقى الكلمة ثابتة بدون مستمعات (اقتصادية)
  if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
  // الماوس يُتتبَّع على مستوى البطاقة كلها — «كشاف» يكشف تدرج الكلمة
  // من أي مكان، دون أن يحجب أي عنصر الروابط القابلة للنقر
  var pending = false, lastX = 0, lastY = 0;
  function apply() {
    var r = svg.getBoundingClientRect();
    if (r.width && r.height) {
      var cx = (lastX - r.left) / r.width;
      var cy = (lastY - r.top) / r.height;
      maskG.setAttribute('cx', (cx * 100).toFixed(2) + '%');
      maskG.setAttribute('cy', (cy * 100).toFixed(2) + '%');
      var inside = lastX >= r.left - 24 && lastX <= r.right + 24 &&
                   lastY >= r.top - 24 && lastY <= r.bottom + 24;
      if (inside) { wrap.classList.add('hovered'); } else { wrap.classList.remove('hovered'); }
    }
    pending = false;
  }
  card.addEventListener('mousemove', function(e){
    lastX = e.clientX; lastY = e.clientY;
    if (!pending) { pending = true; requestAnimationFrame(apply); }
  }, { passive: true });
  card.addEventListener('mouseleave', function(){ wrap.classList.remove('hovered'); });
})();</script>

<!-- ═══ Scroll Progress Bar + Back To Top ═══ -->
<style>
    #wfScrollProgress {
        position: fixed;
        top: 0;
        right: 0;
        height: 3px;
        width: 0%;
        z-index: 9999;
        background: linear-gradient(90deg, #9b30ff, #780ecf, #9b30ff);
        box-shadow: 0 0 12px rgba(120, 14, 207, 0.8), 0 0 24px rgba(120, 14, 207, 0.4);
        border-radius: 0 3px 3px 0;
        transition: width 0.08s linear;
        pointer-events: none;
    }
    #wfBackToTop {
        position: fixed;
        bottom: 24px;
        left: 24px;
        z-index: 9998;
        width: 46px;
        height: 46px;
        border: 1px solid rgba(155, 48, 255, 0.4);
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.05rem;
        color: #fff;
        background: linear-gradient(135deg, #780ecf, #9b30ff);
        box-shadow: 0 6px 20px rgba(120, 14, 207, 0.45);
        opacity: 0;
        visibility: hidden;
        transform: translateY(16px);
        transition: all 0.35s cubic-bezier(0.2, 0.9, 0.4, 1.1);
    }
    #wfBackToTop.show {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }
    #wfBackToTop:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 28px rgba(120, 14, 207, 0.65), 0 0 18px rgba(155, 48, 255, 0.4);
    }
    @media (max-width: 640px) {
        #wfBackToTop { bottom: 18px; left: 18px; width: 40px; height: 40px; }
    }
</style>
<div id="wfScrollProgress"></div>
<button id="wfBackToTop" aria-label="العودة للأعلى"><i class="fas fa-chevron-up"></i></button>
<script>(function(){
    var bar=document.getElementById('wfScrollProgress'),btn=document.getElementById('wfBackToTop'),tick=false;
    function upd(){
        var st=document.documentElement.scrollTop||document.body.scrollTop;
        var h=document.documentElement.scrollHeight-document.documentElement.clientHeight;
        bar.style.width=(h>0?(st/h*100):0)+'%';
        if(st>300){btn.classList.add('show');}else{btn.classList.remove('show');}
        tick=false;
    }
    window.addEventListener('scroll',function(){if(!tick){tick=true;requestAnimationFrame(upd);}},{passive:true});
    upd();
    btn.addEventListener('click',function(){window.scrollTo({top:0,behavior:'smooth'});});
})();</script>

<script>(function(){var els=document.querySelectorAll('.wf-reveal,.wf-reveal-left,.wf-reveal-right,.wf-reveal-scale');if(!els.length)return;var io=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('visible');io.unobserve(e.target);}});},{threshold:0.12});els.forEach(function(el){io.observe(el);});})();</script>
