<%
  var _ftSettings = typeof settings !== 'undefined' ? settings : {};
  var _ftYear = new Date().getFullYear();
  var _ftDiscord = _ftSettings.discord_server_url || '#';
%>
<!-- ═══ نظام حماية المحتوى: منع النسخ/القص/الزر الأيمن/سحب الصور/اختصارات المتصفح ═══
     في الفوتر المشترك ليغطي كل الصفحات (حتى دخول/404 التي بلا هيدر مشترك).
     خفيف عمداً: ستة مستمعات فقط، بلا حلقات ولا مؤقتات ولا مراقبين = أثر لا يُذكر
     على الأداء والاستضافة، ومدمج inline فلا أي ملف أو طلب إضافي.
     الحقول القابلة للكتابة (إدخال/تعبئة/قوائم/محادثة) مستثناة بالكامل حتى لا تنكسر أي فورمة -->
<script>
  (function() {
    var free = function(t) {
      while (t && t !== document) {
        if (t.nodeType === 1 && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.tagName === 'SELECT' || t.isContentEditable)) return true;
        t = t.parentNode;
      }
      return false;
    };
    ['copy', 'cut', 'contextmenu', 'dragstart', 'selectstart'].forEach(function(ev) {
      document.addEventListener(ev, function(e) {
        if (free(e.target)) return;
        e.preventDefault();
      });
    });
    document.addEventListener('keydown', function(e) {
      if (free(e.target)) return;
      var k = (e.key || '').toLowerCase();
      if ((e.ctrlKey || e.metaKey) && e.shiftKey && (k === 'i' || k === 'j' || k === 'c')) { e.preventDefault(); return; }
      if ((e.ctrlKey || e.metaKey) && (k === 'c' || k === 'x' || k === 'a' || k === 's' || k === 'p' || k === 'u')) e.preventDefault();
      else if (k === 'f12') e.preventDefault();
    });
  })();
</script>
<footer class="wf-footer ftv2">
  <div class="ftv2-card">
    <div class="ftv2-bg" aria-hidden="true"></div>

    <div class="ftv2-inner">
      <!-- ══ Brand — اللوغو بمكانه كما هو (بطلب المستخدم) ══ -->
      <div class="ftv2-brand">
        <div class="ftv2-brand-logo">
          <img src="<%= _ftSettings.site_logo_url || '/images/logo.png' %>" alt="WF" loading="lazy" decoding="async">
        </div>
        <div class="ftv2-brand-name">Walton Family</div>
        <p class="ftv2-brand-desc">مجتمع والتون فاميلي — أكثر من مجرد عائلة</p>
      </div>

      <!-- روابط -->
      <nav class="ftv2-col" aria-label="روابط الموقع">
        <h4 class="ftv2-title">القائمة</h4>
        <a href="/" class="ftv2-link"><i class="fas fa-house" aria-hidden="true"></i><span>الرئيسية</span></a>
        <a href="/applications" class="ftv2-link"><i class="fas fa-file-signature" aria-hidden="true"></i><span>التقديمات</span></a>
        <a href="/rules" class="ftv2-link"><i class="fas fa-scale-balanced" aria-hidden="true"></i><span>القوانين</span></a>
        <a href="/store" class="ftv2-link"><i class="fas fa-bag-shopping" aria-hidden="true"></i><span>المتجر</span></a>
      </nav>

      <!-- تواصل -->
      <div class="ftv2-col ftv2-contact">
        <h4 class="ftv2-title">تواصل معنا</h4>
        <a href="<%= _ftDiscord %>" target="_blank" rel="noopener" class="ftv2-contact-item">
          <i class="fab fa-discord" aria-hidden="true"></i><span>سيرفر الديسكورد</span>
        </a>
        <a href="/support" class="ftv2-contact-item">
          <i class="fas fa-headset" aria-hidden="true"></i><span>الدعم الفني</span>
        </a>
        <a href="/about" class="ftv2-contact-item">
          <i class="fas fa-circle-info" aria-hidden="true"></i><span>من نحن</span>
        </a>
      </div>
    </div>

    <div class="ftv2-divider" aria-hidden="true"></div>

    <!-- الحقوق + التطوير: بمنتصف أسفل القوائم فوق الكلمة الكبيرة -->
    <div class="ftv2-legal">
      <div class="ftv2-cr-badge">
        <i class="fas fa-lock ftv2-lock" aria-hidden="true"></i>
        <span>والتون فاميلي &copy; <%= _ftYear %>. جميع الحقوق محفوظة.</span>
      </div>
      <div class="ftv2-dev" dir="ltr">
        <span class="ftv2-dev-label">Developed by</span>
        <strong>KHARBOSH · h05</strong>
      </div>
    </div>

    <!-- ══ الكلمة الكبيرة: كشف بالماوس على الديسكتوب / ثابتة على الهاتف ══ -->
    <div class="ftv2-word" aria-hidden="true">
      <svg id="ftv2WordSvg" viewBox="0 0 300 100" xmlns="http://www.w3.org/2000/svg" role="presentation" focusable="false">
        <defs>
          <!-- تدرج الثيم البنفسجي الرسمي فقط — بدون ألوان مبرقعة -->
          <linearGradient id="ftv2TextGradient" gradientUnits="userSpaceOnUse" cx="50%" cy="50%" r="25%">
            <stop offset="0%" stop-color="#d24dff"/>
            <stop offset="50%" stop-color="#bc13fe"/>
            <stop offset="100%" stop-color="#930fc6"/>
          </linearGradient>
          <radialGradient id="ftv2RevealMask" gradientUnits="userSpaceOnUse" cx="50%" cy="50%" r="20%">
            <stop offset="0%" stop-color="white"/>
            <stop offset="100%" stop-color="black"/>
          </radialGradient>
          <mask id="ftv2TextMask">
            <rect x="0" y="0" width="300" height="100" fill="url(#ftv2RevealMask)"/>
          </mask>
        </defs>
        <!-- الطبقات الأربع بنفس البنية الحرفية بالضبط (tspans بلا إحداثيات) — التشديد textLength
             يُطبّق على متن النص فيتطابق الحروف بكسل-بكسل بين كل الطبقات مهما تغيّر الخط.
         (الطريقة القديمة كانت تبني طبقة الوهج بإحداثيات محسوبة فتظهر حروفها بعرضها الطبيعي
          داخل فتحات الحروف المشدودة = خط مزدوج بعد اكتمال الأنميشنات — أُلغيت نهائياً) -->
        <!-- طبقة 1: حدود رمادية تظهر مع المرور -->
        <text class="ftv2-w1" x="50%" y="54" text-anchor="middle" textLength="264" lengthAdjust="spacingAndGlyphs"><tspan>W</tspan><tspan>A</tspan><tspan>L</tspan><tspan>T</tspan><tspan>O</tspan><tspan>N</tspan></text>
        <!-- طبقة 2: حدود بنفسجية تُرسم مرة واحدة -->
        <text class="ftv2-w2" x="50%" y="54" text-anchor="middle" textLength="264" lengthAdjust="spacingAndGlyphs"><tspan>W</tspan><tspan>A</tspan><tspan>L</tspan><tspan>T</tspan><tspan>O</tspan><tspan>N</tspan></text>
        <!-- طبقة 3: تدرج الثيم يُكشف بمكان المؤشر -->
        <text class="ftv2-w3" x="50%" y="54" text-anchor="middle" textLength="264" lengthAdjust="spacingAndGlyphs" mask="url(#ftv2TextMask)"><tspan>W</tspan><tspan>A</tspan><tspan>L</tspan><tspan>T</tspan><tspan>O</tspan><tspan>N</tspan></text>
        <!-- طبقة 4: وهج حرف-حرف بعد اكتمال المسحة — بنفس بنية الطبقات تماماً -->
        <text class="ftv2-w4" x="50%" y="54" text-anchor="middle" textLength="264" lengthAdjust="spacingAndGlyphs"><tspan>W</tspan><tspan>A</tspan><tspan>L</tspan><tspan>T</tspan><tspan>O</tspan><tspan>N</tspan></text>
        <!-- طبقة 5: بروز وتوهج أقوى للحرف الموجّه — حرف حرف بعناصر text مستقلة
             (tspan لا يقبل transform لذا الحروف هنا عناصر مستقلة بقيم فتحات مأخوذة من الطبقات المرجعية نفسها:
              getExtentOfChar بعد التشديد — تُخبز literal فلا أي حسابات وقت تشغيل)
             لا تُفعّل إلا بعد اكتمال كل الأنميشنات (w5-ready) — تعمل بالماوس وباللمس معاً -->
        <g class="ftv2-w5">
          <text class="ftv2-w5i" x="47.57" y="54" text-anchor="middle" textLength="59.15" lengthAdjust="spacingAndGlyphs"><tspan>W</tspan></text>
          <text class="ftv2-w5i" x="98.03" y="54" text-anchor="middle" textLength="41.76" lengthAdjust="spacingAndGlyphs"><tspan>A</tspan></text>
          <text class="ftv2-w5i" x="136.76" y="54" text-anchor="middle" textLength="35.7" lengthAdjust="spacingAndGlyphs"><tspan>L</tspan></text>
          <text class="ftv2-w5i" x="173.98" y="54" text-anchor="middle" textLength="38.73" lengthAdjust="spacingAndGlyphs"><tspan>T</tspan></text>
          <text class="ftv2-w5i" x="215.61" y="54" text-anchor="middle" textLength="44.53" lengthAdjust="spacingAndGlyphs"><tspan>O</tspan></text>
          <text class="ftv2-w5i" x="259.93" y="54" text-anchor="middle" textLength="44.13" lengthAdjust="spacingAndGlyphs"><tspan>N</tspan></text>
        </g>
      </svg>
    </div>
  </div>
</footer>

<script>(function(){
  var svg = document.getElementById('ftv2WordSvg');
  if (!svg) return;
  var wrap = svg.closest('.ftv2-word');
  var card = svg.closest('.ftv2-card');
  var maskG = document.getElementById('ftv2RevealMask');
  var isTouch = !window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  // ── طبقة الوهج الحرفي صارت ثابتة في الـ HTML بنفس بنية الطبقات الأخرى ──
  // المحاذاة مضمونة بلا أي حسابات: المتصفح يوزّع الحروف بنفس التخطيط بالضبط،
  // وبعد اكتمال المسحة (~3.8ث) كل حرف يتوهج تباعاً عبر CSS فقط
  wrap.classList.add('w4-ready');
  // تفضيل تقليل الحركة: كل شيء جاهز فوراً (CSS يتخطى الأنميشنات أصلاً)
  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // الكمبيوتر: القناع يبدأ خارج الشاشة — صفر كشف قبل الوصول للفوتر وحركة الماوس
  if (!isTouch && maskG) { maskG.setAttribute('cx', '-50%'); maskG.setAttribute('cy', '-50%'); }
  if (reduced) {
    wrap.classList.add('drawn', 'glow-start', 'w5-ready');
  } else if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(es){
      es.forEach(function(en){
        if (en.isIntersecting) {
          wrap.classList.add('drawn'); io.disconnect();
          setTimeout(function(){ wrap.classList.add('glow-start'); }, 3800);
          // تفاعل بروز الحروف يُفتح بعد اكتمال وهج الحروف كله (~5.55ث): رسم 2.6 + كتابة 1.4 + وهج 1.75
          setTimeout(function(){ wrap.classList.add('w5-ready'); }, 5650);
        }
      });
    }, { threshold: 0.2 });
    io.observe(wrap);
  } else {
    wrap.classList.add('drawn');
    setTimeout(function(){ wrap.classList.add('glow-start'); }, 3800);
    setTimeout(function(){ wrap.classList.add('w5-ready'); }, 5650);
  }
  // الهاتف: إظهار التدرج كامل بدون قناع الماوس (إصلاح التشوه/الاختفاء)
  if (isTouch) {
    var w3 = svg.querySelector('.ftv2-w3');
    if (w3) w3.removeAttribute('mask');
  }
  // تحويل إحداثيات الشاشة إلى إحداثيات viewBox بمراعاة التوسيط (preserveAspectRatio):
  // الكلمة تتوسّط داخل صندوق svg (عرض الصندوق أكبر من 3× ارتفاعه فالمحتوى محجوز بالارتفاع)،
  // فقسمة موضع المؤشر على عرض الصندوق مباشرة تنضغط الإحداثيات نحو الوسط —
  // وتوجيه الميلان يروح للحرف المجاور (تجي على W يتحرك A، وO/N ما تنشّط أصلاً)
  var vbW = svg.viewBox.baseVal.width, vbH = svg.viewBox.baseVal.height;
  function svgPoint(clientX, clientY) {
    var r = svg.getBoundingClientRect();
    if (!r.width || !r.height) return null;
    var s = Math.min(r.width / vbW, r.height / vbH); // نفس منطق preserveAspectRatio الافتراضي
    var cw = vbW * s, ch = vbH * s;
    return [
      (clientX - r.left - (r.width - cw) / 2) / cw * vbW,
      (clientY - r.top  - (r.height - ch) / 2) / ch * vbH
    ];
  }
  // الماوس يُتتبَّع على مستوى البطاقة كلها — «كشاف» يكشف تدرج الكلمة من أي مكان،
  // دون أن يحجب أي عنصر الروابط القابلة للنقر (ماوس فقط — على اللمس التدرج كامل بلا قناع)
  // ── حلقة تتبّع الماوس: نعومة lerp للكشاف ولبطاقات الـ 3D معاً ──
  // مستمع الماوس لا يحسب شيئاً: يحفظ هدف المؤشر فقط ويوقظ الحلقة، والحلقة تقترب من
  // الهدف بنسبة ثابتة كل إطار (55%) — حركة even بلا رجفة: كانت transition الـ transform
  // تُعاد تشغيلها كل إطار فوق قيم متقطعة فتظهر خطوات متفاوتة = اهتزاز خفيف أحياناً.
  // الحلقة تعمل فقط عند الحاجة (مؤشر لم يستقر أو حرف مرفوع) وتتوقف كلياً عند السكون،
  // والإطار الساكن صفر كتابات DOM (كتابة فقط عند تغيّر فعلي). مسار اللمس يبقى مباشراً.
  var tiltAt = null, isEngaged = function(){ return false; };
  var tX = 0, tY = 0, sX = 0, sY = 0, queued = false, wasInside = false, lastCx = '', lastCy = '';
  function kick(){ if (!queued) { queued = true; requestAnimationFrame(frame); } }
  function frame(){
    queued = false;
    var r = svg.getBoundingClientRect();
    if (!r.width || !r.height) return;
    sX += (tX - sX) * 0.55; sY += (tY - sY) * 0.55;
    var p = svgPoint(sX, sY);
    if (p) {
      if (!isTouch && maskG) {
        var mcx = (p[0] / vbW * 100).toFixed(2) + '%', mcy = (p[1] / vbH * 100).toFixed(2) + '%';
        if (mcx !== lastCx || mcy !== lastCy) {
          lastCx = mcx; lastCy = mcy;
          maskG.setAttribute('cx', mcx); maskG.setAttribute('cy', mcy);
        }
      }
      if (!isTouch) {
        var inside = tX >= r.left - 24 && tX <= r.right + 24 &&
                     tY >= r.top - 24 && tY <= r.bottom + 24;
        if (inside !== wasInside) {
          wasInside = inside;
          if (inside) wrap.classList.add('hovered'); else wrap.classList.remove('hovered');
        }
      }
      if (tiltAt) tiltAt(p[0], p[1]);
    }
    // الاستمرار عند الداعي فقط: المؤشر لم يبلغ هدفه بعد، أو حرف مرفوع — تُعاد القراءة
    // كل إطار فتبقى البطاقة ملتصقة بالمؤشر حتى لو تحركت الصفحة (سكرول) تحت المؤشر
    if (Math.abs(tX - sX) + Math.abs(tY - sY) > 0.4 || isEngaged()) kick();
  }
  if (!isTouch) {
    card.addEventListener('mousemove', function(e){
      tX = e.clientX; tY = e.clientY; kick();
    }, { passive: true });
    card.addEventListener('mouseleave', function(){
      if (wasInside) { wasInside = false; wrap.classList.remove('hovered'); }
    });
  }
  // ── بطاقة 3D تفاعلية للحروف (نفس تفاعل بطاقات الرئيسية القديمة) — ماوس ولمس معاً ──
  // تتبّع مركزي واحد على مستوى الـ SVG بدل مستمع لكل حرف:
  // · نطاقات الحروف محسوبة مرة واحدة من إحداثياتها المطبوعة (x/textLength) — صفر قياس وقت تشغيل
  // · التغطية متصلة بلا فراغات فالمؤشر لا يفقد الحرف بين الحروف ولا عند حوافه (حساسية أعلى بلا أخطاء)
  // · الميلان يُحدَّث داخل نفس rAF الخاص بكشف التدرج، فيتبع المؤشر فوراً بلا تأخير
  // · الحرف المرفوع: نسخ الطبقات 1-4 تحته تُخفت (ftv2-lift) فينطلق الحرف كله كبطاقة واحدة
  //   بدل «حرفين»، وعند الابتعاد ينشال الميلان بالمنحنى النابض وترجع الطبقات بنعومة
  if (!reduced) {
    var TILT = 18;
    var letters = svg.querySelectorAll('.ftv2-w5i');
    var bands = [];
    Array.prototype.forEach.call(letters, function(lt){
      var x = parseFloat(lt.getAttribute('x'));
      var tl = parseFloat(lt.getAttribute('textLength'));
      bands.push([x - tl / 2, x + tl / 2, x, tl]);
    });
    var baseRows = [];
    Array.prototype.forEach.call(['ftv2-w1', 'ftv2-w2', 'ftv2-w3', 'ftv2-w4'], function(cls){
      baseRows.push(svg.querySelector('.' + cls).querySelectorAll('tspan'));
    });
    var cur = -1;
    var lift = function(i){
      if (i === cur) return;
      if (cur >= 0) {
        letters[cur].classList.remove('ftv2-tilting');
        letters[cur].style.transform = '';
        for (var r = 0; r < 4; r++) baseRows[r][cur].classList.remove('ftv2-lift');
      }
      cur = i;
      if (i >= 0) for (var r2 = 0; r2 < 4; r2++) baseRows[r2][i].classList.add('ftv2-lift');
    };
    isEngaged = function(){ return cur >= 0; };
    var lastHit = -2, lastStr = '';
    tiltAt = function(xSvg, ySvg){
      var hit = -1;
      // النطاق العمودي يغطي الحروف كاملة (القمم ~9.4 والقواعد ~54) مع هامش فوق/تحت
      if (wrap.classList.contains('w5-ready') && ySvg > 6 && ySvg < 76) {
        for (var b = 0; b < bands.length; b++) {
          if (xSvg >= bands[b][0] && xSvg < bands[b][1]) { hit = b; break; }
        }
        // ثبات على الحرف (hysteresis): لا تبديل للحرف المجاور إلا بعد اختراق 3 وحدات
        // داخل نطاقه — يمنع وميض التذبذب حين يرقد المؤشر قرب الفاصل بين حرفين
        if (hit !== cur && cur >= 0 && hit >= 0 &&
            (xSvg < bands[hit][0] + 3 || xSvg >= bands[hit][1] - 3)) hit = cur;
      }
      if (hit >= 0) {
        var bd = bands[hit];
        var px = Math.max(-0.5, Math.min(0.5, (xSvg - bd[2]) / bd[3]));
        var py = Math.max(-0.5, Math.min(0.5, (ySvg - 10) / 44 - 0.5));
        var str = 'perspective(320px) rotateX(' + (-py * 2 * TILT).toFixed(2) +
          'deg) rotateY(' + (px * 2 * TILT).toFixed(2) + 'deg) translateY(-4px) scale(1.2)';
        // كتابة للـ DOM فقط عند تغيّر فعلي — والإطار الساكن بلا أي كتابة
        if (hit !== lastHit || str !== lastStr) {
          letters[hit].classList.add('ftv2-tilting');
          letters[hit].style.transform = str;
          lastHit = hit; lastStr = str;
        }
      } else {
        lastHit = -2; lastStr = '';
      }
      lift(hit);
    };
    if (isTouch) {
      // اللمس: الإصبع يحل محل الماوس بنفس التوجيه المركزي —
      // · تمرير الإصبع فوق الكلمة يميل الحروف تباعاً معه (مستمعات passive فلا تعترض سكرول الصفحة أبداً)
      // · نقرة واحدة ترفع الحرف وتُبقيه لحظة (900ms) ثم ينشال بنعومة
      // · رفع الإصبع بعد تمرير ينشال فوراً (المنحنى النابض يتكفل بجمالية الإنشاءل)
      var holdTimer = null, moved = 0, lx = 0, ly = 0;
      var at = function(e){
        var t = e.touches[0];
        if (!t) return;
        var p = svgPoint(t.clientX, t.clientY);
        if (p) tiltAt(p[0], p[1]);
      };
      var release = function(){ tiltAt(NaN, NaN); };
      var dropHold = function(){ if (holdTimer) { clearTimeout(holdTimer); holdTimer = null; } };
      svg.addEventListener('touchstart', function(e){
        var t = e.touches[0];
        if (t) { moved = 0; lx = t.clientX; ly = t.clientY; }
        dropHold(); at(e);
      }, { passive: true });
      svg.addEventListener('touchmove', function(e){
        var t = e.touches[0];
        if (t) { moved += Math.abs(t.clientX - lx) + Math.abs(t.clientY - ly); lx = t.clientX; ly = t.clientY; }
        at(e);
      }, { passive: true });
      svg.addEventListener('touchend', function(){
        if (moved < 12) { holdTimer = setTimeout(release, 900); } else { release(); }
      }, { passive: true });
      svg.addEventListener('touchcancel', function(){ dropHold(); release(); }, { passive: true });
    } else {
      svg.addEventListener('mouseleave', function(){ lift(-1); });
    }
  }
})();</script>

<!-- ═══ Scroll Progress Bar + Back To Top ═══ -->
<style>
    #wfScrollProgress {
        position: fixed;
        top: 0;
        right: 0;
        height: 3px;
        width: 0%;
        z-index: 9999;
        background: linear-gradient(90deg, #d24dff, #bc13fe, #d24dff);
        box-shadow: 0 0 12px rgba(188, 19, 254, 0.8), 0 0 24px rgba(188, 19, 254, 0.4);
        border-radius: 0 3px 3px 0;
        transition: width 0.08s linear;
        pointer-events: none;
    }
    #wfBackToTop {
        position: fixed;
        bottom: 24px;
        left: 24px;
        z-index: 9998;
        width: 46px;
        height: 46px;
        border: 1px solid rgba(210, 77, 255, 0.4);
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.05rem;
        color: #fff;
        background: linear-gradient(135deg, #bc13fe, #d24dff);
        box-shadow: 0 6px 20px rgba(188, 19, 254, 0.45);
        opacity: 0;
        visibility: hidden;
        transform: translateY(16px);
        transition: all 0.35s cubic-bezier(0.2, 0.9, 0.4, 1.1);
    }
    #wfBackToTop.show {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }
    #wfBackToTop:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 28px rgba(188, 19, 254, 0.65), 0 0 18px rgba(210, 77, 255, 0.4);
    }
    @media (max-width: 640px) {
        #wfBackToTop { bottom: 18px; left: 18px; width: 40px; height: 40px; }
    }
</style>
<div id="wfScrollProgress"></div>
<button id="wfBackToTop" aria-label="العودة للأعلى"><i class="fas fa-chevron-up"></i></button>
<script>(function(){
    var bar=document.getElementById('wfScrollProgress'),btn=document.getElementById('wfBackToTop'),tick=false;
    function upd(){
        var st=document.documentElement.scrollTop||document.body.scrollTop;
        var h=document.documentElement.scrollHeight-document.documentElement.clientHeight;
        bar.style.width=(h>0?(st/h*100):0)+'%';
        if(st>300){btn.classList.add('show');}else{btn.classList.remove('show');}
        tick=false;
    }
    window.addEventListener('scroll',function(){if(!tick){tick=true;requestAnimationFrame(upd);}},{passive:true});
    upd();
    btn.addEventListener('click',function(){window.scrollTo({top:0,behavior:'smooth'});});
})();</script>

<script>(function(){var els=document.querySelectorAll('.wf-reveal,.wf-reveal-left,.wf-reveal-right,.wf-reveal-scale');if(!els.length)return;var io=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('visible');io.unobserve(e.target);}});},{threshold:0.12});els.forEach(function(el){io.observe(el);});})();</script>
