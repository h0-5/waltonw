<%
  var _ftSettings = typeof settings !== 'undefined' ? settings : {};
  var _ftYear = new Date().getFullYear();
  var _ftDiscord = _ftSettings.discord_server_url || '#';
%>
<!-- ═══ نظام حماية المحتوى: منع النسخ/القص/الزر الأيمن/سحب الصور/اختصارات المتصفح ═══
     في الفوتر المشترك ليغطي كل الصفحات (حتى دخول/404 التي بلا هيدر مشترك).
     خفيف عمداً: ستة مستمعات فقط، بلا حلقات ولا مؤقتات ولا مراقبين = أثر لا يُذكر
     على الأداء والاستضافة، ومدمج inline فلا أي ملف أو طلب إضافي.
     الحقول القابلة للكتابة (إدخال/تعبئة/قوائم/محادثة) مستثناة بالكامل حتى لا تنكسر أي فورمة -->
<script>
  (function() {
    var free = function(t) {
      while (t && t !== document) {
        if (t.nodeType === 1 && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.tagName === 'SELECT' || t.isContentEditable)) return true;
        t = t.parentNode;
      }
      return false;
    };
    ['copy', 'cut', 'contextmenu', 'dragstart', 'selectstart'].forEach(function(ev) {
      document.addEventListener(ev, function(e) {
        if (free(e.target)) return;
        e.preventDefault();
      });
    });
    document.addEventListener('keydown', function(e) {
      if (free(e.target)) return;
      var k = (e.key || '').toLowerCase();
      if ((e.ctrlKey || e.metaKey) && e.shiftKey && (k === 'i' || k === 'j' || k === 'c')) { e.preventDefault(); return; }
      if ((e.ctrlKey || e.metaKey) && (k === 'c' || k === 'x' || k === 'a' || k === 's' || k === 'p' || k === 'u')) e.preventDefault();
      else if (k === 'f12') e.preventDefault();
    });
  })();
</script>
<footer class="wf-footer ftv2">
  <div class="ftv2-card">
    <div class="ftv2-bg" aria-hidden="true"></div>

    <div class="ftv2-inner">
      <!-- ══ Brand — اللوغو بمكانه كما هو (بطلب المستخدم) ══ -->
      <div class="ftv2-brand">
        <div class="ftv2-brand-logo">
          <img src="<%= _ftSettings.site_logo_url || '/images/logo.png' %>" alt="WF" loading="lazy" decoding="async">
        </div>
        <div class="ftv2-brand-name">Walton Family</div>
        <p class="ftv2-brand-desc">مجتمع والتون فاميلي — أكثر من مجرد عائلة</p>
      </div>

      <!-- روابط -->
      <nav class="ftv2-col" aria-label="روابط الموقع">
        <h4 class="ftv2-title">القائمة</h4>
        <a href="/" class="ftv2-link"><i class="fas fa-house" aria-hidden="true"></i><span>الرئيسية</span></a>
        <a href="/applications" class="ftv2-link"><i class="fas fa-file-signature" aria-hidden="true"></i><span>التقديمات</span></a>
        <a href="/rules" class="ftv2-link"><i class="fas fa-scale-balanced" aria-hidden="true"></i><span>القوانين</span></a>
        <a href="/store" class="ftv2-link"><i class="fas fa-bag-shopping" aria-hidden="true"></i><span>المتجر</span></a>
      </nav>

      <!-- تواصل -->
      <div class="ftv2-col ftv2-contact">
        <h4 class="ftv2-title">تواصل معنا</h4>
        <a href="<%= _ftDiscord %>" target="_blank" rel="noopener" class="ftv2-contact-item">
          <i class="fab fa-discord" aria-hidden="true"></i><span>سيرفر الديسكورد</span>
        </a>
        <a href="/support" class="ftv2-contact-item">
          <i class="fas fa-headset" aria-hidden="true"></i><span>الدعم الفني</span>
        </a>
        <a href="/about" class="ftv2-contact-item">
          <i class="fas fa-circle-info" aria-hidden="true"></i><span>من نحن</span>
        </a>
      </div>
    </div>

    <div class="ftv2-divider" aria-hidden="true"></div>

    <!-- الحقوق + التطوير: بمنتصف أسفل القوائم فوق الكلمة الكبيرة -->
    <div class="ftv2-legal">
      <div class="ftv2-cr-badge">
        <i class="fas fa-lock ftv2-lock" aria-hidden="true"></i>
        <span>والتون فاميلي &copy; <%= _ftYear %>. جميع الحقوق محفوظة.</span>
      </div>
      <div class="ftv2-dev" dir="ltr">
        <span class="ftv2-dev-label">Developed by</span>
        <strong>KHARBOSH · h05</strong>
      </div>
    </div>

    <!-- ══ الكلمة الكبيرة: كشف بالماوس على الديسكتوب / ثابتة على الهاتف ══ -->
    <div class="ftv2-word" aria-hidden="true">
      <svg id="ftv2WordSvg" viewBox="0 0 457 100" xmlns="http://www.w3.org/2000/svg" role="presentation" focusable="false">
        <defs>
          <!-- تدرج الثيم البنفسجي الرسمي فقط — بدون ألوان مبرقعة -->
          <linearGradient id="ftv2TextGradient" gradientUnits="userSpaceOnUse" cx="50%" cy="50%" r="25%">
            <stop offset="0%" stop-color="#d24dff"/>
            <stop offset="50%" stop-color="#bc13fe"/>
            <stop offset="100%" stop-color="#930fc6"/>
          </linearGradient>
          <radialGradient id="ftv2RevealMask" gradientUnits="userSpaceOnUse" cx="50%" cy="50%" r="20%">
            <stop offset="0%" stop-color="white"/>
            <stop offset="100%" stop-color="black"/>
          </radialGradient>
          <mask id="ftv2TextMask">
            <rect x="0" y="0" width="457" height="100" fill="url(#ftv2RevealMask)"/>
          </mask>
        </defs>
        <!-- الطبقات الأربع بنفس البنية الحرفية بالضبط (tspans بلا إحداثيات) — التشديد textLength
             يُطبّق على متن النص فيتطابق الحروف بكسل-بكسل بين كل الطبقات مهما تغيّر الخط.
         (الطريقة القديمة كانت تبني طبقة الوهج بإحداثيات محسوبة فتظهر حروفها بعرضها الطبيعي
          داخل فتحات الحروف المشدودة = خط مزدوج بعد اكتمال الأنميشنات — أُلغيت نهائياً) -->
        <!-- طبقة 1: حدود رمادية تظهر مع المرور -->
        <text class="ftv2-w1" x="50%" y="54" text-anchor="middle" textLength="421" lengthAdjust="spacingAndGlyphs"><tspan>W</tspan><tspan>a</tspan><tspan>l</tspan><tspan>t</tspan><tspan>o</tspan><tspan>n</tspan><tspan class="ftv2-sp"> </tspan><tspan>F</tspan><tspan>a</tspan><tspan>m</tspan><tspan>i</tspan><tspan>l</tspan><tspan>y</tspan></text>
        <!-- طبقة 2: حدود بنفسجية تُرسم مرة واحدة -->
        <text class="ftv2-w2" x="50%" y="54" text-anchor="middle" textLength="421" lengthAdjust="spacingAndGlyphs"><tspan>W</tspan><tspan>a</tspan><tspan>l</tspan><tspan>t</tspan><tspan>o</tspan><tspan>n</tspan><tspan class="ftv2-sp"> </tspan><tspan>F</tspan><tspan>a</tspan><tspan>m</tspan><tspan>i</tspan><tspan>l</tspan><tspan>y</tspan></text>
        <!-- طبقة 3: تدرج الثيم يُكشف بمكان المؤشر -->
        <text class="ftv2-w3" x="50%" y="54" text-anchor="middle" textLength="421" lengthAdjust="spacingAndGlyphs" mask="url(#ftv2TextMask)"><tspan>W</tspan><tspan>a</tspan><tspan>l</tspan><tspan>t</tspan><tspan>o</tspan><tspan>n</tspan><tspan class="ftv2-sp"> </tspan><tspan>F</tspan><tspan>a</tspan><tspan>m</tspan><tspan>i</tspan><tspan>l</tspan><tspan>y</tspan></text>
        <!-- طبقة 4: وهج حرف-حرف بعد اكتمال المسحة — بنفس بنية الطبقات تماماً -->
        <text class="ftv2-w4" x="50%" y="54" text-anchor="middle" textLength="421" lengthAdjust="spacingAndGlyphs"><tspan>W</tspan><tspan>a</tspan><tspan>l</tspan><tspan>t</tspan><tspan>o</tspan><tspan>n</tspan><tspan class="ftv2-sp"> </tspan><tspan>F</tspan><tspan>a</tspan><tspan>m</tspan><tspan>i</tspan><tspan>l</tspan><tspan>y</tspan></text>
        <!-- طبقة 5 (الانضغاط 3D) انتقلت لطبقة HTML فوق الـ SVG — .ftv2-w5 تحت هذا الـ svg —
             لأن المتصفحات لا ترندر التحويلات المنظورية (rotateX/rotateY/perspective) على عناصر
             SVG الداخلية أصلاً: كانت تُسطَّح أو تُهمل = كل نماذج الدوران السابقة ميتة بصرياً.
             الحروف هنا عناصر HTML divs يبنيها JS بنفس إحداثيات الحروف المطبوعة (x/textLength
             مأخوذة من getExtentOfChar بعد التشديد — مطابقة بكسل-بكسل) وكل حرف svg صغير
             بنفس آلية textLength فيرندر بالحرف الأصلي تماماً، والتحويل المنظوري يتم على الـ div
             (عنصر HTML كامل الأهلية للـ 3D) — تعمل بالماوس وباللمس معاً -->
      </svg>
      <div class="ftv2-w5" id="ftv2W5" aria-hidden="true"></div>
    </div>
  </div>
</footer>

<script>(function(){
  var svg = document.getElementById('ftv2WordSvg');
  if (!svg) return;
  var wrap = svg.closest('.ftv2-word');
  var card = svg.closest('.ftv2-card');
  var W5 = document.getElementById('ftv2W5');
  var maskG = document.getElementById('ftv2RevealMask');
  var isTouch = !window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  // ── طبقة الوهج الحرفي صارت ثابتة في الـ HTML بنفس بنية الطبقات الأخرى ──
  // المحاذاة مضمونة بلا أي حسابات: المتصفح يوزّع الحروف بنفس التخطيط بالضبط،
  // وبعد اكتمال المسحة (~3.8ث) كل حرف يتوهج تباعاً عبر CSS فقط
  wrap.classList.add('w4-ready');
  // تفضيل تقليل الحركة: كل شيء جاهز فوراً (CSS يتخطى الأنميشنات أصلاً)
  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // الكمبيوتر: القناع يبدأ خارج الشاشة — صفر كشف قبل الوصول للفوتر وحركة الماوس
  if (!isTouch && maskG) { maskG.setAttribute('cx', '-50%'); maskG.setAttribute('cy', '-50%'); }
  if (reduced) {
    wrap.classList.add('drawn', 'glow-start', 'w5-ready');
  } else if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(es){
      es.forEach(function(en){
        if (en.isIntersecting) {
          wrap.classList.add('drawn'); io.disconnect();
          setTimeout(function(){ wrap.classList.add('glow-start'); }, 3800);
          // تفاعل انضغاط الحروف يُفتح مبكراً (1.5ث من الوصول للفوتر): الانتظار الطويل (كان 4.2ث
          // ثم 6.3ث قبله) كان يخلي من ينزل الفوتر ويجرب الحروف فوراً يجدها «ما تتفاعل» —
          // الضغط نفسه ما يضر مسحة الرسم فالتفاعل أبكر من اكتمال الوهج
          setTimeout(function(){ wrap.classList.add('w5-ready'); }, 1500);
        }
      });
    }, { threshold: 0.2 });
    io.observe(wrap);
  } else {
    wrap.classList.add('drawn');
    setTimeout(function(){ wrap.classList.add('glow-start'); }, 3800);
    setTimeout(function(){ wrap.classList.add('w5-ready'); }, 1500);
  }
  // الهاتف: إظهار التدرج كامل بدون قناع الماوس (إصلاح التشوه/الاختفاء)
  if (isTouch) {
    var w3 = svg.querySelector('.ftv2-w3');
    if (w3) w3.removeAttribute('mask');
  }
  // تحويل إحداثيات الشاشة إلى إحداثيات viewBox بمراعاة التوسيط (preserveAspectRatio):
  // الكلمة «Walton Family» بنسبة عرض/ارتفاع 4.6 — الصندوق أعرض منها فالمحتوى محجوز بالارتفاع
  // على الديسكتوب (وبالعرض على الشاشات الضيقة) — svgPoint يعالج الحالتين بنفس المعادلة
  var vbW = svg.viewBox.baseVal.width, vbH = svg.viewBox.baseVal.height;
  function svgPoint(clientX, clientY) {
    var r = svg.getBoundingClientRect();
    if (!r.width || !r.height) return null;
    var s = Math.min(r.width / vbW, r.height / vbH); // نفس منطق preserveAspectRatio الافتراضي
    var cw = vbW * s, ch = vbH * s;
    return [
      (clientX - r.left - (r.width - cw) / 2) / cw * vbW,
      (clientY - r.top  - (r.height - ch) / 2) / ch * vbH
    ];
  }
  // الماوس يُتتبَّع على مستوى البطاقة كلها — «كشاف» يكشف تدرج الكلمة من أي مكان،
  // دون أن يحجب أي عنصر الروابط القابلة للنقر (ماوس فقط — على اللمس التدرج كامل بلا قناع)
  // ── حلقة تتبّع الماوس: للكشاف فقط (تنعيم lerp) ──
  // الانضغاط خارج الحلقة كلياً: يُحسب ويُكتب مباشرة من حدث المؤشر بلا أي حلقة ولا مطاردة،
  // فأول لمسة من أي جهة تنضغط الحرف فوراً بالاتجاه الصحيح (بلا تأخر إطارات يُقرأ عكساً).
  // الحلقة تعمل فقط أثناء حركة المؤشر لتنعيم الكشاف وتتوقف كلياً عند السكون —
  // والإطار الساكن صفر كتابات DOM. مسار اللمس يبقى مباشراً بلا حلقة أصلاً.
  var tiltAt = null, releaseAll = null;
  var tX = 0, tY = 0, sX = 0, sY = 0, queued = false, wasInside = false, lastCx = '', lastCy = '', live = false, lastMove = 0;
  function kick(){ if (!queued) { queued = true; requestAnimationFrame(frame); } }
  function frame(){
    queued = false;
    var r = svg.getBoundingClientRect();
    if (!r.width || !r.height) return;
    sX += (tX - sX) * 0.55; sY += (tY - sY) * 0.55;
    if (!isTouch && maskG) {
      var p = svgPoint(sX, sY);
      if (p) {
        var mcx = (p[0] / vbW * 100).toFixed(2) + '%', mcy = (p[1] / vbH * 100).toFixed(2) + '%';
        if (mcx !== lastCx || mcy !== lastCy) {
          lastCx = mcx; lastCy = mcy;
          maskG.setAttribute('cx', mcx); maskG.setAttribute('cy', mcy);
        }
      }
      var inside = tX >= r.left - 24 && tX <= r.right + 24 &&
                   tY >= r.top - 24 && tY <= r.bottom + 24;
      if (inside !== wasInside) {
        wasInside = inside;
        if (inside) wrap.classList.add('hovered'); else wrap.classList.remove('hovered');
      }
    }
    if (Math.abs(tX - sX) + Math.abs(tY - sY) > 0.4) kick();
  }
  if (!isTouch) {
    card.addEventListener('mousemove', function(e){
      var now = performance.now();
      tX = e.clientX; tY = e.clientY;
      // الانضغاط من موضع المؤشر الحقيقي مباشرة (بلا تنعيم): الضغط يظهر حيث يجري المؤشر بالضبط
      if (tiltAt) { var p0 = svgPoint(tX, tY); if (p0) tiltAt(p0[0], p0[1]); }
      if (!live || now - lastMove > 120) { sX = tX; sY = tY; }
      live = true; lastMove = now;
      kick();
    }, { passive: true });
    card.addEventListener('mouseleave', function(){
      live = false;
      if (tiltAt) tiltAt(NaN, NaN); // إنشال فوري عند مغادرة البطاقة
      if (wasInside) { wasInside = false; wrap.classList.remove('hovered'); }
    });
  }
  // ── انضغاط حروف Walton Family — منظور ثلاثي الأبعاد حقيقي — ماوس ولمس معاً ──
  // · الحروف طبقة HTML فوق الكلمة: المتصفحات لا ترندر التحويلات المنظورية
  //   (rotateX/rotateY/perspective) على عناصر SVG الداخلية — تُسطّح أو تُهمل،
  //   ولهذا كانت كل نماذج «الدوران» السابقة على <text> ميتة أو مشوّهة بصرياً.
  //   الحرف الآن div فوق الكلمة بداخله svg صغير بنفس آلية textLength — يطابق
  //   الحرف المطبوع بكسل-بكسل، والمنظور يُطبّق على الـ div (عنصر HTML كامل الأهلية)
  // · نموذج «المفتاح يُكبس» كما اعتُمد سابقاً: نطاقات منفصلة بقلب 70% من كل حرف
  //   وفجوات ميتة بين الحروف (بين حرفين = صفر تفاعل)، وأقصى عمق بقلب الحرف
  //   يتلاشى عند طرفي النطاق — والانضغاط نفسه صار منظورياً: جهة اللمس تغوص
  //   داخل الشاشة بإشارات مدققة (rotateY موجب = اليمين يبتعد عن الناظر،
  //   rotateX سالب = الأسفل يبتعد) + دفع translateZ للخلف + تصغير خفيف،
  //   وقلب الحرف الأفقي = غوص مستقيم بلا أي ميلان
  // · الضغط يُكتب مباشرة من حدث المؤشر بلا انتقال CSS على transform = لحظي
  //   لا يُقرأ متأخراً ولا معكوساً، والإنشال حلقة decay أُسّية قصيرة (~150ms)
  //   تتوقف ذاتياً — لا حلقات دائمة ولا مؤقتات خامل، أثر الأداء صفري بالسكون
  if (!reduced && W5) {
    var MAXR = 16, MAXRX = 13, HH = 34, MAXZ = 12, MAXSH = 0.05;
    var NS = 'http://www.w3.org/2000/svg';
    // [الحرف، مركز x، العرض المشدود (textLength)، مركز y البصري للصنف]
    // المركز الرأسي لكل صنف: قبعة (W/F) 9.4–54 → 31.7 / وسط صغير 20.5–54 → 37.25 / نازل (y) 20.5–66.5 → 43.5
    var CHARS = [
      ['W', 45.82, 55.64, 31.7], ['a', 91.56, 35.82, 37.25], ['l', 117.71, 16.48, 37.25],
      ['t', 140.07, 28.25, 37.25], ['o', 173.17, 37.93, 37.25], ['n', 211.22, 38.17, 37.25],
      ['F', 262.59, 33.09, 31.7], ['a', 297.05, 35.82, 37.25], ['m', 341.41, 52.91, 37.25],
      ['i', 376.11, 16.48, 37.25], ['l', 392.59, 16.48, 37.25], ['y', 419.91, 38.17, 43.5]
    ];
    var letters = [], bands = [];
    CHARS.forEach(function(c){
      var d = document.createElement('div');
      d.className = 'ftv2-w5i';
      var sv = document.createElementNS(NS, 'svg');
      sv.setAttribute('viewBox', (c[1] - c[2] / 2) + ' 0 ' + c[2] + ' 100');
      sv.setAttribute('preserveAspectRatio', 'none');
      var tx = document.createElementNS(NS, 'text');
      tx.setAttribute('x', c[1]); tx.setAttribute('y', '54');
      tx.setAttribute('text-anchor', 'middle');
      tx.setAttribute('textLength', c[2]);
      tx.setAttribute('lengthAdjust', 'spacingAndGlyphs');
      tx.textContent = c[0];
      sv.appendChild(tx); d.appendChild(sv); W5.appendChild(d);
      // محور الدوران بصرّ الحرف نفسه (وليس صندوقه الكامل) — انعكاس دقيق حول مركز الحرف
      d.style.transformOrigin = '50% ' + c[3] + '%';
      var half = c[2] * 0.35; // قلب عرض الحرف ~70% فقط — ما بين الحروف فجوة ميتة بلا تفاعل
      letters.push({ el: d, cx: c[1], half: half, cy: c[3], rx: 0, ry: 0, tz: 0, s: 1 });
      bands.push([c[1] - half, c[1] + half]);
    });
    // تثبيت الحروف بالبكسل فوق حجز viewBox داخل صندوق الـ svg — preserveAspectRatio
    // يوسّط المحتوى فيحجز هوامش، والمطابقة البكسلية تُحسب من نفس معادلة svgPoint
    // وتُعاد عند أي تغيير مقاس (تلف/دوران الجهاز) — بلا قياسات أثناء التفاعل
    function place(){
      var r = svg.getBoundingClientRect();
      if (!r.width || !r.height) return;
      var s = Math.min(r.width / vbW, r.height / vbH);
      var ox = (r.width - vbW * s) / 2, oy = (r.height - vbH * s) / 2;
      for (var i2 = 0; i2 < letters.length; i2++) {
        var c = CHARS[i2];
        letters[i2].el.style.left = (ox + (c[1] - c[2] / 2) * s) + 'px';
        letters[i2].el.style.width = (c[2] * s) + 'px';
        letters[i2].el.style.top = oy + 'px';
        letters[i2].el.style.height = (vbH * s) + 'px';
      }
    }
    place();
    if ('ResizeObserver' in window) new ResizeObserver(place).observe(svg);
    else { window.addEventListener('resize', place); window.addEventListener('orientationchange', place); }

    var baseRows = [];
    // :not(.ftv2-sp) — tspan المسافة بين الكلمتين موجود بالطبقات الأربع لكنه بلا بطاقة
    // (ليس حرفاً) — الاستبعاد يبقي فهرسة baseRows متوافقة مع مصفوفة الحروف 1:1
    Array.prototype.forEach.call(['ftv2-w1', 'ftv2-w2', 'ftv2-w3', 'ftv2-w4'], function(cls){
      baseRows.push(svg.querySelector('.' + cls).querySelectorAll('tspan:not(.ftv2-sp)'));
    });
    var cur = -1, decaying = null, rafId = 0;
    function apply(L){
      L.el.style.transform = 'perspective(340px) translateZ(' + L.tz.toFixed(2) + 'px) rotateX(' + L.rx.toFixed(2) + 'deg) rotateY(' + L.ry.toFixed(2) + 'deg) scale(' + L.s.toFixed(3) + ')';
    }
    function setState(idx, on){
      letters[idx].el.classList[on ? 'add' : 'remove']('ftv2-tilting');
      for (var r2 = 0; r2 < 4; r2++) baseRows[r2][idx].classList[on ? 'add' : 'remove']('ftv2-lift');
    }
    function rest(L){ L.rx = L.ry = L.tz = 0; L.s = 1; L.el.style.transform = ''; }
    function startDecay(idx){
      var L = letters[idx];
      if (Math.abs(L.rx) < 0.3 && Math.abs(L.ry) < 0.3 && Math.abs(L.tz) < 0.4 && Math.abs(1 - L.s) < 0.002) { rest(L); return; }
      (decaying || (decaying = {}))[idx] = L;
      if (!rafId) rafId = requestAnimationFrame(decayStep);
    }
    function decayStep(){
      rafId = 0;
      var live = false;
      for (var k in decaying) {
        var L = decaying[k];
        L.rx *= 0.72; L.ry *= 0.72; L.tz *= 0.72; L.s = 1 - (1 - L.s) * 0.72;
        if (Math.abs(L.rx) < 0.25 && Math.abs(L.ry) < 0.25 && Math.abs(L.tz) < 0.3 && Math.abs(1 - L.s) < 0.0015) {
          rest(L); delete decaying[k];
        } else { apply(L); live = true; }
      }
      if (live) rafId = requestAnimationFrame(decayStep);
    }
    function releaseActive(){
      if (cur < 0) return;
      setState(cur, false);
      startDecay(cur);
      cur = -1;
    }
    tiltAt = function(xSvg, ySvg){
      if (isNaN(xSvg)) { releaseActive(); return; }
      if (!wrap.classList.contains('w5-ready') || !(ySvg > 0 && ySvg < 100)) { releaseActive(); return; }
      var hit = -1;
      for (var b = 0; b < bands.length; b++) {
        if (xSvg >= bands[b][0] && xSvg < bands[b][1]) { hit = b; break; }
      }
      if (hit < 0) { releaseActive(); return; } // الفجوة الميتة بين الحروف: لا أي تفاعل
      var L = letters[hit];
      var ndx = (xSvg - L.cx) / L.half; if (ndx > 1) ndx = 1; else if (ndx < -1) ndx = -1;
      var depth = 1 - Math.abs(ndx);
      var i = depth * depth * (3 - 2 * depth); // أقصى عمق بقلب الحرف، صفر عند طرفي النطاق حتى يلتحم بالفجوة الميتة
      var ndy = (ySvg - L.cy) / HH; if (ndy > 1) ndy = 1; else if (ndy < -1) ndy = -1;
      L.ry =  MAXR  * ndx * i; // يمين القلب ← يمين الحرف يغوص للداخل
      L.rx = -MAXRX * ndy * i; // تحت القلب ← أسفل الحرف يغوص للداخل
      L.tz = -MAXZ  * i;
      L.s  = 1 - MAXSH * i;
      if (hit !== cur) {
        releaseActive();
        cur = hit;
        setState(hit, true);
        if (decaying) delete decaying[hit];
      }
      apply(L);
    };
    if (isTouch) {
      // اللمس: الإصبع بنفس النموذج بالضبط —
      // · تمرير الإصبع فوق الكلمة ينضغط الحروف تباعاً معه (مستمعات passive فلا تعترض سكرول الصفحة أبداً)
      // · نقرة واحدة تنضغط الحرف للداخل وتُبقيه لحظة (900ms) ثم ينشال بنعومة
      // · رفع الإصبع بعد تمرير ينشال فوراً
      var holdTimer = null, moved = 0, lx = 0, ly = 0;
      var at = function(e){
        var t = e.touches[0];
        if (!t) return;
        var p = svgPoint(t.clientX, t.clientY);
        if (p) tiltAt(p[0], p[1]);
      };
      var dropHold = function(){ if (holdTimer) { clearTimeout(holdTimer); holdTimer = null; } };
      svg.addEventListener('touchstart', function(e){
        var t = e.touches[0];
        if (t) { moved = 0; lx = t.clientX; ly = t.clientY; }
        dropHold(); at(e);
      }, { passive: true });
      svg.addEventListener('touchmove', function(e){
        var t = e.touches[0];
        if (t) { moved += Math.abs(t.clientX - lx) + Math.abs(t.clientY - ly); lx = t.clientX; ly = t.clientY; }
        at(e);
      }, { passive: true });
      svg.addEventListener('touchend', function(){
        if (moved < 12) { holdTimer = setTimeout(function(){ tiltAt(NaN, NaN); }, 900); } else { tiltAt(NaN, NaN); }
      }, { passive: true });
      svg.addEventListener('touchcancel', function(){ dropHold(); tiltAt(NaN, NaN); }, { passive: true });
    }
    // الديسكتوب: مغادرة البطاقة تُنشّل الانضغاط فوراً — مُدرَجة فوق في مستمع
    // card mouseleave (النموذج المباشر لا يعلق حرفاً)
  }
})();</script>

<!-- ═══ Scroll Progress Bar + Back To Top ═══ -->
<style>
    #wfScrollProgress {
        position: fixed;
        top: 0;
        right: 0;
        height: 3px;
        width: 0%;
        z-index: 9999;
        background: linear-gradient(90deg, #d24dff, #bc13fe, #d24dff);
        box-shadow: 0 0 12px rgba(188, 19, 254, 0.8), 0 0 24px rgba(188, 19, 254, 0.4);
        border-radius: 0 3px 3px 0;
        transition: width 0.08s linear;
        pointer-events: none;
    }
    #wfBackToTop {
        position: fixed;
        bottom: 24px;
        left: 24px;
        z-index: 9998;
        width: 46px;
        height: 46px;
        border: 1px solid rgba(210, 77, 255, 0.4);
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.05rem;
        color: #fff;
        background: linear-gradient(135deg, #bc13fe, #d24dff);
        box-shadow: 0 6px 20px rgba(188, 19, 254, 0.45);
        opacity: 0;
        visibility: hidden;
        transform: translateY(16px);
        transition: all 0.35s cubic-bezier(0.2, 0.9, 0.4, 1.1);
    }
    #wfBackToTop.show {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }
    #wfBackToTop:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 28px rgba(188, 19, 254, 0.65), 0 0 18px rgba(210, 77, 255, 0.4);
    }
    @media (max-width: 640px) {
        #wfBackToTop { bottom: 18px; left: 18px; width: 40px; height: 40px; }
    }
</style>
<div id="wfScrollProgress"></div>
<button id="wfBackToTop" aria-label="العودة للأعلى"><i class="fas fa-chevron-up"></i></button>
<script>(function(){
    var bar=document.getElementById('wfScrollProgress'),btn=document.getElementById('wfBackToTop'),tick=false;
    function upd(){
        var st=document.documentElement.scrollTop||document.body.scrollTop;
        var h=document.documentElement.scrollHeight-document.documentElement.clientHeight;
        bar.style.width=(h>0?(st/h*100):0)+'%';
        if(st>300){btn.classList.add('show');}else{btn.classList.remove('show');}
        tick=false;
    }
    window.addEventListener('scroll',function(){if(!tick){tick=true;requestAnimationFrame(upd);}},{passive:true});
    upd();
    btn.addEventListener('click',function(){window.scrollTo({top:0,behavior:'smooth'});});
})();</script>

<script>(function(){var els=document.querySelectorAll('.wf-reveal,.wf-reveal-left,.wf-reveal-right,.wf-reveal-scale');if(!els.length)return;var io=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('visible');io.unobserve(e.target);}});},{threshold:0.12});els.forEach(function(el){io.observe(el);});})();</script>
