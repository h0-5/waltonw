<%
  var _ftSettings = typeof settings !== 'undefined' ? settings : {};
%>
<footer class="wf-footer">
    <div class="ft-grid"></div>
    <div class="ft-glow-top"></div>
    <div class="ft-orb-l"></div>
    <div class="ft-orb-r"></div>
    <div class="ft-orb-c"></div>
    <div class="ft-inner">
        <!-- Brand -->
        <div style="text-align:right">
            <div style="display:flex;align-items:center;gap:.6rem;justify-content:flex-end">
                <div>
                    <div class="ft-brand-name">Walton Family</div>
                    <div class="ft-brand-tag">Community</div>
                </div>
                <div class="ft-logo-ring"><img src="<%= _ftSettings.site_logo_url || '/images/walton-logo.svg' %>" alt="WF"></div>
            </div>
            <div class="ft-socials" style="justify-content:flex-end">
                <a href="<%= _ftSettings.discord_server_url || '#' %>" target="_blank" class="ft-social discord"><i class="fab fa-discord"></i></a>
            </div>
        </div>
        <!-- Links -->
        <div class="ft-links-wrap" style="text-align:right">
            <div>
                <h4 class="ft-col-title">روابط</h4>
                <a href="/" class="ft-link"><i class="fas fa-chevron-left"></i>الرئيسية</a>
                <a href="/store" class="ft-link"><i class="fas fa-chevron-left"></i>المتجر</a>
                <a href="/games" class="ft-link"><i class="fas fa-chevron-left"></i>الألعاب</a>
            </div>
            <div>
                <h4 class="ft-col-title">المزيد</h4>
                <a href="/rules" class="ft-link"><i class="fas fa-chevron-left"></i>القوانين</a>
                <a href="/applications" class="ft-link"><i class="fas fa-chevron-left"></i>التقديمات</a>
                <a href="/about" class="ft-link"><i class="fas fa-chevron-left"></i>من نحن</a>
            </div>
        </div>
    </div>
    <div class="ft-bottom">
        <div class="ft-cr">
            <span class="ft-cr-sym">&copy;</span>
            <span class="ft-cr-year"><%= new Date().getFullYear() %></span>
            <span class="ft-cr-brand"> Walton Family</span>
        </div>
        <div class="ft-made">
            <i class="fas fa-code ft-made-icon"></i>
            <span class="ft-dev-name">KHARBOSH</span>
            <span class="ft-dev-sep">&middot;</span>
            <span class="ft-dev-name">h05</span>
        </div>
    </div>
</footer>

<script>(function(){var els=document.querySelectorAll('.wf-reveal,.wf-reveal-left,.wf-reveal-right,.wf-reveal-scale');if(!els.length)return;var io=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('visible');io.unobserve(e.target);}});},{threshold:0.12});els.forEach(function(el){io.observe(el);});})();</script>
