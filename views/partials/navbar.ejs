  });

  /* ═══ حوز لوغو الصفحة + السحب باليد — وصف هادي للمقطع (1548733132562370772):
     «يسحب الدائرة بالماوس ويوقفها على صفحة» — بالمسح الكرة فاضية تتبع اليد،
     وعن الإفلات على صفحة تثبت فوقها — v17 (1548861478076157995) كان شال
     اللوغو والانتقال عن الإفلات، ورجّعه v19 (1251665502242213979): الإفلات
     يحوز اللوغو وينفتح الصفحة بعد استقراره ═══ */
  var carryLink = null, pendingCarry = null, holds = [];
  var dropNav = null; /* v19: مؤقت الانتقال بعد الإفلات على صفحة — يُشال بأي مسك أو ضغطة جديدة */
  var drag = null;
  var HOLD_R = 22;   /* نصف قطر جسم الكرة القابل للمسك — الهوفر والنقر على الروابط لم يُمس */
  var REST_DY = -7;  /* راحة الكرة (v15 هادي 1548815865024348200 «فوق الخط مباشر تلامسه»):
                        الحفرة تغور 13px تحت الكرة — قاع الكرة (+14 = dy+21) يجلس
                        على قاع الخط المنطعج (+13..+14) تلامس حقيقي: لا طايرة ولا غارقة —
                        v16 (1548840856545656843 «امنع الدائرة من انها تطلع او تنزل
                        خلها ثابتة بهذا موضوع»): قيمة وحيدة تُكتب مرة عند التثبيت —
                        الكرة ما تطلع ولا تنزل بالمسك ولا بالسحب ولا بالإفلات */

  /* أيقونة الرابط تطلع من فتحتها بالهدر (+24px من تحت) وتستقر بمركز الكرة،
     وعن المغادرة ترجع لفتحتها — كل عنصر ينشأ بالسكربت (صفر HTML زيادة)
     وكل حركة transform/opacity بلا أي مؤقت */
  function swapCarry(a) {
    for (var i = holds.length - 1; i >= 0; i--) {
      if (holds[i].classList.contains('wb-up')) holds[i].classList.remove('wb-up');
      if (!holds[i].parentNode) holds.splice(i, 1);
    }
    if (carryLink && (!a || carryLink !== a)) carryLink.classList.remove('wb-carry');
    if (!a) { carryLink = null; return; }
    if (carryLink === a) return;
    carryLink = a;
    var ico = a.querySelector('i');
    if (!ico) return;
    a.classList.add('wb-carry');
    var h = document.createElement('span');
    h.className = 'wb-hold ' + ico.className;
    bead.appendChild(h);
    holds.push(h);
    void h.offsetWidth; /* تثبيت موضع الفتحة قبل طلوع اللوغو للمركز */
    h.classList.add('wb-up');
    return h;
  }
  /* الأيقونة الساقطة تُشال بعد وصولها لفتحتها (transitionend opacity) */
  bead.addEventListener('transitionend', function (e) {
    var t = e.target;
    if (e.propertyName !== 'opacity' || !t.classList || !t.classList.contains('wb-hold')) return;
    if (t.classList.contains('wb-up')) return;
    if (t.parentNode) t.parentNode.removeChild(t);
    var ix = holds.indexOf(t);
    if (ix > -1) holds.splice(ix, 1);
  });

  /* نافذة الإفلات العمودية 52px (v14): مركز الكرة فوق الخط أعلى بنحو نصف قطرها
     من نصوص الروابط — النافذة الأوسع تلتقط الإفلات وهي راكبة على الخط */
  function hitLink(cx, cy) {
    for (var i = 0; i < drag.rects.length; i++) {
      var r = drag.rects[i];
      if (cx >= r.l - 6 && cx <= r.r + 6 && Math.abs(cy - r.cy) <= 52) return r.a;
    }
    return null;
  }

  /* المسك من مستند كامل — الكرة راحةً وسحباً تعلو حدود الكبسولة فوق الخط (v14) */
  document.addEventListener('pointerdown', function (e) {
    if (drag || (e.button !== undefined && e.button !== 0)) return;
    var b = bead.getBoundingClientRect();
    var gdx = e.clientX - (b.left + b.width / 2);
    var gdy = e.clientY - (b.top + b.height / 2);
    if (gdx * gdx + gdy * gdy > HOLD_R * HOLD_R) return;
    if (dropNav) { clearTimeout(dropNav); dropNav = null; } /* v19: مسك جديد يشال الانتقال المعلّق */
    var links = wrap.querySelectorAll('.ds-navlink');
    var rects = [];
    for (var i = 0; i < links.length; i++) {
      var r = links[i].getBoundingClientRect();
      rects.push({ a: links[i], l: r.left, r: r.right, cy: r.top + r.height / 2 });
    }
    drag = { id: e.pointerId, sx: e.clientX, sy: e.clientY, moved: false, rects: rects, over: null };
    try { wrap.setPointerCapture(e.pointerId); } catch (err) {}
    e.preventDefault(); /* لا تحديد نص ولا نقرة تمرّ للرابط تحت الكرة */
  });

  document.addEventListener('pointermove', function (e) {
    if (!drag || e.pointerId !== drag.id) return;
    if (!drag.moved) {
      var mx = e.clientX - drag.sx, my = e.clientY - drag.sy;
      if (mx * mx + my * my < 36) return; /* تحت 6px = ضغطة بلا سحب */
      drag.moved = true;
      swapCarry(null); /* باليد الكرة فاضية — أيقونة المقر رجعت لفتحتها */
      pendingCarry = null;
      wrap.classList.add('wb-dragging'); /* ملصوقة باليد: بلا transition */
      wrap.classList.remove('wb-lean-l', 'wb-lean-r');
      wrap.style.setProperty('--wb-dur', '90ms'); /* النقش والودّ يتبعان بتأخر ثقيل */
      wrap.classList.add('wb-press'); /* ثقل اليد */
      document.documentElement.style.cursor = 'grabbing';
    }
    var wr = wrap.getBoundingClientRect();
    var px = Math.max(16, Math.min(wr.width - 16, e.clientX - wr.left));
    /* v16 (1548840856545656843 «امنع الدائرة من انها تطلع او تنزل خلها
       ثابتة بهذا موضوع»): السحب أفقي حصراً — انشال اللعب الرأسي القديم
       (-25..+8) — الكرة على ارتفاع راحتها الثابت مهما تحركت اليد رأسياً */
    if (lastX !== null && px !== lastX) {
      rot += ((px - lastX) / R) * RAD; /* تدحرج فيزيائي مع اليد — نفس نسبة التدحرج */
      wrap.style.setProperty('--wb-rot', rot.toFixed(1) + 'deg');
    }
    wrap.style.setProperty('--wb-x', px + 'px'); /* خط الحافة والحفرة يتبعون بـ transition 90ms — صفر عمل يدوي */
    buildEdge(px); /* أكتاف الانبولة تُقاس على مساحة موضع اليد — مقفولة حتى عند الزوايا */
    lastX = px;
    var over = hitLink(e.clientX, wr.top + REST_DY);
    if (over !== drag.over) {
      if (drag.over) drag.over.classList.remove('wb-under');
      drag.over = over;
      if (over) over.classList.add('wb-under');
      /* v16 (1548840856545656843 «لوغو الصفحة ما يطلع لمنتصف الدائرة الا
         لو انا ضغط على صفحة وبنتقل لها»): مسح الروابط تحت الكرة ما عاد
         يحوز لوغوها — الاسم يتباور فقط، واللوغو لصفحة تنفتح حصراً */
    }
  });

  function endDrag(e, cancelled) {
    if (!drag || e.pointerId !== drag.id) return;
    var d = drag;
    var wr = wrap.getBoundingClientRect();
    var over = cancelled ? null : hitLink(e.clientX, wr.top + REST_DY);
    drag = null;
    document.documentElement.style.cursor = '';
    try { wrap.releasePointerCapture(d.id); } catch (err) {}
    if (!d.moved) return; /* ضغطة بلا سحب — الكرة على راحتها الثابتة أصلاً */
    wrap.classList.remove('wb-dragging');
    if (over) {
      /* v19 (هادي 1251665502242213979 «لو سحبتها بمواس وقفتها عن صفحة معينة
         تنفتح صفحة ذي ويطلع لوغو صفحة للدائرة بشكل سلس مدري ليه انشالو»):
         رجّعنا فتح الصفحة بالإفلات اللي انشاله v17 — الكرة تثبت بمركز الصفحة
         بفيزياء التدحرج نفسها، ولوغو الصفحة يطلع من فتحته لمركز الكرة
         بالسلسلة الأصلية (swapCarry)، وحين يستقر ينتقل للصفحة — نبضة انتقال
         وحيدة 360ms تُشال بأي مسك جديد أو ضغطة قبلها فما ينقلب الفتح فجأة */
      curLink = over;
      parkedLink = over;
      over.classList.add('wb-under');
      wrap.classList.add('wb-press');
      goTo(over); /* تثبيت بمركز الصفحة بنفس فيزياء التدحرج — جلوس مباشر بلا انضغاط ارتطام (v21) */
      swapCarry(over); /* لوغو الصفحة يطلع لمركز الكرة — نفس حركة الضغطة الحقيقية */
      var dest = over.getAttribute('href') || '/';
      if (new URL(dest, location.href).pathname !== location.pathname) {
        /* الإفلات على الصفحة الحالية = جلوس فقط بلا إعادة تحميل */
        if (dropNav) clearTimeout(dropNav);
        dropNav = setTimeout(function () {
          dropNav = null;
          if (!drag) location.assign(dest); /* ما صار مسك ولا ضغطة جديدة — انتقل */
        }, 360); /* 240ms طلوع اللوغو + نبضة استقرار */
      }
    } else {
      /* الإفلات بأي مكان ثاني — ترجع لمقرّها بالنابض ولا شيء ينفتح */
      if (d.over) d.over.classList.remove('wb-under');
      clearPress();
      goTo(curLink || active);
      parkedLink = curLink || active;
    }
    pendingCarry = null; /* الإفلات يحوز اللوغو بنفسه أعلاه (v19) — بلا طريق مزدوج */
  }
  document.addEventListener('pointerup', function (e) { endDrag(e, false); });
  document.addEventListener('pointercancel', function (e) { endDrag(e, true); });

  function sync() {
    if (drag) return; /* لا إعادة محاذاة وسط سحب */
    active = wrap.querySelector('.ds-navlink.active') || active;
    goTo(parkedLink || active, true); /* إعادة محاذاة فورية تحترم مكان الوقوف — وتبني أكتاف الانبولة للعرض الجديد */
    wrap.style.setProperty('--wb-dy', REST_DY + 'px'); /* الكتابة الوحيدة للارتفاع — ثابتة رأسياً (v16) */
    bead.classList.add('wb-bead-ready'); /* تظهر بعد أول تحديد — لا وميض بموضع خاطئ */
    wrap.classList.add('wb-on'); /* الحفرة ظاهرة دائماً منذ أول تحديد — مثل المرجع */
  }
  sync();
  window.addEventListener('resize', sync);
  /* الخط قد يغيّر عرض الروابط بعد أول قياس — إعادة محاذاة واحدة عند جهوزيته */
  if (document.fonts && document.fonts.ready && document.fonts.ready.then) {
    document.fonts.ready.then(sync).catch(function () {});
  }
})();
</script>
