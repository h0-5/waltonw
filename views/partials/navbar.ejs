<%
  var _nbSiteName = typeof siteName !== 'undefined' ? siteName : 'Walton Family';
  var _nbSettings = typeof settings !== 'undefined' ? settings : {};
  var _nbUser = typeof user !== 'undefined' ? user : null;
  var _nbPath = typeof currentPath !== 'undefined' ? currentPath : '/';
  var _nbPageAccess = typeof pageAccess !== 'undefined' ? pageAccess : {};
  var _nbCanSee = function(path) {
    if (!_nbUser) return true;
    if (_nbUser.role === 'owner') return true;
    // If no records in page_access table, default to visible
    if (!(path in _nbPageAccess)) return true;
    return _nbPageAccess[path] === 1;
  };
  var _nbLogo = _nbSettings.site_logo_url || '/images/logo.png';
  /* طاقم الإدارة — رابط الإدارة يُعرض لهم كزر أيقونة بمنطقة الإجراءات (يسار الزاوية)
     بدل رابط داخل شريط الروابط: شريط الروابط يفيض أفقياً بلا سكرولبار ظاهر فكان آخر رابط (الإدارة)
     يُقص ولا يراه الأونر أصلاً */
  var _nbStaff = !!(_nbUser && ['owner', 'developer', 'founder', 'moderator', 'support', 'admin'].includes(_nbUser.role));
%>
<nav class="navbar<%= _nbStaff ? ' is-staff' : '' %>">
  <!-- الختم + اسم العائلة -->
  <a href="/" class="ds-brand" aria-label="<%= _nbSiteName %> — الرئيسية">
    <img src="<%= _nbLogo %>" alt="ختم <%= _nbSiteName %>" width="40" height="40" decoding="async">
    <span class="ds-brand-txt">
      <span class="ds-brand-name">Walton Family</span><br>
      <span class="ds-brand-sub">Community</span>
    </span>
  </a>

  <!-- روابط الديسكتوب -->
  <div class="ds-navlinks" aria-label="التنقل الرئيسي">
    <a href="/" class="ds-navlink<%= _nbPath === '/' || _nbPath === '/home' ? ' active' : '' %>"><i class="fas fa-home" aria-hidden="true"></i>الرئيسية</a>
    <% if (_nbCanSee('/rules')) { %>
    <a href="/rules" class="ds-navlink<%= _nbPath === '/rules' ? ' active' : '' %>"><i class="fas fa-gavel" aria-hidden="true"></i>القوانين</a>
    <% } %>
    <% if (_nbCanSee('/applications')) { %>
    <a href="/applications" class="ds-navlink<%= _nbPath === '/applications' ? ' active' : '' %>"><i class="fas fa-file-alt" aria-hidden="true"></i>التقديمات</a>
    <% } %>
    <% if (_nbCanSee('/store')) { %>
    <a href="/store" class="ds-navlink<%= _nbPath === '/store' ? ' active' : '' %>"><i class="fas fa-store" aria-hidden="true"></i>المتجر</a>
    <% } %>
    <% if (_nbCanSee('/games')) { %>
    <a href="/games" class="ds-navlink<%= _nbPath === '/games' ? ' active' : '' %>"><i class="fas fa-gamepad" aria-hidden="true"></i>الألعاب</a>
    <% } %>
    <% if (_nbCanSee('/properties')) { %>
    <a href="/properties" class="ds-navlink<%= _nbPath === '/properties' ? ' active' : '' %>"><i class="fas fa-building" aria-hidden="true"></i>الممتلكات</a>
    <% } %>
    <% if (_nbCanSee('/company')) { %>
    <a href="/company" class="ds-navlink<%= _nbPath === '/company' ? ' active' : '' %>"><i class="fas fa-briefcase" aria-hidden="true"></i>الشركة</a>
    <% } %>
    <a href="/community" class="ds-navlink<%= _nbPath === '/community' ? ' active' : '' %>"><i class="fas fa-comments" aria-hidden="true"></i>المجتمع</a>
    <a href="/about" class="ds-navlink<%= _nbPath === '/about' ? ' active' : '' %>"><i class="fas fa-circle-info" aria-hidden="true"></i>من نحن</a>
    <% /* الدعم أُزيل من الهدر بطلب المستخدم — مدخله الآن بطاقة الدعم بأسفل الرئيسية + فوتر «تواصل معنا»
       رابط الإدارة انتقل لزر الأيقونة بمنطقة الإجراءات (is-staff) — كان يُقص بفيض الشريط */ %>
  </div>

  <!-- الإجراءات: إشعارات + مستخدم (مود ليل/نهار أُزيل كلياً بطلب المستخدم — الثيم القديم الداكن دائم) -->
  <div class="ds-actions">
    <% if (_nbStaff) { %>
      <!-- زر لوحة الإدارة: أيقونة درع بلون الثيم — دائم الظهور للطاقم بلا قصّ بفيض الشريط -->
      <a href="/admin" class="ds-adminbtn" title="لوحة الإدارة" aria-label="لوحة الإدارة"><i class="fas fa-shield-halved" aria-hidden="true"></i></a>
    <% } %>
    <% if (_nbUser) { %>
      <!-- الإشعارات -->
      <div style="position:relative">
        <button class="ds-iconbtn" id="notifToggle" onclick="toggleNotifications()" aria-label="الإشعارات">
          <i class="fas fa-bell" aria-hidden="true"></i>
          <span id="notificationBadge" class="ds-notif-badge hidden"></span>
        </button>
        <div id="notificationDropdown" class="hidden">
          <div class="ds-drop-head">
            <b>الإشعارات</b>
            <span class="ds-drop-actions">
              <button onclick="markAllRead()" class="ds-drop-mini">قراءة الكل</button>
              <button onclick="deleteAllNotifications()" class="ds-drop-mini ds-drop-mini-danger" title="حذف الكل"><i class="fas fa-trash" aria-hidden="true"></i></button>
            </span>
          </div>
          <div id="notificationList">
            <div class="ds-drop-empty">لا توجد إشعارات</div>
          </div>
        </div>
      </div>

      <!-- قائمة المستخدم -->
      <div style="position:relative" id="userMenuWrap">
        <button class="ds-userbtn" id="userMenuBtn" onclick="toggleUserMenu()" aria-haspopup="true">
          <span class="ds-user-name"><%= _nbUser.username %></span>
          <i class="fas fa-chevron-down ds-user-chev" aria-hidden="true"></i>
          <% if (_nbUser.profile_picture) { %>
            <img src="<%= _nbUser.profile_picture %>" alt="صورة <%= _nbUser.username %>" class="no-lightbox skip-lightbox profile-skip nav-avatar" data-lightbox-skip="true" data-profile-protected="true" width="26" height="26">
          <% } else { %>
            <span class="ds-user-avatar-ph"><%= _nbUser.username.charAt(0).toUpperCase() %></span>
          <% } %>
        </button>
        <div id="userMenuDropdown" class="hidden">
          <a href="/profile" class="ds-drop-item"><i class="fas fa-user" aria-hidden="true"></i>الملف الشخصي</a>
          <a href="/orders" class="ds-drop-item"><i class="fas fa-box" aria-hidden="true"></i>طلباتي</a>
          <a href="/my_discounts" class="ds-drop-item"><i class="fas fa-tag" aria-hidden="true"></i>خصوماتي</a>
          <% if (_nbStaff) { %>
          <a href="/admin" class="ds-drop-item"><i class="fas fa-shield-halved" aria-hidden="true"></i>الإدارة</a>
          <% } %>
          <div class="ds-drop-sep" role="separator"></div>
          <a href="/auth/logout" class="ds-drop-item ds-drop-item-logout"><i class="fas fa-arrow-right-from-bracket" aria-hidden="true"></i>تسجيل خروج</a>
        </div>
      </div>
    <% } else { %>
      <a href="/auth/discord" class="ds-btn ds-btn-primary ds-btn-sm">
        <i class="fab fa-discord" aria-hidden="true"></i>
        <span>تسجيل الدخول</span>
      </a>
    <% } %>

    <button id="mobileMenuBtn" class="ds-menubtn" onclick="toggleMobileMenu()" aria-label="القائمة" aria-expanded="false"><i class="fas fa-bars" aria-hidden="true"></i></button>
  </div>
</nav>

<!-- درج الجوال (نفس id ونفس آلية open/show القديمة) -->
<div id="mobileNav">
  <a href="/" class="ds-mlink<%= _nbPath === '/' ? ' active' : '' %>"><i class="fas fa-home" aria-hidden="true"></i>الرئيسية</a>
  <% if (_nbCanSee('/rules')) { %>
  <a href="/rules" class="ds-mlink<%= _nbPath === '/rules' ? ' active' : '' %>"><i class="fas fa-gavel" aria-hidden="true"></i>القوانين</a>
  <% } %>
  <% if (_nbCanSee('/applications')) { %>
  <a href="/applications" class="ds-mlink<%= _nbPath === '/applications' ? ' active' : '' %>"><i class="fas fa-file-alt" aria-hidden="true"></i>التقديمات</a>
  <% } %>
  <% if (_nbCanSee('/store')) { %>
  <a href="/store" class="ds-mlink<%= _nbPath === '/store' ? ' active' : '' %>"><i class="fas fa-store" aria-hidden="true"></i>المتجر</a>
  <% } %>
  <% if (_nbCanSee('/games')) { %>
  <a href="/games" class="ds-mlink<%= _nbPath === '/games' ? ' active' : '' %>"><i class="fas fa-gamepad" aria-hidden="true"></i>الألعاب</a>
  <% } %>
  <% if (_nbCanSee('/properties')) { %>
  <a href="/properties" class="ds-mlink<%= _nbPath === '/properties' ? ' active' : '' %>"><i class="fas fa-building" aria-hidden="true"></i>الممتلكات</a>
  <% } %>
  <% if (_nbCanSee('/company')) { %>
  <a href="/company" class="ds-mlink<%= _nbPath === '/company' ? ' active' : '' %>"><i class="fas fa-briefcase" aria-hidden="true"></i>الشركة</a>
  <% } %>
  <a href="/community" class="ds-mlink<%= _nbPath === '/community' ? ' active' : '' %>"><i class="fas fa-comments" aria-hidden="true"></i>المجتمع</a>
  <a href="/about" class="ds-mlink<%= _nbPath === '/about' ? ' active' : '' %>"><i class="fas fa-circle-info" aria-hidden="true"></i>من نحن</a>
  <% if (!_nbUser) { %>
  <a href="/auth/discord" class="ds-mlink ds-mlink-accent"><i class="fab fa-discord" aria-hidden="true"></i>تسجيل الدخول</a>
  <% } %>
  <% if (_nbStaff) { %>
  <a href="/admin" class="ds-mlink ds-mlink-accent"><i class="fas fa-shield-halved" aria-hidden="true"></i>الإدارة</a>
  <% } %>
</div>

<script>
function toggleMobileMenu() {
  const nav = document.getElementById('mobileNav');
  const btn = document.getElementById('mobileMenuBtn');
  nav.classList.toggle('open');
  if (btn) btn.setAttribute('aria-expanded', nav.classList.contains('open') ? 'true' : 'false');
}
/* ═══ جرس الإشعارات — حي بالكامل: بادج من السيرفر + قائمة عند الفتح + قراءة الكل + حذف الكل ═══ */
function toggleUserMenu() {
  const dd = document.getElementById('userMenuDropdown');
  dd.classList.toggle('hidden');
}
var _notifItems = [];
function _nfEsc(s) {
  return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
  });
}
function _nfRel(s) {
  if (!s) return '';
  var d = new Date(String(s).replace(' ', 'T') + '+03:00');
  if (isNaN(d.getTime())) return '';
  var m = Math.max(0, Math.round((Date.now() - d.getTime()) / 60000));
  if (m < 1) return 'الآن';
  if (m < 60) return 'منذ ' + m + ' دقيقة';
  var h = Math.floor(m / 60);
  if (h < 24) return 'منذ ' + h + ' ساعة';
  return 'منذ ' + Math.floor(h / 24) + ' يوم';
}
function _nfBadge(n) {
  var b = document.getElementById('notificationBadge');
  if (!b) return;
  if (n > 0) { b.textContent = n > 99 ? '99+' : String(n); b.classList.remove('hidden'); }
  else { b.textContent = ''; b.classList.add('hidden'); }
}
function _nfRender(items) {
  var list = document.getElementById('notificationList');
  if (!list) return;
  if (!items.length) { list.innerHTML = '<div class="ds-drop-empty">لا توجد إشعارات</div>'; return; }
  var ico = { success: 'fa-circle-check', warning: 'fa-triangle-exclamation', info: 'fa-circle-info' };
  list.innerHTML = items.map(function (n) {
    return '<a href="' + _nfEsc(n.link || '#') + '" class="ds-drop-item ds-notif-item' + (Number(n.is_read) ? '' : ' unread') + '">' +
      '<i class="fas ' + (ico[n.type] || 'fa-bell') + '"></i>' +
      '<span class="ds-notif-body"><b>' + _nfEsc(n.title) + '</b>' +
      (n.message ? '<small>' + _nfEsc(n.message) + '</small>' : '') +
      '<em>' + _nfRel(n.created_at) + '</em></span></a>';
  }).join('');
}
async function notifFetch() {
  try {
    var r = await fetch('/api/notifications', { credentials: 'same-origin' });
    var d = await r.json();
    _notifItems = d.notifications || [];
    _nfBadge(_notifItems.filter(function (n) { return !Number(n.is_read); }).length);
    return _notifItems;
  } catch (e) { return []; }
}
async function toggleNotifications() {
  var dd = document.getElementById('notificationDropdown');
  var opening = dd.classList.contains('hidden');
  dd.classList.toggle('hidden');
  if (opening) _nfRender(await notifFetch());
}
async function markAllRead() {
  try { await fetch('/api/notifications/read', { method: 'POST', credentials: 'same-origin' }); } catch (e) {}
  _notifItems = _notifItems.map(function (n) { n.is_read = 1; return n; });
  _nfRender(_notifItems);
  _nfBadge(0);
}
async function deleteAllNotifications() {
  try { await fetch('/api/notifications/delete-all', { method: 'POST', credentials: 'same-origin' }); } catch (e) {}
  _notifItems = [];
  _nfRender([]);
  _nfBadge(0);
}
/* البادج أول ما تتحمل الصفحة — استعلام خفيف بعدد غير المقروء فقط */
(function () {
  if (!document.getElementById('notifToggle')) return;
  fetch('/api/notifications?badge=1', { credentials: 'same-origin' })
    .then(function (r) { return r.json(); })
    .then(function (d) { if (d && typeof d.unread === 'number') _nfBadge(d.unread); })
    .catch(function () {});
})();

/* ═══ حبة التنقل (ديسكتوب ≥1024 فقط) — v10 بطلب هادي (1548712672487546951):
   ① لا فتح تلقائي نهائياً — بطلبه الصريح: «شيل انميشن الدائرة لما تنزل لتحت
     عشان تفتح الصفحة شيله ما نحتاجه اصلا»: الكرة زينة وتدحرج وثقل فقط،
     والصفحة ما تنفتح إلا بنقرة حقيقية من المستخدم — انشال عدّ الوقوف
     كله بمؤقتيه وصار السكربت صفر مؤقتات مطلقاً
   ② خط الحافة طبيعي مطابق للحد السفلي: 1px بشفافية .14 (نفس --glass-line)
     — كان يطلع 2px بـ .46 فيقرأ أثخن وأسطع من خط الكبسولة «حين مختلف»
   ③ الانطعاج تحت الدائرة فقط (v8): جاوس σ15 وغور 13px والقطع تدور بميل
     المماس — المنطعج يتشكّل بمكانها الجديد والقديم يرجع بنفس المدة والمنحنى
     (طلب 1548519324744941720)
   ④ الثقل كما هو: الوقوف على الشريط يغور الكرة 4px داخل الودّ ويغور الرابط
     الحامل 2px وتهبط الكبسولة 2px، وعند الارتطام بعد قفزة طويلة تنضغط وترتد
   ⑤ تدحرج فيزيائي: الدوران من الإزاحة الحقيقية ÷ نصف القطر، ومدة الحركة
     تتناسب مع البعد — وكل الحركة transform/opacity فقط بلا أي مؤقت
   ⑥ المطّ الجيلي — المقطع المرجعي من هادي (ريل انستقرام DbfG6fuPE9y، «خليها
     ذي مقطع بالضبط»): الكرة ما تتدحرج صلبة، تستطيل أفقاً باتجاه الهدف أثناء
     الطيران (حتى 1.72× والارتفاع ينكمش معكاساً) ومنحاز الممدد نحو الجهة
     القادمة، وعند الوصول يرتد للدائرة بنابض 240ms مع انضغاط الارتطام —
     طبقة مطّ منفصلة (.wb-squish) عن طبقة الدوران حتى لا تتعارض مُدَتاهما
   ⑦ السحب والفتح — وصف هادي للمقطع حرفياً (1548733132562370772 «متاكد شفت
     المقطع كامل؟»): «يسحب الدائرة بالماوس ويوقفها على صفحة يطلع لوغو الصفحة
     من الهدر لمركز للدائرة وتفتح الصفحة» — الكرة تنمسك من جسمها (22px)
     وتنشل من الودّ وتتدحرج مع اليد، وأيقونة كل صفحة تقف عندها تطلع من فتحتها
     بمركز الكرة (.wb-hold تنشأ بالسكربت — صفر HTML) وترجع لفتحتها عند
     المغادرة، وعن الإفلات على صفحة تثبت فيها ويطلع لوغوها لمركزها وتنفتح
     الصفحة، والإفلات بمكان ثاني يرجعها لمقرّها بلا فتح — بلا أي مؤقتات:
     pointer events و transitionend حصراً ═══ */
(function () {
  var wrap = document.querySelector('.ds-navlinks');
  if (!wrap || !window.matchMedia('(min-width: 1024px)').matches) return;

  var edge = document.createElement('span');
  edge.className = 'wb-edge';
  edge.setAttribute('aria-hidden', 'true');
  var dent = document.createElement('span');
  dent.className = 'wb-dent';
  dent.setAttribute('aria-hidden', 'true');
  var bead = document.createElement('span');
  bead.className = 'wb-bead';
  bead.setAttribute('aria-hidden', 'true');
  /* طبقة المطّ (المقطع المرجعي): غلاف داخلي تحمله الكرة، يستطيل أفقياً أثناء
     التدحرج ويرجع دائرة عند الوصول — منفصلة عن طبقة الدوران حتى لكل واحدة
     مدتها ومنحناها (المطّ نابض ثابت 240ms، والدوران بمدة الرحلة) */
  var squish = document.createElement('span');
  squish.className = 'wb-squish';
  bead.appendChild(squish);
  /* ترتيب الرسم: خط الحافة ثم الحفرة فوقه ثم الكرة فوق الكل */
  wrap.appendChild(edge);
  wrap.appendChild(dent);
  wrap.appendChild(bead);

  var active = wrap.querySelector('.ds-navlink.active') || wrap.querySelector('.ds-navlink');
  var lastX = null, lastDist = 0, lastDur = 0, rot = 0;
  var curLink = null;
  var R = 21;              /* نصف قطر الكرة 42px — الإزاحة ÷ نصف القطر = زاوية التدحرج */
  var RAD = 180 / Math.PI; /* راديان → درجة */

  /* خط الحافة الحيّ — قطع متداخلة تقرأ كخط واحد متصل (v9 بطلب هادي 1548700388948054030:
     «خلي خط الهدر يظهر كخط متصل مثل الخط اللي من تحت مع حفاظ ع تأثير»):
     كل قطعة أوسع من خطوتها (14px على خطوة 10px — العرض بـ CSS) وتتمركز على مركز
     خطوتها، والتداخل 4px يسدّ أي فتحة عند دوران المفصل، وشفافية الحاوية كوحدة
     واحدة (opacity .46 بـ CSS على .wb-edge) تمنع تراكم اللون عند الدرزات —
     فالخط يظل شريطاً موحداً ينطعج تحت الكرة ويستقيم بنفس مدة ومنحنى التدحرج.
     كل قطعة تغور بعمق جاوس حسب بعدها عن مركز الثقل وتدور بميل المماس
     (v8: جاوس ضيق σ=15 وغور 13px — الانطعاج تحت الدائرة وحدها بلا مبالغة،
     رسالة هادي 1548691246355320905: «مبالغ فيه خليه تحت دائرة فقط») */
  var SEGS = [], SEG_W = 10, EDGE_PAD = 30, SAG = 13, SIG = 15, SIG2 = 2 * SIG * SIG;
  function buildEdge() {
    var n = Math.max(0, Math.floor((wrap.clientWidth - EDGE_PAD * 2) / SEG_W));
    if (n === SEGS.length) return;
    edge.innerHTML = '';
    SEGS = [];
    for (var i = 0; i < n; i++) {
      var s = document.createElement('i');
      /* تمركز القطعة (14px بالـ CSS) على مركز خطوتها — مركز الانحناء يطابق مركزها */
      s.style.left = (EDGE_PAD + i * SEG_W + SEG_W / 2 - 7) + 'px';
      edge.appendChild(s);
      SEGS.push(s);
    }
  }
  function bendEdge(x) {
    for (var i = 0; i < SEGS.length; i++) {
      var d = EDGE_PAD + i * SEG_W + SEG_W / 2 - x;
      var dy = SAG * Math.exp(-(d * d) / SIG2); /* عمق الجاوس تحت مركز الثقل */
      var slope = -(d / SIG2) * dy;             /* ميل المماس — القطع تدور مع انحناء الخط */
      SEGS[i].style.transform = 'translateY(' + dy.toFixed(2) + 'px) rotate(' + (Math.atan(slope) * RAD).toFixed(2) + 'deg)';
    }
  }

  function goTo(a, instant) {
    if (!a) return;
    var x = a.offsetLeft + a.offsetWidth / 2; /* مركز الرابط داخل الكبسولة (relative) */
    lastDur = 0;
    /* لوغو الصفحة (مقطع هادي 1548733132562370772 حرفياً): عند التوجه لرابط غير
       الحامل أيقونته ترجع لفتحتها بالهدر وأيقونة الهدف تطلع لمركز الكرة فور
       الوصول — وعند التثبيت الفوري ترتفع في الحين */
    if (carryLink !== a) {
      swapCarry(null);
      pendingCarry = a;
    }
    if (lastX === null || instant) {
      /* أول وضع أو إعادة محاذاة (resize/خط) — تثبيت فوري بلا تدحرج وبلا مطّ */
      lastDist = 0;
      wrap.style.setProperty('--wb-dur', '0ms');
      squish.style.setProperty('--wb-sx', '1');
      squish.style.setProperty('--wb-sy', '1');
      if (pendingCarry) { swapCarry(pendingCarry); pendingCarry = null; }
    } else {
      var dx = x - lastX;
      lastDist = Math.abs(dx);
      if (lastDist >= 1) {
        lastDur = Math.round(Math.min(560, 200 + lastDist * 0.6));
        rot += (dx / R) * RAD; /* نفس النسبة للدوران والإزاحة وبنفس المدة والمنحنى */
        wrap.style.setProperty('--wb-dur', lastDur + 'ms');
        wrap.style.setProperty('--wb-rot', rot.toFixed(1) + 'deg');
        /* ميلان السطح مع اتجاه الحركة — يرتد لاستقامته عند الهبوط */
        wrap.classList.remove('wb-lean-l', 'wb-lean-r');
        wrap.classList.add(dx > 0 ? 'wb-lean-r' : 'wb-lean-l');
        /* المطّ الجيلي (بالمقطع المرجعي حرفياً): الكرة تستطيل باتجاه الهدف
           أثناء الطيران — كل ما بعدت المسافة زاد الاستطالة (سقف 1.72×)
           والارتفاع ينكمش معكاساً حفاظاً على حجم الكرة — وأصل التمدد
           منحاز للجهة القادمة (30% وهي رايحة يمين / 70% رايحة يسار)
           حتى يبسط المدى الأمامي أكثر من الخلفي، وعند الوصول يرجع 1×1
           بنابض 240ms من transitionend الكرة */
        var sx = 1 + Math.min(0.72, lastDist / 420);
        squish.style.transformOrigin = dx > 0 ? '30% 50%' : '70% 50%';
        squish.style.setProperty('--wb-sx', sx.toFixed(3));
        squish.style.setProperty('--wb-sy', Math.max(0.78, 1 / sx).toFixed(3));
      }
    }
    wrap.style.setProperty('--wb-x', x + 'px');
    bendEdge(x); /* خط الحافة ينطعج بمكانها الجديد والقديم يرجع بنفس المدة والمنحنى */
    lastX = x;
  }

  function clearPress() {
    wrap.classList.remove('wb-press');
    if (curLink) { curLink.classList.remove('wb-under'); curLink = null; }
  }

  /* تفويض واحد على الحاوية بدل مستمع لكل رابط — الكرة زينة فقط: تدحرج وثقل
     بلا أي فتح تلقائي، الصفحة تنفتح بنقرة المستخدم على الرابط حصراً */
  wrap.addEventListener('mouseover', function (e) {
    if (drag || opening) return;
    var a = e.target && e.target.closest ? e.target.closest('.ds-navlink') : null;
    if (!a || a === curLink) return;
    clearPress();
    curLink = a;
    squish.classList.remove('wb-land'); /* أوقف انضغاط الارتطام السابق إن كان يجري */
    a.classList.add('wb-under');
    wrap.classList.add('wb-press');
    goTo(a);
  });

  wrap.addEventListener('mouseleave', function () {
    if (drag || opening) return;
    clearPress();
    goTo(active); /* ترجع لمقرّ الرابط النشط */
  });

  /* هبوط الكرة: السطح يرتد لاستقامته، والمطّ يرتد للدائرة، والقفزة الطويلة
     تنضغط لحظة ثم ترتد — الثلاثة معاً = استقرار المقطع المرجعي */
  bead.addEventListener('transitionend', function (e) {
    if (e.target !== bead || e.propertyName !== 'transform') return;
    wrap.classList.remove('wb-lean-l', 'wb-lean-r');
    /* وصول الكرة لرابط جديد = لوغوه يطلع من الهدر لمركزها (مثل المقطع حرفياً) */
    if (pendingCarry && !drag) { swapCarry(pendingCarry); pendingCarry = null; }
    /* رجوع المطّ للدائرة بنابض 240ms — لحظة وصول الكرة بالضبط مثل المقطع */
    squish.style.setProperty('--wb-sx', '1');
    squish.style.setProperty('--wb-sy', '1');
    if (lastDist < 40) return;
    squish.classList.remove('wb-land');
    void squish.offsetWidth; /* إعادة تشغيل الأنميشن حتى لو تكرر الارتطام بنفس الموضع */
    squish.classList.add('wb-land');
  });
  /* بعد انتهاء الانضغاط تُرفع الكلاس ليعود التحكم بالدوران للانتقال (transition) لا للأنميشن */
  squish.addEventListener('animationend', function () { squish.classList.remove('wb-land'); });

  /* ═══ حوز لوغو الصفحة + السحب باليد + فتح الصفحة — وصف هادي للمقطع حرفياً
     (1548733132562370772): «يسحب الدائرة بالماوس ويوقفها على صفحة يطلع لوغو
     الصفحة من الهدر لمركز للدائرة وتفتح الصفحة» ═══ */
  var carryLink = null, pendingCarry = null, holds = [];
  var drag = null, opening = false;
  var REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var HOLD_R = 22; /* نصف قطر جسم الكرة القابل للمسك — الهوفر والنقر على الروابط لم يُمس */
  var LIFT = -10;  /* رفعة أول المسك — الكرة تنشل من الودّ مثل المقطع */

  /* أيقونة الرابط تطلع من فتحتها بالهدر (+24px من تحت) وتستقر بمركز الكرة،
     وعن المغادرة ترجع لفتحتها — كل عنصر ينشأ بالسكربت (صفر HTML زيادة)
     وكل حركة transform/opacity بلا أي مؤقت */
  function swapCarry(a) {
    for (var i = holds.length - 1; i >= 0; i--) {
      if (holds[i].classList.contains('wb-up')) holds[i].classList.remove('wb-up');
      if (!holds[i].parentNode) holds.splice(i, 1);
    }
    if (carryLink && (!a || carryLink !== a)) carryLink.classList.remove('wb-carry');
    if (!a) { carryLink = null; return; }
    if (carryLink === a) return;
    carryLink = a;
    var ico = a.querySelector('i');
    if (!ico) return;
    a.classList.add('wb-carry');
    var h = document.createElement('span');
    h.className = 'wb-hold ' + ico.className;
    bead.appendChild(h);
    holds.push(h);
    void h.offsetWidth; /* تثبيت موضع الفتحة قبل طلوع اللوغو للمركز */
    h.classList.add('wb-up');
    return h;
  }
  /* الأيقونة الساقطة تُشال بعد وصولها لفتحتها (transitionend opacity) */
  bead.addEventListener('transitionend', function (e) {
    var t = e.target;
    if (e.propertyName !== 'opacity' || !t.classList || !t.classList.contains('wb-hold')) return;
    if (t.classList.contains('wb-up')) return;
    if (t.parentNode) t.parentNode.removeChild(t);
    var ix = holds.indexOf(t);
    if (ix > -1) holds.splice(ix, 1);
  });

  /* فتح الصفحة بعد ما يستقر لوغوها بمركز الكرة — بالضبط مثل تسلسل المقطع:
     الوقوف على الصفحة يطلع اللوغو، واكتمال طلوعه يفتح الصفحة */
  function openPage(a) {
    if (opening) return;
    opening = true;
    pendingCarry = null;
    if (REDUCED) { window.location.assign(a.href); return; }
    var h = swapCarry(a);
    if (h) h.addEventListener('transitionend', function (e) {
      if (e.propertyName !== 'transform') return;
      window.location.assign(a.href);
    });
    else window.location.assign(a.href);
  }

  function hitLink(cx, cy) {
    for (var i = 0; i < drag.rects.length; i++) {
      var r = drag.rects[i];
      if (cx >= r.l - 6 && cx <= r.r + 6 && Math.abs(cy - r.cy) <= 30) return r.a;
    }
    return null;
  }

  /* المسك من مستند كامل — لأن نصف الكرة العلوي يطلع خارج حدود الكبسولة */
  document.addEventListener('pointerdown', function (e) {
    if (drag || opening || (e.button !== undefined && e.button !== 0)) return;
    var b = bead.getBoundingClientRect();
    var gdx = e.clientX - (b.left + b.width / 2);
    var gdy = e.clientY - (b.top + b.height / 2);
    if (gdx * gdx + gdy * gdy > HOLD_R * HOLD_R) return;
    var links = wrap.querySelectorAll('.ds-navlink');
    var rects = [];
    for (var i = 0; i < links.length; i++) {
      var r = links[i].getBoundingClientRect();
      rects.push({ a: links[i], l: r.left, r: r.right, cy: r.top + r.height / 2 });
    }
    drag = { id: e.pointerId, sx: e.clientX, sy: e.clientY, moved: false, rects: rects, over: null, bendX: -1e9 };
    try { wrap.setPointerCapture(e.pointerId); } catch (err) {}
    wrap.style.setProperty('--wb-dy', LIFT + 'px'); /* الرفعة أول المسك */
    e.preventDefault(); /* لا تحديد نص ولا نقرة تمرّ للرابط تحت الكرة */
  });

  document.addEventListener('pointermove', function (e) {
    if (!drag || e.pointerId !== drag.id) return;
    if (!drag.moved) {
      var mx = e.clientX - drag.sx, my = e.clientY - drag.sy;
      if (mx * mx + my * my < 36) return; /* تحت 6px = ضغطة بلا سحب */
      drag.moved = true;
      swapCarry(null); /* باليد الكرة فاضية — أيقونة المقر رجعت لفتحتها */
      pendingCarry = null;
      wrap.classList.add('wb-dragging'); /* ملصوقة باليد: بلا transition */
      wrap.classList.remove('wb-lean-l', 'wb-lean-r');
      wrap.style.setProperty('--wb-dur', '90ms'); /* النقش والودّ يتبعان بتأخر ثقيل */
      wrap.classList.add('wb-press'); /* ثقل اليد */
      document.documentElement.style.cursor = 'grabbing';
    }
    var wr = wrap.getBoundingClientRect();
    var px = Math.max(16, Math.min(wr.width - 16, e.clientX - wr.left));
    var py = Math.max(-18, Math.min(46, e.clientY - wr.top));
    if (lastX !== null && px !== lastX) {
      rot += ((px - lastX) / R) * RAD; /* تدحرج فيزيائي مع اليد — نفس نسبة التدحرج */
      wrap.style.setProperty('--wb-rot', rot.toFixed(1) + 'deg');
    }
    wrap.style.setProperty('--wb-x', px + 'px');
    wrap.style.setProperty('--wb-dy', py + 'px');
    lastX = px;
    if (px - drag.bendX >= 4 || drag.bendX - px >= 4) { bendEdge(px); drag.bendX = px; }
    var over = hitLink(e.clientX, wr.top + py);
    if (over !== drag.over) {
      if (drag.over) drag.over.classList.remove('wb-under');
      drag.over = over;
      if (over) over.classList.add('wb-under');
      swapCarry(over); /* لوغو الصفحة اللي واقف عندها يطلع من الهدر لمركزها */
    }
  });

  function endDrag(e, cancelled) {
    if (!drag || e.pointerId !== drag.id) return;
    var d = drag;
    var wr = wrap.getBoundingClientRect();
    var py = Math.max(-18, Math.min(46, e.clientY - wr.top));
    var over = cancelled ? null : hitLink(e.clientX, wr.top + py);
    drag = null;
    document.documentElement.style.cursor = '';
    try { wrap.releasePointerCapture(d.id); } catch (err) {}
    if (!d.moved) {
      wrap.style.setProperty('--wb-dy', '0px'); /* ضغطة بلا سحب — ترجع للودّ */
      return;
    }
    wrap.classList.remove('wb-dragging');
    if (over) {
      /* الإفلات على صفحة — بالحرف: تثبت فيها ويطلع لوغوها لمركزها وتنفتح */
      curLink = over;
      over.classList.add('wb-under');
      wrap.classList.add('wb-press');
      goTo(over); /* تثبيت بمركز الصفحة بنفس فيزياء التدحرج والنابض */
      wrap.style.setProperty('--wb-dy', '0px');
      squish.classList.remove('wb-land'); /* انضغاط الجلوس في الودّ */
      void squish.offsetWidth;
      squish.classList.add('wb-land');
      openPage(over);
    } else {
      /* الإفلات بأي مكان ثاني — ترجع لمقرّها بالنابض ولا شيء ينفتح */
      if (d.over) d.over.classList.remove('wb-under');
      clearPress();
      goTo(curLink || active);
      wrap.style.setProperty('--wb-dy', '0px');
    }
  }
  document.addEventListener('pointerup', function (e) { endDrag(e, false); });
  document.addEventListener('pointercancel', function (e) { endDrag(e, true); });

  function sync() {
    if (drag) return; /* لا إعادة محاذاة وسط سحب */
    active = wrap.querySelector('.ds-navlink.active') || active;
    buildEdge(); /* إعادة بناء القطع لو تغير عرض الكبسولة (resize) */
    goTo(active, true); /* إعادة محاذاة فورية بلا تدحرج */
    bead.classList.add('wb-bead-ready'); /* تظهر بعد أول تحديد — لا وميض بموضع خاطئ */
    wrap.classList.add('wb-on'); /* الحفرة ظاهرة دائماً منذ أول تحديد — مثل المرجع */
  }
  sync();
  window.addEventListener('resize', sync);
  /* الخط قد يغيّر عرض الروابط بعد أول قياس — إعادة محاذاة واحدة عند جهوزيته */
  if (document.fonts && document.fonts.ready && document.fonts.ready.then) {
    document.fonts.ready.then(sync).catch(function () {});
  }
})();
</script>
